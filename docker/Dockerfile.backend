FROM mcr.microsoft.com/dotnet/sdk:8.0 AS restore
WORKDIR /src

COPY HrProject.Api/HrProject.Api.csproj HrProject.Api/
COPY HrProject.Shared/HrProject.Shared.csproj HrProject.Shared/
RUN dotnet restore HrProject.Api/HrProject.Api.csproj

FROM restore AS publish
COPY . .
RUN dotnet publish HrProject.Api/HrProject.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_EnableDiagnostics=0

COPY --from=publish --chown=app:app /app/publish .

# CLI migration commands in Program.cs resolve ../database/Scripts from /app.
COPY --from=publish --chown=app:app /src/Database /database

RUN mkdir -p /app/App_Data/leave-attachments \
    && chown -R app:app /app/App_Data

USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "HrProject.Api.dll"]

