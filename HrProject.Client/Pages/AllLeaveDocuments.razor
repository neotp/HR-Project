@page "/leave/all-documents"
@inject HttpClient Http

<PageTitle>เอกสารทั้งหมด | HR Project</PageTitle>

<section class="manage-page all-leave-documents-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1>เอกสารทั้งหมด</h1>
                <p>ดูเอกสารการลาของพนักงานทุกคนแบบอ่านอย่างเดียว โดยไม่แสดงไฟล์แนบ</p>
            </div>
            <div class="readonly-badge">ดูได้อย่างเดียว</div>
        </div>
    </header>

    <section class="content-card criteria-card">
        <div class="content-card-header">ค้นหาเอกสาร</div>
        <div class="content-card-body">
            <div class="criteria-grid">
                <label>คำค้นหา
                    <input @bind="searchText" @bind:event="oninput" @bind:after="Filter"
                           placeholder="เลขที่เอกสาร พนักงาน แผนก หรือเหตุผล" />
                </label>
                <div class="criteria-field"><span class="criteria-field-label">ประเภทการลา</span>
                    <CriteriaMultiSelect Options="@LeaveTypeFilterOptions" Values="@selectedLeaveTypes" ValuesChanged="SetLeaveTypeFilters" />
                </div>
                <div class="criteria-field">
                    <span class="criteria-field-label">สถานะ</span>
                    <details class="status-multiselect">
                        <summary>
                            <span>@StatusFilterSummary</span>
                            <span class="status-multiselect-chevron" aria-hidden="true">⌄</span>
                        </summary>
                        <div class="status-multiselect-menu">
                            <button class="status-filter-clear" type="button" @onclick="ClearStatusFilter">แสดงทั้งหมด</button>
                            @foreach (var option in StatusFilterOptions)
                            {
                                <label class="status-multiselect-option">
                                    <input type="checkbox" checked="@selectedStatuses.Contains(option.Code)"
                                           @onchange="args => SetStatusFilter(option.Code, args.Value is true)" />
                                    <span class="status-pill @StatusClass(option.Code)" data-status="@option.Code">@option.Label</span>
                                </label>
                            }
                        </div>
                    </details>
                </div>
                <label>วันที่ลาเริ่มต้น
                    <DateTimePicker @bind-Value="startDate" @bind-Value:after="Filter" AriaLabel="วันที่ลาเริ่มต้น" />
                </label>
                <label>วันที่ลาสิ้นสุด
                    <DateTimePicker @bind-Value="endDate" @bind-Value:after="Filter" AriaLabel="วันที่ลาสิ้นสุด" />
                </label>
            </div>
            <div class="criteria-actions">
                <button class="btn btn-reset" type="button" @onclick="Reset">ล้างข้อมูล</button>
            </div>
        </div>
    </section>

    <section class="content-card result-card">
        <div class="content-card-header">
            รายการเอกสารการลาทั้งหมด
            <span class="result-count">@filteredDocuments.Count รายการ</span>
        </div>
        <div class="content-card-body">
            @if (isLoading)
            {
                <div class="state-message">กำลังโหลดเอกสาร...</div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="state-message error">@loadError</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table employee-table all-documents-table">
                        <thead>
                            <tr>
                                <th>เลขที่เอกสาร</th>
                                <th>พนักงาน</th>
                                <th>แผนก</th>
                                <th>ประเภทการลา</th>
                                <th>วันที่ลา</th>
                                <th>เวลาเริ่มต้น</th>
                                <th>จำนวนชั่วโมง</th>
                                <th>เหตุผล</th>
                                <th>สถานะ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredDocuments.Count == 0)
                            {
                                <tr><td colspan="9" class="no-results">ไม่พบเอกสารตามเงื่อนไขที่ค้นหา</td></tr>
                            }
                            else
                            {
                                @foreach (var document in PagedDocuments)
                                {
                                    <tr>
                                        <td><LeaveDocumentHoverPreview Document="@document"><button class="document-number" type="button" @onclick="() => OpenDocument(document)">@document.DocumentNo</button></LeaveDocumentHoverPreview></td>
                                        <td>@document.CreatorName</td>
                                        <td>@document.CreatorDepartment</td>
                                        <td>@document.LeaveTypeName</td>
                                        <td>@document.LeaveDate.ToString("dd/MM/yyyy")</td>
                                        <td>@document.StartTime.ToString("HH:mm")</td>
                                        <td>@document.LeaveHours.ToString("0.##") ชั่วโมง</td>
                                        <td><span class="reason-cell" title="@document.LeaveReason">@document.LeaveReason</span></td>
                                        <td><span class="status-pill @StatusClass(document.Status)" data-status="@document.Status">@StatusText(document.Status)</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination TotalItems="@filteredDocuments.Count" @bind-CurrentPage="currentPage" @bind-PageSize="pageSize" />
            }
        </div>
    </section>
</section>

@if (selectedDocument is not null)
{
    <div class="document-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="all-document-detail-title">
        <section class="document-modal">
            <header class="document-modal-header">
                <div>
                    <h2 id="all-document-detail-title">รายละเอียดเอกสารการลา</h2>
                    <p>@selectedDocument.DocumentNo</p>
                </div>
                <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseDocument">×</button>
            </header>
            <div class="document-modal-body">
                <div class="readonly-notice">เอกสารนี้เปิดดูได้อย่างเดียว และไม่แสดงเอกสารแนบ</div>
                <div class="form-grid">
                    <label>ผู้สร้างเอกสาร<input value="@selectedDocument.CreatorName" disabled /></label>
                    <label>แผนก<input value="@selectedDocument.CreatorDepartment" disabled /></label>
                    <label>ผู้อนุมัติ<input value="@selectedDocument.ApproverName" disabled /></label>
                    <label>วันที่สร้าง<input value="@selectedDocument.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")" disabled /></label>
                    <label>ชนิดการลา<input value="@KindText(selectedDocument.LeaveKind)" disabled /></label>
                    <label>ประเภทการลา<input value="@selectedDocument.LeaveTypeName" disabled /></label>
                    <label>วันที่ลา<input value="@selectedDocument.LeaveDate.ToString("dd/MM/yyyy")" disabled /></label>
                    <label>เวลาเริ่มต้น<input value="@selectedDocument.StartTime.ToString("HH:mm")" disabled /></label>
                    <label>จำนวนชั่วโมง<input value="@selectedDocument.LeaveHours.ToString("0.##")" disabled /></label>
                    <label>สถานะ<input value="@StatusText(selectedDocument.Status)" disabled /></label>
                    <label class="full-width">เหตุผลการลา<textarea rows="3" disabled>@selectedDocument.LeaveReason</textarea></label>
                </div>
                @if (CanViewBonusDeduction)
                {
                    <section class="bonus-deduction-card">
                        <div class="bonus-deduction-heading">
                            <div>
                                <h3>ข้อมูลการหักโบนัส</h3>
                                <p>ข้อมูลภายในสำหรับผู้ได้รับสิทธิ์เท่านั้น</p>
                            </div>
                            @if (bonusDeduction?.IsOverridden == true)
                            {
                                <span class="bonus-override-badge">ปรับเป็นรายเอกสารแล้ว</span>
                            }
                        </div>
                        @if (isBonusLoading)
                        {
                            <div class="state-message">กำลังโหลดข้อมูลการหักโบนัส...</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(bonusError))
                        {
                            <div class="state-message error">@bonusError</div>
                        }
                        else if (bonusDeduction is not null)
                        {
                            <div class="bonus-form-grid">
                                <label class="bonus-check">
                                    <input type="checkbox" checked="@editBonusIsDeducted"
                                           @onchange="SetBonusDeducted"
                                           disabled="@(!CanEditBonusDeduction || isBonusSaving)" />
                                    หักโบนัส
                                </label>
                                <label>เปอร์เซ็นต์ที่หัก
                                    <input type="number" min="0" max="100" step="0.01"
                                           @bind="editBonusPercent"
                                           disabled="@(!CanEditBonusDeduction || !editBonusIsDeducted || isBonusSaving)" />
                                </label>
                                <label class="bonus-check">
                                    <input type="checkbox" checked="@editBonusIsWaived"
                                           @onchange="SetBonusWaived"
                                           disabled="@(!CanEditBonusDeduction || isBonusSaving)" />
                                    Waive / ยกเว้นการหัก
                                </label>
                                <label class="bonus-reason">เหตุผลในการปรับหรือยกเว้น
                                    <textarea rows="2" @bind="editBonusReason"
                                              disabled="@(!CanEditBonusDeduction || isBonusSaving)"
                                              placeholder="ระบุเหตุผลทุกครั้งที่มีการปรับ"></textarea>
                                </label>
                            </div>
                            @if (CanEditBonusDeduction)
                            {
                                <div class="bonus-actions">
                                    <button class="btn btn-primary" type="button" disabled="@isBonusSaving" @onclick="SaveBonusDeduction">
                                        @(isBonusSaving ? "กำลังบันทึก..." : "บันทึกข้อมูลการหักโบนัส")
                                    </button>
                                </div>
                            }
                        }
                    </section>
                }
            </div>
            <footer class="document-modal-footer">
                <button class="btn btn-history" type="button" @onclick="ToggleHistory">
                    @(isShowingHistory ? "ซ่อนประวัติเอกสาร" : "ประวัติเอกสาร")
                </button>
                <button class="btn btn-reset" type="button" @onclick="CloseDocument">ปิด</button>
            </footer>
        </section>
    </div>
}

@if (isShowingHistory && selectedDocument is not null)
{
    <LeaveDocumentHistoryPanel DocumentNo="@selectedDocument.DocumentNo"
                               Items="@documentHistory" IsLoading="@isHistoryLoading"
                               Error="@historyError" OnClose="CloseHistory" />
}

@code {
    private bool isLoading = true;
    private string? loadError;
    private string searchText = string.Empty;
    private readonly HashSet<string> selectedLeaveTypes = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<CriteriaFilterOption> LeaveTypeFilterOptions => leaveTypes.Select(x => new CriteriaFilterOption(x.NameTh, x.NameTh)).ToList();
    private readonly HashSet<string> selectedStatuses = new(StringComparer.OrdinalIgnoreCase)
    {
        "PENDING_APPROVAL", "EDIT_REQUESTED", "APPROVED"
    };
    private static readonly (string Code, string Label)[] StatusFilterOptions =
    [
        ("PENDING_APPROVAL", "รออนุมัติ"),
        ("APPROVED", "อนุมัติแล้ว"),
        ("REJECTED", "ไม่อนุมัติ"),
        ("EDIT_REQUESTED", "ขอแก้ไข"),
        ("CANCELLED", "ยกเลิก")
    ];
    private string StatusFilterSummary => selectedStatuses.Count switch
    {
        0 => "ทั้งหมด",
        1 => StatusText(selectedStatuses.First()),
        _ => $"เลือกแล้ว {selectedStatuses.Count} สถานะ"
    };
    private DateTime? startDate;
    private DateTime? endDate;
    private CurrentMicrosoftUserDto? currentUser;
    private List<LeaveTypeDto> leaveTypes = [];
    private List<LeaveDocumentDto> documents = [];
    private List<LeaveDocumentDto> filteredDocuments = [];
    private LeaveDocumentDto? selectedDocument;
    private bool isShowingHistory;
    private bool isHistoryLoading;
    private string? historyError;
    private List<LeaveDocumentHistoryDto> documentHistory = [];
    private readonly HashSet<string> allowedActions = new(StringComparer.OrdinalIgnoreCase);
    private LeaveBonusDeductionDto? bonusDeduction;
    private bool isBonusLoading;
    private bool isBonusSaving;
    private string? bonusError;
    private bool editBonusIsDeducted;
    private decimal editBonusPercent;
    private bool editBonusIsWaived;
    private string editBonusReason = string.Empty;
    private bool CanViewBonusDeduction => allowedActions.Contains("VIEW_BONUS_DEDUCTION") || CanEditBonusDeduction;
    private bool CanEditBonusDeduction => allowedActions.Contains("EDIT_BONUS_DEDUCTION");
    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<LeaveDocumentDto> PagedDocuments => filteredDocuments
        .Skip((Math.Clamp(currentPage, 1, Math.Max(1, (int)Math.Ceiling(filteredDocuments.Count / (double)pageSize))) - 1) * pageSize)
        .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
            if (currentUser is null || string.IsNullOrWhiteSpace(currentUser.EmployeeId))
                throw new InvalidOperationException("บัญชี Microsoft ยังไม่ได้เชื่อมกับข้อมูลพนักงาน");

            var actionPermissions = await Http.GetFromJsonAsync<CurrentPageActionPermissionsDto>(
                $"api/page-permissions/current-actions?employeeId={Uri.EscapeDataString(currentUser.EmployeeId)}&pageKey=LEAVE_ALL_DOCUMENTS");
            allowedActions.UnionWith(actionPermissions?.AllowedActions ?? []);

            leaveTypes = await Http.GetFromJsonAsync<List<LeaveTypeDto>>("api/leave-types") ?? [];
            documents = await Http.GetFromJsonAsync<List<LeaveDocumentDto>>(
                $"api/leave-documents?viewAll=true&actingEmployeeId={Uri.EscapeDataString(currentUser.EmployeeId)}") ?? [];
            Filter();
        }
        catch (Exception exception)
        {
            loadError = $"โหลดเอกสารทั้งหมดไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Filter()
    {
        currentPage = 1;
        filteredDocuments = documents.Where(document =>
            (string.IsNullOrWhiteSpace(searchText) ||
             document.DocumentNo.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             document.CreatorEmployeeId.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             document.CreatorName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             document.CreatorDepartment.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             document.LeaveTypeName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             document.LeaveReason.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
            (selectedLeaveTypes.Count == 0 || selectedLeaveTypes.Contains(document.LeaveTypeName)) &&
            (selectedStatuses.Count == 0 || selectedStatuses.Contains(document.Status)) &&
            (!startDate.HasValue || document.LeaveDate >= DateOnly.FromDateTime(startDate.Value)) &&
            (!endDate.HasValue || document.LeaveDate <= DateOnly.FromDateTime(endDate.Value)))
            .ToList();
    }

    private void Reset()
    {
        searchText = string.Empty;
        selectedLeaveTypes.Clear();
        selectedStatuses.Clear();
        selectedStatuses.UnionWith(["PENDING_APPROVAL", "EDIT_REQUESTED", "APPROVED"]);
        startDate = endDate = null;
        Filter();
    }

    private void SetStatusFilter(string statusCode, bool isSelected)
    {
        if (isSelected) selectedStatuses.Add(statusCode); else selectedStatuses.Remove(statusCode);
        Filter();
    }

    private void ClearStatusFilter()
    {
        selectedStatuses.Clear();
        Filter();
    }

    private Task SetLeaveTypeFilters(IReadOnlyCollection<string> values)
    {
        selectedLeaveTypes.Clear(); selectedLeaveTypes.UnionWith(values); Filter();
        return Task.CompletedTask;
    }

    private async Task OpenDocument(LeaveDocumentDto document)
    {
        selectedDocument = document;
        isShowingHistory = false;
        documentHistory = [];
        historyError = null;
        bonusDeduction = null;
        bonusError = null;
        if (CanViewBonusDeduction)
            await LoadBonusDeduction();
    }

    private void CloseDocument()
    {
        selectedDocument = null;
        isShowingHistory = false;
        documentHistory = [];
        historyError = null;
        bonusDeduction = null;
        bonusError = null;
    }

    private async Task ToggleHistory()
    {
        if (isShowingHistory)
        {
            CloseHistory();
            return;
        }
        if (selectedDocument is null) return;
        isShowingHistory = true;
        isHistoryLoading = true;
        historyError = null;
        try
        {
            documentHistory = await Http.GetFromJsonAsync<List<LeaveDocumentHistoryDto>>(
                $"api/leave-documents/{selectedDocument.Id}/history") ?? [];
        }
        catch (Exception exception)
        {
            historyError = $"โหลดประวัติเอกสารไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isHistoryLoading = false;
        }
    }

    private void CloseHistory() => isShowingHistory = false;

    private async Task LoadBonusDeduction()
    {
        if (selectedDocument is null || currentUser is null) return;
        isBonusLoading = true;
        bonusError = null;
        try
        {
            bonusDeduction = await Http.GetFromJsonAsync<LeaveBonusDeductionDto>(
                $"api/leave-documents/{selectedDocument.Id}/bonus-deduction?actingEmployeeId={Uri.EscapeDataString(currentUser.EmployeeId)}");
            if (bonusDeduction is not null)
            {
                editBonusIsDeducted = bonusDeduction.IsDeducted;
                editBonusPercent = bonusDeduction.DeductionPercent;
                editBonusIsWaived = bonusDeduction.IsWaived;
                editBonusReason = bonusDeduction.AdjustmentReason ?? string.Empty;
            }
        }
        catch (Exception exception)
        {
            bonusError = $"โหลดข้อมูลการหักโบนัสไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isBonusLoading = false;
        }
    }

    private async Task SaveBonusDeduction()
    {
        if (selectedDocument is null || currentUser is null || !CanEditBonusDeduction) return;
        if (string.IsNullOrWhiteSpace(editBonusReason))
        {
            bonusError = "กรุณาระบุเหตุผลในการปรับข้อมูลการหักโบนัส";
            return;
        }
        isBonusSaving = true;
        bonusError = null;
        try
        {
            var request = new UpdateLeaveBonusDeductionRequest(
                editBonusIsDeducted, editBonusPercent, editBonusIsWaived,
                editBonusReason, currentUser.EmployeeId, currentUser.EmployeeName);
            var response = await Http.PutAsJsonAsync(
                $"api/leave-documents/{selectedDocument.Id}/bonus-deduction", request);
            if (!response.IsSuccessStatusCode)
            {
                bonusError = (await response.Content.ReadAsStringAsync()).Trim('"');
                return;
            }
            bonusDeduction = await response.Content.ReadFromJsonAsync<LeaveBonusDeductionDto>();
        }
        catch (Exception exception)
        {
            bonusError = $"บันทึกข้อมูลการหักโบนัสไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isBonusSaving = false;
        }
    }

    private void SetBonusDeducted(ChangeEventArgs args)
    {
        editBonusIsDeducted = args.Value is true;
        if (editBonusIsDeducted)
            editBonusIsWaived = false;
    }

    private void SetBonusWaived(ChangeEventArgs args)
    {
        editBonusIsWaived = args.Value is true;
        if (editBonusIsWaived)
            editBonusIsDeducted = false;
    }
    private static string KindText(string kind) => kind == "ADVANCE" ? "ลาล่วงหน้า" : "ลาย้อนหลัง";
    private static string StatusText(string status) => status switch
    {
        "PENDING_APPROVAL" => "รออนุมัติ",
        "APPROVED" => "อนุมัติแล้ว",
        "REJECTED" => "ไม่อนุมัติ",
        "EDIT_REQUESTED" => "ขอแก้ไข",
        "CANCELLED" => "ยกเลิก",
        _ => status
    };
    private static string StatusClass(string status) => status switch
    {
        "APPROVED" => "approved",
        "PENDING_APPROVAL" => "pending",
        "EDIT_REQUESTED" => "editing",
        "CANCELLED" => "cancelled",
        _ => "rejected"
    };
}
