    private void OpenEmployee(int id) => Navigation.NavigateTo($"/employees/{id}");

    private async Task OpenCreateEmployee()
    {
        var masterTask = masterItems.Count == 0
            ? Http.GetFromJsonAsync<List<MasterDataItemDto>>("api/system-master-data/items/all")
            : Task.FromResult<List<MasterDataItemDto>?>(null);
        var employeesTask = employeeOptions.Count == 0
            ? Http.GetFromJsonAsync<List<Employee>>("api/employees")
            : Task.FromResult<List<Employee>?>(null);
        await Task.WhenAll(masterTask, employeesTask);
        if (masterTask.Result is not null) masterItems = masterTask.Result;
        if (employeesTask.Result is not null) employeeOptions = employeesTask.Result;
        newEmployee = CreateBlankEmployee();
        canTravelUpcountry = string.Empty;
        marriageRegistered = string.Empty;
        spouseHasIncome = string.Empty;
        createActiveTab = "basic";
        createError = null;
        isCreateOpen = true;
    }

    private void CloseCreateEmployee()
    {
        if (!isCreating)
            isCreateOpen = false;
    }

    private async Task SaveEmployee()
    {
        createError = null;
        newEmployee.EmployeeCode = EmployeeCodeFormat.NormalizeNew(newEmployee.EmployeeCode);
        if (!EmployeeCodeFormat.IsValid(newEmployee.EmployeeCode))
        {
            createError = "รหัสพนักงานต้องมี 6 ตัว";
            return;
        }
        if (string.IsNullOrWhiteSpace(newEmployee.EmployeeCode) ||
            string.IsNullOrWhiteSpace(newEmployee.FirstName) ||
            string.IsNullOrWhiteSpace(newEmployee.LastName) ||
            string.IsNullOrWhiteSpace(newEmployee.Email) ||
            string.IsNullOrWhiteSpace(newEmployee.Department) ||
            string.IsNullOrWhiteSpace(newEmployee.Position))
        {
            createError = "กรุณากรอกช่องที่มีเครื่องหมาย * ให้ครบถ้วน";
            return;
        }

        isCreating = true;
        try
        {
            newEmployee.CanTravelUpcountry = ParseNullableBool(canTravelUpcountry);
            newEmployee.IsMarriageRegistered = ParseNullableBool(marriageRegistered);
            newEmployee.SpouseHasIncome = ParseNullableBool(spouseHasIncome);
            var response = await Http.PostAsJsonAsync("api/employees", newEmployee);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                createError = string.IsNullOrWhiteSpace(details)
                    ? $"เพิ่มพนักงานไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : details.Trim('"');
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<Employee>();
            if (created is not null) employeeOptions.Add(created);
            isCreateOpen = false;
            await LoadFilterOptions();
            await LoadEmployees();
        }
        catch (Exception exception)
        {
            createError = $"เพิ่มพนักงานไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task UploadProfileImage(InputFileChangeEventArgs eventArgs)
    {
        createError = null;
        var file = eventArgs.File;
        var allowedTypes = new[] { "image/jpeg", "image/png", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            createError = "กรุณาเลือกไฟล์รูป JPG, PNG หรือ WEBP เท่านั้น";
            return;
        }

        if (file.Size > MaxProfileImageBytes)
        {
            createError = "รูปโปรไฟล์ต้องมีขนาดไม่เกิน 2 MB";
            return;
        }

        try
        {
            await using var input = file.OpenReadStream(MaxProfileImageBytes);
            using var memory = new MemoryStream();
            await input.CopyToAsync(memory);
            newEmployee.ProfileImageDataUrl =
                $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
        }
        catch (Exception exception)
        {
            createError = $"อ่านไฟล์รูปไม่สำเร็จ: {exception.Message}";
        }
    }

    private void RemoveProfileImage() => newEmployee.ProfileImageDataUrl = string.Empty;

