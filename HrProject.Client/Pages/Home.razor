@page "/"
@using HrProject.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>ข้อมูลพนักงาน | HR Project</PageTitle>

<section class="manage-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1>ข้อมูลพนักงาน</h1>
                <p>รายชื่อและข้อมูลการทำงานของพนักงาน</p>
            </div>
            <div class="employee-header-actions">
                @if (canExportEmployee)
                {
                <button class="export-employee-button" type="button"
                        disabled="@(employees is null || totalItems == 0)"
                        @onclick="OpenExport">
                    Export ข้อมูล
                </button>
                }
                @if (canCreateEmployee)
                {
                    <button class="add-employee-button" type="button" @onclick="OpenCreateEmployee">
                        + เพิ่มพนักงาน
                    </button>
                }
            </div>
        </div>
    </header>

    <section class="content-card employee-search-card">
        <div class="content-card-header">ค้นหาพนักงาน</div>
        <div class="content-card-body employee-search-body">
            <div class="employee-search-accordion">
                <section class="employee-search-section @(activeSearchSection == EmployeeSearchSection ? "active" : null)">
                    <button class="employee-search-toggle" type="button"
                            aria-expanded="@(activeSearchSection == EmployeeSearchSection)"
                            @onclick="() => ToggleSearchSection(EmployeeSearchSection)">
                        <span class="employee-search-chevron" aria-hidden="true"></span>
                        <span class="employee-search-toggle-copy"><strong>ค้นหาจากข้อมูลพนักงาน</strong><small>รหัสหรือชื่อ, BU, แผนก, ตำแหน่ง, Ext. และจังหวัดที่ดูแล</small></span>
                    </button>
                    @if (activeSearchSection == EmployeeSearchSection)
                    {
                        <div class="employee-search-panel">
                            <div class="employee-search-fields">
                                <label>
                                    <span>รหัส หรือชื่อพนักงาน</span>
                                    <RemoteEmployeeSearchSelect Value="@selectedEmployeeCode"
                                                                ValueChanged="SetEmployeeFilter"
                                                                Placeholder="-- เลือกหรือพิมพ์ค้นหาพนักงาน --" />
                                </label>
                                <label>
                                    <span>Business Unit (BU)</span>
                                    <StringSearchSelect Items="@(PreserveSelected(filterOptions.BusinessUnits, businessUnitFilter).ToList())" @bind-Value="businessUnitFilter" @bind-Value:after="StructuralFilterChanged" />
                                </label>
                                <label>
                                    <span>แผนก</span>
                                    <StringSearchSelect Items="@(PreserveSelected(filterOptions.Departments, departmentFilter).ToList())" @bind-Value="departmentFilter" @bind-Value:after="StructuralFilterChanged" />
                                </label>
                                <label>
                                    <span>ตำแหน่ง</span>
                                    <StringSearchSelect Items="@(PreserveSelected(filterOptions.Positions, positionFilter).ToList())" @bind-Value="positionFilter" @bind-Value:after="StructuralFilterChanged" />
                                </label>
                                <label>
                                    <span>Ext. ภายใน</span>
                                    <div class="employee-search-input">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                                        <input value="@internalExtensionFilter" @oninput="InternalExtensionFilterChanged" placeholder="ค้นหา Ext. ภายใน" />
                                        @if (!string.IsNullOrWhiteSpace(internalExtensionFilter))
                                        {
                                            <button type="button" aria-label="ล้าง Ext. ภายใน" @onclick="ClearInternalExtensionFilter">×</button>
                                        }
                                    </div>
                                </label>
                                <label>
                                    <span>Province of Responsibility (จังหวัดที่ดูแล)</span>
                                    <StringSearchSelect Items="@(filterOptions.ResponsibilityProvinces.ToList())" @bind-Value="responsibilityProvinceFilter" @bind-Value:after="ReloadFirstPage" />
                                </label>
                                @if (HasEmployeeSectionFilters)
                                {
                                    <div class="employee-search-actions"><button type="button" @onclick="ClearActiveSearchFilters">ล้างตัวกรองส่วนนี้</button></div>
                                }
                            </div>
                        </div>
                    }
                </section>

                <section class="employee-search-section @(activeSearchSection == ProductSearchSection ? "active" : null)">
                    <button class="employee-search-toggle" type="button"
                            aria-expanded="@(activeSearchSection == ProductSearchSection)"
                            @onclick="() => ToggleSearchSection(ProductSearchSection)">
                        <span class="employee-search-chevron" aria-hidden="true"></span>
                        <span class="employee-search-toggle-copy"><strong>ค้นหาจากข้อมูล Product</strong><small>Product BU, Brand และ Comm.Group ของรอบข้อมูลปัจจุบัน</small></span>
                    </button>
                    @if (activeSearchSection == ProductSearchSection)
                    {
                        <div class="employee-search-panel">
                            <div class="employee-search-fields product-search-fields">
                                <label>
                                    <span>Product BU</span>
                                    <StringSearchSelect Items="@(PreserveSelected(filterOptions.ProductBusinessUnits, productBusinessUnitFilter).ToList())" @bind-Value="productBusinessUnitFilter" @bind-Value:after="ProductFilterChanged" />
                                </label>
                                <label>
                                    <span>Brand</span>
                                    <StringSearchSelect Items="@(PreserveSelected(filterOptions.Brands, brandFilter).ToList())" @bind-Value="brandFilter" @bind-Value:after="ProductFilterChanged" />
                                </label>
                                <label>
                                    <span>Comm.Group</span>
                                    <StringSearchSelect Items="@(PreserveSelected(filterOptions.CommGroups, commGroupFilter).ToList())" @bind-Value="commGroupFilter" @bind-Value:after="ProductFilterChanged" />
                                </label>
                                @if (HasProductSectionFilters)
                                {
                                    <div class="employee-search-actions"><button type="button" @onclick="ClearActiveSearchFilters">ล้างตัวกรองส่วนนี้</button></div>
                                }
                            </div>
                        </div>
                    }
                </section>
            </div>
        </div>
    </section>

    <section class="content-card">
        <div class="content-card-header">รายชื่อพนักงาน <span class="employee-result-count">@totalItems รายการ</span></div>
        <div class="content-card-body">
            @if (employees is null)
            {
                <p class="loading-state"><em>กำลังโหลดข้อมูลพนักงาน...</em></p>
            }
            else
            {
                <div class="employee-table-scroll">
                <table class="table employee-table">
                    <thead>
                        <tr><th>รหัสพนักงาน</th><th>ชื่อ</th><th>Ext. ภายใน</th><th>วันที่เริ่มงาน</th><th>Province of Responsibility (จังหวัดที่ดูแล)</th><th>Brand</th><th>Comm.Group</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (isLoadingEmployees)
                        {
                            <tr><td colspan="8" class="employee-empty-state">กำลังโหลดข้อมูลพนักงาน...</td></tr>
                        }
                        else if (employees.Count == 0)
                        {
                            <tr><td colspan="8" class="employee-empty-state">ไม่พบพนักงานตามคำค้นหา</td></tr>
                        }
                        @foreach (var employee in employees)
                        {
                            <tr class="employee-row" tabindex="0"
                                title="เปิดข้อมูลพนักงาน"
                                @onclick="() => OpenEmployee(employee.Id)"
                                @onkeydown="args => HandleRowKey(args, employee.Id)">
                                <td>@EmployeeCodeFormat.Display(employee.EmployeeCode)</td>
                                <td><strong>@employee.FullName</strong></td>
                                <td>@DisplayCell(employee.InternalExtension)</td>
                                <td>@(employee.StartDate == default ? "-" : employee.StartDate.ToString("dd/MM/yyyy"))</td>
                                <td class="multi-value-cell">@DisplayCell(employee.ResponsibilityProvince)</td>
                                <td class="multi-value-cell">@DisplayCell(employee.Brand)</td>
                                <td class="multi-value-cell">@DisplayCell(employee.CommGroup)</td>
                                <td><span class="view-details">ดูข้อมูล ›</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <Pagination TotalItems="@totalItems" CurrentPage="@currentPage" CurrentPageChanged="ChangePage"
                            PageSize="@pageSize" PageSizeChanged="ChangePageSize" />
            }
        </div>
    </section>
</section>

@if (isExportOpen)
{
    <div class="employee-create-overlay" role="dialog" aria-modal="true"
         aria-labelledby="export-employee-title" @onclick="CloseExport">
        <section class="employee-export-modal" @onclick:stopPropagation="true">
            <header class="employee-create-header">
                <div>
                    <h2 id="export-employee-title">Export ข้อมูลพนักงาน</h2>
                    <p>เลือกชุดข้อมูลที่ต้องการ Export จำนวน @totalItems คนตามตัวกรองปัจจุบัน</p>
                </div>
                <button type="button" aria-label="ปิด" disabled="@isExporting" @onclick="CloseExport">×</button>
            </header>
            <div class="employee-export-body">
                <button type="button" disabled="@isExporting" @onclick="ExportAllEmployeeFields">
                    <strong>ข้อมูลพนักงานทั้งหมดทุกฟิลด์</strong>
                    <span>รวมข้อมูลส่วนบุคคล ข้อมูลบริษัท ประวัติการทำงาน การศึกษา และการอบรม</span>
                </button>
                <div class="tax-export-option">
                    <label>ปีภาษี
                        <input type="number" min="2000" max="2200" @bind="exportTaxYear" />
                    </label>
                    <button type="button" disabled="@isExporting" @onclick="ExportTaxDeductions">
                        <strong>ข้อมูลค่าลดหย่อนภาษี</strong>
                        <span>Export ค่าลดหย่อนภาษีของปีที่เลือก</span>
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(exportError))
                {
                    <div class="create-error">@exportError</div>
                }
            </div>
        </section>
    </div>
}

@if (isCreateOpen)
{
    <div class="employee-create-overlay" role="dialog" aria-modal="true"
         aria-labelledby="create-employee-title">
        <section class="employee-create-modal">
            <header class="employee-create-header">
                <div>
                    <h2 id="create-employee-title">เพิ่มพนักงาน</h2>
                    <p>กรอกข้อมูลพนักงานใหม่ โดยช่องที่มี * จำเป็นต้องระบุ</p>
                </div>
                <button type="button" aria-label="ปิด" disabled="@isCreating"
                        @onclick="CloseCreateEmployee">×</button>
            </header>

            <div class="employee-create-body">
                <nav class="create-tabs" aria-label="หมวดข้อมูลพนักงานใหม่">
                    @foreach (var tab in CreateTabs)
                    {
                        <button type="button"
                                class="@(createActiveTab == tab.Key ? "active" : null)"
                                @onclick="() => createActiveTab = tab.Key">
                            @tab.Label
                        </button>
                    }
                </nav>

                <section class="create-tab-panel">
                    @switch (createActiveTab)
                    {
                        case "basic":
                            <div class="create-form-grid">
                                <div class="profile-image-editor wide-field">
                                    <div class="profile-image-preview">
                                        @if (string.IsNullOrWhiteSpace(newEmployee.ProfileImageDataUrl))
                                        {
                                            <span aria-hidden="true">@NewEmployeeInitials</span>
                                        }
                                        else
                                        {
                                            <img src="@newEmployee.ProfileImageDataUrl" alt="รูปพนักงานใหม่" />
                                        }
                                    </div>
                                    <div class="profile-image-actions">
                                        <strong>รูปโปรไฟล์</strong>
                                        <small>รองรับ JPG, PNG และ WEBP ขนาดไม่เกิน 2 MB</small>
                                        <label class="upload-image-button">
                                            เลือกรูป
                                            <InputFile OnChange="UploadProfileImage" accept="image/jpeg,image/png,image/webp" />
                                        </label>
                                        @if (!string.IsNullOrWhiteSpace(newEmployee.ProfileImageDataUrl))
                                        {
                                            <button type="button" class="remove-image-button" @onclick="RemoveProfileImage">
                                                ลบรูป
                                            </button>
                                        }
                                    </div>
                                </div>
                                <label><span class="field-label">รหัสพนักงาน <span class="required">*</span></span><input @bind="newEmployee.EmployeeCode" minlength="6" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" placeholder="xxxxxx" /></label>
                                <label>คำนำหน้าชื่อ<SearchableSelect><select @bind="newEmployee.Title"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("TITLE")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <label><span class="field-label">ชื่อ <span class="required">*</span></span><input @bind="newEmployee.FirstName" /></label>
                                <label><span class="field-label">นามสกุล <span class="required">*</span></span><input @bind="newEmployee.LastName" /></label>
                                <label>ชื่อ-นามสกุล (ไทย)<input @bind="newEmployee.ThaiFullName" /></label>
                                <label>ชื่อ-นามสกุล (อังกฤษ)<input @bind="newEmployee.EnglishFullName" /></label>
                                <label>ชื่อเล่น<input @bind="newEmployee.Nickname" /></label>
                                <label>Email for Lotus Notes<input @bind="newEmployee.LotusNotesEmail" /></label>
                                <label><span class="field-label">Email <span class="required">*</span></span><input type="email" @bind="newEmployee.Email" /></label>
                                <label>เบอร์มือถือส่วนตัว<input @bind="newEmployee.PersonalMobile" /></label>
                                <label>โทรศัพท์บ้าน<input @bind="newEmployee.HomePhone" /></label>
                            </div>
                            break;
                        case "personal":
                            <div class="create-form-grid">
                                <label>ศาสนา<SearchableSelect><select @bind="newEmployee.Religion"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("RELIGION")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <label>หมู่เลือด<SearchableSelect><select @bind="newEmployee.BloodType"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("BLOOD_TYPE")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <div class="create-address-section"><h3>ที่อยู่ปัจจุบัน</h3><div class="create-address-grid">
                                    <label class="wide-field">ที่อยู่<textarea rows="2" @bind="newEmployee.CurrentAddress" @bind:event="oninput" @bind:after="SyncNewEmployeeAddresses" placeholder="บ้านเลขที่ หมู่ ถนน ซอย"></textarea></label>
                                    <label>จังหวัด<SearchableSelect><select @bind="newEmployee.ResidenceProvince" @bind:after="ResidenceProvinceChanged"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("PROVINCE")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>อำเภอ / เขต<SearchableSelect><select @bind="newEmployee.ResidenceDistrict" @bind:after="ResidenceDistrictChanged" disabled="@string.IsNullOrWhiteSpace(newEmployee.ResidenceProvince)"><option value="">-- เลือก --</option>@foreach (var item in ResidenceDistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>ตำบล / แขวง<SearchableSelect><select @bind="newEmployee.ResidenceSubdistrict" @bind:after="ResidenceSubdistrictChanged" disabled="@string.IsNullOrWhiteSpace(newEmployee.ResidenceDistrict)"><option value="">-- เลือก --</option>@foreach (var item in ResidenceSubdistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>รหัสไปรษณีย์<SearchableSelect><select @bind="newEmployee.ResidencePostalCode" @bind:after="SyncNewEmployeeAddresses" disabled="@string.IsNullOrWhiteSpace(newEmployee.ResidenceSubdistrict)"><option value="">-- เลือก --</option>@foreach (var item in ResidencePostalCodeOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                </div></div>
                                <div class="create-address-section"><div class="create-address-heading"><h3>ที่อยู่ตามบัตรประชาชน</h3><label class="same-address-option"><input type="checkbox" @bind="newEmployee.IdCardSameAsCurrent" @bind:after="NewIdCardSameChanged" /> เหมือนที่อยู่ปัจจุบัน</label></div><div class="create-address-grid">
                                    <label class="wide-field">ที่อยู่<textarea rows="2" @bind="newEmployee.IdCardAddress" disabled="@newEmployee.IdCardSameAsCurrent"></textarea></label>
                                    <label>จังหวัด<SearchableSelect><select @bind="newEmployee.IdCardProvince" @bind:after="NewIdCardProvinceChanged" disabled="@newEmployee.IdCardSameAsCurrent"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("PROVINCE")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>อำเภอ / เขต<SearchableSelect><select @bind="newEmployee.IdCardDistrict" @bind:after="NewIdCardDistrictChanged" disabled="@(newEmployee.IdCardSameAsCurrent || string.IsNullOrWhiteSpace(newEmployee.IdCardProvince))"><option value="">-- เลือก --</option>@foreach (var item in NewIdCardDistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>ตำบล / แขวง<SearchableSelect><select @bind="newEmployee.IdCardSubdistrict" @bind:after="NewIdCardSubdistrictChanged" disabled="@(newEmployee.IdCardSameAsCurrent || string.IsNullOrWhiteSpace(newEmployee.IdCardDistrict))"><option value="">-- เลือก --</option>@foreach (var item in NewIdCardSubdistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>รหัสไปรษณีย์<SearchableSelect><select @bind="newEmployee.IdCardPostalCode" disabled="@(newEmployee.IdCardSameAsCurrent || string.IsNullOrWhiteSpace(newEmployee.IdCardSubdistrict))"><option value="">-- เลือก --</option>@foreach (var item in NewIdCardPostalCodeOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                </div></div>
                                <div class="create-address-section"><div class="create-address-heading"><h3>ที่อยู่ตามทะเบียนบ้าน</h3><label class="same-address-option"><input type="checkbox" @bind="newEmployee.HouseRegistrationSameAsCurrent" @bind:after="NewHouseSameChanged" /> เหมือนที่อยู่ปัจจุบัน</label></div><div class="create-address-grid">
                                    <label class="wide-field">ที่อยู่<textarea rows="2" @bind="newEmployee.HouseRegistrationAddress" disabled="@newEmployee.HouseRegistrationSameAsCurrent"></textarea></label>
                                    <label>จังหวัด<SearchableSelect><select @bind="newEmployee.HouseRegistrationProvince" @bind:after="NewHouseProvinceChanged" disabled="@newEmployee.HouseRegistrationSameAsCurrent"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("PROVINCE")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>อำเภอ / เขต<SearchableSelect><select @bind="newEmployee.HouseRegistrationDistrict" @bind:after="NewHouseDistrictChanged" disabled="@(newEmployee.HouseRegistrationSameAsCurrent || string.IsNullOrWhiteSpace(newEmployee.HouseRegistrationProvince))"><option value="">-- เลือก --</option>@foreach (var item in NewHouseDistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>ตำบล / แขวง<SearchableSelect><select @bind="newEmployee.HouseRegistrationSubdistrict" @bind:after="NewHouseSubdistrictChanged" disabled="@(newEmployee.HouseRegistrationSameAsCurrent || string.IsNullOrWhiteSpace(newEmployee.HouseRegistrationDistrict))"><option value="">-- เลือก --</option>@foreach (var item in NewHouseSubdistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                    <label>รหัสไปรษณีย์<SearchableSelect><select @bind="newEmployee.HouseRegistrationPostalCode" disabled="@(newEmployee.HouseRegistrationSameAsCurrent || string.IsNullOrWhiteSpace(newEmployee.HouseRegistrationSubdistrict))"><option value="">-- เลือก --</option>@foreach (var item in NewHousePostalCodeOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                </div></div>
                                <label>บุคคลติดต่อกรณีฉุกเฉิน<input @bind="newEmployee.EmergencyContactName" /></label>
                                <label>เบอร์ติดต่อฉุกเฉิน<input @bind="newEmployee.EmergencyContactPhone" /></label>
                                <label class="wide-field">ที่อยู่ผู้ติดต่อฉุกเฉิน<textarea rows="2" @bind="newEmployee.EmergencyContactAddress"></textarea></label>
                            </div>
                            break;
                        case "internal":
                            <div class="create-form-grid">
                                <label>บริษัท<SearchableSelect><select @bind="newEmployee.Company"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("COMPANY")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <label>Business Unit<SearchableSelect><select @bind="newEmployee.BusinessUnit" @bind:after="BusinessUnitChanged"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("BUSINESS_UNIT")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <label>ฝ่าย<input @bind="newEmployee.Division" /></label>
                                <label><span class="field-label">แผนก <span class="required">*</span></span><SearchableSelect><select @bind="newEmployee.Department" disabled="@string.IsNullOrWhiteSpace(newEmployee.BusinessUnit)"><option value="">-- เลือก --</option>@foreach (var item in DepartmentOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <label>ส่วนงาน<input @bind="newEmployee.Section" /></label>
                                <label><span class="field-label">ตำแหน่ง <span class="required">*</span></span><SearchableSelect><select @bind="newEmployee.Position"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("POSITION")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <label>รหัสตำแหน่ง<input @bind="newEmployee.JobCode" /></label>
                                <label>หัวหน้างาน
                                    <EmployeeSearchSelect Items="employeeOptions"
                                                          Value="@newEmployee.SupervisorEmployeeId"
                                                          ValueChanged="SelectNewSupervisor"
                                                          ExcludeEmployeeCode="@newEmployee.EmployeeCode"
                                                          Placeholder="-- เลือกหรือพิมพ์ค้นหาหัวหน้างาน --" />
                                </label>
                                <label>Reporting To (Leave Approve)
                                    <EmployeeSearchSelect Items="employeeOptions"
                                                          Value="@newEmployee.LeaveApproverEmployeeId"
                                                          ValueChanged="SelectNewLeaveApprover"
                                                          ExcludeEmployeeCode="@newEmployee.EmployeeCode"
                                                          Placeholder="-- เลือกหรือพิมพ์ค้นหาผู้อนุมัติลา --" />
                                </label>
                                <label>Buddy<input @bind="newEmployee.BuddyName" /></label>
                                <label>ประเภทการจ้าง
                                    <SearchableSelect><select @bind="newEmployee.EmploymentType">
                                        <option value="">-- เลือก --</option>
                                        @foreach (var item in MasterOptions("EMPLOYMENT_TYPE")) { <option value="@item.NameTh">@item.NameTh</option> }
                                    </select></SearchableSelect>
                                </label>
                                <label>เวลาทำงาน<SearchableSelect><select @bind="newEmployee.WorkSchedule"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("WORK_SCHEDULE")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <label>สถานที่ทำงาน<SearchableSelect><select @bind="newEmployee.WorkLocation"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("WORK_LOCATION")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                <label><span class="field-label">วันที่เริ่มงาน <span class="required">*</span></span><DateOnlyPicker Value="@newEmployee.StartDate" ValueChanged="value => newEmployee.StartDate = value ?? newEmployee.StartDate" AriaLabel="วันที่เริ่มงาน" /></label>
                                <label>Ext. ภายใน<input @bind="newEmployee.InternalExtension" /></label>
