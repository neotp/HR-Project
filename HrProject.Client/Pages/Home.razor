                                <label>รหัสสาขา<input @bind="newEmployee.BranchCode" /></label>
                                <label>ชื่อสาขา<input @bind="newEmployee.BranchName" /></label>
                                <label>สถานะพนักงาน
                                    <SearchableSelect><select @bind="newEmployee.EmployeeStatus">
                                        <option value="พนักงาน">พนักงาน</option>
                                        <option value="ลาออก">ลาออก</option>
                                    </select></SearchableSelect>
                                </label>
                                <label>สามารถเดินทางไปต่างจังหวัดได้
                                    <SearchableSelect><select @bind="canTravelUpcountry">
                                        <option value="">-- เลือก --</option>
                                        <option value="true">ได้</option>
