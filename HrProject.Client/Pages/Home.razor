                            </div>
                            break;
                        case "work":
                            <div class="repeating-section-header">
                                <div><strong>ประวัติการทำงาน & การเลื่อนตำแหน่ง</strong><small>เรียงตามลำดับก่อน-หลัง</small></div>
                                <button type="button" @onclick="AddWorkHistory">+ เพิ่มรายการ</button>
                            </div>
                            <div class="editable-table-scroll">
                                <table class="editable-history-table">
                                    <thead><tr><th>ระยะเวลา</th><th>BU</th><th>แผนก</th><th>ตำแหน่ง</th><th>Brand</th><th>Comm.Group</th><th></th></tr></thead>
                                    <tbody>
                                        @if (newEmployee.WorkHistory.Count == 0)
                                        {
                                            <tr><td colspan="7" class="empty-editable-row">ยังไม่มีประวัติ กรุณากดเพิ่มรายการ</td></tr>
                                        }
                                        @foreach (var item in newEmployee.WorkHistory)
                                        {
                                            <tr>
                                                <td><input @bind="item.Period" placeholder="เช่น 01/05/2023 - 13/09/2024" /></td>
                                                <td><input @bind="item.BusinessUnit" /></td>
                                                <td><input @bind="item.Department" /></td>
                                                <td><input @bind="item.Position" /></td>
                                                <td><input @bind="item.Brand" /></td>
                                                <td><input @bind="item.CommGroup" /></td>
                                                <td><button type="button" class="remove-row-button" @onclick="() => RemoveWorkHistory(item)">×</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            break;
                        case "education":
                            <div class="repeating-section-header">
                                <div><strong>ประวัติการศึกษา</strong><small>เพิ่มได้มากกว่าหนึ่งระดับการศึกษา</small></div>
                                <button type="button" @onclick="AddEducationHistory">+ เพิ่มรายการ</button>
                            </div>
                            <div class="editable-table-scroll">
                                <table class="editable-history-table">
                                    <thead><tr><th>ระดับการศึกษา</th><th>สถานศึกษา</th><th>สาขาวิชา</th><th>ปีที่จบ</th><th></th></tr></thead>
                                    <tbody>
                                        @if (newEmployee.EducationHistory.Count == 0)
                                        {
                                            <tr><td colspan="5" class="empty-editable-row">ยังไม่มีประวัติ กรุณากดเพิ่มรายการ</td></tr>
                                        }
                                        @foreach (var item in newEmployee.EducationHistory)
                                        {
                                            <tr>
                                                <td><input @bind="item.Level" /></td>
                                                <td><input @bind="item.Institution" /></td>
                                                <td><input @bind="item.Major" /></td>
                                                <td><input @bind="item.GraduationYear" /></td>
                                                <td><button type="button" class="remove-row-button" @onclick="() => RemoveEducationHistory(item)">×</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            break;
                        case "training":
                            <div class="repeating-section-header">
                                <div><strong>ประวัติการอบรม & สัมมนา</strong><small>เพิ่มได้มากกว่าหนึ่งหลักสูตร</small></div>
                                <button type="button" @onclick="AddTrainingHistory">+ เพิ่มรายการ</button>
                            </div>
                            <div class="editable-table-scroll">
                                <table class="editable-history-table training-edit-table">
                                    <thead><tr><th>หลักสูตร</th><th>ช่วงที่อบรม</th><th>สถานที่</th><th>ค่าใช้จ่าย</th><th>Certificate</th><th>ค่าสอบ</th><th></th></tr></thead>
                                    <tbody>
                                        @if (newEmployee.TrainingHistory.Count == 0)
                                        {
                                            <tr><td colspan="7" class="empty-editable-row">ยังไม่มีประวัติ กรุณากดเพิ่มรายการ</td></tr>
                                        }
                                        @foreach (var item in newEmployee.TrainingHistory)
                                        {
                                            <tr>
                                                <td><input @bind="item.CourseName" /></td>
                                                <td><input @bind="item.TrainingPeriod" /></td>
                                                <td><input @bind="item.Location" /></td>
                                                <td><input type="number" min="0" step="0.01" @bind="item.Expense" /></td>
                                                <td><input @bind="item.Certificate" /></td>
                                                <td><input type="number" min="0" step="0.01" @bind="item.ExamFee" /></td>
                                                <td><button type="button" class="remove-row-button" @onclick="() => RemoveTrainingHistory(item)">×</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            break;
                        case "family":
                            <div class="create-form-grid">
                                <label>สถานะภาพการสมรส
                                    <SearchableSelect><select @bind="newEmployee.MaritalStatus">
                                        <option value="">-- เลือก --</option>@foreach (var item in MasterOptions("MARITAL_STATUS")) { <option value="@item.NameTh">@item.NameTh</option> }
                                    </select></SearchableSelect>
                                </label>
                                <label>จดทะเบียนสมรส
                                    <SearchableSelect><select @bind="marriageRegistered"><option value="">-- เลือก --</option><option value="true">จดทะเบียน</option><option value="false">ไม่ได้จดทะเบียน</option></select></SearchableSelect>
                                </label>
                                <label>คำนำหน้าคู่สมรส<input @bind="newEmployee.SpouseTitle" /></label>
                                <label>ชื่อ-นามสกุลคู่สมรส<input @bind="newEmployee.SpouseName" /></label>
                                <label>วันที่สมรส<DateOnlyPicker @bind-Value="newEmployee.MarriageDate" AriaLabel="วันที่สมรส" /></label>
                                <label>คู่สมรสมีรายได้
                                    <SearchableSelect><select @bind="spouseHasIncome"><option value="">-- เลือก --</option><option value="true">มีรายได้</option><option value="false">ไม่มีรายได้</option></select></SearchableSelect>
                                </label>
                                <label>เลขบัตรประชาชนคู่สมรส<input @bind="newEmployee.SpouseNationalId" /></label>
                                <label>Passport ID คู่สมรส<input @bind="newEmployee.SpousePassportId" /></label>
                                <label>ชื่อใน Passport<input @bind="newEmployee.SpousePassportName" /></label>
                                <label>จำนวนบุตร (ไม่ศึกษา)<input type="number" min="0" @bind="newEmployee.UneducatedChildCount" /></label>
                                <label>จำนวนบุตร (ศึกษา)<input type="number" min="0" @bind="newEmployee.StudyingChildCount" /></label>
                                <label>เบี้ยประกันชีวิต<input type="number" min="0" step="0.01" @bind="newEmployee.LifeInsuranceAmount" /></label>
                                <label>ลดหย่อนบิดามารดาผู้มีเงินได้<input type="number" min="0" step="0.01" @bind="newEmployee.ParentSupportDeductionAmount" /></label>
                                <label>ลดหย่อนบิดามารดาคู่สมรส<input type="number" min="0" step="0.01" @bind="newEmployee.SpouseParentSupportDeductionAmount" /></label>
                                <label class="wide-field">URL แผนที่อยู่ปัจจุบัน<input type="url" @bind="newEmployee.CurrentAddressMapUrl" /></label>
                            </div>
                            break;
                    }
                </section>

                @if (!string.IsNullOrWhiteSpace(createError))
                {
                    <div class="create-error" role="alert">@createError</div>
                }
            </div>

            <footer class="employee-create-footer">
                <button class="close-create-button" type="button" disabled="@isCreating"
                        @onclick="CloseCreateEmployee">ปิด</button>
                <button class="save-employee-button" type="button" disabled="@isCreating"
                        @onclick="SaveEmployee">
                    @(isCreating ? "กำลังบันทึก..." : "บันทึกพนักงาน")
                </button>
            </footer>
        </section>
    </div>
}

@if (employees is null)
{
    <div class="loading-overlay" role="status" aria-live="polite">
        <div class="loading-dialog">
            <span class="loading-dialog-title">Loading...</span>
            <p class="loading-dialog-message">กำลังโหลดข้อมูลพนักงาน...</p>
        </div>
    </div>
}

@code {
    private List<EmployeeListItemDto>? employees;
    private List<Employee> employeeOptions = [];
    private List<MasterDataItemDto> masterItems = [];
    private EmployeeListFilterOptions filterOptions = new([], [], [], [], [], [], []);
    private int totalItems;
    private bool isLoadingEmployees;
    private int employeeLoadVersion;
    private int extensionFilterVersion;
    private bool canCreateEmployee;
    private bool canExportEmployee;
    private bool isExportOpen;
    private bool isExporting;
    private int exportTaxYear = DateTime.Today.Year;
    private string? exportError;
    private string selectedEmployeeCode = string.Empty;
    private string businessUnitFilter = string.Empty;
    private string departmentFilter = string.Empty;
    private string positionFilter = string.Empty;
    private string internalExtensionFilter = string.Empty;
    private string responsibilityProvinceFilter = string.Empty;
    private string productBusinessUnitFilter = string.Empty;
    private string brandFilter = string.Empty;
    private string commGroupFilter = string.Empty;
    private const string EmployeeSearchSection = "employee";
    private const string ProductSearchSection = "product";
    private string? activeSearchSection = EmployeeSearchSection;
    private int currentPage = 1;
    private int pageSize = 10;
    private bool HasEmployeeSectionFilters => new[] { selectedEmployeeCode, businessUnitFilter, departmentFilter,
        positionFilter, internalExtensionFilter, responsibilityProvinceFilter }
        .Any(value => !string.IsNullOrWhiteSpace(value));
    private bool HasProductSectionFilters => new[] { productBusinessUnitFilter, brandFilter, commGroupFilter }
        .Any(value => !string.IsNullOrWhiteSpace(value));

    private EmployeeListFilterRequest CurrentFilterRequest(int? page = null, int? size = null) => new(
        page ?? currentPage,
        size ?? pageSize,
        activeSearchSection == EmployeeSearchSection ? selectedEmployeeCode : string.Empty,
        activeSearchSection == EmployeeSearchSection ? businessUnitFilter : string.Empty,
        activeSearchSection == EmployeeSearchSection ? departmentFilter : string.Empty,
        activeSearchSection == EmployeeSearchSection ? positionFilter : string.Empty,
        activeSearchSection == EmployeeSearchSection ? internalExtensionFilter : string.Empty,
        activeSearchSection == EmployeeSearchSection ? responsibilityProvinceFilter : string.Empty,
        activeSearchSection == ProductSearchSection ? productBusinessUnitFilter : string.Empty,
        activeSearchSection == ProductSearchSection ? brandFilter : string.Empty,
        activeSearchSection == ProductSearchSection ? commGroupFilter : string.Empty);

    private async Task LoadEmployees()
    {
        var loadVersion = ++employeeLoadVersion;
        isLoadingEmployees = true;
        try
        {
            var result = await Http.PostAsJsonAsync("api/employees/paged", CurrentFilterRequest());
            result.EnsureSuccessStatusCode();
            var page = await result.Content.ReadFromJsonAsync<EmployeePagedResult>();
            if (loadVersion != employeeLoadVersion) return;
            employees = page?.Items.ToList() ?? [];
            totalItems = page?.TotalItems ?? 0;
            currentPage = page?.Page ?? 1;
            pageSize = page?.PageSize ?? pageSize;
        }
        finally { if (loadVersion == employeeLoadVersion) isLoadingEmployees = false; }
    }

    private async Task LoadFilterOptions()
    {
        var useEmployeeFilters = activeSearchSection == EmployeeSearchSection;
        var useProductFilters = activeSearchSection == ProductSearchSection;
        filterOptions = await Http.GetFromJsonAsync<EmployeeListFilterOptions>(
            $"api/employees/filter-options?businessUnit={Uri.EscapeDataString(useEmployeeFilters ? businessUnitFilter : string.Empty)}" +
            $"&department={Uri.EscapeDataString(useEmployeeFilters ? departmentFilter : string.Empty)}" +
            $"&position={Uri.EscapeDataString(useEmployeeFilters ? positionFilter : string.Empty)}" +
            $"&productBusinessUnit={Uri.EscapeDataString(useProductFilters ? productBusinessUnitFilter : string.Empty)}" +
            $"&brand={Uri.EscapeDataString(useProductFilters ? brandFilter : string.Empty)}" +
            $"&commGroup={Uri.EscapeDataString(useProductFilters ? commGroupFilter : string.Empty)}")
            ?? new([], [], [], [], [], [], []);
    }

    private static IEnumerable<string> PreserveSelected(
        IEnumerable<string> options, string selectedValue)
    {
        var values = options
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (!string.IsNullOrWhiteSpace(selectedValue) &&
            !values.Any(value => string.Equals(value, selectedValue, StringComparison.OrdinalIgnoreCase)))
            values.Insert(0, selectedValue);
        return values;
    }

    private async Task ReloadFirstPage()
    {
        currentPage = 1;
        await LoadEmployees();
    }

    private Task SetEmployeeFilter(string employeeCode)
    { selectedEmployeeCode = employeeCode; return ReloadFirstPage(); }
    private async Task ClearInternalExtensionFilter()
    { extensionFilterVersion++; internalExtensionFilter = string.Empty; await ReloadFirstPage(); }
    private async Task InternalExtensionFilterChanged(ChangeEventArgs args)
    {
        internalExtensionFilter = args.Value?.ToString() ?? string.Empty;
        var version = ++extensionFilterVersion;
        await Task.Delay(300);
        if (version == extensionFilterVersion) await ReloadFirstPage();
    }
    private async Task StructuralFilterChanged()
    {
        await LoadFilterOptions();
        await ReloadFirstPage();
    }
    private async Task ProductFilterChanged()
    {
        await LoadFilterOptions();
        await ReloadFirstPage();
    }
    private async Task ToggleSearchSection(string section)
    {
        extensionFilterVersion++;
        activeSearchSection = activeSearchSection == section ? null : section;
        await LoadFilterOptions();
        await ReloadFirstPage();
    }
    private async Task ClearActiveSearchFilters()
    {
        extensionFilterVersion++;
        if (activeSearchSection == EmployeeSearchSection)
        {
            selectedEmployeeCode = businessUnitFilter = departmentFilter = positionFilter = internalExtensionFilter =
                responsibilityProvinceFilter = string.Empty;
        }
        else if (activeSearchSection == ProductSearchSection)
        {
            productBusinessUnitFilter = brandFilter = commGroupFilter = string.Empty;
        }
        await LoadFilterOptions();
        await ReloadFirstPage();
    }
    private async Task ChangePage(int page) { currentPage = page; await LoadEmployees(); }
    private Task ChangePageSize(int size) { pageSize = size; currentPage = 1; return Task.CompletedTask; }
    private static string DisplayCell(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private bool isCreateOpen;
    private bool isCreating;
    private string createActiveTab = "basic";
    private string? createError;
    private Employee newEmployee = CreateBlankEmployee();
    private string canTravelUpcountry = string.Empty;
    private string marriageRegistered = string.Empty;
    private string spouseHasIncome = string.Empty;
    private const long MaxProfileImageBytes = 2 * 1024 * 1024;
    private string NewEmployeeInitials
    {
        get
        {
            var first = string.IsNullOrWhiteSpace(newEmployee.FirstName)
                ? string.Empty
                : newEmployee.FirstName[..1];
            var last = string.IsNullOrWhiteSpace(newEmployee.LastName)
                ? string.Empty
                : newEmployee.LastName[..1];
            return string.IsNullOrEmpty(first + last) ? "+" : (first + last).ToUpperInvariant();
        }
    }

    private static readonly (string Key, string Label)[] CreateTabs =
    [
        ("basic", "ข้อมูลพื้นฐาน"),
        ("personal", "ข้อมูลส่วนบุคคล"),
        ("internal", "ข้อมูลภายในบริษัท"),
        ("work", "ประวัติการทำงาน"),
        ("education", "ประวัติการศึกษา"),
        ("training", "ประวัติการอบรม & สัมมนา"),
        ("family", "บันทึกค่าลดหย่อนภาษี")
    ];

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
        if (!string.IsNullOrWhiteSpace(currentUser?.EmployeeId))
        {
            var permissions = await Http.GetFromJsonAsync<CurrentPageActionPermissionsDto>(
                $"api/page-permissions/current-actions?employeeId={Uri.EscapeDataString(currentUser.EmployeeId)}&pageKey=EMPLOYEES");
            canCreateEmployee = permissions?.AllowedActions.Contains("CREATE", StringComparer.OrdinalIgnoreCase) == true;
            canExportEmployee = permissions?.AllowedActions.Contains("EXPORT", StringComparer.OrdinalIgnoreCase) == true;
        }
        await Task.WhenAll(LoadFilterOptions(), LoadEmployees());
    }

    private void OpenExport()
    {
        if (!canExportEmployee || totalItems == 0) return;
        exportTaxYear = DateTime.Today.Year;
        exportError = null;
        isExportOpen = true;
    }

    private void CloseExport()
    {
        if (!isExporting) isExportOpen = false;
    }

    private async Task ExportAllEmployeeFields()
    {
        if (!canExportEmployee || isExporting) return;
        isExporting = true;
        exportError = null;
        try
        {
            var employeeIds = await GetFilteredEmployeeIds();
            if (employeeIds.Count == 0) { exportError = "ไม่พบพนักงานที่ต้องการ Export"; return; }
            var response = await Http.PostAsJsonAsync("api/employees/export",
                new EmployeeExportSelectionRequest(employeeIds));
            if (!response.IsSuccessStatusCode)
            {
                exportError = (await response.Content.ReadAsStringAsync()).Trim().Trim('"');
                return;
            }
            var rows = await response.Content.ReadFromJsonAsync<List<Employee>>() ?? [];
            await DownloadCsv($"employees-all-fields-{DateTime.Now:yyyyMMdd-HHmmss}.csv", rows);
            isExportOpen = false;
        }
        catch (Exception exception)
        {
            exportError = $"Export ข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally { isExporting = false; }
    }

    private async Task ExportTaxDeductions()
    {
        if (!canExportEmployee || isExporting) return;
        if (exportTaxYear is < 2000 or > 2200)
        {
            exportError = "ปีภาษีต้องอยู่ระหว่าง 2000–2200";
            return;
        }
        isExporting = true;
        exportError = null;
        try
        {
            var selectedIds = (await GetFilteredEmployeeIds()).ToHashSet();
            var rows = await Http.GetFromJsonAsync<List<EmployeeTaxDeductionDto>>(
                $"api/employee-tax-deductions/report?year={exportTaxYear}") ?? [];
            rows = rows.Where(item => selectedIds.Contains(item.EmployeeId)).ToList();
            await DownloadCsv($"employee-tax-deductions-{exportTaxYear}-{DateTime.Now:yyyyMMdd-HHmmss}.csv", rows);
            isExportOpen = false;
        }
        catch (Exception exception)
        {
            exportError = $"Export ข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally { isExporting = false; }
    }

    private async Task<List<int>> GetFilteredEmployeeIds()
    {
        var response = await Http.PostAsJsonAsync("api/employees/filter-ids", CurrentFilterRequest(1, 5000));
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException((await response.Content.ReadAsStringAsync()).Trim().Trim('"'));
        return await response.Content.ReadFromJsonAsync<List<int>>() ?? [];
    }

    private async Task DownloadCsv<T>(string fileName, IReadOnlyList<T> rows)
    {
        var properties = typeof(T).GetProperties()
            .Where(property => property.CanRead)
            .ToArray();
        var lines = new List<string>
        {
            string.Join(",", properties.Select(property => Csv(property.Name)))
        };
        lines.AddRange(rows.Select(row => string.Join(",", properties.Select(property =>
            Csv(ExportValue(property.GetValue(row)))))));
        await JS.InvokeVoidAsync("hrDownload.downloadText", fileName,
            "\uFEFF" + string.Join("\r\n", lines), "text/csv;charset=utf-8");
    }

    private static string ExportValue(object? value) => value switch
    {
        null => string.Empty,
        DateOnly date => date.ToString("yyyy-MM-dd"),
        DateTime dateTime => dateTime.ToString("yyyy-MM-dd HH:mm:ss"),
        DateTimeOffset dateTimeOffset => dateTimeOffset.ToString("yyyy-MM-dd HH:mm:ss zzz"),
        bool boolean => boolean ? "TRUE" : "FALSE",
        string text => text,
        IFormattable formattable => formattable.ToString(null, System.Globalization.CultureInfo.InvariantCulture),
        _ => System.Text.Json.JsonSerializer.Serialize(value)
    };

    private static string Csv(string? value) =>
        "\"" + (value ?? string.Empty).Replace("\"", "\"\"") + "\"";

    private IEnumerable<MasterDataItemDto> MasterOptions(string categoryCode) =>
        masterItems.Where(item => item.IsActive &&
            string.Equals(item.CategoryCode, categoryCode, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MasterDataItemDto> ResidenceDistrictOptions => ChildAddressOptions(
        "DISTRICT", "PROVINCE", newEmployee.ResidenceProvince);
    private IEnumerable<MasterDataItemDto> ResidenceSubdistrictOptions => ChildAddressOptions(
        "SUBDISTRICT", "DISTRICT", newEmployee.ResidenceDistrict, ResidenceDistrictOptions);
    private IEnumerable<MasterDataItemDto> ResidencePostalCodeOptions => ChildAddressOptions(
        "POSTAL_CODE", "SUBDISTRICT", newEmployee.ResidenceSubdistrict, ResidenceSubdistrictOptions);
    private IEnumerable<MasterDataItemDto> NewIdCardDistrictOptions => ChildAddressOptions(
        "DISTRICT", "PROVINCE", newEmployee.IdCardProvince);
    private IEnumerable<MasterDataItemDto> NewIdCardSubdistrictOptions => ChildAddressOptions(
        "SUBDISTRICT", "DISTRICT", newEmployee.IdCardDistrict, NewIdCardDistrictOptions);
    private IEnumerable<MasterDataItemDto> NewIdCardPostalCodeOptions => ChildAddressOptions(
        "POSTAL_CODE", "SUBDISTRICT", newEmployee.IdCardSubdistrict, NewIdCardSubdistrictOptions);
    private IEnumerable<MasterDataItemDto> NewHouseDistrictOptions => ChildAddressOptions(
        "DISTRICT", "PROVINCE", newEmployee.HouseRegistrationProvince);
    private IEnumerable<MasterDataItemDto> NewHouseSubdistrictOptions => ChildAddressOptions(
        "SUBDISTRICT", "DISTRICT", newEmployee.HouseRegistrationDistrict, NewHouseDistrictOptions);
    private IEnumerable<MasterDataItemDto> NewHousePostalCodeOptions => ChildAddressOptions(
        "POSTAL_CODE", "SUBDISTRICT", newEmployee.HouseRegistrationSubdistrict, NewHouseSubdistrictOptions);

    private IEnumerable<MasterDataItemDto> ChildAddressOptions(
        string childCategory, string parentCategory, string parentName,
        IEnumerable<MasterDataItemDto>? parents = null)
    {
        var parent = (parents ?? MasterOptions(parentCategory)).FirstOrDefault(item =>
            string.Equals(item.NameTh, parentName, StringComparison.OrdinalIgnoreCase));
        return parent is null ? [] : MasterOptions(childCategory).Where(item => item.ParentItemId == parent.Id);
    }

