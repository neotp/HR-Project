    private static async Task AddSelectedAttachments(
        InputFileChangeEventArgs eventArgs,
        List<LeaveAttachmentUploadDto> target,
        Action<string?> setError)
    {
        setError(null);
        var remaining = 10 - target.Count;
        if (remaining <= 0)
        {
            setError("แนบไฟล์ได้ไม่เกิน 10 ไฟล์ต่อครั้ง");
            return;
        }

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = eventArgs.GetMultipleFiles(remaining);
        }
        catch (InvalidOperationException)
        {
            setError($"เลือกไฟล์ได้อีกไม่เกิน {remaining} ไฟล์");
            return;
        }

        const long maxFileSize = 10 * 1024 * 1024;
        foreach (var file in files)
        {
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not (".pdf" or ".jpg" or ".jpeg" or ".png"))
            {
                setError($"ไฟล์ {file.Name} ไม่รองรับ รองรับเฉพาะ PDF, JPG และ PNG");
                return;
            }
            if (file.Size == 0 || file.Size > maxFileSize)
            {
                setError($"ไฟล์ {file.Name} ต้องมีขนาดมากกว่า 0 และไม่เกิน 10 MB");
                return;
            }

            await using var stream = file.OpenReadStream(maxFileSize);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            target.Add(new LeaveAttachmentUploadDto(
                Path.GetFileName(file.Name),
                string.IsNullOrWhiteSpace(file.ContentType)
                    ? "application/octet-stream"
                    : file.ContentType,
                memory.ToArray()));
        }
    }

    private async Task SaveDocument()
    {
        saveError = null;
        var type = FindLeaveType(newLeaveType);
        if (type is null || string.IsNullOrWhiteSpace(newLeaveKind) || string.IsNullOrWhiteSpace(newLeaveReason))
        {
            saveError = "กรุณาเลือกชนิดการลา ประเภทการลา และกรอกเหตุผลการลาให้ครบถ้วน";
            return;
        }
        var leaveKindCode = KindCode(newLeaveKind);
        var today = DateOnly.FromDateTime(DateTime.Today);
        var singleLeaveDate = DateOnly.FromDateTime(newSingleLeaveDate);
        if (leaveKindCode == "ADVANCE" && createMode == "single" && singleLeaveDate < today)
        {
            saveError = "วันที่ลาเป็นวันที่ย้อนหลัง กรุณาเลือกชนิดการลาเป็นลาย้อนหลัง";
            return;
        }
        if (leaveKindCode == "ADVANCE" && createMode != "single" &&
            multiDayRows.Any(row => DateOnly.FromDateTime(row.LeaveDate) < today))
        {
            saveError = "รายการมีวันที่ย้อนหลัง กรุณาเลือกชนิดการลาเป็นลาย้อนหลัง หรือลบวันที่ย้อนหลังออกจากรายการ";
            return;
        }
        if (leaveKindCode == "RETROACTIVE" && createMode == "single" && singleLeaveDate > today)
        {
            saveError = "วันที่ลาเป็นวันที่ในอนาคต กรุณาเลือกชนิดการลาเป็นลาล่วงหน้า";
            return;
        }
        if (leaveKindCode == "RETROACTIVE" && createMode != "single" &&
            multiDayRows.Any(row => DateOnly.FromDateTime(row.LeaveDate) > today))
        {
            saveError = "รายการมีวันที่ในอนาคต กรุณาเลือกชนิดการลาเป็นลาล่วงหน้า หรือลบวันที่ในอนาคตออกจากรายการ";
            return;
        }
        var oldestRetroactiveDate = today.AddDays(-3);
        if (leaveKindCode == "RETROACTIVE" && createMode == "single" &&
            DateOnly.FromDateTime(newSingleLeaveDate) < oldestRetroactiveDate)
        {
            saveError = $"ลาย้อนหลังได้ไม่เกิน 3 วัน วันที่เก่าสุดที่เลือกได้คือ {oldestRetroactiveDate:dd/MM/yyyy}";
            return;
        }
        if (leaveKindCode == "RETROACTIVE" && createMode != "single" &&
            multiDayRows.Any(row => DateOnly.FromDateTime(row.LeaveDate) < oldestRetroactiveDate))
        {
            saveError = $"ลาย้อนหลังได้ไม่เกิน 3 วัน กรุณาลบวันที่ก่อน {oldestRetroactiveDate:dd/MM/yyyy} ออกจากรายการ";
            return;
        }
        if (IsSickLeave && !newHasMedicalCertificate.HasValue)
        {
            saveError = "กรุณาระบุว่ามีใบรับรองแพทย์หรือไม่";
            return;
        }
        if (IsSickLeave && newHasMedicalCertificate == true &&
            newAttachments.Count == 0)
        {
            saveError = "กรุณาแนบใบรับรองแพทย์ก่อนบันทึกเอกสาร";
            return;
        }

        HttpResponseMessage response;
        if (createMode == "single")
        {
            var request = new CreateLeaveDocumentRequest(
                type.Id,
                leaveKindCode,
                DateOnly.FromDateTime(newSingleLeaveDate),
                newLeaveStartTime,
                newLeaveHours,
                newLeaveReason,
                CurrentEmployeeId,
                CurrentEmployeeName,
                CurrentEmployeeDepartment,
                null,
                CurrentApproverName,
                IsSickLeave ? newHasMedicalCertificate : null,
                newAttachments.ToList());
            response = await Http.PostAsJsonAsync("api/leave-documents", request);
        }
        else
        {
            if (multiDayRows.Count == 0)
            {
                saveError = "กรุณาเลือกช่วงวันที่และกดสร้างรายการก่อนบันทึก";
                return;
            }
            if (multiDayRows.Any(row => row.LeaveHours <= 0 || row.LeaveHours > 8))
            {
                saveError = "จำนวนชั่วโมงของแต่ละวันต้องมากกว่า 0 และไม่เกิน 8 ชั่วโมง";
                return;
            }
            if (multiDayRows.Select(row => row.LeaveDate.Date).Distinct().Count() != multiDayRows.Count)
            {
                saveError = "วันที่ลาในตารางต้องไม่ซ้ำกัน";
                return;
            }

            var request = new CreateMultiDayLeaveDocumentsRequest(
                type.Id,
                leaveKindCode,
                multiDayRows.Select(row => new CreateMultiDayLeaveItemRequest(
                    DateOnly.FromDateTime(row.LeaveDate),
                    row.StartTime,
                    row.LeaveHours)).ToList(),
                newLeaveReason,
                CurrentEmployeeId,
                CurrentEmployeeName,
                CurrentEmployeeDepartment,
                null,
                CurrentApproverName,
                IsSickLeave ? newHasMedicalCertificate : null,
                newAttachments.ToList());
            response = await Http.PostAsJsonAsync("api/leave-documents/batch", request);
        }
        if (!response.IsSuccessStatusCode)
        {
            var details = await response.Content.ReadAsStringAsync();
            saveError = string.IsNullOrWhiteSpace(details)
                ? $"บันทึกไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                : $"บันทึกไม่สำเร็จ: {details}";
            return;
        }
        await ReloadData();
        CloseCreate();
    }
    private LeaveTypeDto? FindLeaveType(string name) => leaveTypes.FirstOrDefault(x => x.NameTh == name);

    private string KindText(string kind) =>
        leaveKinds.FirstOrDefault(item => item.ItemCode == kind)?.NameTh ?? kind;
    private string KindCode(string kind) =>
        leaveKinds.FirstOrDefault(item => item.NameTh == kind)?.ItemCode ?? kind;
    private static string HoursToDays(decimal hours) => (hours / 8).ToString("0.##");

    private sealed class MultiDayLeaveRow
    {
        public DateTime LeaveDate { get; set; }
        public TimeOnly StartTime { get; set; }
        public decimal LeaveHours { get; set; }
    }

    private static string StatusText(string value) => value switch
    {
        "PENDING_APPROVAL" => "รออนุมัติ",
        "APPROVED" => "อนุมัติแล้ว",
        "REJECTED" => "ไม่อนุมัติ",
        "CANCELLED" => "ยกเลิก",
        "EDIT_REQUESTED" => "ขอแก้ไข",
        "CANCEL_REQUESTED" => "ขอยกเลิก",
        _ => value
    };

    private static string StatusClass(string value) => value switch
    {
        "APPROVED" => "approved",
        "REJECTED" => "rejected",
        "CANCELLED" => "cancelled",
        "EDIT_REQUESTED" => "editing",
        "CANCEL_REQUESTED" => "cancelled",
        _ => "pending"
    };

    private static string DisplayStatus(LeaveDocumentDto document) =>
        document.PendingCancelRequest is not null ? "CANCEL_REQUESTED" : document.Status;

