            detailActionError = string.IsNullOrWhiteSpace(details)
                ? "ไม่สามารถบันทึกการแก้ไขได้ กรุณาลองใหม่อีกครั้ง"
                : details;
            return;
        }
        await ReloadData();
        CloseDocument();
    }

