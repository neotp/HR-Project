@page "/leave/documents"
@inject HttpClient Http
@inject IJSRuntime JS

@code {
    [Parameter, SupplyParameterFromQuery(Name = "documentId")]
    public long? RequestedDocumentId { get; set; }
}

<PageTitle>เอกสารการลา | HR Project</PageTitle>

<section class="manage-page leave-documents-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1>เอกสารการลา</h1>
                <p>ตรวจสอบและติดตามเอกสารการลาของคุณ</p>
            </div>
            <button class="btn btn-create" type="button" @onclick="StartCreate">
                <span aria-hidden="true">＋</span> สร้างเอกสาร
            </button>
        </div>
    </header>

    <section class="content-card my-quota-card">
        <div class="content-card-header">
            โควต้าวันลาของฉัน
            <span class="quota-year">ปี @DateTime.Today.Year</span>
        </div>
        <div class="content-card-body">
            @if (myLeaveQuotas.Count == 0)
            {
                <div class="quota-empty">ยังไม่มีการกำหนดโควต้าวันลาสำหรับปีนี้</div>
            }
            else
            {
                <div class="my-quota-grid">
                    @foreach (var quota in myLeaveQuotas)
                    {
                        <article class="my-quota-item">
                            <h2>@quota.LeaveTypeName</h2>
                            <div class="quota-values">
                                <div>
                                    <span>ใช้ไปแล้ว</span>
                                    <strong class="used-value">@quota.UsedHours.ToString("0.##")</strong>
                                    <small>ชั่วโมง</small>
                                    <small class="day-equivalent">(@HoursToDays(quota.UsedHours) วัน)</small>
                                </div>
                                <div>
                                    <span>คงเหลือ</span>
                                    <strong class="remaining-value">@quota.RemainingHours.ToString("0.##")</strong>
                                    <small>ชั่วโมง</small>
                                    <small class="day-equivalent">(@HoursToDays(quota.RemainingHours) วัน)</small>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="content-card criteria-card">
        <div class="content-card-header">Criteria ค้นหาเอกสาร</div>
        <div class="content-card-body">
            <div class="criteria-grid">
                <label>
                    คำค้นหา
                    <input @bind="searchText" @bind:event="oninput" @bind:after="Search"
                           placeholder="เลขที่เอกสาร ประเภทการลา หรือเหตุผล" />
                </label>
                <div class="criteria-field">
                    <span class="criteria-field-label">ประเภทการลา</span>
                    <CriteriaMultiSelect Options="@LeaveTypeFilterOptions" Values="@selectedLeaveTypes" ValuesChanged="SetLeaveTypeFilters" />
                </div>
                <div class="criteria-field">
                    <span class="criteria-field-label">สถานะ</span>
                    <details class="status-multiselect">
                        <summary>
                            <span>@StatusFilterSummary</span>
                            <span class="status-multiselect-chevron" aria-hidden="true">⌄</span>
                        </summary>
                        <div class="status-multiselect-menu">
                            <button class="status-filter-clear" type="button" @onclick="ClearStatusFilter">
                                แสดงทั้งหมด
                            </button>
                            @foreach (var option in StatusFilterOptions)
                            {
                                <label class="status-multiselect-option">
                                    <input type="checkbox"
                                           checked="@selectedStatuses.Contains(option.Code)"
                                           @onchange="args => SetStatusFilter(option.Code, args.Value is true)" />
                                    <span class="status-pill @StatusClass(option.Code)" data-status="@option.Code">@option.Label</span>
                                </label>
                            }
                        </div>
                    </details>
                </div>
                <label>
                    วันที่เริ่มต้น
                    <DateTimePicker @bind-Value="startDate" @bind-Value:after="Search" AriaLabel="วันที่ลาเริ่มต้น" />
                </label>
                <label>
                    วันที่สิ้นสุด
                    <DateTimePicker @bind-Value="endDate" @bind-Value:after="Search" AriaLabel="วันที่ลาสิ้นสุด" />
                </label>
            </div>
            <div class="criteria-actions">
                <button class="btn btn-reset" type="button" @onclick="Reset">ล้างข้อมูล</button>
            </div>
        </div>
    </section>

    <section class="content-card result-card">
        <div class="content-card-header">เอกสารการลาของฉัน <span class="result-count">@filteredDocuments.Count รายการ</span></div>
        <div class="content-card-body">
            <div class="table-responsive">
                <table class="table employee-table leave-table">
                    <thead><tr><th>เลขที่เอกสาร</th><th>ประเภทการลา</th><th>วันที่ลา</th><th>เวลาเริ่มต้น</th><th>จำนวนชั่วโมง</th><th>เหตุผล</th><th>สถานะ</th></tr></thead>
                    <tbody>
                        @if (filteredDocuments.Count == 0)
                        {
                            <tr><td colspan="7" class="no-results">ไม่พบเอกสารการลาตามเงื่อนไขที่ค้นหา</td></tr>
                        }
                        else
                        {
                            @foreach (var document in PagedDocuments)
                            {
                                <tr>
                                        <td><LeaveDocumentHoverPreview Document="@document"><button class="document-number" type="button" @onclick="() => OpenDocument(document)">@document.DocumentNo</button></LeaveDocumentHoverPreview></td>
                                    <td>@document.LeaveTypeName</td>
                                    <td>@document.LeaveDate.ToString("dd/MM/yyyy")</td>
                                    <td>@document.StartTime.ToString("HH:mm")</td>
                                    <td>@document.LeaveHours.ToString("0.##") ชั่วโมง</td>
                                    <td><span class="reason-cell" title="@document.LeaveReason">@document.LeaveReason</span></td>
                                    <td><span class="status-pill @StatusClass(DisplayStatus(document))" data-status="@DisplayStatus(document)">@StatusText(DisplayStatus(document))</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <Pagination TotalItems="@filteredDocuments.Count" @bind-CurrentPage="currentPage" @bind-PageSize="pageSize" />
        </div>
    </section>
</section>

@if (isCreating)
{
    <div class="document-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="create-document-title">
        <section class="document-modal @(createMode == "multiple" ? "multi-day-modal" : null)">
            <header class="document-modal-header">
                <div><h2 id="create-document-title">สร้างเอกสารการลา</h2><p>กรอกรายละเอียดเพื่อส่งคำขอลา</p></div>
                <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseCreate">×</button>
            </header>
            <div class="document-modal-body">
                <h3>ข้อมูลเอกสาร</h3>
                <div class="form-grid readonly-grid">
                    <label>ผู้อนุมัติ<input value="@CurrentApproverName" disabled /></label>
                    <label>วันที่สร้างเอกสาร<input value="@DateTime.Today.ToString("dd/MM/yyyy")" disabled /></label>
                    <label>ผู้สร้างเอกสาร<input value="@CurrentEmployeeName" disabled /></label>
                    <label>แผนก (ผู้สร้าง)<input value="@CurrentEmployeeDepartment" disabled /></label>
                </div>

                <div class="leave-mode-tabs" role="tablist" aria-label="รูปแบบการลา">
                    <button class="leave-mode-tab @(createMode == "single" ? "active" : null)" type="button" role="tab"
                            aria-selected="@(createMode == "single")" @onclick="ShowSingleMode">
                        ลาวันเดียว
                    </button>
                    <button class="leave-mode-tab @(createMode == "multiple" ? "active" : null)" type="button" role="tab"
                            aria-selected="@(createMode == "multiple")" @onclick="ShowMultipleMode">
                        ลาหลายวัน
                    </button>
                </div>

                <h3>รายละเอียดการลา</h3>
                <div class="form-grid">
                    <label><span class="field-label">ชนิดการลา<span class="required">*</span></span>
                        <select @bind="newLeaveKind"><option value="">-- เลือกชนิดการลา --</option>@foreach (var kind in leaveKinds) { <option value="@kind.NameTh">@kind.NameTh</option> }</select>
                    </label>
                    <label><span class="field-label">ประเภทการลา<span class="required">*</span></span>
                        <select @bind="newLeaveType" @bind:after="HandleLeaveTypeChanged"><option value="">-- เลือกประเภทการลา --</option>@foreach (var type in leaveTypes) { <option value="@type.NameTh">@type.NameTh</option> }</select>
                    </label>
                    @if (IsSickLeave)
                    {
                        <fieldset class="medical-certificate-field full-width">
                            <legend>ใบรับรองแพทย์<span class="required">*</span></legend>
                            <label class="radio-option">
                                <input type="radio" name="medical-certificate" checked="@(newHasMedicalCertificate == true)"
                                       @onchange="() => SetMedicalCertificate(true)" />
                                มีใบรับรองแพทย์
                            </label>
                            <label class="radio-option">
                                <input type="radio" name="medical-certificate" checked="@(newHasMedicalCertificate == false)"
                                       @onchange="() => SetMedicalCertificate(false)" />
                                ไม่มีใบรับรองแพทย์
                            </label>
                        </fieldset>
                    }
                    @if (createMode == "single")
                    {
                        <label><span class="field-label">วันที่ลา<span class="required">*</span></span><DateTimePicker Value="@newSingleLeaveDate" ValueChanged="value => newSingleLeaveDate = value ?? newSingleLeaveDate" AriaLabel="วันที่ลา" /></label>
                        <label><span class="field-label">เวลาเริ่มต้น (24 ชั่วโมง)<span class="required">*</span></span>
                            <TimeMinutePicker @bind-Value="newLeaveStartTime" AriaLabel="เวลาเริ่มต้นการลา" />
                        </label>
                        <label><span class="field-label">จำนวนชั่วโมง<span class="required">*</span></span><input type="number" min="0.5" max="8" step="0.5" @bind="newLeaveHours" /></label>
                    }
                    <label>
                        <span class="field-label">เอกสารแนบ<span class="required" hidden="@(!(IsSickLeave && newHasMedicalCertificate == true))">*</span></span>
                        <div class="attachment-picker">
                            <InputFile class="attachment-input" @key="attachmentInputVersion" OnChange="SelectAttachments" multiple accept=".pdf,.jpg,.jpeg,.png" />
                        </div>
                        <small class="attachment-help">แนบได้หลายไฟล์ สูงสุด 10 ไฟล์ และแต่ละไฟล์ต้องไม่เกิน 10 MB (PDF, JPG หรือ PNG)</small>
                    </label>
                    <label class="full-width"><span class="field-label">เหตุผลการลา<span class="required">*</span></span><textarea rows="3" @bind="newLeaveReason" placeholder="ระบุเหตุผลการลา"></textarea></label>
                </div>

                @if (createMode == "multiple")
                {
                    <section class="multi-day-builder">
                        <div class="multi-range-grid">
                            <label>วันที่เริ่มต้น<DateTimePicker Value="@multiStartDate" ValueChanged="value => multiStartDate = value ?? multiStartDate" AriaLabel="วันที่เริ่มต้น" /></label>
                            <label>วันที่สิ้นสุด<DateTimePicker Value="@multiEndDate" ValueChanged="value => multiEndDate = value ?? multiEndDate" Min="@multiStartDate" AriaLabel="วันที่สิ้นสุด" /></label>
                            <button class="btn btn-generate-days" type="button" @onclick="GenerateMultiDayRows">สร้างรายการ</button>
                        </div>

                        <div class="multi-day-table-wrap">
                            <table class="multi-day-table">
                                <thead>
                                    <tr><th>#</th><th>วันที่ลา</th><th>เวลาเริ่มต้น</th><th>จำนวนชั่วโมง</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @if (multiDayRows.Count == 0)
                                    {
                                        <tr><td colspan="5" class="empty-multi-days">เลือกช่วงวันที่แล้วกดสร้างรายการ</td></tr>
                                    }
                                    else
                                    {
                                        @for (var index = 0; index < multiDayRows.Count; index++)
                                        {
                                            var row = multiDayRows[index];
                                            var rowNumber = index + 1;
                                            <tr>
                                                <td>@rowNumber</td>
                                                <td><DateTimePicker Value="@row.LeaveDate" ValueChanged="value => row.LeaveDate = value ?? row.LeaveDate" AriaLabel="วันที่ลา" /></td>
                                                <td>
                                                    <TimeMinutePicker @bind-Value="row.StartTime" AriaLabel="เวลาเริ่มต้นการลา" />
                                                </td>
                                                <td><input type="number" min="0.5" max="8" step="0.5" @bind="row.LeaveHours" /></td>
                                                <td><button class="remove-day" type="button" aria-label="ลบวันที่" @onclick="() => RemoveMultiDayRow(row)">×</button></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (multiDayRows.Count > 0)
                        {
                            <p class="batch-note">พร้อมสร้าง @multiDayRows.Count เอกสาร แยกวันละ 1 เอกสาร</p>
                        }
                    </section>
                }
                @if (newAttachments.Count > 0)
                {
                    <div class="selected-attachments">
                        @foreach (var attachment in newAttachments)
                        {
                            <span>@attachment.FileName <button type="button" @onclick="() => newAttachments.Remove(attachment)">×</button></span>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(saveError)) { <p class="save-error" role="alert">@saveError</p> }
            </div>
            <footer class="document-modal-footer">
                <button class="btn btn-reset" type="button" @onclick="CloseCreate">ยกเลิก</button>
                <button class="btn btn-create" type="button" disabled="@confirmBusy" @onclick="ConfirmCreateDocument">
                    @(createMode == "multiple" && multiDayRows.Count > 0 ? $"บันทึก {multiDayRows.Count} เอกสาร" : "บันทึกเอกสาร")
                </button>
            </footer>
        </section>
    </div>
}

@if (selectedDocument is not null)
{
    <div class="document-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="document-detail-title">
        <section class="document-modal">
            <header class="document-modal-header">
                <div><h2 id="document-detail-title">รายละเอียดเอกสารการลา</h2><p>@selectedDocument.DocumentNo</p></div>
                <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseDocument">×</button>
            </header>
            <div class="document-modal-body">
                @if (IsDocumentReadOnly)
                {
                    <div class="approved-notice">
                        @(HasLeaveStarted && selectedDocument.Status == "PENDING_APPROVAL"
                            ? "เอกสารรออนุมัตินี้ถึงวันเวลาเริ่มลาแล้ว เจ้าของเอกสารจึงไม่สามารถแก้ไขหรือยกเลิกได้"
                            : selectedDocument.PendingCancelRequest is not null
                                ? "เอกสารนี้มีคำขอยกเลิกที่รอพิจารณา จึงยังไม่สามารถแก้ไขข้อมูลได้"
                            : selectedDocument.Status is "APPROVED" or "EDIT_REQUESTED"
                                ? $"เอกสารนี้มีสถานะ {StatusText(selectedDocument.Status)} จึงแก้ไขข้อมูลหลักโดยตรงไม่ได้ แต่สามารถส่งคำขอแก้ไขได้"
                                : $"เอกสารนี้มีสถานะ {StatusText(selectedDocument.Status)} จึงไม่สามารถแก้ไขข้อมูลได้")
                    </div>
                }
                <div class="form-grid readonly-grid">
                    <label>เลขที่เอกสาร<input value="@selectedDocument.DocumentNo" disabled /></label>
                    <label>ผู้สร้างเอกสาร<input value="@selectedDocument.CreatorName" disabled /></label>
                </div>
                <h3>รายละเอียดการลา</h3>
                <div class="form-grid">
                    <label>ชนิดการลา<select @bind="detailLeaveKind" disabled="@IsDocumentReadOnly">@foreach (var kind in leaveKinds) { <option value="@kind.NameTh">@kind.NameTh</option> }</select></label>
                    <label>ประเภทการลา<select @bind="detailLeaveType" disabled="@IsDocumentReadOnly">@foreach (var type in leaveTypes) { <option value="@type.NameTh">@type.NameTh</option> }</select></label>
                    <label>วันที่ลา<DateTimePicker Value="@detailLeaveDate" ValueChanged="value => detailLeaveDate = value ?? detailLeaveDate" Disabled="@IsDocumentReadOnly" AriaLabel="วันที่ลา" /></label>
                    <label>เวลาเริ่มต้น (24 ชั่วโมง)
                        <TimeMinutePicker @bind-Value="detailLeaveStartTime" Disabled="@IsDocumentReadOnly" AriaLabel="เวลาเริ่มต้นการลา" />
                    </label>
                    <label>จำนวนชั่วโมง<input type="number" min="0.5" max="8" step="0.5" @bind="detailLeaveHours" disabled="@IsDocumentReadOnly" /></label>
                    <div class="attachment-detail">
                        <span class="attachment-detail-label">เอกสารแนบ</span>
                        @if (isLoadingAttachments)
                        {
                            <span class="attachment-empty">กำลังโหลดไฟล์แนบ...</span>
                        }
                        else if (documentAttachments.Count == 0)
                        {
                            <span class="attachment-empty">ไม่มีเอกสารแนบ</span>
                        }
                        else
                        {
                            @foreach (var attachment in documentAttachments)
                            {
                                <button class="attachment-download" type="button"
                                        @onclick="() => OpenAttachmentPreview(attachment)">
                                    <span class="attachment-file-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><path d="M21.4 11.6 12 21a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5" /></svg>
                                    </span>
                                    <span class="attachment-file-info">
                                        <strong title="@attachment.FileName">@attachment.FileName</strong>
                                        <small>@FormatFileSize(attachment.FileSizeBytes)</small>
                                    </span>
                                    <span class="attachment-preview-action">ดู</span>
                                </button>
                            }
                        }
                    </div>
                    <label class="full-width">เหตุผลการลา<textarea rows="3" @bind="detailLeaveReason" disabled="@IsDocumentReadOnly"></textarea></label>
                </div>
                @if (selectedDocument.PendingCancelRequest is { } pendingCancel)
                {
                    <div class="request-attachment-section">
                        <strong>คำขอยกเลิกเอกสารกำลังรอพิจารณา</strong>
                        <span>เหตุผล: @pendingCancel.RequestReason</span>
                        <small>ส่งคำขอเมื่อ @pendingCancel.RequestedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(detailActionError))
                {
                    <p class="save-error" role="alert">@detailActionError</p>
                }
            </div>
            <footer class="document-modal-footer">
                <button class="btn btn-history" type="button" @onclick="ToggleHistory">ประวัติเอกสาร</button>
                <button class="btn btn-reset" type="button" @onclick="CloseDocument">ปิด</button>
                @if (selectedDocument.PendingCancelRequest is not null)
                {
                    <button class="btn btn-cancel-document" type="button" disabled="@isDocumentActionSaving" @onclick="ConfirmCancelPendingCancelRequest">
                        ยกเลิกคำขอยกเลิก
                    </button>
                }
                else if (CanCancelDocument)
                {
                    <button class="btn btn-cancel-document" type="button" disabled="@isDocumentActionSaving" @onclick="ConfirmCancelDocumentImmediately">
                        @(isDocumentActionSaving ? "กำลังยกเลิก..." : "ยกเลิกเอกสาร")
                    </button>
                }
                else if (CanRequestCancellation)
                {
                    <button class="btn btn-cancel-document" type="button" disabled="@isDocumentActionSaving" @onclick="StartCancelRequest">
                        ขอยกเลิกเอกสาร
                    </button>
                }
                @if (selectedDocument.PendingCancelRequest is null && selectedDocument.Status is "APPROVED" or "EDIT_REQUESTED")
                {
                    <button class="btn btn-request-edit" type="button" @onclick="StartEditRequest">ขอแก้ไขเอกสาร</button>
                }
                else if (!IsDocumentReadOnly)
                {
                    <button class="btn btn-create" type="button" @onclick="ConfirmSaveDocumentEdits">บันทึกการแก้ไข</button>
                }
            </footer>
        </section>
    </div>
}

@if (isShowingHistory && selectedDocument is not null)
{
    <LeaveDocumentHistoryPanel DocumentNo="@selectedDocument.DocumentNo"
                               Items="@documentHistory" OnClose="CloseHistory" />
}

@if (previewAttachment is not null)
{
    <div class="attachment-preview-overlay" role="dialog" aria-modal="true" aria-labelledby="attachment-preview-title">
        <section class="attachment-preview-modal">
            <header class="attachment-preview-header">
                <div>
                    <h2 id="attachment-preview-title">ตัวอย่างเอกสารแนบ</h2>
                    <p>@previewAttachment.FileName · @FormatFileSize(previewAttachment.FileSizeBytes)</p>
                </div>
                <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseAttachmentPreview">×</button>
            </header>
            <div class="attachment-preview-body">
                @if (isLoadingPreview)
                {
                    <div class="attachment-preview-state">กำลังโหลดเอกสาร...</div>
                }
                else if (!string.IsNullOrWhiteSpace(previewError))
                {
                    <div class="attachment-preview-state error">@previewError</div>
                }
                else if (!string.IsNullOrWhiteSpace(attachmentPreviewUrl))
                {
                    @if (previewAttachment.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                    {
                        <img src="@attachmentPreviewUrl" alt="@previewAttachment.FileName" />
                    }
                    else
                    {
                        <iframe src="@AttachmentPreviewSource" title="@previewAttachment.FileName"></iframe>
                    }
                }
            </div>
        </section>
    </div>
}

@if (isRequestingEdit)
{
    <div class="edit-request-panel" role="dialog" aria-modal="true" aria-labelledby="edit-request-title">
        <header class="edit-request-header">
            <div><h2 id="edit-request-title">ขอแก้ไขเอกสาร</h2><p>ระบุข้อมูลใหม่ที่ต้องการแก้ไข</p></div>
            <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseEditRequest">×</button>
        </header>
        <div class="edit-request-body">
            <div class="form-grid single-column">
                <label>ประเภทการลา<select @bind="requestLeaveType">@foreach (var type in leaveTypes) { <option value="@type.NameTh">@type.NameTh</option> }</select></label>
                @if (IsRequestSickLeave)
                {
                    <fieldset class="medical-certificate-field full-width edit-medical-certificate-field">
                        <legend>ใบรับรองแพทย์<span class="required">*</span></legend>
                        <label class="radio-option">
                            <input type="radio" name="request-medical-certificate"
                                   checked="@(requestHasMedicalCertificate == true)"
                                   @onchange="() => requestHasMedicalCertificate = true" />
                            มีใบรับรองแพทย์
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="request-medical-certificate"
                                   checked="@(requestHasMedicalCertificate == false)"
                                   @onchange="() => requestHasMedicalCertificate = false" />
                            ไม่มีใบรับรองแพทย์
                        </label>
                    </fieldset>
                }
                <label>วันที่ลา<DateTimePicker Value="@requestLeaveDate" ValueChanged="value => requestLeaveDate = value ?? requestLeaveDate" AriaLabel="วันที่ลาที่ขอแก้ไข" /></label>
                <label>เวลาเริ่มต้น (24 ชั่วโมง)
                    <TimeMinutePicker @bind-Value="requestLeaveStartTime" AriaLabel="เวลาเริ่มต้นการลาที่ขอแก้ไข" />
                </label>
                <label>จำนวนชั่วโมง<input type="number" min="0.5" max="8" step="0.5" @bind="requestLeaveHours" /></label>
                <label>เพิ่มไฟล์แนบ
                    <div class="attachment-picker">
                        <InputFile class="attachment-input" @key="requestAttachmentInputVersion" OnChange="SelectRequestAttachments" multiple accept=".pdf,.jpg,.jpeg,.png" />
                    </div>
                    <small class="attachment-help">ไฟล์ใหม่จะเพิ่มต่อจากไฟล์เดิมเมื่อคำขอได้รับอนุมัติ สูงสุด 10 ไฟล์ ไฟล์ละไม่เกิน 10 MB</small>
                </label>
                <label>เหตุผลในการขอแก้ไข<textarea rows="3" @bind="requestEditReason" placeholder="ระบุเหตุผลที่ต้องการแก้ไขเอกสาร"></textarea></label>
            </div>
            @if (pendingEditAttachments.Count > 0)
            {
                <div class="request-attachment-section">
                    <strong>ไฟล์ที่อยู่ในคำขอนี้</strong>
                    @foreach (var attachment in pendingEditAttachments)
                    {
                        <button type="button" @onclick="() => OpenAttachmentPreview(attachment)">@attachment.FileName · ดูตัวอย่าง</button>
                    }
                </div>
            }
            @if (requestAttachments.Count > 0)
            {
                <div class="selected-attachments">
                    @foreach (var attachment in requestAttachments)
                    {
                        <span>@attachment.FileName <button type="button" @onclick="() => requestAttachments.Remove(attachment)">×</button></span>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(editRequestError))
            {
                <div class="form-error" role="alert">@editRequestError</div>
            }
        </div>
        <footer class="edit-request-footer">
            @if (selectedDocument?.Status == "EDIT_REQUESTED")
            {
                <button class="btn btn-cancel-request" type="button" @onclick="ConfirmCancelEditRequest">ยกเลิกขอแก้ไข</button>
            }
            <button class="btn btn-request-edit" type="button" @onclick="ConfirmSaveEditRequest">บันทึกคำขอ</button>
        </footer>
    </div>
}

@if (isRequestingCancel && selectedDocument is not null)
{
    <div class="edit-request-panel cancel-request-panel" role="dialog" aria-modal="true" aria-labelledby="cancel-request-title">
        <header class="edit-request-header cancel-request-header">
            <div><h2 id="cancel-request-title">ขอยกเลิกเอกสาร</h2><p>@selectedDocument.DocumentNo</p></div>
            <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseCancelRequest">×</button>
        </header>
        <div class="edit-request-body">
            <label class="cancel-request-reason">
                เหตุผลในการขอยกเลิก <span class="required">*</span>
                <textarea rows="4" @bind="cancelRequestReason" placeholder="ระบุเหตุผลในการขอยกเลิกเอกสาร"></textarea>
            </label>
            @if (!string.IsNullOrWhiteSpace(cancelRequestError))
            {
                <div class="form-error" role="alert">@cancelRequestError</div>
            }
        </div>
        <footer class="edit-request-footer">
            <button class="btn btn-reset" type="button" @onclick="CloseCancelRequest">ปิด</button>
            <button class="btn btn-cancel-document" type="button" disabled="@isDocumentActionSaving" @onclick="ConfirmSubmitCancelRequest">
                @(isDocumentActionSaving ? "กำลังส่งคำขอ..." : "ส่งคำขอยกเลิก")
            </button>
        </footer>
    </div>
}

<ConfirmActionDialog IsOpen="@confirmOpen"
                     IsBusy="@confirmBusy"
                     Title="@confirmTitle"
                     Message="@confirmMessage"
                     ConfirmText="@confirmText"
                     BusyText="@confirmBusyText"
                     Tone="@confirmTone"
                     OnConfirm="ExecuteConfirmedAction"
                     OnCancel="CloseConfirmation" />

@code {
    private string searchText = string.Empty;
    private readonly HashSet<string> selectedLeaveTypes = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<CriteriaFilterOption> LeaveTypeFilterOptions => leaveTypes.Select(x => new CriteriaFilterOption(x.NameTh, x.NameTh)).ToList();
    private readonly HashSet<string> selectedStatuses = new(StringComparer.OrdinalIgnoreCase)
    {
        "PENDING_APPROVAL", "EDIT_REQUESTED", "APPROVED"
    };
    private static readonly (string Code, string Label)[] StatusFilterOptions =
    [
        ("PENDING_APPROVAL", "รออนุมัติ"),
        ("APPROVED", "อนุมัติแล้ว"),
        ("REJECTED", "ไม่อนุมัติ"),
        ("EDIT_REQUESTED", "ขอแก้ไข"),
        ("CANCELLED", "ยกเลิก")
    ];
    private string StatusFilterSummary => selectedStatuses.Count switch
    {
        0 => "ทั้งหมด",
        1 => StatusText(selectedStatuses.First()),
        _ => $"เลือกแล้ว {selectedStatuses.Count} สถานะ"
    };
    private DateTime? startDate;
    private DateTime? endDate;
    private bool isCreating;
    private string createMode = "single";
    private string newLeaveKind = string.Empty;
    private string newLeaveType = string.Empty;
    private DateTime newSingleLeaveDate = DateTime.Today;
    private TimeOnly newLeaveStartTime = new(9, 0);
    private decimal newLeaveHours = 8;
    private DateTime multiStartDate = DateTime.Today;
    private DateTime multiEndDate = DateTime.Today;
    private readonly List<MultiDayLeaveRow> multiDayRows = [];
    private string newLeaveReason = string.Empty;
    private readonly List<LeaveAttachmentUploadDto> newAttachments = [];
    private int attachmentInputVersion;
    private bool? newHasMedicalCertificate;
    private bool IsSickLeave => string.Equals(
        FindLeaveType(newLeaveType)?.Code,
        "SICK",
        StringComparison.OrdinalIgnoreCase);
    private string? saveError;
    private LeaveDocumentDto? selectedDocument;
    private string detailLeaveKind = "ลาล่วงหน้า";
    private string detailLeaveType = string.Empty;
    private DateTime detailLeaveDate = DateTime.Today;
    private TimeOnly detailLeaveStartTime = new(9, 0);
    private decimal detailLeaveHours = 8;
    private string detailLeaveReason = string.Empty;
    private bool HasLeaveStarted => selectedDocument is not null &&
        DateTime.Now >= selectedDocument.LeaveDate.ToDateTime(selectedDocument.StartTime);
    private bool IsPendingRetroactiveLeave =>
        selectedDocument?.Status == "PENDING_APPROVAL" &&
        string.Equals(selectedDocument.LeaveKind, "RETROACTIVE", StringComparison.OrdinalIgnoreCase);
    private bool IsDocumentReadOnly => selectedDocument is null ||
        (HasLeaveStarted && !IsPendingRetroactiveLeave) ||
        selectedDocument.PendingCancelRequest is not null ||
        selectedDocument.Status != "PENDING_APPROVAL";
    private bool CanCancelDocument =>
        selectedDocument is not null &&
        !HasLeaveStarted &&
        selectedDocument.PendingCancelRequest is null &&
        selectedDocument.Status is "PENDING_APPROVAL" or "APPROVED";
    private bool CanRequestCancellation =>
        selectedDocument is not null &&
        HasLeaveStarted &&
        selectedDocument.PendingCancelRequest is null &&
        selectedDocument.Status == "APPROVED";
    private bool isDocumentActionSaving;
    private bool confirmOpen;
    private bool confirmBusy;
    private string confirmTitle = string.Empty;
    private string confirmMessage = string.Empty;
    private string confirmText = "ยืนยัน";
    private string confirmBusyText = "กำลังดำเนินการ...";
    private string confirmTone = "primary";
    private Func<Task>? confirmedAction;
    private bool isRequestingCancel;
    private string cancelRequestReason = string.Empty;
    private string? cancelRequestError;
    private string? detailActionError;
    private bool isLoadingAttachments;
    private List<LeaveDocumentAttachmentDto> documentAttachments = [];
    private LeaveDocumentAttachmentDto? previewAttachment;
    private string? attachmentPreviewUrl;
    private string? AttachmentPreviewSource =>
        string.IsNullOrWhiteSpace(attachmentPreviewUrl)
            ? null
            : $"{attachmentPreviewUrl}#toolbar=0&navpanes=0&scrollbar=1";
    private string? previewError;
    private bool isLoadingPreview;
    private bool isRequestingEdit;
    private string requestLeaveType = string.Empty;
    private bool? requestHasMedicalCertificate;
    private bool IsRequestSickLeave => string.Equals(
        FindLeaveType(requestLeaveType)?.Code,
        "SICK",
        StringComparison.OrdinalIgnoreCase);
    private DateTime requestLeaveDate = DateTime.Today;
    private TimeOnly requestLeaveStartTime = new(9, 0);
    private decimal requestLeaveHours = 8;
    private string requestEditReason = string.Empty;
    private readonly List<LeaveAttachmentUploadDto> requestAttachments = [];
    private List<LeaveDocumentAttachmentDto> pendingEditAttachments = [];
    private int requestAttachmentInputVersion;
    private string? editRequestError;
    private bool isShowingHistory;
    private List<LeaveDocumentHistoryDto> documentHistory = [];
    private List<LeaveTypeDto> leaveTypes = [];
    private List<MasterDataItemDto> leaveKinds = [];
    private List<LeaveQuotaDto> myLeaveQuotas = [];
    private List<LeaveDocumentDto> documents = [];
    private bool hasOpenedRequestedDocument;
    private CurrentMicrosoftUserDto? currentUser;
    private string CurrentEmployeeId => currentUser?.EmployeeId ?? string.Empty;
    private string CurrentEmployeeName => currentUser?.EmployeeName ?? currentUser?.DisplayName ?? string.Empty;
    private string CurrentEmployeeDepartment => currentUser?.Department ?? string.Empty;
    private string CurrentApproverName => !string.IsNullOrWhiteSpace(currentUser?.LeaveApproverName)
        ? currentUser.LeaveApproverName
        : currentUser?.SupervisorName ?? string.Empty;
    private List<LeaveDocumentDto> filteredDocuments = [];
    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<LeaveDocumentDto> PagedDocuments => filteredDocuments
        .Skip((Math.Clamp(currentPage, 1, Math.Max(1, (int)Math.Ceiling(filteredDocuments.Count / (double)pageSize))) - 1) * pageSize)
        .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
        await ReloadData();
    }

    private async Task ReloadData()
    {
        leaveTypes = await Http.GetFromJsonAsync<List<LeaveTypeDto>>("api/leave-types") ?? [];
        leaveKinds = await Http.GetFromJsonAsync<List<MasterDataItemDto>>(
            "api/system-master-data/items?category=LEAVE_KIND&includeInactive=false") ?? [];
        if (string.IsNullOrWhiteSpace(CurrentEmployeeId))
        {
            myLeaveQuotas = [];
            documents = [];
            Search();
            return;
        }
        myLeaveQuotas = (await Http.GetFromJsonAsync<List<LeaveQuotaDto>>(
            $"api/leave-quotas?year={DateTime.Today.Year}&employeeId={Uri.EscapeDataString(CurrentEmployeeId)}") ?? [])
            .OrderBy(quota => LeaveQuotaDisplayOrder(quota.LeaveTypeName))
            .ThenBy(quota => quota.LeaveTypeName)
            .ToList();
        documents = await Http.GetFromJsonAsync<List<LeaveDocumentDto>>(
            $"api/leave-documents?creatorEmployeeId={Uri.EscapeDataString(CurrentEmployeeId)}") ?? [];
        Search();
        if (!hasOpenedRequestedDocument && RequestedDocumentId is long requestedId)
        {
            hasOpenedRequestedDocument = true;
            var requestedDocument = documents.FirstOrDefault(document => document.Id == requestedId);
            if (requestedDocument is not null)
                await OpenDocument(requestedDocument);
        }
    }

    private void Search()
    {
        currentPage = 1;
        filteredDocuments = documents.Where(document =>
            (string.IsNullOrWhiteSpace(searchText) ||
             document.DocumentNo.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             document.LeaveTypeName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             document.LeaveReason.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
            (selectedLeaveTypes.Count == 0 || selectedLeaveTypes.Contains(document.LeaveTypeName)) &&
            (selectedStatuses.Count == 0 || selectedStatuses.Contains(document.Status)) &&
            (!startDate.HasValue || document.LeaveDate >= DateOnly.FromDateTime(startDate.Value)) &&
            (!endDate.HasValue || document.LeaveDate <= DateOnly.FromDateTime(endDate.Value))).ToList();
    }

    private static int LeaveQuotaDisplayOrder(string leaveTypeName) => leaveTypeName switch
    {
        "ลาพักร้อน" => 10,
        "ลาป่วย" => 20,
        "ลากิจไม่รับเงินเดือน" => 30,
        "ลาคลอด" => 40,
        "ลาบวช" => 50,
        _ => 100
    };

    private void Reset()
    {
        searchText = string.Empty;
        selectedLeaveTypes.Clear();
        selectedStatuses.Clear();
        selectedStatuses.UnionWith(["PENDING_APPROVAL", "EDIT_REQUESTED", "APPROVED"]);
        startDate = endDate = null;
        Search();
    }

    private void SetStatusFilter(string statusCode, bool isSelected)
    {
        if (isSelected)
            selectedStatuses.Add(statusCode);
        else
            selectedStatuses.Remove(statusCode);

        Search();
    }

    private void ClearStatusFilter()
    {
        selectedStatuses.Clear();
        Search();
    }

    private Task SetLeaveTypeFilters(IReadOnlyCollection<string> values)
    {
        selectedLeaveTypes.Clear();
        selectedLeaveTypes.UnionWith(values);
        Search();
        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        isCreating = true;
        createMode = "single";
        newLeaveKind = newLeaveType = newLeaveReason = string.Empty;
        newSingleLeaveDate = multiStartDate = multiEndDate = DateTime.Today;
        newLeaveStartTime = new TimeOnly(9, 0);
        newLeaveHours = 8;
        multiDayRows.Clear();
        newAttachments.Clear();
        attachmentInputVersion++;
        newHasMedicalCertificate = null;
        saveError = null;
    }

    private void ChangeCreateMode(string mode)
    {
        createMode = mode;
        saveError = null;
    }

    private void ShowSingleMode() => ChangeCreateMode("single");
    private void ShowMultipleMode() => ChangeCreateMode("multiple");

    private void GenerateMultiDayRows()
    {
        saveError = null;
        if (multiEndDate.Date < multiStartDate.Date)
        {
            saveError = "วันที่สิ้นสุดต้องไม่น้อยกว่าวันที่เริ่มต้น";
            return;
        }

        var totalDays = (multiEndDate.Date - multiStartDate.Date).Days + 1;
        if (totalDays > 99)
        {
            saveError = "เอกสารการลาหนึ่งชุดสร้างได้ไม่เกิน 99 วัน";
            return;
        }

        multiDayRows.Clear();
        for (var offset = 0; offset < totalDays; offset++)
        {
            multiDayRows.Add(new MultiDayLeaveRow
            {
                LeaveDate = multiStartDate.Date.AddDays(offset),
                StartTime = new TimeOnly(9, 0),
                LeaveHours = 8
            });
        }
    }

    private void RemoveMultiDayRow(MultiDayLeaveRow row) =>
        multiDayRows.Remove(row);

    private async Task OpenDocument(LeaveDocumentDto document)
    {
        detailActionError = null;
        selectedDocument = await Http.GetFromJsonAsync<LeaveDocumentDto>($"api/leave-documents/{document.Id}") ?? document;
        detailLeaveKind = KindText(selectedDocument.LeaveKind);
        detailLeaveType = selectedDocument.LeaveTypeName;
        detailLeaveDate = selectedDocument.LeaveDate.ToDateTime(TimeOnly.MinValue);
        detailLeaveStartTime = selectedDocument.StartTime;
        detailLeaveHours = selectedDocument.LeaveHours;
        detailLeaveReason = selectedDocument.LeaveReason;
        isLoadingAttachments = true;
        documentAttachments = [];
        try
        {
            documentAttachments = await Http.GetFromJsonAsync<List<LeaveDocumentAttachmentDto>>(
                $"api/leave-documents/{selectedDocument.Id}/attachments") ?? [];
        }
        catch (Exception exception)
        {
            detailActionError = $"โหลดไฟล์แนบไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoadingAttachments = false;
        }
    }

    private void CloseDocument()
    {
        selectedDocument = null;
        documentAttachments = [];
        isRequestingEdit = false;
        isRequestingCancel = false;
        cancelRequestReason = string.Empty;
        cancelRequestError = null;
        isShowingHistory = false;
    }

    private async Task OpenAttachmentPreview(LeaveDocumentAttachmentDto attachment)
    {
        if (selectedDocument is null) return;
        await RevokePreviewUrl();
        previewAttachment = attachment;
        previewError = null;
        isLoadingPreview = true;
        var response = await Http.GetAsync(
            $"api/leave-documents/{selectedDocument.Id}/attachments/{attachment.Id}/preview");
        if (!response.IsSuccessStatusCode)
        {
            previewError = (await response.Content.ReadAsStringAsync()).Trim('"');
            isLoadingPreview = false;
            return;
        }

        var content = await response.Content.ReadAsByteArrayAsync();
        attachmentPreviewUrl = await JS.InvokeAsync<string>(
            "hrPreview.createObjectUrl", attachment.ContentType, content);
        isLoadingPreview = false;
    }

    private async Task CloseAttachmentPreview()
    {
        await RevokePreviewUrl();
        previewAttachment = null;
        previewError = null;
        isLoadingPreview = false;
    }

    private async Task RevokePreviewUrl()
    {
        if (string.IsNullOrWhiteSpace(attachmentPreviewUrl)) return;
        await JS.InvokeVoidAsync("hrPreview.revokeObjectUrl", attachmentPreviewUrl);
        attachmentPreviewUrl = null;
    }

    private static string FormatFileSize(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{Math.Max(1, bytes / 1024d):0.##} KB";

    private async Task ToggleHistory()
    {
        isShowingHistory = !isShowingHistory;
        if (isShowingHistory && selectedDocument is not null)
            documentHistory = await Http.GetFromJsonAsync<List<LeaveDocumentHistoryDto>>($"api/leave-documents/{selectedDocument.Id}/history") ?? [];
    }
    private void CloseHistory() => isShowingHistory = false;

    private async Task StartEditRequest()
    {
        if (selectedDocument?.Status is not ("APPROVED" or "EDIT_REQUESTED") ||
            selectedDocument.PendingCancelRequest is not null) return;
        isRequestingEdit = true;
        editRequestError = null;
        requestAttachments.Clear();
        pendingEditAttachments = [];
        requestAttachmentInputVersion++;
        if (selectedDocument.PendingEditRequest is { } existingRequest)
        {
            requestLeaveType = existingRequest.RequestedLeaveTypeName;
            requestHasMedicalCertificate = existingRequest.RequestedHasMedicalCertificate;
            requestLeaveDate = existingRequest.RequestedLeaveDate.ToDateTime(TimeOnly.MinValue);
            requestLeaveStartTime = existingRequest.RequestedStartTime;
            requestLeaveHours = existingRequest.RequestedLeaveHours;
            requestEditReason = existingRequest.RequestReason;
        }
        else
        {
            requestLeaveType = detailLeaveType;
            requestHasMedicalCertificate = selectedDocument.HasMedicalCertificate;
            requestLeaveDate = detailLeaveDate;
            requestLeaveStartTime = detailLeaveStartTime;
            requestLeaveHours = detailLeaveHours;
            requestEditReason = string.Empty;
        }
        if (selectedDocument.Status == "EDIT_REQUESTED")
        {
            try
            {
                pendingEditAttachments = await Http.GetFromJsonAsync<List<LeaveDocumentAttachmentDto>>(
                    $"api/leave-documents/{selectedDocument.Id}/edit-requests/pending/attachments") ?? [];
            }
            catch (Exception exception)
            {
                editRequestError = $"โหลดไฟล์ในคำขอไม่สำเร็จ: {exception.Message}";
            }
        }
    }

    private void CloseEditRequest()
    {
        isRequestingEdit = false;
        editRequestError = null;
        requestAttachments.Clear();
        pendingEditAttachments = [];
        requestHasMedicalCertificate = null;
    }

    private void ConfirmCreateDocument()
    {
        var count = createMode == "multiple" ? multiDayRows.Count : 1;
        OpenConfirmation(
            "ยืนยันการสร้างเอกสารการลา",
            count > 1
                ? $"ระบบจะสร้างเอกสารการลา {count} รายการ ต้องการดำเนินการต่อหรือไม่"
                : "ต้องการสร้างเอกสารการลานี้ใช่หรือไม่",
            "สร้างเอกสาร", "กำลังสร้างเอกสาร...", "primary", SaveDocument);
    }

    private void ConfirmSaveEditRequest() => OpenConfirmation(
        "ยืนยันการขอแก้ไขเอกสาร",
        $"ต้องการส่งคำขอแก้ไขเอกสาร {selectedDocument?.DocumentNo} ใช่หรือไม่",
        "ส่งคำขอแก้ไข", "กำลังส่งคำขอ...", "warning", SaveEditRequest);

    private void ConfirmCancelEditRequest() => OpenConfirmation(
        "ยืนยันการยกเลิกคำขอแก้ไข",
        $"ต้องการยกเลิกคำขอแก้ไขเอกสาร {selectedDocument?.DocumentNo} ใช่หรือไม่",
        "ยกเลิกคำขอ", "กำลังยกเลิก...", "danger", CancelEditRequest);

    private void ConfirmCancelDocumentImmediately() => OpenConfirmation(
        "ยืนยันการยกเลิกเอกสาร",
        $"ต้องการยกเลิกเอกสาร {selectedDocument?.DocumentNo} ใช่หรือไม่ การทำรายการนี้ไม่สามารถย้อนกลับได้",
        "ยกเลิกเอกสาร", "กำลังยกเลิก...", "danger", CancelDocumentImmediately);

    private void ConfirmSubmitCancelRequest() => OpenConfirmation(
        "ยืนยันการขอยกเลิกเอกสาร",
        $"ต้องการส่งคำขอยกเลิกเอกสาร {selectedDocument?.DocumentNo} ใช่หรือไม่",
        "ส่งคำขอยกเลิก", "กำลังส่งคำขอ...", "warning", SubmitCancelRequest);

    private void ConfirmCancelPendingCancelRequest() => OpenConfirmation(
        "ยืนยันการยกเลิกคำขอยกเลิก",
        $"ต้องการยกเลิกคำขอยกเลิกของเอกสาร {selectedDocument?.DocumentNo} ใช่หรือไม่",
        "ยกเลิกคำขอ", "กำลังยกเลิก...", "danger", CancelPendingCancelRequest);

    private void ConfirmSaveDocumentEdits() => OpenConfirmation(
        "ยืนยันการแก้ไขเอกสาร",
        $"ต้องการบันทึกการแก้ไขเอกสาร {selectedDocument?.DocumentNo} ใช่หรือไม่",
        "บันทึกการแก้ไข", "กำลังบันทึก...", "warning", SaveDocumentEdits);

    private void OpenConfirmation(
        string title, string message, string confirmTextValue,
        string busyText, string tone, Func<Task> action)
    {
        if (confirmBusy) return;
        confirmTitle = title;
        confirmMessage = message;
        confirmText = confirmTextValue;
        confirmBusyText = busyText;
        confirmTone = tone;
        confirmedAction = action;
        confirmOpen = true;
    }

    private async Task ExecuteConfirmedAction()
    {
        if (confirmBusy || confirmedAction is null) return;
        confirmBusy = true;
        try { await confirmedAction(); }
        finally
        {
            confirmBusy = false;
            confirmOpen = false;
            confirmedAction = null;
        }
    }

    private void CloseConfirmation()
    {
        if (confirmBusy) return;
        confirmOpen = false;
        confirmedAction = null;
    }

    private async Task SaveEditRequest()
    {
        if (selectedDocument is null ||
            selectedDocument.Status is not ("APPROVED" or "EDIT_REQUESTED") ||
            selectedDocument.PendingCancelRequest is not null) return;
        editRequestError = null;
        var type = FindLeaveType(requestLeaveType);
        if (type is null || string.IsNullOrWhiteSpace(requestEditReason))
        {
            editRequestError = "กรุณาระบุประเภทการลาและเหตุผลในการขอแก้ไขให้ครบถ้วน";
            return;
        }
        if (IsRequestSickLeave && !requestHasMedicalCertificate.HasValue)
        {
            editRequestError = "กรุณาระบุว่ามีใบรับรองแพทย์หรือไม่";
            return;
        }
        if (IsRequestSickLeave && requestHasMedicalCertificate == true &&
            selectedDocument.HasMedicalCertificate != true &&
            requestAttachments.Count == 0 && pendingEditAttachments.Count == 0)
        {
            editRequestError = "กรุณาแนบใบรับรองแพทย์";
            return;
        }
        var request = new SaveLeaveEditRequest(type.Id, selectedDocument.LeaveKind, DateOnly.FromDateTime(requestLeaveDate), requestLeaveStartTime,
            requestLeaveHours, IsRequestSickLeave ? requestHasMedicalCertificate : null,
            requestEditReason, CurrentEmployeeId, CurrentEmployeeName, requestAttachments.ToList());
        var response = await Http.PostAsJsonAsync($"api/leave-documents/{selectedDocument.Id}/edit-requests", request);
        if (!response.IsSuccessStatusCode)
        {
            editRequestError = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(editRequestError))
                editRequestError = "ไม่สามารถบันทึกคำขอแก้ไขได้ กรุณาลองใหม่อีกครั้ง";
            return;
        }
        await ReloadData();
        CloseEditRequest();
        CloseDocument();
    }

    private async Task CancelEditRequest()
    {
        if (selectedDocument?.Status != "EDIT_REQUESTED") return;
        var url = $"api/leave-documents/{selectedDocument.Id}/edit-requests/pending?actionBy={Uri.EscapeDataString(CurrentEmployeeId)}&actionByName={Uri.EscapeDataString(CurrentEmployeeName)}";
        var response = await Http.DeleteAsync(url);
        if (!response.IsSuccessStatusCode) return;
        await ReloadData();
        CloseDocument();
    }

    private async Task CancelDocumentImmediately()
    {
        if (selectedDocument is null || !CanCancelDocument || isDocumentActionSaving)
            return;
        isDocumentActionSaving = true;
        detailActionError = null;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/leave-documents/{selectedDocument.Id}/cancel",
                new ReviewLeaveDocumentRequest(CurrentEmployeeId, CurrentEmployeeName));
            if (!response.IsSuccessStatusCode)
            {
                detailActionError = $"ยกเลิกเอกสารไม่สำเร็จ: {await response.Content.ReadAsStringAsync()}";
                return;
            }
            await ReloadData();
            CloseDocument();
        }
        catch (Exception exception)
        {
            detailActionError = $"ยกเลิกเอกสารไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isDocumentActionSaving = false;
        }
    }

    private void StartCancelRequest()
    {
        if (!CanRequestCancellation) return;
        cancelRequestReason = string.Empty;
        cancelRequestError = null;
        isRequestingCancel = true;
    }

    private void CloseCancelRequest()
    {
        if (isDocumentActionSaving) return;
        isRequestingCancel = false;
        cancelRequestReason = string.Empty;
        cancelRequestError = null;
    }

    private async Task SubmitCancelRequest()
    {
        if (selectedDocument is null || !CanRequestCancellation || isDocumentActionSaving)
            return;
        if (string.IsNullOrWhiteSpace(cancelRequestReason))
        {
            cancelRequestError = "กรุณาระบุเหตุผลในการขอยกเลิกเอกสาร";
            return;
        }

        cancelRequestError = null;
        isDocumentActionSaving = true;
        try
        {
            var request = new ReviewLeaveDocumentRequest(
                CurrentEmployeeId, CurrentEmployeeName, cancelRequestReason.Trim());
            var response = await Http.PostAsJsonAsync(
                $"api/leave-documents/{selectedDocument.Id}/cancel-requests",
                request);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                cancelRequestError = string.IsNullOrWhiteSpace(details)
                    ? $"ส่งคำขอยกเลิกไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : $"ส่งคำขอยกเลิกไม่สำเร็จ: {details}";
                return;
            }

            await ReloadData();
            CloseDocument();
        }
        catch (Exception exception)
        {
            cancelRequestError = $"ส่งคำขอยกเลิกไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isDocumentActionSaving = false;
        }
    }

    private async Task CancelPendingCancelRequest()
    {
        if (selectedDocument?.PendingCancelRequest is null || isDocumentActionSaving)
            return;
        isDocumentActionSaving = true;
        detailActionError = null;
        try
        {
            var url = $"api/leave-documents/{selectedDocument.Id}/cancel-requests/pending?actionBy={Uri.EscapeDataString(CurrentEmployeeId)}&actionByName={Uri.EscapeDataString(CurrentEmployeeName)}";
            var response = await Http.DeleteAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                detailActionError = $"ยกเลิกคำขอไม่สำเร็จ: {await response.Content.ReadAsStringAsync()}";
                return;
            }
            await ReloadData();
            CloseDocument();
        }
        finally
        {
            isDocumentActionSaving = false;
        }
    }

    private async Task SaveDocumentEdits()
    {
        if (selectedDocument is null || IsDocumentReadOnly) return;
        detailActionError = null;
        var type = FindLeaveType(detailLeaveType);
        if (type is null || string.IsNullOrWhiteSpace(detailLeaveReason)) return;
        var request = new UpdateLeaveDocumentRequest(type.Id, KindCode(detailLeaveKind), DateOnly.FromDateTime(detailLeaveDate), detailLeaveStartTime,
            detailLeaveHours, detailLeaveReason, CurrentEmployeeId, CurrentEmployeeName);
        var response = await Http.PutAsJsonAsync($"api/leave-documents/{selectedDocument.Id}", request);
        if (!response.IsSuccessStatusCode)
        {
