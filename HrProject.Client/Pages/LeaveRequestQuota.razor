@page "/leave/request-quota"
@inject HttpClient Http
@inject HrProject.Client.Services.LoadingState LoadingState

<PageTitle>ขอวันลาเพิ่ม | HR Project</PageTitle>

<section class="manage-page quota-request-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1>ขอวันลาเพิ่ม</h1>
                <p>ส่งคำขอเพิ่มโควต้าวันลาของคุณ</p>
            </div>
            <button class="btn btn-create" type="button" @onclick="OpenCreate">+ สร้างคำขอ</button>
        </div>
    </header>

    <section class="content-card criteria-card">
        <div class="content-card-header">ค้นหาคำขอ</div>
        <div class="content-card-body">
            <div class="criteria-grid">
                <label>คำค้นหา
                    <input @bind="searchText" @bind:event="oninput" @bind:after="Filter"
                           placeholder="เลขที่คำขอ ประเภท หรือเหตุผล" />
                </label>
                <div class="criteria-field"><span>ประเภทการลา</span><CriteriaMultiSelect Options="@LeaveTypeFilterOptions" Values="@selectedLeaveTypes" ValuesChanged="SetLeaveTypeFilters" /></div>
                <div class="criteria-field"><span>สถานะ</span><CriteriaMultiSelect Options="@StatusFilterOptions" Values="@selectedStatuses" ValuesChanged="SetStatusFilters" /></div>
            </div>
            <div class="criteria-actions">
                <button class="btn btn-reset" type="button" @onclick="Reset">ล้างข้อมูล</button>
            </div>
        </div>
    </section>

    <section class="content-card">
        <div class="content-card-header">
            คำขอเพิ่มโควต้าของฉัน
            <span class="result-count">@filteredRequests.Count รายการ</span>
        </div>
        <div class="content-card-body">
            @if (isLoading)
            {
                <div class="state-message">กำลังโหลดคำขอ...</div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="state-message error">@loadError</div>
            }
            else
            {
                @if (CanApproveQuotaRequest || CanRejectQuotaRequest)
                {
                    <div class="bulk-toolbar">
                        @if (!string.IsNullOrWhiteSpace(bulkMessage))
                        {
                            <span class="bulk-message @(bulkSucceeded ? "success" : "error")">@bulkMessage</span>
                        }
                        @if (CanApproveQuotaRequest)
                        {
                        <button class="btn btn-approve" type="button" disabled="@(selectedIds.Count == 0 || isBulkReviewing)" @onclick="BulkApprove">
                            @(isBulkReviewing ? "กำลังอนุมัติ..." : $"อนุมัติที่เลือก ({selectedIds.Count})")
                        </button>
                        }
                        @if (CanRejectQuotaRequest)
                        {
                            <button class="btn btn-reject" type="button" disabled="@(selectedIds.Count == 0 || isBulkReviewing || string.IsNullOrWhiteSpace(bulkRejectRemark))" @onclick="BulkReject">
                                @(isBulkReviewing ? "กำลังดำเนินการ..." : $"ไม่อนุมัติที่เลือก ({selectedIds.Count})")
                            </button>
                        }
                        <input class="bulk-reason" @bind="bulkRejectRemark" placeholder="เหตุผลที่ไม่อนุมัติรายการที่เลือก" />
                    </div>
                }
                <div class="table-responsive">
                    <table class="table employee-table request-table">
                        <thead>
                            <tr>
                                @if (CanApproveQuotaRequest || CanRejectQuotaRequest)
                                {
                                    <th class="select-column"><input type="checkbox" aria-label="เลือกทั้งหมดในหน้านี้" checked="@AreAllPageItemsSelected" @onchange="ToggleCurrentPage" /></th>
                                }
                                <th>เลขที่คำขอ</th>
                                <th>ชื่อพนักงาน</th>
                                <th>ประเภทการลา</th>
                                <th>จำนวนที่ขอ</th>
                                <th>จำนวนที่อนุมัติ</th>
                                <th>เหตุผล</th>
                                <th>วันที่ขอ</th>
                                <th>สถานะ</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredRequests.Count == 0)
                            {
                                <tr><td colspan="@(CanApproveQuotaRequest || CanRejectQuotaRequest ? 10 : 9)" class="no-results">ไม่พบคำขอเพิ่มโควต้าวันลา</td></tr>
                            }
                            else
                            {
                                @foreach (var request in PagedRequests)
                                {
                                    <tr>
                                        @if (CanApproveQuotaRequest || CanRejectQuotaRequest)
                                        {
                                            <td class="select-column"><input type="checkbox" aria-label="เลือก @request.RequestNo" disabled="@(request.Status != "PENDING")" checked="@selectedIds.Contains(request.Id)" @onchange="eventArgs => ToggleItem(request.Id, (bool?)eventArgs.Value == true)" /></td>
                                        }
                                        <td><LeaveQuotaRequestHoverPreview Request="@request" EmployeeName="@EmployeeName(request.EmployeeId)" EmployeeDepartment="@EmployeeDepartment(request.EmployeeId)"><button class="request-number" type="button" @onclick="() => OpenRequest(request)">@request.RequestNo</button></LeaveQuotaRequestHoverPreview></td>
                                        <td>@EmployeeName(request.EmployeeId)</td>
                                        <td>@request.LeaveTypeName</td>
                                        <td>@request.RequestedHours.ToString("0.##") ชั่วโมง <small>(@HoursToDays(request.RequestedHours) วัน)</small></td>
                                        <td>
                                            @if (request.Status == "PENDING")
                                            {
                                                <span>@request.RequestedHours.ToString("0.##") ชั่วโมง <small>(@HoursToDays(request.RequestedHours) วัน)</small></span>
                                            }
                                            else if (request.ApprovedHours.HasValue)
                                            {
                                                <span>@request.ApprovedHours.Value.ToString("0.##") ชั่วโมง <small>(@HoursToDays(request.ApprovedHours.Value) วัน)</small></span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td><span class="reason-cell" title="@request.RequestReason">@request.RequestReason</span></td>
                                        <td>@request.RequestedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="status-pill @StatusClass(request.Status)" data-status="@request.Status">@StatusText(request.Status)</span></td>
                                        <td><button class="btn-view-request" type="button" @onclick="() => OpenRequest(request)">ดูรายละเอียด</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination TotalItems="@filteredRequests.Count" @bind-CurrentPage="currentPage" @bind-PageSize="pageSize" />
            }
        </div>
    </section>
</section>

@if (isCreating)
{
    <div class="request-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="create-quota-request-title">
        <section class="request-modal">
            <header class="request-modal-header">
                <div>
                    <h2 id="create-quota-request-title">สร้างคำขอเพิ่มโควต้าวันลา</h2>
                    <p>คำขอจะมีผลต่อโควต้าเมื่อได้รับการอนุมัติ</p>
                </div>
                <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseCreate">×</button>
            </header>
            <div class="request-modal-body">
                <div class="form-grid readonly-grid">
                    <label>ปีโควต้า<input value="@DateTime.Today.Year" disabled /></label>
                    <div class="add-row-action full-width">
                        <button class="btn btn-add-employee" type="button" @onclick="AddEmployee">
                            + เพิ่มรายการ
                        </button>
                    </div>
                    <div class="selected-employees full-width">
                        <div class="selected-employees-header">
                            รายการพนักงาน <strong>@employeeRequests.Count คน</strong>
                        </div>
                        <div class="table-responsive">
                            <table class="employee-request-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>พนักงาน</th>
                                        <th>แผนก</th>
                                        <th>ประเภทการลา</th>
                                        <th>จำนวนที่ขอ (ชั่วโมง)</th>
                                        <th>จำนวนวัน</th>
                                        <th>เหตุผล</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (employeeRequests.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="8" class="empty-employee-list">
                                                ยังไม่มีพนักงาน กรุณาเลือกพนักงานและกดเพิ่ม
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @for (var index = 0; index < employeeRequests.Count; index++)
                                        {
                                            var row = employeeRequests[index];
                                            <tr @key="row.RowId">
                                                <td>@(index + 1)</td>
                                                <td>
                                                    <EmployeeSearchSelect Items="@AvailableEmployeesFor(row).ToList()"
                                                                          @bind-Value="row.EmployeeId"
                                                                          Placeholder="ค้นหาพนักงาน" />
                                                </td>
                                                <td>@EmployeeDepartment(row.EmployeeId)</td>
                                                <td>
                                                    <select @bind="row.LeaveTypeId">
                                                        <option value="0">-- เลือกประเภท --</option>
                                                        @foreach (var type in leaveTypes)
                                                        {
                                                            <option value="@type.Id">@type.NameTh</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" min="0.5" step="0.5"
                                                           @bind="row.RequestedHours" />
                                                </td>
                                                <td>@HoursToDays(row.RequestedHours) วัน</td>
                                                <td>
                                                    <input class="row-reason" @bind="row.RequestReason"
                                                           placeholder="เหตุผล" />
                                                </td>
                                                <td>
                                                    <button class="remove-employee" type="button"
                                                            title="ลบพนักงาน"
                                                            @onclick="() => RemoveEmployee(row.EmployeeId)">×</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <div class="save-error" role="alert">@saveError</div>
                }
            </div>
            <footer class="request-modal-footer">
                <button class="btn btn-reset" type="button" @onclick="CloseCreate">ปิด</button>
                <button class="btn btn-create" type="button" disabled="@isSaving" @onclick="SaveRequest">
                    @(isSaving ? "กำลังส่งคำขอ..." : "ส่งคำขอ")
                </button>
            </footer>
        </section>
    </div>
}

@if (selectedRequest is not null)
{
    <div class="request-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="review-quota-request-title">
        <section class="request-modal review-request-modal">
            <header class="request-modal-header">
                <div>
                    <h2 id="review-quota-request-title">รายละเอียดคำขอเพิ่มโควต้า</h2>
                    <p>@selectedRequest.RequestNo</p>
                </div>
                <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseRequest">×</button>
            </header>
            <div class="request-modal-body">
                <div class="form-grid review-detail-grid">
                    <label>พนักงาน<input value="@EmployeeName(selectedRequest.EmployeeId)" disabled /></label>
                    <label>แผนก<input value="@EmployeeDepartment(selectedRequest.EmployeeId)" disabled /></label>
                    <label>ประเภทการลา<input value="@selectedRequest.LeaveTypeName" disabled /></label>
                    <label>ปีโควต้า<input value="@selectedRequest.QuotaYear" disabled /></label>
                    <label>จำนวนที่ขอ<input value="@($"{selectedRequest.RequestedHours:0.##} ชั่วโมง ({HoursToDays(selectedRequest.RequestedHours)} วัน)")" disabled /></label>
                    <label>วันที่ขอ<input value="@selectedRequest.RequestedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")" disabled /></label>
                    <label class="full-width">เหตุผลในการขอ<textarea rows="3" disabled>@selectedRequest.RequestReason</textarea></label>
                    <label>สถานะ<input value="@StatusText(selectedRequest.Status)" disabled /></label>
                    <label>
                        จำนวนที่อนุมัติ (ชั่วโมง)
                        <input type="number" min="0.5" step="0.5" max="@selectedRequest.RequestedHours"
                               disabled="@(selectedRequest.Status != "PENDING")"
                               @bind="reviewApprovedHours" />
                        <small class="approved-day-preview">เท่ากับ @HoursToDays(reviewApprovedHours) วัน</small>
                    </label>
                    <label class="full-width">
                        หมายเหตุการพิจารณา
                        <textarea rows="3" disabled="@(selectedRequest.Status != "PENDING")"
                                  @bind="reviewRemark" placeholder="กรณีไม่อนุมัติ กรุณาระบุเหตุผล"></textarea>
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(reviewError))
                {
                    <div class="save-error" role="alert">@reviewError</div>
                }
            </div>
            <footer class="request-modal-footer">
                <button class="btn btn-reset" type="button" @onclick="CloseRequest">ปิด</button>
                @if (selectedRequest.Status == "PENDING" && CanRejectQuotaRequest)
                {
                    <button class="btn btn-reject" type="button" disabled="@isReviewing" @onclick="RejectRequest">
                        @(isReviewing ? "กำลังดำเนินการ..." : "ไม่อนุมัติ")
                    </button>
                }
                @if (selectedRequest.Status == "PENDING" && CanApproveQuotaRequest)
                {
                    <button class="btn btn-approve" type="button" disabled="@isReviewing" @onclick="ApproveRequest">
                        @(isReviewing ? "กำลังดำเนินการ..." : "อนุมัติ")
                    </button>
                }
            </footer>
        </section>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isCreating;
    private bool isSaving;
    private bool isReviewing;
    private bool isBulkReviewing;
    private bool bulkSucceeded;
    private string? bulkMessage;
    private string bulkRejectRemark = string.Empty;
    private readonly HashSet<long> selectedIds = [];
    private string? loadError;
    private string? saveError;
    private string? reviewError;
    private string searchText = string.Empty;
    private readonly HashSet<string> selectedLeaveTypes = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> selectedStatuses = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<CriteriaFilterOption> LeaveTypeFilterOptions => leaveTypes.Select(x => new CriteriaFilterOption(x.NameTh, x.NameTh)).ToList();
    private static readonly IReadOnlyList<CriteriaFilterOption> StatusFilterOptions = [new("PENDING", "รออนุมัติ"), new("APPROVED", "อนุมัติแล้ว"), new("REJECTED", "ไม่อนุมัติ"), new("CANCELLED", "ยกเลิก")];
    private readonly List<EmployeeQuotaRequestRow> employeeRequests = [];
    private List<Employee> employees = [];
    private List<LeaveTypeDto> leaveTypes = [];
    private List<LeaveQuotaRequestDto> requests = [];
    private List<LeaveQuotaRequestDto> filteredRequests = [];
    private LeaveQuotaRequestDto? selectedRequest;
    private decimal reviewApprovedHours;
    private string reviewRemark = string.Empty;
    private CurrentMicrosoftUserDto? currentUser;
    private HashSet<string> allowedActions = new(StringComparer.OrdinalIgnoreCase);
    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<LeaveQuotaRequestDto> PagedRequests => filteredRequests
        .Skip((Math.Clamp(currentPage, 1, Math.Max(1, (int)Math.Ceiling(filteredRequests.Count / (double)pageSize))) - 1) * pageSize)
        .Take(pageSize);
    private string CurrentEmployeeId => currentUser?.EmployeeId ?? string.Empty;
    private string CurrentEmployeeName => currentUser?.EmployeeName ?? currentUser?.DisplayName ?? string.Empty;
    private bool CanApproveQuotaRequest => allowedActions.Contains("APPROVE") || allowedActions.Contains("VIEW_ALL");
    private bool CanRejectQuotaRequest => allowedActions.Contains("REJECT") || allowedActions.Contains("VIEW_ALL");
    private List<LeaveQuotaRequestDto> PageSelectableRequests => PagedRequests.Where(item => item.Status == "PENDING").ToList();
    private bool AreAllPageItemsSelected => PageSelectableRequests.Count > 0 && PageSelectableRequests.All(item => selectedIds.Contains(item.Id));

    protected override async Task OnInitializedAsync()
    {
        using var pageLoading = LoadingState.BeginRequest();
        try
        {
            currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
            if (currentUser is null || string.IsNullOrWhiteSpace(currentUser.EmployeeId))
                throw new InvalidOperationException("บัญชี Microsoft ยังไม่ได้เชื่อมกับข้อมูลพนักงาน");
            var actionPermissions = await Http.GetFromJsonAsync<CurrentPageActionPermissionsDto>(
                $"api/page-permissions/current-actions?employeeId={Uri.EscapeDataString(CurrentEmployeeId)}&pageKey=LEAVE_REQUEST_QUOTA");
            allowedActions = actionPermissions?.AllowedActions.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
            employees = await Http.GetFromJsonAsync<List<Employee>>("api/employees") ?? [];
            leaveTypes = await Http.GetFromJsonAsync<List<LeaveTypeDto>>("api/leave-types") ?? [];
            await ReloadData();
        }
        catch (Exception exception)
        {
            loadError = $"โหลดข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReloadData()
    {
        requests = await Http.GetFromJsonAsync<List<LeaveQuotaRequestDto>>(
            "api/leave-quota-requests") ?? [];
        Filter();
    }

    private void Filter()
    {
        currentPage = 1;
        filteredRequests = requests.Where(request =>
            (string.IsNullOrWhiteSpace(searchText) ||
             request.RequestNo.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             EmployeeName(request.EmployeeId).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             request.LeaveTypeName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             request.RequestReason.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
            (selectedLeaveTypes.Count == 0 || selectedLeaveTypes.Contains(request.LeaveTypeName)) &&
            (selectedStatuses.Count == 0 || selectedStatuses.Contains(request.Status)))
            .ToList();
        selectedIds.IntersectWith(filteredRequests.Where(item => item.Status == "PENDING").Select(item => item.Id));
    }

    private void Reset()
    {
        searchText = string.Empty; selectedLeaveTypes.Clear(); selectedStatuses.Clear();
        Filter();
    }
    private Task SetLeaveTypeFilters(IReadOnlyCollection<string> values) { selectedLeaveTypes.Clear(); selectedLeaveTypes.UnionWith(values); Filter(); return Task.CompletedTask; }
    private Task SetStatusFilters(IReadOnlyCollection<string> values) { selectedStatuses.Clear(); selectedStatuses.UnionWith(values); Filter(); return Task.CompletedTask; }

    private void OpenCreate()
    {
        employeeRequests.Clear();
        saveError = null;
        isCreating = true;
    }

    private async Task SaveRequest()
    {
        saveError = null;
        if (employeeRequests.Count == 0 ||
            employeeRequests.Any(row =>
                string.IsNullOrWhiteSpace(row.EmployeeId) ||
                row.LeaveTypeId <= 0 ||
                row.RequestedHours <= 0 ||
                string.IsNullOrWhiteSpace(row.RequestReason)))
        {
            saveError = "กรุณาระบุประเภทการลา จำนวนชั่วโมง และเหตุผลของพนักงานแต่ละคนให้ครบถ้วน";
            return;
        }

        if (employeeRequests
            .GroupBy(row => row.EmployeeId, StringComparer.OrdinalIgnoreCase)
            .Any(group => group.Count() > 1))
        {
            saveError = "ไม่สามารถเลือกพนักงานซ้ำในคำขอชุดเดียวกันได้";
            return;
        }

        isSaving = true;
        try
        {
            var request = new CreateMultiEmployeeLeaveQuotaRequest(
                employeeRequests.Select(row =>
                    new LeaveQuotaRequestEmployeeItem(
                        row.EmployeeId,
                        row.LeaveTypeId,
                        row.RequestedHours,
                        row.RequestReason)).ToList(),
                DateTime.Today.Year,
                CurrentEmployeeId,
                CurrentEmployeeName);
            var response = await Http.PostAsJsonAsync("api/leave-quota-requests/batch", request);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                saveError = string.IsNullOrWhiteSpace(details)
                    ? $"ส่งคำขอไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : $"ส่งคำขอไม่สำเร็จ: {details}";
                return;
            }

            await ReloadData();
            isCreating = false;
        }
        catch (Exception exception)
        {
            saveError = $"ส่งคำขอไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CloseCreate()
    {
        if (!isSaving)
            isCreating = false;
    }

    private void OpenRequest(LeaveQuotaRequestDto request)
    {
        selectedRequest = request;
        reviewApprovedHours = request.Status == "PENDING"
            ? request.RequestedHours
            : request.ApprovedHours ?? request.RequestedHours;
        reviewRemark = string.Empty;
        reviewError = null;
    }

    private void CloseRequest()
    {
        if (!isReviewing)
            selectedRequest = null;
    }

    private Task ApproveRequest() => ReviewRequest("approve", "อนุมัติ");

    private Task RejectRequest() => ReviewRequest("reject", "ไม่อนุมัติ");

    private void ToggleItem(long id, bool selected)
    {
        if (selected) selectedIds.Add(id); else selectedIds.Remove(id);
        bulkMessage = null;
    }

    private void ToggleCurrentPage(ChangeEventArgs eventArgs)
    {
        var selected = (bool?)eventArgs.Value == true;
        foreach (var item in PageSelectableRequests)
        {
            if (selected) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id);
        }
        bulkMessage = null;
    }

    private async Task BulkApprove()
    {
        if (!CanApproveQuotaRequest || selectedIds.Count == 0 || isBulkReviewing) return;
        isBulkReviewing = true;
        bulkMessage = null;
        var succeeded = new List<long>();
        var failed = new List<string>();
        foreach (var request in requests.Where(item => selectedIds.Contains(item.Id) && item.Status == "PENDING").ToList())
        {
            try
            {
                var payload = new ReviewLeaveQuotaRequest(request.RequestedHours, string.Empty, CurrentEmployeeId, CurrentEmployeeName);
                var response = await Http.PostAsJsonAsync($"api/leave-quota-requests/{request.Id}/approve", payload);
                if (response.IsSuccessStatusCode) succeeded.Add(request.Id); else failed.Add(request.RequestNo);
            }
            catch { failed.Add(request.RequestNo); }
        }
        selectedIds.ExceptWith(succeeded);
        await ReloadData();
        bulkSucceeded = failed.Count == 0;
        bulkMessage = failed.Count == 0
            ? $"อนุมัติเพิ่มโควต้าเรียบร้อย {succeeded.Count} รายการ"
            : $"สำเร็จ {succeeded.Count} รายการ; ไม่สำเร็จ: {string.Join(", ", failed)}";
        isBulkReviewing = false;
    }

    private async Task BulkReject()
    {
        if (!CanRejectQuotaRequest || selectedIds.Count == 0 || isBulkReviewing || string.IsNullOrWhiteSpace(bulkRejectRemark)) return;
        isBulkReviewing = true;
        bulkMessage = null;
        var succeeded = new List<long>();
        var failed = new List<string>();
        foreach (var request in requests.Where(item => selectedIds.Contains(item.Id) && item.Status == "PENDING").ToList())
        {
            try
            {
                var payload = new ReviewLeaveQuotaRequest(null, bulkRejectRemark.Trim(), CurrentEmployeeId, CurrentEmployeeName);
                var response = await Http.PostAsJsonAsync($"api/leave-quota-requests/{request.Id}/reject", payload);
                if (response.IsSuccessStatusCode) succeeded.Add(request.Id); else failed.Add(request.RequestNo);
            }
            catch { failed.Add(request.RequestNo); }
        }
        selectedIds.ExceptWith(succeeded);
        await ReloadData();
        bulkSucceeded = failed.Count == 0;
        bulkMessage = failed.Count == 0 ? $"ไม่อนุมัติคำขอเพิ่มโควต้าเรียบร้อย {succeeded.Count} รายการ" : $"สำเร็จ {succeeded.Count} รายการ; ไม่สำเร็จ: {string.Join(", ", failed)}";
        if (failed.Count == 0) bulkRejectRemark = string.Empty;
        isBulkReviewing = false;
    }

    private async Task ReviewRequest(string action, string actionText)
    {
        if (selectedRequest is null || isReviewing)
            return;

        reviewError = null;
        if (action == "approve" &&
            (reviewApprovedHours <= 0 || reviewApprovedHours > selectedRequest.RequestedHours))
        {
            reviewError = $"จำนวนที่อนุมัติต้องมากกว่า 0 และไม่เกิน {selectedRequest.RequestedHours:0.##} ชั่วโมง";
            return;
        }
        if (action == "reject" && string.IsNullOrWhiteSpace(reviewRemark))
        {
            reviewError = "กรุณาระบุเหตุผลที่ไม่อนุมัติ";
            return;
        }

        isReviewing = true;
        try
        {
            var payload = new ReviewLeaveQuotaRequest(
                action == "approve" ? reviewApprovedHours : null,
                reviewRemark,
                CurrentEmployeeId,
                CurrentEmployeeName);
            var response = await Http.PostAsJsonAsync(
                $"api/leave-quota-requests/{selectedRequest.Id}/{action}", payload);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                reviewError = string.IsNullOrWhiteSpace(details)
                    ? $"{actionText}ไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : $"{actionText}ไม่สำเร็จ: {details}";
                return;
            }

            selectedRequest = null;
            await ReloadData();
        }
        catch (Exception exception)
        {
            reviewError = $"{actionText}ไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isReviewing = false;
        }
    }

    private void AddEmployee()
    {
        saveError = null;
        if (employeeRequests.Count >= employees.Count)
        {
            saveError = "เพิ่มรายการครบจำนวนพนักงานที่มีอยู่แล้ว";
            return;
        }

        employeeRequests.Add(new EmployeeQuotaRequestRow
        {
            RequestedHours = 8
        });
    }

    private void RemoveEmployee(string employeeId)
    {
        var row = employeeRequests.FirstOrDefault(item =>
            string.Equals(item.EmployeeId, employeeId, StringComparison.OrdinalIgnoreCase));
        if (row is not null)
            employeeRequests.Remove(row);
    }

    private string EmployeeName(string employeeId) =>
        employees.FirstOrDefault(employee => employee.EmployeeCode == employeeId)?.FullName
        ?? employeeId;

    private string EmployeeDepartment(string employeeId) =>
        employees.FirstOrDefault(employee => employee.EmployeeCode == employeeId)?.Department
        ?? "-";

    private IEnumerable<Employee> AvailableEmployeesFor(EmployeeQuotaRequestRow currentRow) =>
        employees.Where(employee =>
            string.Equals(employee.EmployeeCode, currentRow.EmployeeId, StringComparison.OrdinalIgnoreCase) ||
            employeeRequests.All(row =>
                ReferenceEquals(row, currentRow) ||
                !string.Equals(row.EmployeeId, employee.EmployeeCode, StringComparison.OrdinalIgnoreCase)));

    private static string HoursToDays(decimal hours) => (hours / 8).ToString("0.##");
    private static string StatusText(string status) => status switch
    {
        "PENDING" => "รออนุมัติ",
        "APPROVED" => "อนุมัติแล้ว",
        "REJECTED" => "ไม่อนุมัติ",
        "CANCELLED" => "ยกเลิก",
        _ => status
    };
    private static string StatusClass(string status) => status switch
    {
        "APPROVED" => "approved",
        "REJECTED" => "rejected",
        "CANCELLED" => "cancelled",
        _ => "pending"
    };

    private sealed class EmployeeQuotaRequestRow
    {
        public Guid RowId { get; } = Guid.NewGuid();
        public string EmployeeId { get; set; } = string.Empty;
        public long LeaveTypeId { get; set; }
        public decimal RequestedHours { get; set; }
        public string RequestReason { get; set; } = string.Empty;
    }
}
