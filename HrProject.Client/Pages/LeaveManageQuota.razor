@page "/leave/manage-quota"
@inject HttpClient Http

<PageTitle>จัดการโควต้าวันลา | HR Project</PageTitle>

<section class="manage-page quota-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1>จัดการโควต้าวันลา</h1>
                <p>กำหนดและแก้ไขจำนวนชั่วโมงลาของพนักงาน</p>
            </div>
            <button class="btn btn-create" type="button" @onclick="StartCreate">+ กำหนดโควต้า</button>
        </div>
    </header>

    <section class="content-card">
        <div class="content-card-header">
            โควต้าวันลาพนักงาน
            <span class="result-count">@filteredQuotas.Count รายการ</span>
        </div>
        <div class="content-card-body">
            @if (isLoading)
            {
                <div class="state-message">กำลังโหลดข้อมูลโควต้า...</div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="state-message error">@loadError</div>
            }
            else
            {
                <div class="quota-search-grid">
                    <label>
                        ชื่อพนักงาน
                        <input type="search" placeholder="ค้นหาชื่อหรือรหัสพนักงาน"
                               @bind="EmployeeSearch" @bind:event="oninput" />
                    </label>
                    <label>
                        ประเภทการลา
                        <input type="search" placeholder="ค้นหาประเภทการลา"
                               @bind="LeaveTypeSearch" @bind:event="oninput" />
                    </label>
                </div>
                <div class="table-responsive">
                    <table class="table employee-table quota-table">
                        <thead>
                            <tr>
                                <th>ชื่อพนักงาน</th>
                                <th>ประเภทการลา</th>
                                <th>จำนวนคงเหลือ (ชั่วโมง)</th>
                                <th>จำนวนใช้ไปแล้ว (ชั่วโมง)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredQuotas.Count == 0)
                            {
                                <tr><td colspan="5" class="no-results">ไม่พบข้อมูลโควต้าที่ตรงกับคำค้นหา</td></tr>
                            }
                            else
                            {
                                @foreach (var quota in PagedQuotas)
                                {
                                    <tr>
                                        <td>@EmployeeName(quota.EmployeeId)</td>
                                        <td>@quota.LeaveTypeName</td>
                                        <td><strong class="remaining">@quota.RemainingHours.ToString("0.##")</strong></td>
                                        <td>@quota.UsedHours.ToString("0.##")</td>
                                        <td>
                                            <div class="quota-row-actions">
                                                <button class="btn-edit" type="button" @onclick="() => StartEdit(quota)">แก้ไข</button>
                                                <button class="btn-delete" type="button" @onclick="() => RequestDelete(quota)">ลบ</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination TotalItems="@filteredQuotas.Count" @bind-CurrentPage="currentPage" @bind-PageSize="pageSize" />
            }
        </div>
    </section>
</section>

@if (isEditing)
{
    <div class="quota-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="quota-modal-title">
        <section class="quota-modal">
            <header class="quota-modal-header">
                <div>
                    <h2 id="quota-modal-title">@(editingQuotaId.HasValue ? "แก้ไขโควต้าวันลา" : "กำหนดโควต้าวันลา")</h2>
                    <p>หน่วยเป็นชั่วโมง</p>
                </div>
                <button class="modal-close" type="button" aria-label="ปิด" @onclick="CloseModal">×</button>
            </header>
            <div class="quota-modal-body">
                <div class="form-grid">
                    <label>ชื่อพนักงาน
                        <EmployeeSearchSelect Items="employees"
                                              @bind-Value="quotaEmployeeId"
                                              Disabled="@editingQuotaId.HasValue" />
                    </label>
                    <label>ประเภทการลา
                        <select @bind="quotaLeaveTypeId" disabled="@editingQuotaId.HasValue">
                            <option value="0">-- เลือกประเภทการลา --</option>
                            @foreach (var type in leaveTypes)
                            {
                                <option value="@type.Id">@type.NameTh</option>
                            }
                        </select>
                    </label>
                    <label>โควต้ารวม (ชั่วโมง)
                        <input type="number" min="0" step="0.5" @bind="quotaHours" />
                    </label>
                    <label>ใช้ไปแล้ว (ชั่วโมง)
                        <input value="@usedHours.ToString("0.##")" disabled />
                    </label>
                    <label class="full-width">คงเหลือ (ชั่วโมง)
                        <input class="remaining-input" value="@RemainingPreview.ToString("0.##")" disabled />
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <div class="save-error" role="alert">@saveError</div>
                }
            </div>
            <footer class="quota-modal-footer">
                <button class="btn btn-reset" type="button" @onclick="CloseModal">ปิด</button>
                <button class="btn btn-create" type="button" disabled="@isSaving" @onclick="SaveQuota">
                    @(isSaving ? "กำลังบันทึก..." : "บันทึก")
                </button>
            </footer>
        </section>
    </div>
}

@if (deletingQuota is not null)
{
    <div class="quota-modal-overlay delete-confirm-overlay" role="dialog" aria-modal="true"
         aria-labelledby="delete-quota-title">
        <section class="delete-quota-dialog">
            <h2 id="delete-quota-title">ยืนยันการลบโควต้าวันลา</h2>
            <p>
                ต้องการลบโควต้า <strong>@deletingQuota.LeaveTypeName</strong><br />
                ของ <strong>@EmployeeName(deletingQuota.EmployeeId)</strong> ปี @deletingQuota.QuotaYear ใช่หรือไม่
            </p>
            <p class="delete-quota-note">การลบนี้ไม่ลบข้อมูลพนักงานและเอกสารการลา</p>
            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <div class="save-error" role="alert">@deleteError</div>
            }
            <div class="delete-quota-actions">
                <button class="btn btn-reset" type="button" disabled="@isDeleting" @onclick="CancelDelete">ไม่ลบ</button>
                <button class="btn btn-danger" type="button" disabled="@isDeleting" @onclick="DeleteQuota">
                    @(isDeleting ? "กำลังลบ..." : "ลบโควต้า")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isEditing;
    private bool isSaving;
    private bool isDeleting;
    private string? loadError;
    private string? saveError;
    private string? deleteError;
    private List<Employee> employees = [];
    private List<LeaveTypeDto> leaveTypes = [];
    private List<LeaveQuotaDto> quotas = [];
    private List<LeaveQuotaDto> filteredQuotas = [];
    private Dictionary<string, string> employeeNames = new(StringComparer.OrdinalIgnoreCase);
    private string employeeSearch = string.Empty;
    private string leaveTypeSearch = string.Empty;
    private string EmployeeSearch
    {
        get => employeeSearch;
        set
        {
            employeeSearch = value;
            ApplyFilters();
        }
    }
    private string LeaveTypeSearch
    {
        get => leaveTypeSearch;
        set
        {
            leaveTypeSearch = value;
            ApplyFilters();
        }
    }
    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<LeaveQuotaDto> PagedQuotas => filteredQuotas
        .Skip((Math.Clamp(currentPage, 1, Math.Max(1, (int)Math.Ceiling(filteredQuotas.Count / (double)pageSize))) - 1) * pageSize)
        .Take(pageSize);
    private long? editingQuotaId;
    private string quotaEmployeeId = string.Empty;
    private long quotaLeaveTypeId;
    private decimal quotaHours;
    private decimal usedHours;
    private LeaveQuotaDto? deletingQuota;
    private CurrentMicrosoftUserDto? currentUser;
    private decimal RemainingPreview => quotaHours - usedHours;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
            employees = await Http.GetFromJsonAsync<List<Employee>>("api/employees") ?? [];
            employeeNames = employees.ToDictionary(
                employee => employee.EmployeeCode,
                employee => employee.FullName,
                StringComparer.OrdinalIgnoreCase);
            leaveTypes = await Http.GetFromJsonAsync<List<LeaveTypeDto>>("api/leave-types") ?? [];
            await ReloadQuotas();
        }
        catch (Exception exception)
        {
            loadError = $"โหลดข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReloadQuotas()
    {
        quotas = await Http.GetFromJsonAsync<List<LeaveQuotaDto>>(
            $"api/leave-quotas?year={DateTime.Today.Year}") ?? [];
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var employeeTerm = employeeSearch.Trim();
        var leaveTypeTerm = leaveTypeSearch.Trim();
        filteredQuotas = quotas.Where(quota =>
            (employeeTerm.Length == 0 ||
             quota.EmployeeId.Contains(employeeTerm, StringComparison.OrdinalIgnoreCase) ||
             EmployeeName(quota.EmployeeId).Contains(employeeTerm, StringComparison.OrdinalIgnoreCase)) &&
            (leaveTypeTerm.Length == 0 ||
             quota.LeaveTypeName.Contains(leaveTypeTerm, StringComparison.OrdinalIgnoreCase)))
            .ToList();
        currentPage = 1;
    }

    private void StartCreate()
    {
        editingQuotaId = null;
        quotaEmployeeId = string.Empty;
        quotaLeaveTypeId = 0;
        quotaHours = usedHours = 0;
        saveError = null;
        isEditing = true;
    }

    private void StartEdit(LeaveQuotaDto quota)
    {
        editingQuotaId = quota.Id;
        quotaEmployeeId = quota.EmployeeId;
        quotaLeaveTypeId = quota.LeaveTypeId;
        quotaHours = quota.QuotaHours;
        usedHours = quota.UsedHours;
        saveError = null;
        isEditing = true;
    }

    private async Task SaveQuota()
    {
        saveError = null;
        if (string.IsNullOrWhiteSpace(quotaEmployeeId) || quotaLeaveTypeId <= 0 || quotaHours < 0)
        {
            saveError = "กรุณาเลือกพนักงาน ประเภทการลา และระบุโควต้า";
            return;
        }
        if (RemainingPreview < 0)
        {
            saveError = "โควต้าต้องไม่น้อยกว่าจำนวนชั่วโมงที่ใช้ไปแล้ว";
            return;
        }

        isSaving = true;
        try
        {
            var request = new SaveLeaveQuotaRequest(
                quotaEmployeeId,
                quotaLeaveTypeId,
                DateTime.Today.Year,
                quotaHours,
                null,
                currentUser?.EmployeeId ?? string.Empty,
                currentUser?.EmployeeName ?? currentUser?.DisplayName ?? string.Empty);
            var response = await Http.PostAsJsonAsync("api/leave-quotas", request);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                saveError = string.IsNullOrWhiteSpace(details)
                    ? $"บันทึกไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : $"บันทึกไม่สำเร็จ: {details}";
                return;
            }

            await ReloadQuotas();
            isEditing = false;
        }
        catch (Exception exception)
        {
            saveError = $"บันทึกไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CloseModal()
    {
        if (!isSaving)
            isEditing = false;
    }

    private void RequestDelete(LeaveQuotaDto quota)
    {
        deletingQuota = quota;
        deleteError = null;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
            deletingQuota = null;
    }

    private async Task DeleteQuota()
    {
        if (deletingQuota is null)
            return;

        isDeleting = true;
        deleteError = null;
        try
        {
            var actorId = Uri.EscapeDataString(currentUser?.EmployeeId ?? string.Empty);
            var actorName = Uri.EscapeDataString(currentUser?.EmployeeName ?? currentUser?.DisplayName ?? string.Empty);
            var response = await Http.DeleteAsync(
                $"api/leave-quotas/{deletingQuota.Id}?actionBy={actorId}&actionByName={actorName}");
            if (!response.IsSuccessStatusCode)
            {
                deleteError = response.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "ไม่พบโควต้าที่ต้องการลบ อาจถูกลบไปแล้ว"
                    : $"ลบโควต้าไม่สำเร็จ (HTTP {(int)response.StatusCode})";
                return;
            }

            deletingQuota = null;
            await ReloadQuotas();
        }
        catch (Exception exception)
        {
            deleteError = $"ลบโควต้าไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private string EmployeeName(string employeeId) =>
        employeeNames.GetValueOrDefault(employeeId, employeeId);
}
