@page "/leave/team"
@using System.Net.Http.Json
@using HrProject.Shared.Models
@inject HttpClient Http

<PageTitle>หัวหน้าแจ้งลาลูกน้อง | HR Project</PageTitle>

<section class="manage-page manager-notification-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1>หัวหน้าแจ้งลาลูกน้อง</h1>
                <p>แจ้งข้อมูลให้พนักงานในความดูแลทางอีเมล โดยไม่สร้างเอกสารลาและไม่ตัดโควตา</p>
            </div>
        </div>
    </header>

    <div class="notice-banner">
        <span class="notice-icon">i</span>
        <div>
            <strong>การแจ้งข้อมูลเท่านั้น</strong>
            <p>รายชื่อนี้แสดงเฉพาะผู้ที่มี Boss หรือ Reporting To (Leave Approve) เป็นคุณ ข้อมูลที่ส่งจะไม่เข้าสู่กระบวนการอนุมัติเอกสารลา</p>
        </div>
    </div>

    <section class="content-card send-card">
        <div class="content-card-header">ส่งข้อมูลแจ้งลา</div>
        <div class="content-card-body">
            @if (isLoading)
            {
                <div class="state-message">กำลังโหลดรายชื่อพนักงาน...</div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="state-message error">@loadError</div>
            }
            else if (recipients.Count == 0)
            {
                <div class="state-message">ไม่พบพนักงานที่มี Boss หรือ Reporting To (Leave Approve) เป็นคุณ</div>
            }
            else
            {
                <div class="form-grid">
                    <label class="full-width">เลือกลูกน้อง<span class="required">*</span>
                        <select @bind="recipientEmployeeId" @bind:after="RecipientChanged">
                            <option value="">-- เลือกพนักงาน --</option>
                            @foreach (var recipient in recipients)
                            {
                                <option value="@recipient.EmployeeId">
                                    @recipient.EmployeeName (@recipient.EmployeeId) — @recipient.Department
                                </option>
                            }
                        </select>
                    </label>

                    @if (SelectedRecipient is not null)
                    {
                        <div class="recipient-preview full-width">
                            <div class="recipient-avatar">@Initial(SelectedRecipient.EmployeeName)</div>
                            <div>
                                <strong>@SelectedRecipient.EmployeeName</strong>
                                <span>@SelectedRecipient.Position · @SelectedRecipient.Department</span>
                                <span>@SelectedRecipient.Email</span>
                            </div>
                            <div class="relation-tags">
                                @if (SelectedRecipient.IsDirectBoss)
                                {
                                    <span>Boss</span>
                                }
                                @if (SelectedRecipient.IsLeaveApprover)
                                {
                                    <span>Reporting To</span>
                                }
                            </div>
                        </div>
                    }

                    <label class="full-width">วันที่ขอลา<span class="required">*</span>
                        <input type="date" @bind="leaveDate" />
                    </label>
                    <label>เวลาเริ่มต้น<span class="required">*</span>
                        <input type="time" @bind="startTime" />
                    </label>
                    <label>เวลาสิ้นสุด<span class="required">*</span>
                        <input type="time" @bind="endTime" />
                    </label>
                    <label class="full-width">จำนวนชั่วโมง<span class="required">*</span>
                        <input type="number" min="0.5" max="24" step="0.5" @bind="leaveHours" />
                    </label>
                    <label class="full-width">หมายเหตุ
                        <textarea rows="5" @bind="note" maxlength="4000"
                                  placeholder="ระบุหมายเหตุเพิ่มเติม (ถ้ามี)"></textarea>
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <div class="save-message error" role="alert">@saveError</div>
                }
                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="save-message success" role="status">@successMessage</div>
                }

                <div class="form-actions">
                    <button class="btn btn-reset" type="button" disabled="@isSending" @onclick="() => ResetForm()">ล้างข้อมูล</button>
                    <button class="btn btn-send" type="button" disabled="@isSending" @onclick="SendNotification">
                        @(isSending ? "กำลังส่ง..." : "ส่งอีเมลแจ้งข้อมูล")
                    </button>
                </div>
            }
        </div>
    </section>

    <section class="content-card history-card">
        <div class="content-card-header">
            ประวัติการแจ้งของฉัน
            <span class="result-count">@notifications.Count รายการ</span>
        </div>
        <div class="content-card-body">
            <div class="table-responsive">
                <table class="notification-table">
                    <thead>
                        <tr>
                            <th>เลขที่รายการ</th>
                            <th>ลูกน้อง</th>
                            <th>วันที่ขอลา</th>
                            <th>ช่วงเวลา</th>
                            <th>จำนวนชั่วโมง</th>
                            <th>หมายเหตุ</th>
                            <th>สถานะอีเมล</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!isLoading && notifications.Count == 0)
                        {
                            <tr><td colspan="7" class="no-results">ยังไม่มีประวัติการแจ้งข้อมูล</td></tr>
                        }
                        else
                        {
                            @foreach (var item in PagedNotifications)
                            {
                                <tr title="@item.Note">
                                    <td><strong>@item.NotificationNo</strong></td>
                                    <td>
                                        <strong>@item.RecipientName</strong>
                                        <small>@item.RecipientEmail</small>
                                    </td>
                                    <td>@item.LeaveDate.ToString("dd/MM/yyyy")</td>
                                    <td>@TimeRange(item)</td>
                                    <td>@(item.LeaveHours.HasValue ? $"{item.LeaveHours:0.##} ชั่วโมง" : "-")</td>
                                    <td><span class="subject-cell">@(string.IsNullOrWhiteSpace(item.Note) ? "-" : item.Note)</span></td>
                                    <td>
                                        <span class="email-status @StatusClass(item.EmailStatus)">@StatusText(item.EmailStatus)</span>
                                        @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                                        {
                                            <small class="email-error" title="@item.ErrorMessage">ส่งไม่สำเร็จ</small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <Pagination TotalItems="@notifications.Count" @bind-CurrentPage="currentPage" @bind-PageSize="pageSize" />
        </div>
    </section>
</section>

@code {
    private readonly List<ManagerNotificationRecipientDto> recipients = [];
    private readonly List<ManagerLeaveNotificationDto> notifications = [];
    private bool isLoading = true;
    private bool isSending;
    private string loadError = string.Empty;
    private string saveError = string.Empty;
    private string successMessage = string.Empty;
    private string recipientEmployeeId = string.Empty;
    private DateOnly leaveDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly startTime = new(9, 0);
    private TimeOnly endTime = new(18, 0);
    private decimal leaveHours = 8;
    private string note = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;

    private ManagerNotificationRecipientDto? SelectedRecipient =>
        recipients.FirstOrDefault(x => x.EmployeeId == recipientEmployeeId);

    private IEnumerable<ManagerLeaveNotificationDto> PagedNotifications =>
        notifications.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var recipientTask = Http.GetFromJsonAsync<List<ManagerNotificationRecipientDto>>(
                "api/manager-leave-notifications/recipients");
            var historyTask = Http.GetFromJsonAsync<List<ManagerLeaveNotificationDto>>(
                "api/manager-leave-notifications");
            await Task.WhenAll(recipientTask, historyTask);
            recipients.AddRange(await recipientTask ?? []);
            notifications.AddRange(await historyTask ?? []);
        }
        catch (Exception exception)
        {
            loadError = $"โหลดข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RecipientChanged()
    {
        saveError = string.Empty;
        successMessage = string.Empty;
    }

    private async Task SendNotification()
    {
        saveError = string.Empty;
        successMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(recipientEmployeeId))
        {
            saveError = "กรุณาเลือกลูกน้อง";
            return;
        }
        if (endTime <= startTime)
        {
            saveError = "เวลาสิ้นสุดต้องมากกว่าเวลาเริ่มต้น";
            return;
        }
        if (leaveHours <= 0 || leaveHours > 24)
        {
            saveError = "จำนวนชั่วโมงต้องมากกว่า 0 และไม่เกิน 24 ชั่วโมง";
            return;
        }

        isSending = true;
        try
        {
            var request = new CreateManagerLeaveNotificationRequest(
                recipientEmployeeId, leaveDate, startTime, endTime, leaveHours, note.Trim());
            var response = await Http.PostAsJsonAsync("api/manager-leave-notifications", request);
            if (!response.IsSuccessStatusCode)
            {
                saveError = (await response.Content.ReadAsStringAsync()).Trim('"');
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<ManagerLeaveNotificationDto>();
            if (created is not null)
            {
                notifications.Insert(0, created);
                currentPage = 1;
                successMessage = $"ส่งอีเมลเรียบร้อยแล้ว เลขที่รายการ {created.NotificationNo}";
            }
            ResetForm(false);
        }
        catch (Exception exception)
        {
            saveError = $"ส่งข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSending = false;
        }
    }

    private void ResetForm(bool clearMessages = true)
    {
        recipientEmployeeId = string.Empty;
        leaveDate = DateOnly.FromDateTime(DateTime.Today);
        startTime = new TimeOnly(9, 0);
        endTime = new TimeOnly(18, 0);
        leaveHours = 8;
        note = string.Empty;
        saveError = string.Empty;
        if (clearMessages)
            successMessage = string.Empty;
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString();

    private static string TimeRange(ManagerLeaveNotificationDto item) =>
        item.StartTime.HasValue || item.EndTime.HasValue
            ? $"{item.StartTime?.ToString("HH:mm") ?? "-"} - {item.EndTime?.ToString("HH:mm") ?? "-"}"
            : "ไม่ระบุเวลา";

    private static string StatusClass(string status) => status.ToUpperInvariant() switch
    {
        "SENT" => "sent",
        "FAILED" => "failed",
        _ => "pending"
    };

    private static string StatusText(string status) => status.ToUpperInvariant() switch
    {
        "SENT" => "ส่งแล้ว",
        "FAILED" => "ส่งไม่สำเร็จ",
        _ => "กำลังส่ง"
    };
}
