@page "/employees/edit-requests"
@inject HttpClient Http

<PageTitle>ขอแก้ไขข้อมูลพนักงาน | HR Project</PageTitle>

<section class="manage-page employee-request-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1>ขอแก้ไขข้อมูลพนักงาน</h1>
                <p>เอกสารคำขอแก้ไขข้อมูลพนักงานและสถานะการดำเนินการ</p>
            </div>
        </div>
    </header>

    <section class="content-card criteria-card">
        <div class="content-card-header">ค้นหาเอกสาร</div>
        <div class="content-card-body">
            <div class="request-criteria">
                <label>คำค้นหา
                    <input @bind="searchText" @bind:event="oninput" @bind:after="ResetPaging"
                           placeholder="เลขที่เอกสาร พนักงาน เหตุผล หรือข้อมูลที่แก้ไข" />
                </label>
                <div class="criteria-filter"><span>สถานะ</span>
                    <CriteriaMultiSelect Options="@StatusFilterOptions" Values="@selectedStatuses" ValuesChanged="SetStatusFilters" />
                </div>
                <button class="reset-filter" type="button" @onclick="ResetFilter">ล้างข้อมูล</button>
            </div>
        </div>
    </section>

    <section class="content-card">
        <div class="content-card-header">
            เอกสารขอแก้ไขข้อมูลพนักงาน
            <span class="result-count">@FilteredRequests.Count รายการ</span>
        </div>
        <div class="content-card-body">
            @if (isLoading)
            {
                <div class="request-state">กำลังโหลดเอกสาร...</div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="request-state error">@loadError</div>
            }
            else
            {
                @if (CanBulkApprove || CanBulkReject)
                {
                    <div class="bulk-toolbar">
                        @if (!string.IsNullOrWhiteSpace(bulkMessage))
                        {
                            <span class="bulk-message @(bulkSucceeded ? "success" : "error")">@bulkMessage</span>
                        }
                        @if (CanBulkApprove)
                        {
                            <button class="approve-request" type="button" disabled="@(selectedIds.Count == 0 || isBulkReviewing)" @onclick="BulkApprove">
                                @(isBulkReviewing ? "กำลังอนุมัติ..." : $"อนุมัติที่เลือก ({selectedIds.Count})")
                            </button>
                        }
                        @if (CanBulkReject)
                        {
                            <button class="reject-request" type="button" disabled="@(selectedIds.Count == 0 || isBulkReviewing || string.IsNullOrWhiteSpace(bulkRejectRemark))" @onclick="BulkReject">
                                @(isBulkReviewing ? "กำลังดำเนินการ..." : $"ไม่อนุมัติที่เลือก ({selectedIds.Count})")
                            </button>
                        }
                        <input class="bulk-reason" @bind="bulkRejectRemark" placeholder="เหตุผลที่ไม่อนุมัติรายการที่เลือก" />
                    </div>
                }
                <div class="table-responsive">
                    <table class="employee-edit-request-table">
                        <thead>
                            <tr>
                                @if (CanBulkApprove || CanBulkReject)
                                {
                                    <th class="select-column"><input type="checkbox" aria-label="เลือกทั้งหมดในหน้านี้" checked="@AreAllPageItemsSelected" @onchange="ToggleCurrentPage" /></th>
                                }
                                <th>เลขที่เอกสาร</th>
                                <th>พนักงาน</th>
                                <th>ข้อมูลที่ขอแก้ไข</th>
                                <th>เหตุผล</th>
                                <th>ผู้ขอ</th>
                                <th>วันที่ขอ</th>
                                <th>สถานะ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredRequests.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(CanBulkApprove || CanBulkReject ? 8 : 7)" class="request-state">ไม่พบเอกสารขอแก้ไขข้อมูลพนักงาน</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var request in PagedRequests)
                                {
                                    <tr>
                                        @if (CanBulkApprove || CanBulkReject)
                                        {
                                            <td class="select-column"><input type="checkbox" aria-label="เลือก @request.RequestNo" disabled="@(request.Status != "PENDING")" checked="@selectedIds.Contains(request.Id)" @onchange="eventArgs => ToggleItem(request.Id, (bool?)eventArgs.Value == true)" /></td>
                                        }
                                        <td>
                                            <button class="request-number" type="button"
                                                    @onclick="() => OpenRequest(request)">
                                                @request.RequestNo
                                            </button>
                                        </td>
                                        <td>
                                            <strong>@request.EmployeeName</strong>
                                            <small>@EmployeeCodeFormat.Display(request.EmployeeId)</small>
                                        </td>
                                        <td>
                                            <div class="change-tags">
                                                @foreach (var change in request.Changes)
                                                {
                                                    <span>@change.FieldName</span>
                                                }
                                            </div>
                                        </td>
                                        <td><span class="reason-text" title="@request.RequestReason">@request.RequestReason</span></td>
                                        <td>@request.RequestedByName</td>
                                        <td>@request.RequestedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="request-status @StatusClass(request.Status)" data-status="@request.Status">@StatusText(request.Status)</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination TotalItems="@FilteredRequests.Count" @bind-CurrentPage="currentPage" @bind-PageSize="pageSize" />
            }
        </div>
    </section>
</section>

@if (selectedRequest is not null)
{
    <div class="request-detail-overlay" role="dialog" aria-modal="true"
         aria-labelledby="request-detail-title">
        <section class="request-detail-modal">
            <header>
                <div>
                    <h2 id="request-detail-title">@selectedRequest.RequestNo</h2>
                    <p>@EmployeeCodeFormat.Display(selectedRequest.EmployeeId) · @selectedRequest.EmployeeName</p>
                </div>
                <button type="button" aria-label="ปิด" disabled="@isReviewing"
                        @onclick="CloseRequest">×</button>
            </header>
            <div class="request-detail-body">
                <div class="request-document-info">
                    <span><strong>พนักงาน:</strong> @selectedRequest.EmployeeName</span>
                    <span><strong>รหัส:</strong> @EmployeeCodeFormat.Display(selectedRequest.EmployeeId)</span>
                    <span><strong>ผู้ขอแก้ไข:</strong> @selectedRequest.RequestedByName</span>
                    <span><strong>วันที่ขอ:</strong> @selectedRequest.RequestedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                    <span><strong>สถานะ:</strong> <span class="request-status @StatusClass(selectedRequest.Status)" data-status="@selectedRequest.Status">@StatusText(selectedRequest.Status)</span></span>
                </div>
                <label class="request-reason-detail">
                    เหตุผลในการขอแก้ไข
                    <textarea rows="3" disabled>@selectedRequest.RequestReason</textarea>
                </label>
                <h3>ข้อมูลที่ขอแก้ไข</h3>
                <div class="change-sections">
                    @foreach (var changeSection in GroupedChanges(selectedRequest))
                    {
                        <section class="request-change-section">
                            <h4>@changeSection.Title</h4>
                            <div class="section-comparison-grid">
                                <section class="employee-comparison-card current">
                                    <h5>ข้อมูลปัจจุบัน</h5>
                                    @foreach (var change in changeSection.Changes)
                                    {
                                        <label>
                                            <span>@change.FieldName</span>
                                            @if (IsProfileImageChange(change))
                                            {
                                                <div class="profile-change-preview current-image">
                                                    @if (string.IsNullOrWhiteSpace(change.OldValue))
                                                    {
                                                        <span>ไม่มีรูปโปรไฟล์</span>
                                                    }
                                                    else
                                                    {
                                                        <img src="@change.OldValue" alt="รูปโปรไฟล์ปัจจุบัน" />
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <input value="@change.OldValue" disabled />
                                            }
                                        </label>
                                    }
                                </section>
                                <section class="employee-comparison-card requested">
                                    <h5>ข้อมูลที่ขอแก้ไข</h5>
                                    @foreach (var change in changeSection.Changes)
                                    {
                                        <label class="field-changed">
                                            <span>
                                                @change.FieldName
                                                <small>มีการเปลี่ยนแปลง</small>
                                            </span>
                                            @if (IsProfileImageChange(change))
                                            {
                                                <div class="profile-change-preview requested-image">
                                                    <img src="@change.NewValue" alt="รูปโปรไฟล์ที่ขอแก้ไข" />
                                                </div>
                                            }
                                            else
                                            {
                                                <input value="@change.NewValue" disabled />
                                            }
                                        </label>
                                    }
                                </section>
                            </div>
                        </section>
                    }
                </div>
                @if (selectedRequest.Status == "PENDING")
                {
                    <label class="review-remark">หมายเหตุการพิจารณา
                        <textarea rows="3" @bind="reviewRemark"
                                  placeholder="ระบุหมายเหตุ (ถ้ามี)"></textarea>
                    </label>
                }
                @if (!string.IsNullOrWhiteSpace(reviewMessage))
                {
                    <div class="review-message @(reviewSucceeded ? "success" : "error")"
                         role="status">@reviewMessage</div>
                }
            </div>
            <footer>
                <button class="close-request" type="button" disabled="@isReviewing"
                        @onclick="CloseRequest">ปิด</button>
                @if (selectedRequest.Status == "PENDING")
                {
                    <button class="reject-request" type="button" disabled="@isReviewing"
                            @onclick="() => ReviewRequest(false)">
                        @(isReviewing ? "กำลังดำเนินการ..." : "ไม่อนุมัติ")
                    </button>
                    <button class="approve-request" type="button" disabled="@isReviewing"
                            @onclick="() => ReviewRequest(true)">
                        @(isReviewing ? "กำลังดำเนินการ..." : "อนุมัติ")
                    </button>
                }
            </footer>
        </section>
    </div>
}

@code {
    private bool isLoading = true;
    private string? loadError;
    private string searchText = string.Empty;
    private readonly HashSet<string> selectedStatuses = new(StringComparer.OrdinalIgnoreCase);
    private static readonly IReadOnlyList<CriteriaFilterOption> StatusFilterOptions =
        [new("PENDING", "รออนุมัติ"), new("APPROVED", "อนุมัติแล้ว"), new("REJECTED", "ไม่อนุมัติ"), new("CANCELLED", "ยกเลิก")];
    private List<EmployeeEditRequestDto> requests = [];
    private int currentPage = 1;
    private int pageSize = 10;
    private EmployeeEditRequestDto? selectedRequest;
    private bool isReviewing;
    private bool reviewSucceeded;
    private string reviewRemark = string.Empty;
    private string? reviewMessage;
    private CurrentMicrosoftUserDto? currentUser;
    private HashSet<string> allowedActions = new(StringComparer.OrdinalIgnoreCase);
    private bool isBulkReviewing;
    private bool bulkSucceeded;
    private string? bulkMessage;
    private string bulkRejectRemark = string.Empty;
    private readonly HashSet<long> selectedIds = [];
    private bool CanBulkApprove => allowedActions.Contains("APPROVE");
    private bool CanBulkReject => allowedActions.Contains("REJECT");

    private List<EmployeeEditRequestDto> FilteredRequests => requests.Where(request =>
        (selectedStatuses.Count == 0 || selectedStatuses.Contains(request.Status)) &&
        (string.IsNullOrWhiteSpace(searchText) ||
         request.RequestNo.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         request.EmployeeId.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         request.EmployeeName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         request.RequestReason.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         request.Changes.Any(change =>
             change.FieldName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             change.OldValue.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             change.NewValue.Contains(searchText, StringComparison.OrdinalIgnoreCase))))
        .ToList();
    private IEnumerable<EmployeeEditRequestDto> PagedRequests
    {
        get
        {
            var filtered = FilteredRequests;
            var safePage = Math.Clamp(currentPage, 1, Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)pageSize)));
            return filtered.Skip((safePage - 1) * pageSize).Take(pageSize);
        }
    }
    private List<EmployeeEditRequestDto> PageSelectableRequests => PagedRequests.Where(item => item.Status == "PENDING").ToList();
    private bool AreAllPageItemsSelected => PageSelectableRequests.Count > 0 && PageSelectableRequests.All(item => selectedIds.Contains(item.Id));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
            if (currentUser is null || string.IsNullOrWhiteSpace(currentUser.EmployeeId))
                throw new InvalidOperationException("บัญชี Microsoft ยังไม่ได้เชื่อมกับข้อมูลพนักงาน");
            var permissions = await Http.GetFromJsonAsync<CurrentPageActionPermissionsDto>(
                $"api/page-permissions/current-actions?employeeId={Uri.EscapeDataString(currentUser.EmployeeId)}&pageKey=EMPLOYEE_EDIT_REQUESTS");
            allowedActions = permissions?.AllowedActions.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
            requests = await Http.GetFromJsonAsync<List<EmployeeEditRequestDto>>(
                "api/employee-edit-requests") ?? [];
        }
        catch (Exception exception)
        {
            loadError = $"โหลดเอกสารไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetFilter()
    {
        currentPage = 1;
        searchText = string.Empty;
        selectedStatuses.Clear();
    }

    private void ResetPaging() => currentPage = 1;

    private Task SetStatusFilters(IReadOnlyCollection<string> values)
    {
        selectedStatuses.Clear(); selectedStatuses.UnionWith(values); ResetPaging();
        return Task.CompletedTask;
    }

    private void OpenRequest(EmployeeEditRequestDto request)
    {
        selectedRequest = request;
        reviewRemark = string.Empty;
        reviewMessage = null;
    }

    private void CloseRequest()
    {
        if (!isReviewing)
            selectedRequest = null;
    }

    private async Task ReviewRequest(bool approve)
    {
        if (selectedRequest is null || selectedRequest.Status != "PENDING")
            return;

        isReviewing = true;
        reviewMessage = null;
        try
        {
            var action = approve ? "approve" : "reject";
            var review = new ReviewEmployeeEditRequest(
                currentUser!.EmployeeId,
                currentUser.EmployeeName,
                reviewRemark);
            var response = await Http.PutAsJsonAsync(
                $"api/employee-edit-requests/{selectedRequest.Id}/{action}",
                review);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                reviewSucceeded = false;
                reviewMessage = string.IsNullOrWhiteSpace(details)
                    ? $"ดำเนินการไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : $"ดำเนินการไม่สำเร็จ: {details}";
                return;
            }

            var updated = await response.Content.ReadFromJsonAsync<EmployeeEditRequestDto>();
            if (updated is not null)
            {
                var index = requests.FindIndex(item => item.Id == updated.Id);
                if (index >= 0)
                    requests[index] = updated;
                selectedRequest = updated;
            }

            reviewSucceeded = true;
            reviewMessage = approve
                ? "อนุมัติเอกสารเรียบร้อยแล้ว"
                : "ไม่อนุมัติเอกสารเรียบร้อยแล้ว";
        }
        catch (Exception exception)
        {
            reviewSucceeded = false;
            reviewMessage = $"ดำเนินการไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isReviewing = false;
        }
    }

    private void ToggleItem(long id, bool selected)
    {
        if (selected) selectedIds.Add(id); else selectedIds.Remove(id);
        bulkMessage = null;
    }

    private void ToggleCurrentPage(ChangeEventArgs eventArgs)
    {
        var selected = (bool?)eventArgs.Value == true;
        foreach (var item in PageSelectableRequests)
        {
            if (selected) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id);
        }
        bulkMessage = null;
    }

    private async Task BulkApprove()
    {
        if (!CanBulkApprove || selectedIds.Count == 0 || isBulkReviewing || currentUser is null) return;
        isBulkReviewing = true;
        bulkMessage = null;
        var succeeded = new List<long>();
        var failed = new List<string>();
        foreach (var request in requests.Where(item => selectedIds.Contains(item.Id) && item.Status == "PENDING").ToList())
        {
            try
            {
                var payload = new ReviewEmployeeEditRequest(currentUser.EmployeeId, currentUser.EmployeeName, string.Empty);
                var response = await Http.PutAsJsonAsync($"api/employee-edit-requests/{request.Id}/approve", payload);
                if (response.IsSuccessStatusCode) succeeded.Add(request.Id); else failed.Add(request.RequestNo);
            }
            catch { failed.Add(request.RequestNo); }
        }
        selectedIds.ExceptWith(succeeded);
        requests = await Http.GetFromJsonAsync<List<EmployeeEditRequestDto>>("api/employee-edit-requests") ?? [];
        bulkSucceeded = failed.Count == 0;
        bulkMessage = failed.Count == 0
            ? $"อนุมัติคำขอแก้ไขข้อมูลเรียบร้อย {succeeded.Count} รายการ"
            : $"สำเร็จ {succeeded.Count} รายการ; ไม่สำเร็จ: {string.Join(", ", failed)}";
        isBulkReviewing = false;
    }

    private async Task BulkReject()
    {
        if (!CanBulkReject || selectedIds.Count == 0 || isBulkReviewing || currentUser is null || string.IsNullOrWhiteSpace(bulkRejectRemark)) return;
        isBulkReviewing = true;
        bulkMessage = null;
        var succeeded = new List<long>();
        var failed = new List<string>();
        foreach (var request in requests.Where(item => selectedIds.Contains(item.Id) && item.Status == "PENDING").ToList())
        {
            try
            {
                var payload = new ReviewEmployeeEditRequest(currentUser.EmployeeId, currentUser.EmployeeName, bulkRejectRemark.Trim());
                var response = await Http.PutAsJsonAsync($"api/employee-edit-requests/{request.Id}/reject", payload);
                if (response.IsSuccessStatusCode) succeeded.Add(request.Id); else failed.Add(request.RequestNo);
            }
            catch { failed.Add(request.RequestNo); }
        }
        selectedIds.ExceptWith(succeeded);
        requests = await Http.GetFromJsonAsync<List<EmployeeEditRequestDto>>("api/employee-edit-requests") ?? [];
        bulkSucceeded = failed.Count == 0;
        bulkMessage = failed.Count == 0 ? $"ไม่อนุมัติคำขอแก้ไขข้อมูลเรียบร้อย {succeeded.Count} รายการ" : $"สำเร็จ {succeeded.Count} รายการ; ไม่สำเร็จ: {string.Join(", ", failed)}";
        if (failed.Count == 0) bulkRejectRemark = string.Empty;
        isBulkReviewing = false;
    }

    private static IReadOnlyList<EmployeeChangeSection> GroupedChanges(
        EmployeeEditRequestDto request)
    {
        var sectionDefinitions = new (string Key, string Title)[]
        {
            ("basic", "ข้อมูลพื้นฐาน"),
            ("personal", "ข้อมูลส่วนบุคคล"),
            ("internal", "ข้อมูลภายในบริษัท"),
            ("work", "ประวัติการทำงาน"),
            ("education", "ประวัติการศึกษา"),
            ("training", "ประวัติการอบรม & สัมมนา"),
            ("family", "บันทึกค่าลดหย่อนภาษี")
        };

        return sectionDefinitions
            .Select(section => new EmployeeChangeSection(
                section.Title,
                request.Changes
                    .Where(change => ChangeSectionKey(change.FieldKey) == section.Key)
                    .ToList()))
            .Where(section => section.Changes.Count > 0)
            .ToList();
    }

    private static string ChangeSectionKey(string fieldKey)
    {
        var separator = fieldKey.IndexOf('.');
        return separator > 0 ? fieldKey[..separator] : "basic";
    }

    private static bool IsProfileImageChange(EmployeeFieldChangeDto change) =>
        string.Equals(change.FieldKey, "profileImage", StringComparison.OrdinalIgnoreCase);

    private static string StatusText(string status) => status switch
    {
        "PENDING" => "รออนุมัติ",
        "APPROVED" => "อนุมัติแล้ว",
        "REJECTED" => "ไม่อนุมัติ",
        "CANCELLED" => "ยกเลิก",
        _ => status
    };

    private static string StatusClass(string status) => status switch
    {
        "APPROVED" => "approved",
        "REJECTED" => "rejected",
        "CANCELLED" => "cancelled",
        _ => "pending"
    };

    private sealed record EmployeeChangeSection(
        string Title,
        IReadOnlyList<EmployeeFieldChangeDto> Changes);
}
