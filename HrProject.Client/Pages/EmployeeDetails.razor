    private static DateOnly? ParseDate(string value) =>
        DateOnly.TryParse(value, out var parsed) ? parsed : null;
    private static bool ParseBool(string value) => bool.TryParse(value, out var parsed) && parsed;
    private static List<T> DeserializeList<T>(string value)
    {
        try { return System.Text.Json.JsonSerializer.Deserialize<List<T>>(value) ?? []; }
        catch (System.Text.Json.JsonException) { return []; }
    }

    private IReadOnlyList<EmployeeEditRequestAttachmentDto> ExistingAttachments =>
        editingRequest?.Attachments.Where(item => !removedEditRequestAttachmentIds.Contains(item.Id)).ToList() ?? [];
    private bool IsEditRequestReadOnly => editingRequest is not null && editingRequest.Status != "PENDING";
    private void RemoveExistingAttachment(long id) => removedEditRequestAttachmentIds.Add(id);

    private async Task SaveDirectChanges()
    {
        if (employee is null)
            return;

        editError = null;
        switch (editActiveTab)
        {
            case "personal":
                employee.Nickname = proposedNickname.Trim();
                employee.PersonalMobile = proposedPersonalMobile.Trim();
                employee.HomePhone = proposedHomePhone.Trim();
                employee.MacAddress = personalMacAddress.Trim();
                employee.CurrentAddress = personalCurrentAddress.Trim();
                employee.EmergencyContactName = personalEmergencyContactName.Trim();
                employee.EmergencyContactPhone = personalEmergencyContactPhone.Trim();
                employee.EmergencyContactAddress = personalEmergencyContactAddress.Trim();
                break;
            case "internal":
                employee.LotusNotesEmail = proposedLotusNotesEmail.Trim();
                employee.Email = proposedEmail.Trim();
                employee.Company = internalCompany.Trim();
                employee.BusinessUnit = internalBusinessUnit.Trim();
                employee.Department = internalDepartment.Trim();
                employee.Position = internalPosition.Trim();
                employee.SupervisorName = internalSupervisorName.Trim();
                employee.SupervisorEmployeeId = internalSupervisorEmployeeId.Trim();
                employee.LeaveApproverName = internalLeaveApproverName.Trim();
                employee.LeaveApproverEmployeeId = internalLeaveApproverEmployeeId.Trim();
                employee.BuddyName = internalBuddyName.Trim();
                employee.WorkSchedule = internalWorkSchedule.Trim();
                employee.InternalExtension = internalExtension.Trim();
                employee.DirectPhone = internalDirectPhone.Trim();
                employee.CompanyMobile = internalCompanyMobile.Trim();
                employee.BranchName = internalBranchName.Trim();
                employee.ResponsibilityProvinces = [.. internalResponsibilityProvinces];
                employee.ResponsibilityProvince = JoinProvinceValues(internalResponsibilityProvinces);
                employee.ChecklistType = internalChecklistType.Trim();
                employee.ProductsResponsible = internalProductsResponsible.Trim();
                employee.StartDate = proposedStartDate;
                employee.WorkExperienceType = internalWorkExperienceType.Trim();
                employee.HasCompanyParking = ParseOptionalBoolean(internalHasCompanyParking);
                employee.CanTravelUpcountry = ParseOptionalBoolean(internalCanTravelUpcountry);
                employee.EmployeeStatus = internalEmployeeStatus.Trim();
                employee.ExcludeAttendanceCalculation = internalExcludeAttendanceCalculation;
                break;
            case "training":
                employee.TrainingHistory = editableTrainingHistory;
                break;
            case "work":
                employee.WorkHistory = editableWorkHistory;
                break;
            case "accounting":
                employee.SocialSecurityNumber = accountingSocialSecurityNumber.Trim();
                employee.TaxpayerIdentificationNumber = accountingTaxpayerIdentificationNumber.Trim();
                employee.SalaryAccountNumber = accountingSalaryAccountNumber.Trim();
                break;
            case "family":
                employee.FamilyPhone = familyPhone.Trim();
                employee.CurrentAddressMapUrl = familyCurrentAddressMapUrl.Trim();
                break;
        }

        isSubmittingEdit = true;
        try
        {
            var endpoint = editActiveTab == "internal"
                ? $"api/employees/{employee.Id}/company?actorEmployeeId={Uri.EscapeDataString(currentUser?.EmployeeId ?? string.Empty)}"
                : $"api/employees/{employee.Id}/direct/{editActiveTab}";
            var response = await Http.PutAsJsonAsync(endpoint, employee);
            if (!response.IsSuccessStatusCode)
            {
                editError = $"บันทึกข้อมูลไม่สำเร็จ: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            employee = await response.Content.ReadFromJsonAsync<Employee>() ?? employee;
            isEditRequestOpen = false;
            actionMessage = $"บันทึก{TabLabel(editActiveTab)}เรียบร้อยแล้ว";
        }
        catch (Exception exception)
        {
            editError = $"บันทึกข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSubmittingEdit = false;
        }
    }

