    private void CloseEditRequest()
    {
        if (!isSubmittingEdit)
            isEditRequestOpen = false;
    }

    private async Task SaveDirectChanges()
    {
        if (employee is null || isRequestMode)
            return;

        editError = null;
        switch (editActiveTab)
        {
            case "basic":
                employee.Nickname = proposedNickname.Trim();
                employee.PersonalMobile = proposedPersonalMobile.Trim();
                employee.HomePhone = proposedHomePhone.Trim();
                break;
            case "personal":
                employee.CurrentAddress = personalCurrentAddress.Trim();
                employee.EmergencyContactName = personalEmergencyContactName.Trim();
                employee.EmergencyContactPhone = personalEmergencyContactPhone.Trim();
                employee.EmergencyContactAddress = personalEmergencyContactAddress.Trim();
                break;
            case "training":
                employee.TrainingHistory = editableTrainingHistory;
                break;
            case "family":
                employee.FamilyPhone = familyPhone.Trim();
                employee.CurrentAddressMapUrl = familyCurrentAddressMapUrl.Trim();
                break;
        }

        isSubmittingEdit = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/employees/{employee.Id}/self-service", employee);
            if (!response.IsSuccessStatusCode)
            {
                editError = $"บันทึกข้อมูลไม่สำเร็จ: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            employee = await response.Content.ReadFromJsonAsync<Employee>() ?? employee;
            isEditRequestOpen = false;
            actionMessage = $"บันทึก{TabLabel(editActiveTab)}เรียบร้อยแล้ว";
        }
        catch (Exception exception)
        {
            editError = $"บันทึกข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSubmittingEdit = false;
        }
    }

    private async Task SubmitEditRequest()
    {
        if (employee is null)
            return;

        editError = null;
        var changes = new List<EmployeeFieldChangeDto>();
        switch (editActiveTab)
        {
            case "basic":
                AddChange(changes, "title", "คำนำหน้าชื่อ", employee.Title, proposedTitle);
                AddChange(changes, "firstName", "ชื่อ", employee.FirstName, proposedFirstName);
                AddChange(changes, "lastName", "นามสกุล", employee.LastName, proposedLastName);
                AddChange(changes, "thaiFullName", "ชื่อ-นามสกุล (ไทย)", employee.ThaiFullName, proposedThaiFullName);
                AddChange(changes, "englishFullName", "ชื่อ-นามสกุล (อังกฤษ)", employee.EnglishFullName, proposedEnglishFullName);
                AddChange(changes, "email", "อีเมล", employee.Email, proposedEmail);
                break;
            case "personal":
                AddOptionalChange(changes, "personal.nationalId", "เลขบัตรประชาชน", personalNationalId);
                AddOptionalChange(changes, "personal.birthDate", "วันเกิด", personalBirthDate?.ToString("yyyy-MM-dd") ?? string.Empty);
                AddOptionalChange(changes, "personal.gender", "เพศ", personalGender);
                AddChange(changes, "personal.religion", "ศาสนา", employee.Religion, personalReligion);
                AddChange(changes, "personal.bloodType", "หมู่เลือด", employee.BloodType, personalBloodType);
                AddChange(changes, "personal.residenceProvince", "จังหวัดที่พักอาศัย", employee.ResidenceProvince, personalResidenceProvince);
                AddChange(changes, "personal.idCardAddress", "ที่อยู่ตามบัตรประชาชน", employee.IdCardAddress, personalIdCardAddress);
                AddChange(changes, "personal.houseRegistrationAddress", "ที่อยู่ตามทะเบียนบ้าน", employee.HouseRegistrationAddress, personalHouseRegistrationAddress);
                break;
            case "work":
                AddTableChange(changes, "work.history", "รายการประวัติการทำงาน", employee.WorkHistory, editableWorkHistory);
                break;
            case "education":
                AddTableChange(changes, "education.history", "รายการประวัติการศึกษา", employee.EducationHistory, editableEducationHistory);
                break;
            case "family":
                AddChange(changes, "family.maritalStatus", "สถานภาพการสมรส", employee.MaritalStatus, familyMaritalStatus);
                AddChange(changes, "family.spouseName", "ชื่อ-นามสกุลคู่สมรส", employee.SpouseName, familySpouseName);
                AddChange(changes, "family.spouseNationalId", "เลขบัตรประชาชนคู่สมรส", employee.SpouseNationalId, familySpouseNationalId);
                break;
        }

        if (changes.Count == 0 || string.IsNullOrWhiteSpace(editReason))
        {
            editError = "กรุณาแก้ไขข้อมูลอย่างน้อย 1 รายการและระบุเหตุผล";
            return;
        }

        if (changes.Any(change => string.IsNullOrWhiteSpace(change.NewValue)))
        {
            editError = "ข้อมูลที่ขอแก้ไขต้องไม่เป็นค่าว่าง";
            return;
        }

        isSubmittingEdit = true;
        try
        {
            var request = new CreateEmployeeEditRequest(
                employee.EmployeeCode,
                employee.FullName,
                changes,
                editReason,
                "EMP-001",
                "Anan Sukjai");
            var response = await Http.PostAsJsonAsync("api/employee-edit-requests", request);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                editError = string.IsNullOrWhiteSpace(details)
                    ? $"ส่งคำขอไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : $"ส่งคำขอไม่สำเร็จ: {details}";
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<EmployeeEditRequestDto>();
            isEditRequestOpen = false;
            actionMessage = $"สร้างเอกสารคำขอแก้ไข {created?.RequestNo} เรียบร้อยแล้ว";
        }
        catch (Exception exception)
        {
            editError = $"ส่งคำขอไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSubmittingEdit = false;
        }
    }

    private static void AddChange(
        ICollection<EmployeeFieldChangeDto> changes,
        string fieldKey,
        string fieldName,
        string oldValue,
        string newValue)
    {
        var normalizedNewValue = newValue?.Trim() ?? string.Empty;
        if (!string.Equals(oldValue, normalizedNewValue, StringComparison.Ordinal))
            changes.Add(new EmployeeFieldChangeDto(fieldKey, fieldName, oldValue, normalizedNewValue));
    }

    private static void AddOptionalChange(
        ICollection<EmployeeFieldChangeDto> changes,
        string fieldKey,
        string fieldName,
        string newValue)
    {
        var normalizedNewValue = newValue?.Trim() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(normalizedNewValue))
        {
            changes.Add(new EmployeeFieldChangeDto(
                fieldKey,
                fieldName,
                "ยังไม่มีข้อมูล",
                normalizedNewValue));
        }
    }

    private static void AddTableChange<T>(
        ICollection<EmployeeFieldChangeDto> changes,
        string fieldKey,
        string fieldName,
        IReadOnlyCollection<T> oldItems,
        IReadOnlyCollection<T> newItems)
    {
        var oldJson = System.Text.Json.JsonSerializer.Serialize(oldItems);
        var newJson = System.Text.Json.JsonSerializer.Serialize(newItems);
        if (!string.Equals(oldJson, newJson, StringComparison.Ordinal))
            changes.Add(new EmployeeFieldChangeDto(fieldKey, fieldName, oldJson, newJson));
    }

    private static List<T> CloneList<T>(IReadOnlyCollection<T> items) =>
        System.Text.Json.JsonSerializer.Deserialize<List<T>>(
            System.Text.Json.JsonSerializer.Serialize(items)) ?? [];

    private void AddEditableWork() => editableWorkHistory.Add(new EmployeeWorkHistoryItem());
    private void AddEditableEducation() => editableEducationHistory.Add(new EmployeeEducationItem());
    private void AddEditableTraining() => editableTrainingHistory.Add(new EmployeeTrainingItem());

    private static bool CanDirectEdit(string tab) => tab is "basic" or "personal" or "training" or "family";
    private static bool CanRequestEdit(string tab) => tab is "basic" or "personal" or "work" or "education" or "family";

    private static string TabLabel(string tab) =>
        Tabs.FirstOrDefault(item => item.Key == tab).Label ?? "ข้อมูลพนักงาน";

    private static string TabPolicyDescription(string tab) => tab switch
    {
        "basic" => "ชื่อเล่นและข้อมูลติดต่อแก้ได้ทันที ส่วนชื่อและอีเมลต้องขออนุมัติ",
        "personal" => "ที่อยู่ปัจจุบันและผู้ติดต่อฉุกเฉินแก้ได้ทันที ข้อมูลระบุตัวตนต้องขออนุมัติ",
        "internal" => "ข้อมูลการจ้างงานและโครงสร้างบริษัทจัดการโดย HR",
        "work" => "การเพิ่ม แก้ไข หรือลบประวัติการทำงานต้องขออนุมัติ",
        "education" => "การเพิ่ม แก้ไข หรือลบประวัติการศึกษาต้องขออนุมัติ",
        "training" => "พนักงานเพิ่ม แก้ไข และลบประวัติการอบรมได้ทันที",
        "family" => "ข้อมูลติดต่อแก้ได้ทันที ส่วนข้อมูลคู่สมรสต้องขออนุมัติ",
        _ => string.Empty
    };

    private static string Initials(Employee value)
    {
        var first = string.IsNullOrWhiteSpace(value.FirstName) ? string.Empty : value.FirstName[..1];
        var last = string.IsNullOrWhiteSpace(value.LastName) ? string.Empty : value.LastName[..1];
        return $"{first}{last}".ToUpperInvariant();
    }

    private static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateOnly date) => date.ToString("dd/MM/yyyy");

    private static string FormatDate(DateOnly? date) =>
        date?.ToString("dd/MM/yyyy") ?? "-";

    private static string ParkingText(bool? hasParking) => hasParking switch
    {
        true => "มี",
        false => "ไม่มี",
        null => "-"
    };

    private static string ParkingEditValue(bool? hasParking) => hasParking switch
    {
        true => "มี",
        false => "ไม่มี",
        null => string.Empty
    };

    private static string BooleanText(bool? value, string trueText, string falseText) => value switch
    {
        true => trueText,
        false => falseText,
        null => "-"
    };

    private static string MoneyText(decimal value) => $"{value:N2} บาท";
}
