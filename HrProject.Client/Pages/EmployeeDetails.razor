                </section>
                @if (!IsDirectEdit)
                {
                <label class="edit-reason">เหตุผลที่ขอแก้ไข
                    <textarea rows="3" @bind="editReason" placeholder="ระบุเหตุผลในการขอแก้ไขข้อมูล"></textarea>
                </label>
                <section class="edit-request-attachments">
                    <div class="edit-request-attachment-heading">
                        <div><strong>เอกสารแนบ</strong><small>PDF, JPG, PNG หรือ WEBP · สูงสุด 5 ไฟล์ · ไฟล์ละไม่เกิน 3 MB</small></div>
                        <label class="edit-request-file-button">+ เลือกไฟล์
                            <InputFile @key="editAttachmentInputVersion" OnChange="SelectEditRequestAttachments"
                                       multiple accept=".pdf,.jpg,.jpeg,.png,.webp" />
                        </label>
                    </div>
                    @if (editingRequest is not null && ExistingAttachments.Count > 0)
                    {
                        <div class="edit-request-attachment-list existing-files">
                            @foreach (var attachment in ExistingAttachments)
                            {
                                <div>
                                    <a href="@($"/api/employee-edit-requests/{editingRequest.Id}/attachments/{attachment.Id}")"
                                       target="_blank" title="@attachment.FileName">@attachment.FileName</a>
                                    <small>@FormatFileSize(attachment.FileSizeBytes)</small>
                                    @if (!IsEditRequestReadOnly)
                                    {
                                        <button type="button" aria-label="ลบไฟล์" @onclick="() => RemoveExistingAttachment(attachment.Id)">×</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (editRequestAttachments.Count > 0)
                    {
                        <div class="edit-request-attachment-list">
                            @foreach (var attachment in editRequestAttachments)
                            {
                                <div><span title="@attachment.FileName">@attachment.FileName</span><small>@FormatFileSize(attachment.Content.LongLength)</small><button type="button" aria-label="ลบไฟล์" @onclick="() => RemoveEditRequestAttachment(attachment)">×</button></div>
                            }
                        </div>
                    }
                </section>
                }
                @if (!string.IsNullOrWhiteSpace(editError))
                {
                    <div class="edit-error" role="alert">@editError</div>
                }
            </div>
            <footer class="employee-edit-modal-footer">
                <button class="cancel-edit-button" type="button"
                        disabled="@isSubmittingEdit" @onclick="CloseEditRequest">ปิด</button>
                @if (!IsEditRequestReadOnly)
                {
                    <button class="submit-edit-button" type="button" disabled="@isSubmittingEdit" @onclick="SubmitEditor">
                        @(isSubmittingEdit ? "กำลังบันทึก..." : IsDirectEdit ? "บันทึกข้อมูล" : editingRequest is null ? "ส่งคำขอแก้ไข" : "บันทึกการแก้ไข")
                    </button>
                }
            </footer>
        </section>
    </div>
}

@if (isLoading)
{
    <div class="loading-overlay" role="status" aria-live="polite">
        <div class="loading-dialog">
            <span class="loading-dialog-title">Loading...</span>
            <p class="loading-dialog-message">กำลังโหลดข้อมูลพนักงาน...</p>
        </div>
    </div>
}

