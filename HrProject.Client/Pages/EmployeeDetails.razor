                                    <label>โทรศัพท์บ้าน<input @bind="proposedHomePhone" /></label>
                                    <label>MAC Address<input @bind="personalMacAddress" /></label>
                                    <label>บุคคลติดต่อกรณีฉุกเฉิน<input @bind="personalEmergencyContactName" /></label>
                                    <label>เบอร์ติดต่อฉุกเฉิน<input @bind="personalEmergencyContactPhone" /></label>
                                    <label class="wide-field">ที่อยู่ผู้ติดต่อฉุกเฉิน<textarea rows="3" @bind="personalEmergencyContactAddress"></textarea></label>
                                }
                            </div>
                            break;
                        case "internal":
                            <div class="employee-edit-grid">
                                <label>Email for Lotus Notes<input @bind="proposedLotusNotesEmail" /></label>
                                <label>Email<input type="email" @bind="proposedEmail" /></label>
                                <label>บริษัท<MasterDataSearchSelect Items="@(MasterOptions("COMPANY").ToList())" Value="@internalCompany" ValueChanged="value => internalCompany = value" Placeholder="-- เลือกหรือพิมพ์ค้นหาบริษัท --" /></label>
                                <label>Business Unit<MasterDataSearchSelect Items="@(MasterOptions("BUSINESS_UNIT").ToList())" Value="@internalBusinessUnit" ValueChanged="InternalBusinessUnitSelected" Placeholder="-- เลือกหรือพิมพ์ค้นหา Business Unit --" /></label>
                                <label>แผนก<MasterDataSearchSelect Items="@(InternalDepartmentOptions.ToList())" Value="@internalDepartment" ValueChanged="InternalDepartmentSelected" Disabled="@string.IsNullOrWhiteSpace(internalBusinessUnit)" Placeholder="-- เลือกหรือพิมพ์ค้นหาแผนก --" /></label>
                                <label>ตำแหน่ง<MasterDataSearchSelect Items="@(InternalPositionOptions.ToList())" Value="@internalPosition" ValueChanged="value => internalPosition = value" Disabled="@string.IsNullOrWhiteSpace(internalDepartment)" Placeholder="-- เลือกหรือพิมพ์ค้นหาตำแหน่ง --" /></label>
                                <label>หัวหน้างาน
                                    <RemoteEmployeeSearchSelect Value="@internalSupervisorEmployeeId"
                                                                ValueChanged="value => internalSupervisorEmployeeId = value"
                                                                EmployeeChanged="SelectInternalSupervisor"
                                                                SelectedDisplayText="@ManagerDisplayText(internalSupervisorName, internalSupervisorEmployeeId)"
                                                                ExcludeEmployeeCode="@(employee?.EmployeeCode ?? string.Empty)"
                                                                Placeholder="-- เลือกหรือพิมพ์ค้นหาหัวหน้างาน --" />
