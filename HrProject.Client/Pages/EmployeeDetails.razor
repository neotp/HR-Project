    private static void AddTableChange<T>(
        ICollection<EmployeeFieldChangeDto> changes,
        string fieldKey,
        string fieldName,
        IReadOnlyCollection<T> oldItems,
        IReadOnlyCollection<T> newItems)
    {
        var oldJson = System.Text.Json.JsonSerializer.Serialize(oldItems);
        var newJson = System.Text.Json.JsonSerializer.Serialize(newItems);
        if (!string.Equals(oldJson, newJson, StringComparison.Ordinal))
            changes.Add(new EmployeeFieldChangeDto(fieldKey, fieldName, oldJson, newJson));
    }

