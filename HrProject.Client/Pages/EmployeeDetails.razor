                                            <label>ตำบล / แขวง<SearchableSelect><select @bind="personalHouseRegistrationSubdistrict" @bind:after="PersonalHouseSubdistrictChanged" disabled="@(personalHouseRegistrationSameAsCurrent || string.IsNullOrWhiteSpace(personalHouseRegistrationDistrict))"><option value="">-- เลือก --</option>@foreach (var item in PersonalHouseSubdistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                            <label>รหัสไปรษณีย์<SearchableSelect><select @bind="personalHouseRegistrationPostalCode" disabled="@(personalHouseRegistrationSameAsCurrent || string.IsNullOrWhiteSpace(personalHouseRegistrationSubdistrict))"><option value="">-- เลือก --</option>@foreach (var item in PersonalHousePostalCodeOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
