                AddChange(changes, "internal.extension", "Ext. ภายใน", employee.InternalExtension, internalExtension);
                AddChange(changes, "internal.directPhone", "เบอร์โทรสายตรง", employee.DirectPhone, internalDirectPhone);
                AddChange(changes, "internal.companyMobile", "เบอร์มือถือบริษัท", employee.CompanyMobile, internalCompanyMobile);
                AddChange(changes, "internal.macAddress", "MAC Address", employee.MacAddress, internalMacAddress);
                AddChange(changes, "internal.branchCode", "รหัสสาขา", employee.BranchCode, internalBranchCode);
                AddChange(changes, "internal.branchName", "ชื่อสาขา", employee.BranchName, internalBranchName);
                AddChange(changes, "internal.responsibilityProvince", "จังหวัดที่ให้ดูแล", employee.ResponsibilityProvince, internalResponsibilityProvince);
                AddChange(changes, "internal.checklistType", "ประเภท Checklist", employee.ChecklistType, internalChecklistType);
                AddChange(changes, "internal.productsResponsible", "สินค้าที่ให้ขาย", employee.ProductsResponsible, internalProductsResponsible);
                AddChange(changes, "internal.startDate", "วันที่เริ่มงาน", DateText(employee.StartDate), DateText(proposedStartDate));
                AddChange(changes, "internal.appointmentDate", "วันที่บรรจุ", DateText(employee.AppointmentDate), DateText(internalAppointmentDate));
                AddChange(changes, "internal.providentFundStartDate", "วันที่เปิดกองทุนเงินสะสม", DateText(employee.ProvidentFundStartDate), DateText(internalProvidentFundStartDate));
                AddChange(changes, "internal.workExperienceType", "ประสบการณ์การทำงาน", employee.WorkExperienceType, internalWorkExperienceType);
                AddChange(changes, "internal.hasCompanyParking", "บริษัทมีที่จอดรถให้", BooleanText(employee.HasCompanyParking), BooleanText(ParseOptionalBoolean(internalHasCompanyParking)));
                AddChange(changes, "internal.employeeStatus", "สถานะพนักงาน", employee.EmployeeStatus, internalEmployeeStatus);
                AddChange(changes, "internal.excludeAttendance", "การคำนวณการมาทำงาน", employee.ExcludeAttendanceCalculation.ToString(), internalExcludeAttendanceCalculation.ToString());
                break;
            case "work":
                AddTableChange(changes, "work.history", "รายการประวัติการทำงาน", employee.WorkHistory, editableWorkHistory);
                break;
            case "education":
                AddTableChange(changes, "education.history", "รายการประวัติการศึกษา", employee.EducationHistory, editableEducationHistory);
                break;
            case "training":
                AddTableChange(changes, "training.history", "รายการประวัติการอบรมและสัมมนา", employee.TrainingHistory, editableTrainingHistory);
                break;
            case "family":
                AddChange(changes, "family.maritalStatus", "สถานภาพการสมรส", employee.MaritalStatus, familyMaritalStatus);
                AddChange(changes, "family.spouseName", "ชื่อ-นามสกุลคู่สมรส", employee.SpouseName, familySpouseName);
                AddChange(changes, "family.spouseNationalId", "เลขบัตรประชาชนคู่สมรส", employee.SpouseNationalId, familySpouseNationalId);
                AddChange(changes, "family.phone", "เบอร์โทรศัพท์ครอบครัว", employee.FamilyPhone, familyPhone);
                AddChange(changes, "family.currentAddressMapUrl", "URL แผนที่อยู่ปัจจุบัน", employee.CurrentAddressMapUrl, familyCurrentAddressMapUrl);
                break;
        }

        if (changes.Count == 0 || string.IsNullOrWhiteSpace(editReason))
        {
            editError = "กรุณาแก้ไขข้อมูลอย่างน้อย 1 รายการและระบุเหตุผล";
            return;
        }

        isSubmittingEdit = true;
        try
        {
            var request = new CreateEmployeeEditRequest(
                employee.EmployeeCode,
                employee.FullName,
                changes,
                editReason,
                currentUser?.EmployeeId ?? employee.EmployeeCode,
                currentUser?.EmployeeName ?? currentUser?.DisplayName ?? employee.FullName);
            var response = await Http.PostAsJsonAsync("api/employee-edit-requests", request);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                editError = string.IsNullOrWhiteSpace(details)
                    ? $"ส่งคำขอไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : $"ส่งคำขอไม่สำเร็จ: {details}";
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<EmployeeEditRequestDto>();
            isEditRequestOpen = false;
            actionMessage = $"สร้างเอกสารคำขอแก้ไข {created?.RequestNo} เรียบร้อยแล้ว";
        }
        catch (Exception exception)
        {
            editError = $"ส่งคำขอไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSubmittingEdit = false;
        }
    }

    private static void AddChange(
        ICollection<EmployeeFieldChangeDto> changes,
        string fieldKey,
        string fieldName,
        string oldValue,
        string newValue)
    {
        var normalizedNewValue = newValue?.Trim() ?? string.Empty;
        if (!string.Equals(oldValue, normalizedNewValue, StringComparison.Ordinal))
            changes.Add(new EmployeeFieldChangeDto(fieldKey, fieldName, oldValue, normalizedNewValue));
    }

    private async Task UploadProposedProfileImage(InputFileChangeEventArgs eventArgs)
    {
        editError = null;
        var file = eventArgs.File;
        var allowedTypes = new[] { "image/jpeg", "image/png", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            editError = "กรุณาเลือกไฟล์รูป JPG, PNG หรือ WEBP เท่านั้น";
            return;
        }

        if (file.Size > MaxProfileImageBytes)
        {
            editError = "รูปโปรไฟล์ต้องมีขนาดไม่เกิน 2 MB";
            return;
        }

        try
        {
            await using var input = file.OpenReadStream(MaxProfileImageBytes);
            using var memory = new MemoryStream();
            await input.CopyToAsync(memory);
            proposedProfileImageDataUrl =
                $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
        }
        catch (Exception exception)
        {
            editError = $"อ่านไฟล์รูปไม่สำเร็จ: {exception.Message}";
        }
    }

    private void ResetProposedProfileImage()
    {
        if (employee is not null)
            proposedProfileImageDataUrl = employee.ProfileImageDataUrl;
    }

    private static void AddOptionalChange(
        ICollection<EmployeeFieldChangeDto> changes,
        string fieldKey,
        string fieldName,
        string newValue)
    {
        var normalizedNewValue = newValue?.Trim() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(normalizedNewValue))
        {
            changes.Add(new EmployeeFieldChangeDto(
                fieldKey,
                fieldName,
                "ยังไม่มีข้อมูล",
                normalizedNewValue));
        }
    }

    private static void AddTableChange<T>(
        ICollection<EmployeeFieldChangeDto> changes,
        string fieldKey,
        string fieldName,
        IReadOnlyCollection<T> oldItems,
        IReadOnlyCollection<T> newItems)
    {
        var oldJson = System.Text.Json.JsonSerializer.Serialize(oldItems);
        var newJson = System.Text.Json.JsonSerializer.Serialize(newItems);
        if (!string.Equals(oldJson, newJson, StringComparison.Ordinal))
            changes.Add(new EmployeeFieldChangeDto(fieldKey, fieldName, oldJson, newJson));
    }

    private static List<T> CloneList<T>(IReadOnlyCollection<T> items) =>
        System.Text.Json.JsonSerializer.Deserialize<List<T>>(
            System.Text.Json.JsonSerializer.Serialize(items)) ?? [];

