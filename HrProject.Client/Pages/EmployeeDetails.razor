        {
            value.CurrentAddress?.Trim(),
            string.IsNullOrWhiteSpace(value.ResidenceSubdistrict) ? null : $"ตำบล/แขวง {value.ResidenceSubdistrict.Trim()}",
            string.IsNullOrWhiteSpace(value.ResidenceDistrict) ? null : $"อำเภอ/เขต {value.ResidenceDistrict.Trim()}",
            string.IsNullOrWhiteSpace(value.ResidenceProvince) ? null : $"จังหวัด {value.ResidenceProvince.Trim()}",
            value.ResidencePostalCode?.Trim()
        };
        var address = string.Join(" ", parts.Where(part => !string.IsNullOrWhiteSpace(part)));
        return DisplayValue(address);
    }

    private static string FormatDate(DateOnly date) => date.ToString("dd/MM/yyyy");

    private static string FormatDate(DateOnly? date) =>
        date?.ToString("dd/MM/yyyy") ?? "-";

    private static string ParkingText(bool? hasParking) => hasParking switch
    {
        true => "มี",
        false => "ไม่มี",
        null => "-"
    };

    private static string ParkingEditValue(bool? hasParking) => hasParking switch
    {
        true => "มี",
        false => "ไม่มี",
        null => string.Empty
    };

    private static string BooleanEditValue(bool? value) => value switch
    {
        true => "True",
        false => "False",
        null => string.Empty
    };

    private static bool? ParseOptionalBoolean(string value) => value switch
    {
        "มี" or "True" or "true" => true,
        "ไม่มี" or "False" or "false" => false,
        _ => null
    };

    private static string BooleanText(bool? value, string trueText, string falseText) => value switch
    {
        true => trueText,
        false => falseText,
        null => "-"
    };

    private static string MoneyText(decimal value) => $"{value:N2} บาท";
}
