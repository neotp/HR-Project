    private static readonly (string Key, string Label)[] Tabs =
    [
        ("basic", "ข้อมูลพื้นฐาน"),
        ("personal", "ข้อมูลส่วนบุคคล"),
        ("internal", "ข้อมูลภายในบริษัท"),
        ("work", "ประวัติการทำงาน"),
        ("education", "ประวัติการศึกษา"),
        ("training", "ประวัติการอบรม & สัมมนา"),
        ("family", "ประวัติครอบครัว")
    ];

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        employee = null;
        activeTab = "basic";
        try
        {
            employee = await Http.GetFromJsonAsync<Employee>($"api/employees/{Id}");
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            employee = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BackToList() => Navigation.NavigateTo("/");

    private void OpenEditor(bool requestMode)
    {
        if (employee is null)
            return;

        if (requestMode && !CanRequestEdit(activeTab) ||
            !requestMode && !CanDirectEdit(activeTab))
            return;

        isRequestMode = requestMode;

        proposedTitle = employee.Title;
        proposedFirstName = employee.FirstName;
        proposedLastName = employee.LastName;
        proposedThaiFullName = employee.ThaiFullName;
        proposedEnglishFullName = employee.EnglishFullName;
        proposedNickname = employee.Nickname;
        proposedEmail = employee.Email;
        proposedPersonalMobile = employee.PersonalMobile;
        proposedHomePhone = employee.HomePhone;
        proposedStartDate = employee.StartDate;
        editActiveTab = activeTab;
        personalNationalId = string.Empty;
        personalBirthDate = null;
        personalGender = string.Empty;
        personalReligion = employee.Religion;
        personalBloodType = employee.BloodType;
        personalResidenceProvince = employee.ResidenceProvince;
        personalCurrentAddress = employee.CurrentAddress;
        personalIdCardAddress = employee.IdCardAddress;
        personalHouseRegistrationAddress = employee.HouseRegistrationAddress;
        personalEmergencyContactName = employee.EmergencyContactName;
        personalEmergencyContactPhone = employee.EmergencyContactPhone;
        personalEmergencyContactAddress = employee.EmergencyContactAddress;
        internalCompany = employee.Company;
        internalBusinessUnit = employee.BusinessUnit;
        internalDivision = employee.Division;
        internalDepartment = employee.Department;
        internalSection = employee.Section;
        internalPosition = employee.Position;
        internalJobCode = employee.JobCode;
        internalSupervisorName = employee.SupervisorName;
