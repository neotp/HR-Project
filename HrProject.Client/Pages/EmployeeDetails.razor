@page "/employees/{Id:int}"
@inject HttpClient Http
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>@(employee is null ? "ข้อมูลพนักงาน" : employee.FullName) | HR Project</PageTitle>

<section class="manage-page employee-details-page">
    @if (isLoading)
    {
        <div class="detail-state">กำลังโหลดข้อมูลพนักงาน...</div>
    }
    else if (employee is null)
    {
        <section class="content-card detail-state">
            <h1>ไม่พบข้อมูลพนักงาน</h1>
            <p>ไม่พบพนักงานตามรหัสที่ระบุ</p>
            <button class="back-button" type="button" @onclick="BackToList">กลับหน้ารายชื่อ</button>
        </section>
    }
    else
    {
        <header class="employee-profile-header">
            <button class="back-link" type="button" @onclick="BackToList">‹ กลับหน้ารายชื่อพนักงาน</button>
            <div class="profile-summary">
                @if (string.IsNullOrWhiteSpace(employee.ProfileImageDataUrl))
                {
                    <div class="employee-avatar" aria-hidden="true">@Initials(employee)</div>
                }
                else
                {
                    <img class="employee-avatar employee-photo"
                         src="@employee.ProfileImageDataUrl"
                         alt="รูปของ @employee.FullName" />
                }
                <div class="profile-name">
                    <span class="employee-code">@EmployeeCodeFormat.Display(employee.EmployeeCode)</span>
                    <h1>@employee.FullName</h1>
                    <p>@employee.Position · @employee.Department</p>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(actionMessage))
        {
            <div class="employee-action-message" role="status">@actionMessage</div>
        }

        <section class="content-card employee-detail-card">
            <nav class="employee-tabs" aria-label="หมวดข้อมูลพนักงาน">
                @foreach (var tab in VisibleTabs)
                {
                    <button type="button"
                            class="employee-tab @(activeTab == tab.Key ? "active" : null)"
                            @onclick="() => activeTab = tab.Key">
                        @tab.Label
                    </button>
                }
            </nav>

            <div class="tab-edit-actions">
                <span class="tab-policy-note">@TabPolicyDescription(activeTab)</span>
                <div>
                    @if (CanRequestEdit(activeTab))
                    {
                        <button class="request-edit-button" type="button" disabled="@isPreparingEditor" @onclick="OpenEditor">
                            @(activeTab == "documents" ? "ขอเพิ่มเอกสาร" : "ขอแก้ไขข้อมูล")
                        </button>
                    }
                    else if (CanDirectEdit(activeTab))
                    {
                        <button class="request-edit-button" type="button" disabled="@isPreparingEditor" @onclick="OpenEditor">แก้ไขข้อมูล</button>
                    }
                </div>
            </div>

            <div class="tab-content">
                @switch (activeTab)
                {
                    case "basic":
                        <section aria-labelledby="basic-title">
                            <h2 id="basic-title">ข้อมูลพื้นฐาน</h2>
                            <div class="detail-grid">
                                <DetailField Label="รหัสพนักงาน" Value="@EmployeeCodeFormat.Display(employee.EmployeeCode)" />
                                <DetailField Label="คำนำหน้าชื่อ" Value="@employee.Title" />
                                <DetailField Label="ชื่อ-นามสกุล (ไทย)" Value="@DisplayValue(string.IsNullOrWhiteSpace(employee.ThaiFullName) ? employee.FullName : employee.ThaiFullName)" />
                                <DetailField Label="ชื่อ-นามสกุล (อังกฤษ)" Value="@DisplayValue(employee.EnglishFullName)" />
                                <DetailField Label="ชื่อเล่น" Value="@employee.Nickname" />
                                <DetailField Label="Email" Value="@employee.Email" />
                                <DetailField Label="เบอร์มือถือส่วนตัว" Value="@employee.PersonalMobile" />
                                <DetailField Label="เบอร์มือถือบริษัท" Value="@DisplayValue(employee.CompanyMobile)" />
                                <DetailField Label="Ext. ภายใน" Value="@DisplayValue(employee.InternalExtension)" />
                                <DetailField Label="Business Unit" Value="@DisplayValue(employee.BusinessUnit)" />
                                <DetailField Label="แผนก" Value="@DisplayValue(employee.Department)" />
                                <DetailField Label="ตำแหน่ง" Value="@DisplayValue(employee.Position)" />
                                <DetailField Label="หัวหน้างาน" Value="@DisplayValue(employee.SupervisorName)" />
                                <DetailField Label="Reporting To (Leave Approve)" Value="@DisplayValue(employee.LeaveApproverName)" />
                                <DetailField Label="วันที่เริ่มงาน" Value="@FormatDate(employee.StartDate)" />
                                <DetailField Label="Branch" Value="@DisplayValue(employee.BranchName)" />
                                <DetailField Label="Province of Residence (จังหวัดที่อาศัยอยู่)" Value="@DisplayValue(employee.ResidenceProvince)" />
                                <DetailField Label="ที่อยู่ปัจจุบัน" Value="@FormatCurrentAddress(employee)" />
                                <DetailField Label="Province of Responsibility (จังหวัดที่ให้ดูแล)" Value="@DisplayValue(employee.ResponsibilityProvince)" />
                                <DetailField Label="Brand" Value="@DisplayValue(employee.Brand)" />
                                <DetailField Label="Comm.Group" Value="@DisplayValue(employee.CommGroup)" />
                                <DetailField Label="ประเภท Checklist" Value="@DisplayValue(employee.ChecklistType)" />
                            </div>
                        </section>
                        break;
                    case "personal":
                        <section aria-labelledby="personal-title">
                            <h2 id="personal-title">ข้อมูลส่วนบุคคล</h2>
                            <div class="detail-grid">
                                <DetailField Label="คำนำหน้าชื่อ" Value="@employee.Title" />
                                <DetailField Label="ชื่อ-นามสกุล (ไทย)" Value="@employee.ThaiFullName" />
                                <DetailField Label="ชื่อ-นามสกุล (อังกฤษ)" Value="@employee.EnglishFullName" />
                                <DetailField Label="ชื่อเล่น" Value="@employee.Nickname" />
                                <DetailField Label="เบอร์มือถือส่วนตัว" Value="@employee.PersonalMobile" />
                                <DetailField Label="โทรศัพท์บ้าน" Value="@employee.HomePhone" />
                                <DetailField Label="MAC Address" Value="@DisplayValue(employee.MacAddress)" />
                                <DetailField Label="ศาสนา" Value="@employee.Religion" />
                                <DetailField Label="หมู่เลือด" Value="@employee.BloodType" />
                                <div class="address-detail-section">
                                    <h3>ที่อยู่ปัจจุบัน</h3>
                                    <div class="address-detail-grid">
                                        <DetailField Label="ที่อยู่" Value="@employee.CurrentAddress" />
                                        <DetailField Label="ตำบล / แขวง" Value="@employee.ResidenceSubdistrict" />
                                        <DetailField Label="อำเภอ / เขต" Value="@employee.ResidenceDistrict" />
                                        <DetailField Label="จังหวัด" Value="@employee.ResidenceProvince" />
                                        <DetailField Label="รหัสไปรษณีย์" Value="@employee.ResidencePostalCode" />
                                    </div>
                                </div>
                                <div class="address-detail-section">
                                    <h3>ที่อยู่ตามบัตรประชาชน @if (employee.IdCardSameAsCurrent) { <span>เหมือนที่อยู่ปัจจุบัน</span> }</h3>
                                    <div class="address-detail-grid">
                                        <DetailField Label="ที่อยู่" Value="@employee.IdCardAddress" />
                                        <DetailField Label="ตำบล / แขวง" Value="@employee.IdCardSubdistrict" />
                                        <DetailField Label="อำเภอ / เขต" Value="@employee.IdCardDistrict" />
                                        <DetailField Label="จังหวัด" Value="@employee.IdCardProvince" />
                                        <DetailField Label="รหัสไปรษณีย์" Value="@employee.IdCardPostalCode" />
                                    </div>
                                </div>
                                <div class="address-detail-section">
                                    <h3>ที่อยู่ตามทะเบียนบ้าน @if (employee.HouseRegistrationSameAsCurrent) { <span>เหมือนที่อยู่ปัจจุบัน</span> }</h3>
                                    <div class="address-detail-grid">
                                        <DetailField Label="ที่อยู่" Value="@employee.HouseRegistrationAddress" />
                                        <DetailField Label="ตำบล / แขวง" Value="@employee.HouseRegistrationSubdistrict" />
                                        <DetailField Label="อำเภอ / เขต" Value="@employee.HouseRegistrationDistrict" />
                                        <DetailField Label="จังหวัด" Value="@employee.HouseRegistrationProvince" />
                                        <DetailField Label="รหัสไปรษณีย์" Value="@employee.HouseRegistrationPostalCode" />
                                    </div>
                                </div>
                                <DetailField Label="บุคคลติดต่อกรณีฉุกเฉิน" Value="@employee.EmergencyContactName" />
                                <DetailField Label="เบอร์ติดต่อฉุกเฉิน" Value="@employee.EmergencyContactPhone" />
                                <DetailField Label="ที่อยู่ผู้ติดต่อฉุกเฉิน" Value="@employee.EmergencyContactAddress" />
                            </div>
                        </section>
                        break;
                    case "internal":
                        <section aria-labelledby="internal-title">
                            <h2 id="internal-title">ข้อมูลภายในบริษัท</h2>
                            <div class="detail-grid">
                                <DetailField Label="รหัสพนักงาน" Value="@EmployeeCodeFormat.Display(employee.EmployeeCode)" />
                                <DetailField Label="Email for Lotus Notes" Value="@DisplayValue(employee.LotusNotesEmail)" />
                                <DetailField Label="Email" Value="@DisplayValue(employee.Email)" />
                                <DetailField Label="บริษัท" Value="@DisplayValue(employee.Company)" />
                                <DetailField Label="Business Unit" Value="@DisplayValue(employee.BusinessUnit)" />
                                <DetailField Label="แผนก" Value="@DisplayValue(employee.Department)" />
                                <DetailField Label="ตำแหน่ง" Value="@DisplayValue(employee.Position)" />
                                <DetailField Label="หัวหน้างาน" Value="@DisplayValue(employee.SupervisorName)" />
                                <DetailField Label="Reporting To (Leave Approve)" Value="@DisplayValue(employee.LeaveApproverName)" />
                                <DetailField Label="Branch" Value="@DisplayValue(employee.BranchName)" />
                                <DetailField Label="เบอร์โทรสายตรง" Value="@DisplayValue(employee.DirectPhone)" />
                                <DetailField Label="เบอร์มือถือบริษัท" Value="@DisplayValue(employee.CompanyMobile)" />
                                <DetailField Label="Ext. ภายใน" Value="@DisplayValue(employee.InternalExtension)" />
                                <DetailField Label="Buddy" Value="@DisplayValue(employee.BuddyName)" />
                                <DetailField Label="Province of Residence (จังหวัดที่อาศัยอยู่)" Value="@DisplayValue(employee.ResidenceProvince)" />
                                <DetailField Label="Province of Responsibility (จังหวัดที่ให้ดูแล)" Value="@DisplayValue(employee.ResponsibilityProvince)" />
                                <DetailField Label="ประเภท Checklist" Value="@DisplayValue(employee.ChecklistType)" />
                                <DetailField Label="ประเภทพนักงานและเวลาทำงานในโปรแกรมดึงเวลาทำงาน" Value="@DisplayValue(employee.WorkSchedule)" />
                                <DetailField Label="สินค้าที่ให้ขาย" Value="@DisplayValue(employee.ProductsResponsible)" />
                                <DetailField Label="วันที่เริ่มงาน" Value="@FormatDate(employee.StartDate)" />
                                <DetailField Label="ประสบการณ์การทำงาน" Value="@DisplayValue(employee.WorkExperienceType)" />
                                <DetailField Label="บริษัทมีที่จอดรถให้" Value="@ParkingText(employee.HasCompanyParking)" />
                                <DetailField Label="สามารถเดินทางไปต่างจังหวัดได้" Value="@BooleanText(employee.CanTravelUpcountry, "ได้", "ไม่ได้")" />
                                <DetailField Label="สถานะพนักงาน" Value="@DisplayValue(employee.EmployeeStatus)" />
                                <DetailField Label="การคำนวณการมาทำงาน" Value="@(employee.ExcludeAttendanceCalculation ? "ไม่ต้องคำนวณ" : "คำนวณตามปกติ")" />
                            </div>
                        </section>
                        break;
                    case "accounting":
                        <section aria-labelledby="accounting-title">
                            <h2 id="accounting-title">ข้อมูลทางบัญชี</h2>
                            <div class="detail-grid">
                                <DetailField Label="เลขที่บัตรประกันสังคม" Value="@DisplayValue(employee.SocialSecurityNumber)" />
                                <DetailField Label="เลขที่บัตรประจำตัวผู้เสียภาษี" Value="@DisplayValue(employee.TaxpayerIdentificationNumber)" />
                                <DetailField Label="เลขที่บัญชีรับเงินเดือน" Value="@DisplayValue(employee.SalaryAccountNumber)" />
                            </div>
                        </section>
                        break;
                    case "work":
                        <section aria-labelledby="work-title">
                            <h2 id="work-title">ประวัติการทำงาน</h2>
                            <div class="employee-history-scroll">
                                <table class="employee-history-table">
                                    <thead><tr><th>ระยะเวลา</th><th>BU</th><th>แผนก</th><th>ตำแหน่ง</th><th>Brand</th><th>Comm.Group</th></tr></thead>
                                    <tbody>
                                        @if (employee.WorkHistory.Count == 0)
                                        {
                                            <tr><td colspan="6" class="history-empty">ยังไม่มีรายการประวัติการทำงาน</td></tr>
                                        }
                                        @foreach (var item in employee.WorkHistory)
                                        {
                                            <tr><td>@item.Period</td><td>@item.BusinessUnit</td><td>@item.Department</td><td>@item.Position</td><td>@item.Brand</td><td>@item.CommGroup</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        break;
                    case "education":
                        <section aria-labelledby="education-title">
                            <h2 id="education-title">ประวัติการศึกษา</h2>
                            <div class="employee-history-scroll">
                                <table class="employee-history-table">
                                    <thead><tr><th>ระดับการศึกษา</th><th>สถานศึกษา</th><th>สาขาวิชา</th><th>ปีที่สำเร็จการศึกษา</th></tr></thead>
                                    <tbody>
                                        @if (employee.EducationHistory.Count == 0)
                                        {
                                            <tr><td colspan="4" class="history-empty">ยังไม่มีรายการประวัติการศึกษา</td></tr>
                                        }
                                        @foreach (var item in employee.EducationHistory)
                                        {
                                            <tr><td>@item.Level</td><td>@item.Institution</td><td>@item.Major</td><td>@item.GraduationYear</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        break;
                    case "training":
                        <section aria-labelledby="training-title">
                            <h2 id="training-title">ประวัติการอบรม & สัมมนา</h2>
                            <div class="employee-history-scroll">
                                <table class="employee-history-table training-history-table">
                                    <thead><tr><th>หลักสูตร</th><th>ช่วงที่อบรม</th><th>สถานที่อบรม</th><th>ค่าใช้จ่าย</th><th>Certificate</th><th>ค่าสอบ</th></tr></thead>
                                    <tbody>
                                        @if (employee.TrainingHistory.Count == 0)
                                        {
                                            <tr><td colspan="6" class="history-empty">ยังไม่มีรายการอบรมหรือสัมมนา</td></tr>
                                        }
                                        @foreach (var item in employee.TrainingHistory)
                                        {
                                            <tr>
                                                <td>@item.CourseName</td><td>@item.TrainingPeriod</td><td>@item.Location</td>
                                                <td>@MoneyText(item.Expense)</td><td>@DisplayValue(item.Certificate)</td><td>@MoneyText(item.ExamFee)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        break;
                    case "family":
                        <EmployeeTaxDeductionEditor EmployeeId="@employee.Id" IsOwner="@IsOwnEmployee" />
                        break;
                    case "documents":
                        <section class="personal-documents-section" aria-labelledby="documents-title">
                            <div class="personal-documents-heading">
                                <div>
                                    <h2 id="documents-title">เอกสารส่วนตัว</h2>
                                    <p>ข้อมูลเอกสารสำคัญของพนักงาน จำกัดเฉพาะผู้ที่ได้รับสิทธิ์</p>
                                </div>
                                <span class="confidential-badge">ข้อมูลลับ</span>
                            </div>
                            <EmployeePersonalDocuments EmployeeId="@employee.Id" CanManage="false" />
                        </section>
                        break;
                    case "recruit-documents":
                        <section class="personal-documents-section" aria-labelledby="recruit-documents-title">
                            <div class="personal-documents-heading">
                                <div>
                                    <h2 id="recruit-documents-title">เอกสาร Recruit</h2>
                                    <p>ลิงก์เอกสารจากกระบวนการสรรหา กดที่รายการเพื่อเปิดเอกสารใน Browser แท็บใหม่</p>
                                </div>
                                <span class="confidential-badge">ข้อมูลลับ</span>
                            </div>
                            <EmployeeRecruitDocumentLinks EmployeeId="@employee.Id" CanManage="false" />
                        </section>
                        break;
                    case "change-history":
                        <section aria-labelledby="change-history-title">
                            <h2 id="change-history-title">ประวัติการเปลี่ยนแปลงข้อมูล</h2>
                            <EmployeeChangeHistory EmployeeId="@employee.Id" />
                        </section>
                        break;
                }
            </div>
        </section>
    }
</section>

@if (isEditRequestOpen && employee is not null)
{
    <div class="employee-edit-overlay" role="dialog" aria-modal="true"
         aria-labelledby="employee-edit-title">
        <section class="employee-edit-modal @(IsEditRequestReadOnly ? "request-readonly" : null)">
            <header class="employee-edit-modal-header">
                <div>
                    <h2 id="employee-edit-title">@(IsDirectEdit ? $"แก้ไข{TabLabel(editActiveTab)}" : editingRequest is null ? "ขอแก้ไขข้อมูลพนักงาน" : $"แก้ไขคำขอ {editingRequest.RequestNo}")</h2>
                    <p>@EmployeeCodeFormat.Display(employee.EmployeeCode) · @employee.FullName</p>
                </div>
                <button type="button" aria-label="ปิด" @onclick="CloseEditRequest">×</button>
            </header>
            <div class="employee-edit-modal-body">
                <p class="edit-hint">@(IsDirectEdit ? $"บันทึก{TabLabel(editActiveTab)}ได้โดยตรงตามสิทธิ์ที่ได้รับ" : $"คำขอนี้มีเฉพาะ {TabLabel(editActiveTab)} และข้อมูลหลักจะเปลี่ยนหลังได้รับอนุมัติ")</p>
                <section class="edit-tab-panel">
                    @switch (editActiveTab)
                    {
                        case "personal":
                            <div class="employee-edit-grid">
                                @if (true)
                                {
                                    <div class="profile-image-request-editor wide-field">
                                        <div class="profile-image-request-preview">
                                            @if (string.IsNullOrWhiteSpace(proposedProfileImageDataUrl))
                                            {
                                                <span>@Initials(employee)</span>
                                            }
                                            else
                                            {
                                                <img src="@proposedProfileImageDataUrl" alt="รูปโปรไฟล์ที่เลือก" />
                                            }
                                        </div>
                                        <div class="profile-image-request-actions">
                                            <strong>รูปโปรไฟล์</strong>
                                            <small>รองรับ JPG, PNG หรือ WEBP ขนาดไม่เกิน 2 MB</small>
                                            <label class="select-profile-image-button">
                                                เลือกรูปใหม่
                                                <InputFile OnChange="UploadProposedProfileImage" accept="image/jpeg,image/png,image/webp" />
                                            </label>
                                            @if (!string.Equals(proposedProfileImageDataUrl, employee.ProfileImageDataUrl, StringComparison.Ordinal))
                                            {
                                                <button type="button" class="reset-profile-image-button" @onclick="ResetProposedProfileImage">ใช้รูปเดิม</button>
                                            }
                                        </div>
                                    </div>
                                    <label>คำนำหน้าชื่อ<input @bind="proposedTitle" /></label>
                                    <label>ชื่อ<input @bind="proposedFirstName" /></label>
                                    <label>นามสกุล<input @bind="proposedLastName" /></label>
                                    <label>ชื่อ-นามสกุล (ไทย)<input @bind="proposedThaiFullName" /></label>
                                    <label>ชื่อ-นามสกุล (อังกฤษ)<input @bind="proposedEnglishFullName" /></label>
                                    <label>เลขบัตรประชาชน<input @bind="personalNationalId" placeholder="ระบุข้อมูลที่ต้องการแก้ไข" /></label>
                                    <label>วันเกิด<DateOnlyPicker @bind-Value="personalBirthDate" AriaLabel="วันเกิด" /></label>
                                    <label>เพศ<SearchableSelect><select @bind="personalGender"><option value="">-- เลือก --</option><option value="ชาย">ชาย</option><option value="หญิง">หญิง</option><option value="ไม่ระบุ">ไม่ระบุ</option></select></SearchableSelect></label>
                                    <label>ศาสนา<input @bind="personalReligion" /></label>
                                    <label>หมู่เลือด<input @bind="personalBloodType" /></label>
                                    <div class="address-editor-section">
                                        <h3>ที่อยู่ปัจจุบัน</h3>
                                        <div class="address-editor-grid">
                                            <label class="wide-field">ที่อยู่<textarea rows="3" @bind="personalCurrentAddress" @bind:event="oninput" @bind:after="SyncMatchingPersonalAddresses" placeholder="บ้านเลขที่ หมู่ ถนน ซอย"></textarea></label>
                                            <label>จังหวัด<SearchableSelect><select @bind="personalResidenceProvince" @bind:after="PersonalResidenceProvinceChanged"><option value="">-- เลือก --</option>@foreach (var item in MasterOptions("PROVINCE")) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                            <label>อำเภอ / เขต<SearchableSelect><select @bind="personalResidenceDistrict" @bind:after="PersonalResidenceDistrictChanged" disabled="@string.IsNullOrWhiteSpace(personalResidenceProvince)"><option value="">-- เลือก --</option>@foreach (var item in PersonalResidenceDistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                            <label>ตำบล / แขวง<SearchableSelect><select @bind="personalResidenceSubdistrict" @bind:after="PersonalResidenceSubdistrictChanged" disabled="@string.IsNullOrWhiteSpace(personalResidenceDistrict)"><option value="">-- เลือก --</option>@foreach (var item in PersonalResidenceSubdistrictOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                            <label>รหัสไปรษณีย์<SearchableSelect><select @bind="personalResidencePostalCode" @bind:after="SyncMatchingPersonalAddresses" disabled="@string.IsNullOrWhiteSpace(personalResidenceSubdistrict)"><option value="">-- เลือก --</option>@foreach (var item in PersonalResidencePostalCodeOptions) { <option value="@item.NameTh">@item.NameTh</option> }</select></SearchableSelect></label>
                                        </div>
                                    </div>
                                    <div class="address-editor-section">
