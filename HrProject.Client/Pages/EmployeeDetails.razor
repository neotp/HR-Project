    private async Task SelectEditRequestAttachments(InputFileChangeEventArgs eventArgs)
    {
        editError = null;
        var availableSlots = 5 - ExistingAttachments.Count - editRequestAttachments.Count;
        if (availableSlots <= 0 || eventArgs.FileCount > availableSlots)
        {
            editError = "แนบไฟล์ได้ไม่เกิน 5 ไฟล์ต่อคำขอ";
            editAttachmentInputVersion++;
            return;
        }

        foreach (var file in eventArgs.GetMultipleFiles(availableSlots))
        {
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not (".pdf" or ".jpg" or ".jpeg" or ".png" or ".webp"))
            {
                editError = $"ไฟล์ {file.Name} ไม่รองรับ กรุณาเลือก PDF, JPG, PNG หรือ WEBP";
                continue;
            }
            if (file.Size > 3 * 1024 * 1024)
            {
                editError = $"ไฟล์ {file.Name} มีขนาดเกิน 3 MB";
                continue;
            }

            await using var stream = file.OpenReadStream(3 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            editRequestAttachments.Add(new EmployeeEditRequestAttachmentUploadDto(
                file.Name, file.ContentType, memory.ToArray()));
        }
        editAttachmentInputVersion++;
    }

    private void RemoveEditRequestAttachment(EmployeeEditRequestAttachmentUploadDto attachment) =>
        editRequestAttachments.Remove(attachment);

    private static string FormatFileSize(long bytes) => bytes >= 1024 * 1024
