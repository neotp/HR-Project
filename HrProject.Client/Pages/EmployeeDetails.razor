                                        <tr><td><input @bind="item.Period" /></td><td><input @bind="item.BusinessUnit" /></td><td><input @bind="item.Department" /></td><td><input @bind="item.Position" /></td><td><input @bind="item.Brand" /></td><td><input @bind="item.CommGroup" /></td><td><button type="button" class="remove-table-row" @onclick="() => editableWorkHistory.Remove(item)">×</button></td></tr>
                                    }
                                </tbody></table>
                            </div>
