@page "/employees/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(employee is null ? "ข้อมูลพนักงาน" : employee.FullName) | HR Project</PageTitle>

<section class="manage-page employee-details-page">
    @if (isLoading)
    {
        <div class="detail-state">กำลังโหลดข้อมูลพนักงาน...</div>
    }
    else if (employee is null)
    {
        <section class="content-card detail-state">
            <h1>ไม่พบข้อมูลพนักงาน</h1>
            <p>ไม่พบพนักงานตามรหัสที่ระบุ</p>
            <button class="back-button" type="button" @onclick="BackToList">กลับหน้ารายชื่อ</button>
        </section>
    }
    else
    {
        <header class="employee-profile-header">
            <button class="back-link" type="button" @onclick="BackToList">‹ กลับหน้ารายชื่อพนักงาน</button>
            <div class="profile-summary">
                @if (string.IsNullOrWhiteSpace(employee.ProfileImageDataUrl))
                {
                    <div class="employee-avatar" aria-hidden="true">@Initials(employee)</div>
                }
                else
                {
                    <img class="employee-avatar employee-photo"
                         src="@employee.ProfileImageDataUrl"
                         alt="รูปของ @employee.FullName" />
                }
                <div class="profile-name">
                    <span class="employee-code">@employee.EmployeeCode</span>
                    <h1>@employee.FullName</h1>
                    <p>@employee.Position · @employee.Department</p>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(actionMessage))
        {
            <div class="employee-action-message" role="status">@actionMessage</div>
        }

        <section class="content-card employee-detail-card">
            <nav class="employee-tabs" aria-label="หมวดข้อมูลพนักงาน">
                @foreach (var tab in Tabs)
                {
                    <button type="button"
                            class="employee-tab @(activeTab == tab.Key ? "active" : null)"
                            @onclick="() => activeTab = tab.Key">
                        @tab.Label
                    </button>
                }
            </nav>

            <div class="tab-edit-actions">
                <span class="tab-policy-note">@TabPolicyDescription(activeTab)</span>
                <div>
                    @if (CanDirectEdit(activeTab))
                    {
                        <button class="direct-edit-button" type="button" @onclick="() => OpenEditor(false)">แก้ไขข้อมูล</button>
                    }
                    @if (CanRequestEdit(activeTab))
                    {
                        <button class="request-edit-button" type="button" @onclick="() => OpenEditor(true)">ขอแก้ไขข้อมูล</button>
                    }
                    @if (activeTab == "internal")
                    {
                        <span class="hr-only-badge">เฉพาะ HR แก้ไข</span>
                    }
                </div>
            </div>

            <div class="tab-content">
                @switch (activeTab)
                {
                    case "basic":
                        <section aria-labelledby="basic-title">
                            <h2 id="basic-title">ข้อมูลพื้นฐาน</h2>
                            <div class="detail-grid">
                                <DetailField Label="รหัสพนักงาน" Value="@employee.EmployeeCode" />
                                <DetailField Label="คำนำหน้าชื่อ" Value="@employee.Title" />
                                <DetailField Label="ชื่อ-นามสกุล (ไทย)" Value="@employee.ThaiFullName" />
                                <DetailField Label="ชื่อ-นามสกุล (อังกฤษ)" Value="@employee.EnglishFullName" />
                                <DetailField Label="ชื่อเล่น" Value="@employee.Nickname" />
                                <DetailField Label="E-mail" Value="@employee.Email" />
                                <DetailField Label="เบอร์มือถือส่วนตัว" Value="@employee.PersonalMobile" />
                                <DetailField Label="โทรศัพท์บ้าน" Value="@employee.HomePhone" />
                            </div>
                        </section>
                        break;
                    case "personal":
                        <section aria-labelledby="personal-title">
                            <h2 id="personal-title">ข้อมูลส่วนบุคคล</h2>
                            <div class="detail-grid">
                                <DetailField Label="ศาสนา" Value="@employee.Religion" />
                                <DetailField Label="หมู่เลือด" Value="@employee.BloodType" />
                                <DetailField Label="จังหวัดที่พักอาศัย" Value="@employee.ResidenceProvince" />
                                <DetailField Label="ที่อยู่ปัจจุบัน" Value="@employee.CurrentAddress" />
                                <DetailField Label="ที่อยู่ตามบัตรประชาชน" Value="@employee.IdCardAddress" />
                                <DetailField Label="ที่อยู่ตามทะเบียนบ้าน" Value="@employee.HouseRegistrationAddress" />
                                <DetailField Label="บุคคลติดต่อกรณีฉุกเฉิน" Value="@employee.EmergencyContactName" />
                                <DetailField Label="เบอร์ติดต่อฉุกเฉิน" Value="@employee.EmergencyContactPhone" />
                                <DetailField Label="ที่อยู่ผู้ติดต่อฉุกเฉิน" Value="@employee.EmergencyContactAddress" />
                            </div>
                        </section>
                        break;
                    case "internal":
                        <section aria-labelledby="internal-title">
                            <h2 id="internal-title">ข้อมูลภายในบริษัท</h2>
                            <div class="detail-grid">
                                <DetailField Label="รหัสพนักงาน" Value="@employee.EmployeeCode" />
                                <DetailField Label="บริษัท" Value="@DisplayValue(employee.Company)" />
                                <DetailField Label="Business Unit" Value="@DisplayValue(employee.BusinessUnit)" />
                                <DetailField Label="ฝ่าย" Value="@DisplayValue(employee.Division)" />
                                <DetailField Label="แผนก" Value="@DisplayValue(employee.Department)" />
                                <DetailField Label="ส่วนงาน" Value="@DisplayValue(employee.Section)" />
                                <DetailField Label="ตำแหน่ง" Value="@DisplayValue(employee.Position)" />
                                <DetailField Label="รหัสตำแหน่ง" Value="@DisplayValue(employee.JobCode)" />
                                <DetailField Label="หัวหน้างาน" Value="@DisplayValue(employee.SupervisorName)" />
                                <DetailField Label="Reporting To (Leave Approve)" Value="@DisplayValue(employee.LeaveApproverName)" />
                                <DetailField Label="หัวหน้างาน (Functional Boss)" Value="@DisplayValue(employee.FunctionalSupervisorName)" />
                                <DetailField Label="Buddy" Value="@DisplayValue(employee.BuddyName)" />
                                <DetailField Label="ประเภทการจ้าง" Value="@DisplayValue(employee.EmploymentType)" />
                                <DetailField Label="ประเภทพนักงานและเวลาทำงาน" Value="@DisplayValue(employee.WorkSchedule)" />
                                <DetailField Label="สถานที่ทำงาน" Value="@DisplayValue(employee.WorkLocation)" />
                                <DetailField Label="อีเมลบริษัท" Value="@DisplayValue(employee.Email)" />
                                <DetailField Label="Ext. ภายใน" Value="@DisplayValue(employee.InternalExtension)" />
                                <DetailField Label="เบอร์โทรสายตรง" Value="@DisplayValue(employee.DirectPhone)" />
                                <DetailField Label="เบอร์มือถือบริษัท" Value="@DisplayValue(employee.CompanyMobile)" />
                                <DetailField Label="MAC Address" Value="@DisplayValue(employee.MacAddress)" />
                                <DetailField Label="รหัสสาขา" Value="@DisplayValue(employee.BranchCode)" />
                                <DetailField Label="ชื่อสาขา" Value="@DisplayValue(employee.BranchName)" />
                                <DetailField Label="จังหวัดที่ให้ดูแล" Value="@DisplayValue(employee.ResponsibilityProvince)" />
                                <DetailField Label="ประเภท Checklist" Value="@DisplayValue(employee.ChecklistType)" />
                                <DetailField Label="สินค้าที่ให้ขาย" Value="@DisplayValue(employee.ProductsResponsible)" />
                                <DetailField Label="วันที่เริ่มงาน" Value="@FormatDate(employee.StartDate)" />
                                <DetailField Label="วันที่บรรจุ" Value="@FormatDate(employee.AppointmentDate)" />
                                <DetailField Label="วันที่เปิดกองทุนเงินสะสม" Value="@FormatDate(employee.ProvidentFundStartDate)" />
                                <DetailField Label="ประสบการณ์การทำงาน" Value="@DisplayValue(employee.WorkExperienceType)" />
                                <DetailField Label="บริษัทมีที่จอดรถให้" Value="@ParkingText(employee.HasCompanyParking)" />
                                <DetailField Label="สถานะพนักงาน" Value="@DisplayValue(employee.EmployeeStatus)" />
                            </div>
                        </section>
                        break;
                    case "work":
                        <section aria-labelledby="work-title">
                            <h2 id="work-title">ประวัติการทำงาน</h2>
                            <div class="employee-history-scroll">
                                <table class="employee-history-table">
                                    <thead><tr><th>ระยะเวลา</th><th>ตำแหน่ง/หน้าที่</th><th>บริษัทที่ทำงาน</th></tr></thead>
                                    <tbody>
                                        @if (employee.WorkHistory.Count == 0)
                                        {
                                            <tr><td colspan="3" class="history-empty">ยังไม่มีรายการประวัติการทำงาน</td></tr>
                                        }
                                        @foreach (var item in employee.WorkHistory)
                                        {
                                            <tr><td>@item.Period</td><td>@item.Position</td><td>@item.Company</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="history-summary"><span>สามารถเดินทางไปต่างจังหวัดได้</span><strong>@BooleanText(employee.CanTravelUpcountry, "ได้", "ไม่ได้")</strong></div>
                        </section>
                        break;
                    case "education":
                        <section aria-labelledby="education-title">
                            <h2 id="education-title">ประวัติการศึกษา</h2>
                            <div class="employee-history-scroll">
                                <table class="employee-history-table">
                                    <thead><tr><th>ระดับการศึกษา</th><th>สถานศึกษา</th><th>สาขาวิชา</th><th>ปีที่สำเร็จการศึกษา</th></tr></thead>
                                    <tbody>
                                        @if (employee.EducationHistory.Count == 0)
                                        {
                                            <tr><td colspan="4" class="history-empty">ยังไม่มีรายการประวัติการศึกษา</td></tr>
                                        }
                                        @foreach (var item in employee.EducationHistory)
                                        {
                                            <tr><td>@item.Level</td><td>@item.Institution</td><td>@item.Major</td><td>@item.GraduationYear</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        break;
                    case "training":
                        <section aria-labelledby="training-title">
                            <h2 id="training-title">ประวัติการอบรม & สัมมนา</h2>
                            <div class="employee-history-scroll">
                                <table class="employee-history-table training-history-table">
                                    <thead><tr><th>หลักสูตร</th><th>ช่วงที่อบรม</th><th>สถานที่อบรม</th><th>ค่าใช้จ่าย</th><th>Certificate</th><th>ค่าสอบ</th></tr></thead>
                                    <tbody>
                                        @if (employee.TrainingHistory.Count == 0)
                                        {
                                            <tr><td colspan="6" class="history-empty">ยังไม่มีรายการอบรมหรือสัมมนา</td></tr>
                                        }
                                        @foreach (var item in employee.TrainingHistory)
                                        {
                                            <tr>
                                                <td>@item.CourseName</td><td>@item.TrainingPeriod</td><td>@item.Location</td>
                                                <td>@MoneyText(item.Expense)</td><td>@DisplayValue(item.Certificate)</td><td>@MoneyText(item.ExamFee)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        break;
                    case "family":
                        <section aria-labelledby="family-title">
                            <h2 id="family-title">ประวัติครอบครัว</h2>
                            <div class="detail-grid">
                                <DetailField Label="สถานะภาพการสมรส" Value="@employee.MaritalStatus" />
                                <DetailField Label="จดทะเบียนสมรส" Value="@BooleanText(employee.IsMarriageRegistered, "จดทะเบียน", "ไม่ได้จดทะเบียน")" />
                                <DetailField Label="คำนำหน้าคู่สมรส" Value="@employee.SpouseTitle" />
                                <DetailField Label="ชื่อ-นามสกุลคู่สมรส" Value="@employee.SpouseName" />
                                <DetailField Label="วันที่สมรส" Value="@FormatDate(employee.MarriageDate)" />
                                <DetailField Label="คู่สมรสมีรายได้" Value="@BooleanText(employee.SpouseHasIncome, "มีรายได้", "ไม่มีรายได้")" />
                                <DetailField Label="เลขบัตรประชาชนคู่สมรส" Value="@employee.SpouseNationalId" />
                                <DetailField Label="Passport ID คู่สมรส" Value="@employee.SpousePassportId" />
                                <DetailField Label="ชื่อใน Passport" Value="@employee.SpousePassportName" />
                                <DetailField Label="จำนวนบุตร (ไม่ศึกษา)" Value="@($"{employee.UneducatedChildCount} คน")" />
                                <DetailField Label="จำนวนบุตร (ศึกษา)" Value="@($"{employee.StudyingChildCount} คน")" />
                                <DetailField Label="เบี้ยประกันชีวิต" Value="@MoneyText(employee.LifeInsuranceAmount)" />
                                <DetailField Label="ลดหย่อนบิดามารดาผู้มีเงินได้" Value="@MoneyText(employee.ParentSupportDeductionAmount)" />
                                <DetailField Label="ลดหย่อนบิดามารดาคู่สมรส" Value="@MoneyText(employee.SpouseParentSupportDeductionAmount)" />
                                <DetailField Label="URL แผนที่อยู่ปัจจุบัน" Value="@employee.CurrentAddressMapUrl" />
                            </div>
                        </section>
                        break;
                }
            </div>
        </section>
    }
</section>

@if (isEditRequestOpen && employee is not null)
{
    <div class="employee-edit-overlay" role="dialog" aria-modal="true"
         aria-labelledby="employee-edit-title">
        <section class="employee-edit-modal">
            <header class="employee-edit-modal-header">
                <div>
                    <h2 id="employee-edit-title">@(isRequestMode ? "ขอแก้ไขข้อมูลพนักงาน" : "แก้ไขข้อมูลพนักงาน")</h2>
                    <p>@employee.EmployeeCode · @employee.FullName</p>
                </div>
                <button type="button" aria-label="ปิด" @onclick="CloseEditRequest">×</button>
            </header>
            <div class="employee-edit-modal-body">
                <p class="edit-hint">@(isRequestMode
                    ? $"คำขอนี้มีเฉพาะ {TabLabel(editActiveTab)} และข้อมูลหลักจะเปลี่ยนหลังได้รับอนุมัติ"
                    : $"บันทึก {TabLabel(editActiveTab)} ได้ทันทีโดยไม่ต้องส่งคำขอ")</p>
                <section class="edit-tab-panel">
                    @switch (editActiveTab)
                    {
                        case "basic":
                            <div class="employee-edit-grid">
                                @if (isRequestMode)
                                {
                                    <label>คำนำหน้าชื่อ<input @bind="proposedTitle" /></label>
                                    <label>ชื่อ<input @bind="proposedFirstName" /></label>
                                    <label>นามสกุล<input @bind="proposedLastName" /></label>
                                    <label>ชื่อ-นามสกุล (ไทย)<input @bind="proposedThaiFullName" /></label>
                                    <label>ชื่อ-นามสกุล (อังกฤษ)<input @bind="proposedEnglishFullName" /></label>
                                    <label>E-mail<input type="email" @bind="proposedEmail" /></label>
                                }
                                else
                                {
                                    <label>ชื่อเล่น<input @bind="proposedNickname" /></label>
                                    <label>เบอร์มือถือส่วนตัว<input @bind="proposedPersonalMobile" /></label>
                                    <label>โทรศัพท์บ้าน<input @bind="proposedHomePhone" /></label>
                                }
                            </div>
                            break;
                        case "personal":
                            <div class="employee-edit-grid">
                                @if (isRequestMode)
                                {
                                    <label>เลขบัตรประชาชน<input @bind="personalNationalId" placeholder="ระบุข้อมูลที่ต้องการแก้ไข" /></label>
                                    <label>วันเกิด<input type="date" @bind="personalBirthDate" /></label>
                                    <label>เพศ<select @bind="personalGender"><option value="">-- เลือก --</option><option value="ชาย">ชาย</option><option value="หญิง">หญิง</option><option value="ไม่ระบุ">ไม่ระบุ</option></select></label>
                                    <label>ศาสนา<input @bind="personalReligion" /></label>
                                    <label>หมู่เลือด<input @bind="personalBloodType" /></label>
                                    <label>จังหวัดที่พักอาศัย<input @bind="personalResidenceProvince" /></label>
                                    <label class="wide-field">ที่อยู่ตามบัตรประชาชน<textarea rows="3" @bind="personalIdCardAddress"></textarea></label>
                                    <label class="wide-field">ที่อยู่ตามทะเบียนบ้าน<textarea rows="3" @bind="personalHouseRegistrationAddress"></textarea></label>
                                }
                                else
                                {
                                    <label class="wide-field">ที่อยู่ปัจจุบัน<textarea rows="3" @bind="personalCurrentAddress"></textarea></label>
                                    <label>บุคคลติดต่อกรณีฉุกเฉิน<input @bind="personalEmergencyContactName" /></label>
                                    <label>เบอร์ติดต่อฉุกเฉิน<input @bind="personalEmergencyContactPhone" /></label>
                                    <label class="wide-field">ที่อยู่ผู้ติดต่อฉุกเฉิน<textarea rows="3" @bind="personalEmergencyContactAddress"></textarea></label>
                                }
                            </div>
                            break;
                        case "internal":
                            <div class="employee-edit-grid">
                                <label>บริษัท<input @bind="internalCompany" /></label>
                                <label>Business Unit<input @bind="internalBusinessUnit" /></label>
                                <label>ฝ่าย<input @bind="internalDivision" /></label>
                                <label>แผนก<input @bind="internalDepartment" /></label>
                                <label>ส่วนงาน<input @bind="internalSection" /></label>
                                <label>ตำแหน่ง<input @bind="internalPosition" /></label>
                                <label>รหัสตำแหน่ง<input @bind="internalJobCode" /></label>
                                <label>หัวหน้างาน<input @bind="internalSupervisorName" /></label>
                                <label>Reporting To (Leave Approve)<input @bind="internalLeaveApproverName" /></label>
                                <label>หัวหน้างาน (Functional Boss)<input @bind="internalFunctionalSupervisorName" /></label>
                                <label>Buddy<input @bind="internalBuddyName" /></label>
                                <label>ประเภทการจ้าง
                                    <select @bind="internalEmploymentType">
                                        <option value="">-- เลือก --</option>
                                        <option value="พนักงานประจำ">พนักงานประจำ</option>
                                        <option value="พนักงานสัญญาจ้าง">พนักงานสัญญาจ้าง</option>
                                        <option value="พนักงานทดลองงาน">พนักงานทดลองงาน</option>
                                        <option value="นักศึกษาฝึกงาน">นักศึกษาฝึกงาน</option>
                                    </select>
                                </label>
                                <label>ประเภทพนักงานและเวลาทำงาน<input @bind="internalWorkSchedule" /></label>
                                <label>สถานที่ทำงาน<input @bind="internalWorkLocation" /></label>
                                <label>Ext. ภายใน<input @bind="internalExtension" /></label>
                                <label>เบอร์โทรสายตรง<input @bind="internalDirectPhone" /></label>
                                <label>เบอร์มือถือบริษัท<input @bind="internalCompanyMobile" /></label>
                                <label>MAC Address<input @bind="internalMacAddress" /></label>
                                <label>รหัสสาขา<input @bind="internalBranchCode" /></label>
                                <label>ชื่อสาขา<input @bind="internalBranchName" /></label>
                                <label>จังหวัดที่ให้ดูแล<input @bind="internalResponsibilityProvince" /></label>
                                <label>ประเภท Checklist<input @bind="internalChecklistType" /></label>
                                <label>สินค้าที่ให้ขาย<input @bind="internalProductsResponsible" /></label>
                                <label>วันที่เริ่มงาน<input type="date" @bind="proposedStartDate" /></label>
                                <label>วันที่บรรจุ<input type="date" @bind="internalAppointmentDate" /></label>
                                <label>วันที่เปิดกองทุนเงินสะสม<input type="date" @bind="internalProvidentFundStartDate" /></label>
                                <label>ประสบการณ์การทำงาน
                                    <select @bind="internalWorkExperienceType">
                                        <option value="">-- เลือก --</option>
                                        <option value="เพิ่งจบการศึกษา">เพิ่งจบการศึกษา</option>
                                        <option value="มีประสบการณ์การทำงาน">มีประสบการณ์การทำงาน</option>
                                    </select>
                                </label>
                                <label>บริษัทมีที่จอดรถให้
                                    <select @bind="internalHasCompanyParking">
                                        <option value="">-- เลือก --</option>
                                        <option value="มี">มี</option>
                                        <option value="ไม่มี">ไม่มี</option>
                                    </select>
                                </label>
                                <label>สถานะพนักงาน
                                    <select @bind="internalEmployeeStatus">
                                        <option value="">-- เลือก --</option>
                                        <option value="ปฏิบัติงาน">ปฏิบัติงาน</option>
                                        <option value="ทดลองงาน">ทดลองงาน</option>
                                        <option value="พักงาน">พักงาน</option>
                                        <option value="ลาออก">ลาออก</option>
                                    </select>
                                </label>
                            </div>
                            break;
                        case "work":
                            <div class="modal-table-toolbar"><strong>รายการประวัติการทำงาน</strong><button type="button" @onclick="AddEditableWork">+ เพิ่มรายการ</button></div>
                            <div class="employee-history-scroll">
                                <table class="editable-modal-table"><thead><tr><th>ระยะเวลา</th><th>ตำแหน่ง/หน้าที่</th><th>บริษัท</th><th></th></tr></thead><tbody>
                                    @foreach (var item in editableWorkHistory)
                                    {
                                        <tr><td><input @bind="item.Period" /></td><td><input @bind="item.Position" /></td><td><input @bind="item.Company" /></td><td><button type="button" class="remove-table-row" @onclick="() => editableWorkHistory.Remove(item)">×</button></td></tr>
                                    }
                                </tbody></table>
                            </div>
                            break;
                        case "education":
                            <div class="modal-table-toolbar"><strong>รายการประวัติการศึกษา</strong><button type="button" @onclick="AddEditableEducation">+ เพิ่มรายการ</button></div>
                            <div class="employee-history-scroll">
                                <table class="editable-modal-table"><thead><tr><th>ระดับ</th><th>สถานศึกษา</th><th>สาขา</th><th>ปีที่จบ</th><th></th></tr></thead><tbody>
                                    @foreach (var item in editableEducationHistory)
                                    {
                                        <tr><td><input @bind="item.Level" /></td><td><input @bind="item.Institution" /></td><td><input @bind="item.Major" /></td><td><input @bind="item.GraduationYear" /></td><td><button type="button" class="remove-table-row" @onclick="() => editableEducationHistory.Remove(item)">×</button></td></tr>
                                    }
                                </tbody></table>
                            </div>
                            break;
                        case "training":
                            <div class="modal-table-toolbar"><strong>รายการอบรมและสัมมนา</strong><button type="button" @onclick="AddEditableTraining">+ เพิ่มรายการ</button></div>
                            <div class="employee-history-scroll">
                                <table class="editable-modal-table training-modal-table"><thead><tr><th>หลักสูตร</th><th>ช่วงอบรม</th><th>สถานที่</th><th>ค่าใช้จ่าย</th><th>Certificate</th><th>ค่าสอบ</th><th></th></tr></thead><tbody>
                                    @foreach (var item in editableTrainingHistory)
                                    {
                                        <tr><td><input @bind="item.CourseName" /></td><td><input @bind="item.TrainingPeriod" /></td><td><input @bind="item.Location" /></td><td><input type="number" @bind="item.Expense" /></td><td><input @bind="item.Certificate" /></td><td><input type="number" @bind="item.ExamFee" /></td><td><button type="button" class="remove-table-row" @onclick="() => editableTrainingHistory.Remove(item)">×</button></td></tr>
                                    }
                                </tbody></table>
                            </div>
                            break;
                        case "family":
                            <div class="employee-edit-grid">
                                @if (isRequestMode)
                                {
                                    <label>สถานภาพการสมรส<select @bind="familyMaritalStatus"><option value="โสด">โสด</option><option value="สมรส">สมรส</option><option value="หย่า">หย่า</option><option value="หม้าย">หม้าย</option></select></label>
                                    <label>ชื่อ-นามสกุลคู่สมรส<input @bind="familySpouseName" /></label>
                                    <label>เลขบัตรประชาชนคู่สมรส<input @bind="familySpouseNationalId" /></label>
                                }
                                else
                                {
                                    <label>เบอร์โทรศัพท์ครอบครัว<input @bind="familyPhone" /></label>
                                    <label class="wide-field">URL แผนที่อยู่ปัจจุบัน<input type="url" @bind="familyCurrentAddressMapUrl" /></label>
                                }
                            </div>
                            break;
                    }
                </section>
                @if (isRequestMode)
                {
                    <label class="edit-reason">เหตุผลที่ขอแก้ไข
                        <textarea rows="3" @bind="editReason" placeholder="ระบุเหตุผลในการขอแก้ไขข้อมูล"></textarea>
                    </label>
                }
                @if (!string.IsNullOrWhiteSpace(editError))
                {
                    <div class="edit-error" role="alert">@editError</div>
                }
            </div>
            <footer class="employee-edit-modal-footer">
                <button class="cancel-edit-button" type="button"
                        disabled="@isSubmittingEdit" @onclick="CloseEditRequest">ปิด</button>
                @if (isRequestMode)
                {
                    <button class="submit-edit-button" type="button" disabled="@isSubmittingEdit" @onclick="SubmitEditRequest">
                        @(isSubmittingEdit ? "กำลังส่งคำขอ..." : "ส่งคำขอแก้ไข")
                    </button>
                }
                else
                {
                    <button class="submit-edit-button direct-save-button" type="button" disabled="@isSubmittingEdit" @onclick="SaveDirectChanges">
                        @(isSubmittingEdit ? "กำลังบันทึก..." : "บันทึกข้อมูล")
                    </button>
                }
            </footer>
        </section>
    </div>
}

@if (isLoading)
{
    <div class="loading-overlay" role="status" aria-live="polite">
        <div class="loading-dialog">
            <span class="loading-dialog-title">Loading...</span>
            <p class="loading-dialog-message">กำลังโหลดข้อมูลพนักงาน...</p>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

