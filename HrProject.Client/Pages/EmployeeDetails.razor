    private void CloseEditRequest()
    {
        if (!isSubmittingEdit)
        {
            isEditRequestOpen = false;
            if (editingRequest is not null && string.Equals(SourcePage, "my-edit-requests", StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo($"/employees/my-edit-requests?requestId={editingRequest.Id}");
        }
    }

    private async Task OpenExistingEditRequest(long requestId)
    {
        var request = await Http.GetFromJsonAsync<EmployeeEditRequestDto>($"api/employee-edit-requests/{requestId}");
        if (request is null || employee is null ||
            !string.Equals(request.EmployeeId, employee.EmployeeCode, StringComparison.OrdinalIgnoreCase))
        {
            actionMessage = "ไม่พบคำขอแก้ไขที่ระบุ";
            return;
        }

        activeTab = RequestTab(request.Changes.FirstOrDefault()?.FieldKey);
        await OpenEditor();
        if (!isEditRequestOpen)
        {
            actionMessage = "คุณไม่มีสิทธิ์เปิดแบบฟอร์มคำขอนี้";
            return;
        }

        editingRequest = request;
        openedEditRequestId = requestId;
        editReason = request.RequestReason;
        removedEditRequestAttachmentIds.Clear();
        foreach (var change in request.Changes)
            ApplyExistingChange(change);
    }

    private static string RequestTab(string? fieldKey)
    {
        if (string.IsNullOrWhiteSpace(fieldKey)) return "personal";
        if (fieldKey.StartsWith("documents.", StringComparison.OrdinalIgnoreCase)) return "documents";
        if (fieldKey.StartsWith("work.", StringComparison.OrdinalIgnoreCase)) return "work";
        if (fieldKey.StartsWith("education.", StringComparison.OrdinalIgnoreCase)) return "education";
        if (fieldKey.StartsWith("training.", StringComparison.OrdinalIgnoreCase)) return "training";
        if (fieldKey.StartsWith("family.", StringComparison.OrdinalIgnoreCase)) return "family";
        if (fieldKey.StartsWith("accounting.", StringComparison.OrdinalIgnoreCase)) return "accounting";
        if (fieldKey.StartsWith("internal.", StringComparison.OrdinalIgnoreCase) &&
            !fieldKey.Equals("internal.macAddress", StringComparison.OrdinalIgnoreCase)) return "internal";
        if (fieldKey is "email" or "lotusNotesEmail") return "internal";
        return "personal";
    }

