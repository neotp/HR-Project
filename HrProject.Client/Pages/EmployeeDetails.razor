        internalWorkSchedule = employee.WorkSchedule;
        internalWorkLocation = employee.WorkLocation;
        internalExtension = employee.InternalExtension;
        internalDirectPhone = employee.DirectPhone;
        internalCompanyMobile = employee.CompanyMobile;
        internalMacAddress = employee.MacAddress;
        internalBranchCode = employee.BranchCode;
        internalBranchName = employee.BranchName;
        internalResponsibilityProvince = employee.ResponsibilityProvince;
        internalChecklistType = employee.ChecklistType;
        internalProductsResponsible = employee.ProductsResponsible;
        internalAppointmentDate = employee.AppointmentDate;
        internalProvidentFundStartDate = employee.ProvidentFundStartDate;
        internalWorkExperienceType = employee.WorkExperienceType;
        internalHasCompanyParking = ParkingEditValue(employee.HasCompanyParking);
        internalEmployeeStatus = employee.EmployeeStatus;
        workCompany = employee.PreviousCompany;
        workPosition = employee.PreviousPosition;
        workPeriod = employee.PreviousWorkPeriod;
        workDetails = employee.PreviousWorkDetails;
        educationLevel = employee.EducationLevel;
        educationInstitution = employee.EducationInstitution;
        educationMajor = employee.EducationMajor;
