                                <label>Reporting To (Leave Approve)
                                    <RemoteEmployeeSearchSelect Value="@internalLeaveApproverEmployeeId"
                                                                ValueChanged="value => internalLeaveApproverEmployeeId = value"
                                                                EmployeeChanged="SelectInternalLeaveApprover"
                                                                SelectedDisplayText="@ManagerDisplayText(internalLeaveApproverName, internalLeaveApproverEmployeeId)"
                                                                ExcludeEmployeeCode="@(employee?.EmployeeCode ?? string.Empty)"
                                                                Placeholder="-- เลือกหรือพิมพ์ค้นหาผู้อนุมัติลา --" />
