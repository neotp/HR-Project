    private bool IsOwnEmployee => employee is not null && currentUser is not null &&
        string.Equals(employee.EmployeeCode, currentUser.EmployeeId, StringComparison.OrdinalIgnoreCase);
    private IEnumerable<(string Key, string Label)> VisibleTabs => Tabs.Where(tab =>
        tab.Key == "basic" ||
        (tab.Key == "personal" && (IsOwnEmployee || allowedActions.Contains("VIEW_PERSONAL"))) ||
        (tab.Key == "internal" && (IsOwnEmployee || allowedActions.Contains("VIEW_COMPANY") || allowedActions.Contains("EDIT_INTERNAL"))) ||
        (tab.Key == "accounting" && (allowedActions.Contains("VIEW_ACCOUNTING") || allowedActions.Contains("EDIT_ACCOUNTING"))) ||
        (tab.Key == "work" && (IsOwnEmployee || allowedActions.Contains("VIEW_WORK_HISTORY") || allowedActions.Contains("EDIT_WORK_HISTORY"))) ||
        (tab.Key == "education" && (IsOwnEmployee || allowedActions.Contains("VIEW_EDUCATION"))) ||
        (tab.Key == "training" && (IsOwnEmployee || allowedActions.Contains("VIEW_TRAINING") || allowedActions.Contains("EDIT_TRAINING"))) ||
        (tab.Key == "family" && (IsOwnEmployee || allowedActions.Contains("VIEW_TAX_DEDUCTION"))) ||
        (tab.Key == "documents" && (IsOwnEmployee || allowedActions.Contains("VIEW_PERSONAL_DOCUMENTS"))) ||
        (tab.Key == "recruit-documents" && allowedActions.Contains("VIEW_RECRUIT_DOCUMENTS")) ||
        (tab.Key == "change-history" && allowedActions.Contains("VIEW_CHANGE_HISTORY")));

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        employee = null;
        currentUser = null;
        allowedActions = new(StringComparer.OrdinalIgnoreCase);
        activeTab = "basic";
        try
        {
            employee = await Http.GetFromJsonAsync<Employee>($"api/employees/{Id}");
            try
            {
                currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
                if (!string.IsNullOrWhiteSpace(currentUser?.EmployeeId))
                {
                    var permissions = await Http.GetFromJsonAsync<CurrentPageActionPermissionsDto>(
                        $"api/page-permissions/current-actions?employeeId={Uri.EscapeDataString(currentUser.EmployeeId)}&pageKey=EMPLOYEES");
                    allowedActions = permissions?.AllowedActions.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
                }
            }
            catch (HttpRequestException)
            {
                allowedActions = new(StringComparer.OrdinalIgnoreCase);
            }

            if (EditRequestId.HasValue && openedEditRequestId != EditRequestId.Value)
                await OpenExistingEditRequest(EditRequestId.Value);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            employee = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BackToList() => Navigation.NavigateTo(SourcePage?.ToLowerInvariant() switch
    {
        "resigned" => "/employees/resigned",
        "my-edit-requests" => "/employees/my-edit-requests",
        _ => "/"
    });

    private async Task OpenEditor()
    {
        if (employee is null || isPreparingEditor)
            return;

        if (!CanRequestEdit(activeTab) && !CanDirectEdit(activeTab))
            return;

        isPreparingEditor = true;
        actionMessage = null;
        try
        {
            PrepareEditorForActiveTab();
            isEditRequestOpen = true;
            await InvokeAsync(StateHasChanged);

            if ((activeTab is "personal" or "internal") && masterItems.Count == 0)
            {
                var backgroundHttp = HttpClientFactory.CreateClient("HrApiBackground");
                masterItems = await backgroundHttp.GetFromJsonAsync<List<MasterDataItemDto>>(
                    "api/system-master-data/items/all") ?? [];
            }
        }
        catch (Exception exception)
        {
            actionMessage = $"ไม่สามารถเตรียมข้อมูลสำหรับแก้ไขได้: {exception.Message}";
        }
        finally
        {
            isPreparingEditor = false;
        }
    }

    private void PrepareEditorForActiveTab()
    {
        if (employee is null) return;

        editActiveTab = activeTab;
        editReason = string.Empty;
        editRequestAttachments.Clear();
        editingRequest = null;
        removedEditRequestAttachmentIds.Clear();
        editAttachmentInputVersion++;
        editError = null;
        actionMessage = null;

        switch (activeTab)
        {
            case "personal":
                PreparePersonalEditor();
                break;
            case "internal":
                PrepareInternalEditor();
                break;
            case "work":
                editableWorkHistory = CloneList(employee.WorkHistory);
                break;
            case "education":
                editableEducationHistory = CloneList(employee.EducationHistory);
                break;
            case "training":
                editableTrainingHistory = CloneList(employee.TrainingHistory);
                break;
            case "accounting":
                accountingSocialSecurityNumber = employee.SocialSecurityNumber;
                accountingTaxpayerIdentificationNumber = employee.TaxpayerIdentificationNumber;
                accountingSalaryAccountNumber = employee.SalaryAccountNumber;
                break;
        }
    }

