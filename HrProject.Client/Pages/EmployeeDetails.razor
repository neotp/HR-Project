                break;
            case "education":
                AddTableChange(changes, "education.history", "รายการประวัติการศึกษา", employee.EducationHistory, editableEducationHistory);
                break;
            case "documents":
                if (editRequestAttachments.Count > 0)
                {
                    changes.Add(new EmployeeFieldChangeDto(
                        "documents.add", "เพิ่มเอกสารส่วนตัว", string.Empty,
                        string.Join(", ", editRequestAttachments.Select(item => item.FileName))));
                }
                break;
            case "training":
                AddTableChange(changes, "training.history", "รายการประวัติการอบรมและสัมมนา", employee.TrainingHistory, editableTrainingHistory);
                break;
            case "family":
                AddChange(changes, "family.maritalStatus", "สถานภาพการสมรส", employee.MaritalStatus, familyMaritalStatus);
                AddChange(changes, "family.spouseName", "ชื่อ-นามสกุลคู่สมรส", employee.SpouseName, familySpouseName);
                AddChange(changes, "family.spouseNationalId", "เลขบัตรประชาชนคู่สมรส", employee.SpouseNationalId, familySpouseNationalId);
                AddChange(changes, "family.phone", "เบอร์โทรศัพท์ครอบครัว", employee.FamilyPhone, familyPhone);
                AddChange(changes, "family.currentAddressMapUrl", "URL แผนที่อยู่ปัจจุบัน", employee.CurrentAddressMapUrl, familyCurrentAddressMapUrl);
                break;
        }

        if (changes.Count == 0 || string.IsNullOrWhiteSpace(editReason))
        {
            editError = "กรุณาแก้ไขข้อมูลอย่างน้อย 1 รายการและระบุเหตุผล";
            return;
        }

        isSubmittingEdit = true;
        try
        {
            if (editingRequest is not null)
            {
                var update = new UpdateEmployeeEditRequest(
                    changes,
                    editReason,
                    editRequestAttachments,
                    removedEditRequestAttachmentIds.ToArray());
                var updateResponse = await Http.PutAsJsonAsync(
                    $"api/employee-edit-requests/{editingRequest.Id}", update);
                if (!updateResponse.IsSuccessStatusCode)
                {
                    var details = await updateResponse.Content.ReadAsStringAsync();
                    editError = string.IsNullOrWhiteSpace(details)
                        ? $"บันทึกคำขอไม่สำเร็จ (HTTP {(int)updateResponse.StatusCode})"
                        : $"บันทึกคำขอไม่สำเร็จ: {details}";
                    return;
                }

                var updated = await updateResponse.Content.ReadFromJsonAsync<EmployeeEditRequestDto>();
                isEditRequestOpen = false;
                Navigation.NavigateTo($"/employees/my-edit-requests?requestId={updated?.Id ?? editingRequest.Id}");
                return;
            }

            var request = new CreateEmployeeEditRequest(
                employee.EmployeeCode,
                employee.FullName,
                changes,
                editReason,
                currentUser?.EmployeeId ?? employee.EmployeeCode,
                currentUser?.EmployeeName ?? currentUser?.DisplayName ?? employee.FullName,
                editRequestAttachments);
            var response = await Http.PostAsJsonAsync("api/employee-edit-requests", request);
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                editError = string.IsNullOrWhiteSpace(details)
                    ? $"ส่งคำขอไม่สำเร็จ (HTTP {(int)response.StatusCode})"
                    : $"ส่งคำขอไม่สำเร็จ: {details}";
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<EmployeeEditRequestDto>();
            isEditRequestOpen = false;
            actionMessage = $"สร้างเอกสารคำขอแก้ไข {created?.RequestNo} เรียบร้อยแล้ว";
        }
        catch (Exception exception)
        {
            editError = $"ส่งคำขอไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSubmittingEdit = false;
        }
    }

