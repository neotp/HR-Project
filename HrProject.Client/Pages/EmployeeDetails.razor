        familyMemberName = employee.FamilyMemberName;
        familyRelationship = employee.FamilyRelationship;
        familyPhone = employee.FamilyPhone;
        familyOccupation = employee.FamilyOccupation;
        familyMaritalStatus = employee.MaritalStatus;
