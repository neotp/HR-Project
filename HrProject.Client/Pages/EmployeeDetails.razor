                                <label>Buddy<input @bind="internalBuddyName" /></label>
                                <label>ประเภทพนักงานและเวลาทำงาน<MasterDataSearchSelect Items="@(MasterOptions("WORK_SCHEDULE").ToList())" Value="@internalWorkSchedule" ValueChanged="value => internalWorkSchedule = value" Placeholder="-- เลือกหรือพิมพ์ค้นหาเวลาทำงาน --" /></label>
                                <label>Ext. ภายใน<input @bind="internalExtension" /></label>
