@page "/system/master-data"
@inject HttpClient Http

<PageTitle>จัดการข้อมูลพื้นฐานระบบ | HR Project</PageTitle>

<section class="manage-page master-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1>จัดการข้อมูลพื้นฐานระบบ</h1>
                <p>กำหนดข้อมูลที่ใช้ใน Dropdown และค่าเริ่มต้นของระบบ HR</p>
            </div>
            <button class="master-add-button" type="button" disabled="@(isLoading || selectedCategory is null)"
                    @onclick="StartCreate">+ เพิ่มข้อมูล</button>
        </div>
    </header>

    <section class="content-card master-category-card">
        <div class="content-card-header">หมวดข้อมูล</div>
        <div class="content-card-body">
            <nav class="master-tabs" aria-label="หมวดข้อมูลพื้นฐาน">
                @foreach (var category in categories)
                {
                    <button type="button" class="@(selectedCategory?.Code == category.Code ? "active" : null)"
                            @onclick="() => SelectCategory(category)">@category.Name</button>
                }
            </nav>
        </div>
    </section>

    <section class="content-card master-list-card">
        <div class="content-card-header master-list-header">
            <span>@(selectedCategory?.Name ?? "ข้อมูลพื้นฐาน")</span>
            <span class="master-count">@FilteredCount รายการ</span>
        </div>
        <div class="content-card-body">
            <div class="master-search">
                <label>ค้นหา
                    <input type="search" @bind="searchText" @bind:event="oninput" @bind:after="ResetPaging"
                           placeholder="ค้นหารหัสหรือชื่อ" />
                </label>
                <div class="active-filter"><span>สถานะ</span>
                    <CriteriaMultiSelect Options="@StatusFilterOptions" Values="@selectedStatuses" ValuesChanged="SetStatusFilters" />
                </div>
            </div>

            @if (isLoading)
            {
                <div class="master-state">กำลังโหลดข้อมูล...</div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="master-state error">@loadError</div>
            }
            else
            {
                <div class="table-responsive">
                    @if (IsLeaveType)
                    {
                        <table class="table master-table">
                            <thead><tr><th>รหัส</th><th>ชื่อประเภทการลา</th><th>โควต้าเริ่มต้น</th><th>หักโบนัสเริ่มต้น</th><th>สถานะ</th><th></th></tr></thead>
                            <tbody>
                                @if (!PagedLeaveTypes.Any())
                                {
                                    <tr><td colspan="6" class="master-state">ไม่พบข้อมูล</td></tr>
                                }
                                @foreach (var item in PagedLeaveTypes)
                                {
                                    <tr>
                                        <td><code>@item.Code</code></td>
                                        <td><strong>@item.NameTh</strong></td>
                                        <td>@item.DefaultHours.ToString("0.##") ชั่วโมง (@(item.DefaultHours / 8) วัน)</td>
                                        <td>
                                            @if (item.DefaultBonusDeductionEnabled)
                                            {
                                                <span class="status-pill inactive">หัก @item.DefaultBonusDeductionPercent.ToString("0.##")%</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill active">ไม่หัก</span>
                                            }
                                        </td>
                                        <td><span class="status-pill @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</span></td>
                                        <td><button class="master-edit-button" type="button" @onclick="() => StartEditLeaveType(item)">แก้ไข</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (IsAttendanceEventType)
                    {
                        <table class="table master-table">
                            <thead><tr><th>รหัส</th><th>ชื่อภาษาไทย</th><th>ชื่อภาษาอังกฤษ</th><th>นำไปคำนวณการมาทำงาน</th><th>ลำดับ</th><th>สถานะ</th><th></th></tr></thead>
                            <tbody>
                                @if (!PagedAttendanceEventTypes.Any())
                                {
                                    <tr><td colspan="7" class="master-state">ไม่พบข้อมูล</td></tr>
                                }
                                @foreach (var item in PagedAttendanceEventTypes)
                                {
                                    <tr>
                                        <td><code>@item.Code</code></td>
                                        <td><strong>@item.NameTh</strong></td>
                                        <td>@(item.NameEn ?? "-")</td>
                                        <td><span class="status-pill @(item.CountsAsWorkTime ? "active" : "inactive")">@(item.CountsAsWorkTime ? "นำไปคำนวณ" : "ไม่คำนวณ")</span></td>
                                        <td>@item.DisplayOrder</td>
                                        <td><span class="status-pill @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</span></td>
                                        <td><button class="master-edit-button" type="button" @onclick="() => StartEditAttendanceEventType(item)">แก้ไข</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <table class="table master-table">
                            <thead>
                                <tr>
                                    <th>@(IsPostalCode ? "รหัสไปรษณีย์" : "รหัส")</th>
                                    @if (HasParentCategory) { <th>@ParentCategoryLabel</th> }
                                    @if (!IsPostalCode)
                                    {
                                        <th>ชื่อภาษาไทย</th>
                                        <th>ชื่อภาษาอังกฤษ</th>
                                    }
                                    <th>ลำดับ</th><th>สถานะ</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!PagedItems.Any())
                                {
                                    <tr><td colspan="@MasterItemColumnCount" class="master-state">ไม่พบข้อมูล</td></tr>
                                }
                                @foreach (var item in PagedItems)
                                {
                                    <tr>
                                        <td><code>@item.ItemCode</code></td>
                                        @if (HasParentCategory) { <td><strong>@item.ParentItemName</strong></td> }
                                        @if (!IsPostalCode)
                                        {
                                            <td><strong>@item.NameTh</strong></td>
                                            <td>@(item.NameEn ?? "-")</td>
                                        }
                                        <td>@item.DisplayOrder</td>
                                        <td><span class="status-pill @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</span></td>
                                        <td><button class="master-edit-button" type="button" @onclick="() => StartEditItem(item)">แก้ไข</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <Pagination TotalItems="@FilteredCount" @bind-CurrentPage="currentPage" @bind-PageSize="pageSize" />
            }
        </div>
    </section>
</section>

@if (isEditorOpen)
{
    <div class="master-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="master-editor-title">
        <section class="master-modal">
            <header class="master-modal-header">
                <div>
                    <h2 id="master-editor-title">@(editingId.HasValue ? "แก้ไข" : "เพิ่ม") @(selectedCategory?.Name)</h2>
                    <p>ข้อมูลที่เปิดใช้งานจะแสดงใน Dropdown ของระบบ</p>
                </div>
                <button type="button" aria-label="ปิด" disabled="@isSaving" @onclick="CloseEditor">×</button>
            </header>
            <div class="master-modal-body">
                <div class="master-form-grid">
                    <label>@(IsPostalCode ? "รหัสไปรษณีย์" : "รหัส") *
                        <input @bind="editCode" maxlength="@(IsPostalCode ? 5 : 100)" placeholder="@(IsPostalCode ? "เช่น 10110" : "เช่น IS")"
                               disabled="@(IsAttendanceEventType && editingId.HasValue)" />
                    </label>
                    @if (!IsPostalCode)
                    {
                        <label>ชื่อภาษาไทย *
                            <input @bind="editNameTh" maxlength="250" />
                        </label>
                    }
                    @if (IsLeaveType)
                    {
                        <label>จำนวนเริ่มต้น (ชั่วโมง) *
                            <input type="number" min="0" step="0.5" @bind="editDefaultHours" />
                        </label>
                        <label>เทียบเป็นวัน
                            <input value="@((editDefaultHours / 8).ToString("0.##")) วัน" disabled />
                        </label>
                        <label class="master-active-check">
                            <input type="checkbox" @bind="editDefaultBonusDeductionEnabled" />
                            หักโบนัสเป็นค่าเริ่มต้น
                        </label>
                        <label>เปอร์เซ็นต์หักโบนัสเริ่มต้น
                            <input type="number" min="0" max="100" step="0.01"
                                   disabled="@(!editDefaultBonusDeductionEnabled)"
                                   @bind="editDefaultBonusDeductionPercent" />
                        </label>
                    }
                    else if (IsAttendanceEventType)
                    {
                        <label>ชื่อภาษาอังกฤษ
                            <input @bind="editNameEn" maxlength="200" />
                        </label>
                        <label>ลำดับแสดงผล
                            <input type="number" min="0" @bind="editDisplayOrder" />
                        </label>
                        <label class="master-active-check">
                            <input type="checkbox" @bind="editCountsAsWorkTime" />
                            นำช่วงเวลา Event ไปคำนวณการมาทำงาน
                        </label>
                    }
                    else
                    {
                        @if (HasParentCategory)
                        {
                            <label>@ParentCategoryLabel *
                                <select @bind="editParentItemId">
                                    <option value="">-- เลือก @ParentCategoryLabel --</option>
                                    @foreach (var parent in ParentOptions)
                                    {
                                        <option value="@parent.Id">@parent.NameTh</option>
                                    }
                                </select>
                            </label>
                        }
                        @if (!IsPostalCode)
                        {
                            <label>ชื่อภาษาอังกฤษ
                                <input @bind="editNameEn" maxlength="250" />
                            </label>
                        }
                        <label>ลำดับแสดงผล
                            <input type="number" min="0" @bind="editDisplayOrder" />
                        </label>
                    }
                    <label class="master-active-check">
                        <input type="checkbox" @bind="editIsActive" />
                        เปิดใช้งาน
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <div class="master-save-error" role="alert">@saveError</div>
                }
            </div>
            <footer class="master-modal-footer">
                <button class="btn master-close-button" type="button" disabled="@isSaving" @onclick="CloseEditor">ปิด</button>
                <button class="btn master-save-button" type="button" disabled="@isSaving" @onclick="Save">
                    @(isSaving ? "กำลังบันทึก..." : "บันทึก")
                </button>
            </footer>
        </section>
    </div>
}

@code {
    private List<MasterDataCategoryDto> categories = [];
    private List<MasterDataItemDto> items = [];
    private List<MasterDataItemDto> allMasterItems = [];
    private List<LeaveTypeMasterDto> leaveTypes = [];
    private List<AttendanceEventTypeMasterDto> attendanceEventTypes = [];
    private MasterDataCategoryDto? selectedCategory;
    private bool isLoading = true;
    private bool isEditorOpen;
    private bool isSaving;
    private string? loadError;
    private string? saveError;
    private string searchText = string.Empty;
    private readonly HashSet<string> selectedStatuses = new(StringComparer.OrdinalIgnoreCase);
    private static readonly IReadOnlyList<CriteriaFilterOption> StatusFilterOptions = [new("ACTIVE", "ใช้งาน"), new("INACTIVE", "ปิดใช้งาน")];
    private int currentPage = 1;
    private int pageSize = 10;
    private long? editingId;
    private string editCode = string.Empty;
    private string editNameTh = string.Empty;
    private string editNameEn = string.Empty;
    private int editDisplayOrder;
    private decimal editDefaultHours;
    private bool editDefaultBonusDeductionEnabled;
    private decimal editDefaultBonusDeductionPercent;
    private bool editCountsAsWorkTime;
    private bool editIsActive = true;
    private string editParentItemId = string.Empty;

    private bool IsLeaveType => selectedCategory?.IsLeaveType == true;
    private bool IsAttendanceEventType => selectedCategory?.IsAttendanceEventType == true;
    private bool IsPostalCode => string.Equals(selectedCategory?.Code, "POSTAL_CODE", StringComparison.OrdinalIgnoreCase);
    private int MasterItemColumnCount => (HasParentCategory ? 1 : 0) + (IsPostalCode ? 4 : 6);
    private string? ParentCategoryCode => selectedCategory?.Code switch
    {
        "DEPARTMENT" => "BUSINESS_UNIT",
        "DISTRICT" => "PROVINCE",
        "SUBDISTRICT" => "DISTRICT",
        "POSTAL_CODE" => "SUBDISTRICT",
        _ => null
    };
    private bool HasParentCategory => ParentCategoryCode is not null;
    private string ParentCategoryLabel => ParentCategoryCode switch
    {
        "BUSINESS_UNIT" => "Business Unit",
        "PROVINCE" => "จังหวัด",
        "DISTRICT" => "อำเภอ / เขต",
        "SUBDISTRICT" => "ตำบล / แขวง",
        _ => "ข้อมูลแม่"
    };
    private IEnumerable<MasterDataItemDto> ParentOptions => allMasterItems.Where(item =>
        item.IsActive && string.Equals(item.CategoryCode, ParentCategoryCode, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<MasterDataItemDto> FilteredItems => items.Where(item =>
        MatchesStatus(item.IsActive) &&
        (string.IsNullOrWhiteSpace(searchText) ||
         item.ItemCode.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         item.NameTh.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         (item.ParentItemName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (item.NameEn?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)));
    private IEnumerable<LeaveTypeMasterDto> FilteredLeaveTypes => leaveTypes.Where(item =>
        MatchesStatus(item.IsActive) &&
        (string.IsNullOrWhiteSpace(searchText) ||
         item.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         item.NameTh.Contains(searchText, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<AttendanceEventTypeMasterDto> FilteredAttendanceEventTypes => attendanceEventTypes.Where(item =>
        MatchesStatus(item.IsActive) &&
        (string.IsNullOrWhiteSpace(searchText) ||
         item.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         item.NameTh.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
         (item.NameEn?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)));
    private int FilteredCount => IsLeaveType
        ? FilteredLeaveTypes.Count()
        : IsAttendanceEventType ? FilteredAttendanceEventTypes.Count() : FilteredItems.Count();
    private int SafePage => Math.Clamp(currentPage, 1, Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)pageSize)));
    private IEnumerable<MasterDataItemDto> PagedItems => FilteredItems.Skip((SafePage - 1) * pageSize).Take(pageSize);
    private IEnumerable<LeaveTypeMasterDto> PagedLeaveTypes => FilteredLeaveTypes.Skip((SafePage - 1) * pageSize).Take(pageSize);
    private IEnumerable<AttendanceEventTypeMasterDto> PagedAttendanceEventTypes =>
        FilteredAttendanceEventTypes.Skip((SafePage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<MasterDataCategoryDto>>("api/system-master-data/categories") ?? [];
            selectedCategory = categories.FirstOrDefault();
            await LoadData();
        }
        catch (Exception exception)
        {
            loadError = $"โหลดข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectCategory(MasterDataCategoryDto category)
    {
        selectedCategory = category;
        searchText = string.Empty;
        selectedStatuses.Clear();
        currentPage = 1;
        await LoadData();
    }

    private async Task LoadData()
    {
        if (selectedCategory is null) return;
        isLoading = true;
        loadError = null;
        try
        {
            if (IsLeaveType)
                leaveTypes = await Http.GetFromJsonAsync<List<LeaveTypeMasterDto>>("api/system-master-data/leave-types") ?? [];
            else if (IsAttendanceEventType)
                attendanceEventTypes = await Http.GetFromJsonAsync<List<AttendanceEventTypeMasterDto>>(
                    "api/system-master-data/attendance-event-types?includeInactive=true") ?? [];
            else
                items = await Http.GetFromJsonAsync<List<MasterDataItemDto>>(
                    $"api/system-master-data/items?category={Uri.EscapeDataString(selectedCategory.Code)}&includeInactive=true") ?? [];
        }
        catch (Exception exception)
        {
            loadError = $"โหลดข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartCreate()
    {
        await EnsureParentOptionsLoaded();
        editingId = null;
        editCode = editNameTh = editNameEn = string.Empty;
        editDisplayOrder = 0;
        editDefaultHours = 0;
        editDefaultBonusDeductionEnabled = false;
        editDefaultBonusDeductionPercent = 0;
        editCountsAsWorkTime = false;
        editIsActive = true;
        editParentItemId = string.Empty;
        saveError = null;
        isEditorOpen = true;
    }

    private async Task StartEditItem(MasterDataItemDto item)
    {
        await EnsureParentOptionsLoaded();
        editingId = item.Id;
        editCode = item.ItemCode;
        editNameTh = item.NameTh;
        editNameEn = item.NameEn ?? string.Empty;
        editDisplayOrder = item.DisplayOrder;
        editIsActive = item.IsActive;
        editParentItemId = item.ParentItemId?.ToString() ?? string.Empty;
        saveError = null;
        isEditorOpen = true;
    }

    private async Task EnsureParentOptionsLoaded()
    {
        if (!HasParentCategory || string.IsNullOrWhiteSpace(ParentCategoryCode)) return;
        if (allMasterItems.Any(item =>
                string.Equals(item.CategoryCode, ParentCategoryCode, StringComparison.OrdinalIgnoreCase))) return;

        var parentItems = await Http.GetFromJsonAsync<List<MasterDataItemDto>>(
            $"api/system-master-data/items?category={Uri.EscapeDataString(ParentCategoryCode)}&includeInactive=true") ?? [];
        var knownIds = allMasterItems.Select(item => item.Id).ToHashSet();
        allMasterItems.AddRange(parentItems.Where(item => knownIds.Add(item.Id)));
    }

    private void StartEditLeaveType(LeaveTypeMasterDto item)
    {
        editingId = item.Id;
        editCode = item.Code;
        editNameTh = item.NameTh;
        editDefaultHours = item.DefaultHours;
        editDefaultBonusDeductionEnabled = item.DefaultBonusDeductionEnabled;
        editDefaultBonusDeductionPercent = item.DefaultBonusDeductionPercent;
        editIsActive = item.IsActive;
        saveError = null;
        isEditorOpen = true;
    }

    private void StartEditAttendanceEventType(AttendanceEventTypeMasterDto item)
    {
        editingId = item.Id;
        editCode = item.Code;
        editNameTh = item.NameTh;
        editNameEn = item.NameEn ?? string.Empty;
        editCountsAsWorkTime = item.CountsAsWorkTime;
        editDisplayOrder = item.DisplayOrder;
        editIsActive = item.IsActive;
        saveError = null;
        isEditorOpen = true;
    }

    private async Task Save()
    {
        if (selectedCategory is null || string.IsNullOrWhiteSpace(editCode) || (!IsPostalCode && string.IsNullOrWhiteSpace(editNameTh)))
        {
            saveError = IsPostalCode ? "กรุณากรอกรหัสไปรษณีย์" : "กรุณากรอกรหัสและชื่อให้ครบถ้วน";
            return;
        }

        if (IsPostalCode && (editCode.Length != 5 || !editCode.All(char.IsDigit)))
        {
            saveError = "รหัสไปรษณีย์ต้องเป็นตัวเลข 5 หลัก";
            return;
        }
        isSaving = true;
        saveError = null;
        try
        {
            HttpResponseMessage response;
            if (IsLeaveType)
            {
                var request = new SaveLeaveTypeMasterRequest(
                    editCode, editNameTh, editDefaultHours,
                    editDefaultBonusDeductionEnabled,
                    editDefaultBonusDeductionPercent,
                    editIsActive);
                response = editingId.HasValue
                    ? await Http.PutAsJsonAsync($"api/system-master-data/leave-types/{editingId.Value}", request)
                    : await Http.PostAsJsonAsync("api/system-master-data/leave-types", request);
            }
            else if (IsAttendanceEventType)
            {
                var request = new SaveAttendanceEventTypeMasterRequest(
                    editCode, editNameTh, editNameEn, editCountsAsWorkTime,
                    editDisplayOrder, editIsActive);
                response = editingId.HasValue
                    ? await Http.PutAsJsonAsync($"api/system-master-data/attendance-event-types/{editingId.Value}", request)
                    : await Http.PostAsJsonAsync("api/system-master-data/attendance-event-types", request);
            }
            else
            {
                long? parentItemId = null;
                if (HasParentCategory)
                {
                    if (!long.TryParse(editParentItemId, out var parsedParentId))
                    {
                        saveError = $"กรุณาเลือก {ParentCategoryLabel}";
                        return;
                    }
                    parentItemId = parsedParentId;
                }
                var storedNameTh = IsPostalCode ? editCode.Trim() : editNameTh;
                var storedNameEn = IsPostalCode ? editCode.Trim() : editNameEn;
                var request = new SaveMasterDataItemRequest(
                    selectedCategory.Code, editCode, storedNameTh, storedNameEn,
                    editDisplayOrder, editIsActive, parentItemId);
                response = editingId.HasValue
                    ? await Http.PutAsJsonAsync($"api/system-master-data/items/{editingId.Value}", request)
                    : await Http.PostAsJsonAsync("api/system-master-data/items", request);
            }
            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                saveError = string.IsNullOrWhiteSpace(details) ? "บันทึกข้อมูลไม่สำเร็จ" : details.Trim('"');
                return;
            }
            isEditorOpen = false;
            await LoadData();
        }
        catch (Exception exception)
        {
            saveError = $"บันทึกข้อมูลไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool MatchesStatus(bool isActive) => selectedStatuses.Count == 0 ||
        (selectedStatuses.Contains("ACTIVE") && isActive) ||
        (selectedStatuses.Contains("INACTIVE") && !isActive);
    private Task SetStatusFilters(IReadOnlyCollection<string> values)
    {
        selectedStatuses.Clear(); selectedStatuses.UnionWith(values); ResetPaging();
        return Task.CompletedTask;
    }
    private void ResetPaging() => currentPage = 1;
    private void CloseEditor() { if (!isSaving) isEditorOpen = false; }
}
