@page "/forgot-password"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject LocalAuthSession LocalSession

<PageTitle>ลืมรหัสผ่าน | HR Project</PageTitle>

<main class="local-auth-page">
    <section class="local-auth-card">
        <img src="images/image.png" alt="SiS logo" />
        <h1>ลืมรหัสผ่าน</h1>
        <p>ส่งคำขอให้ผู้ดูแลระบบรีเซ็ตรหัสผ่าน</p>
        @if (submitted)
        {
            <div class="local-auth-success" role="status">
                รับคำขอแล้ว หากพบบัญชีในระบบ ผู้ดูแลจะได้รับรายการเพื่อดำเนินการ
            </div>
            <a class="local-auth-submit local-auth-link-button" href="local-login">กลับหน้าเข้าสู่ระบบ</a>
        }
        else
        {
            <EditForm class="local-auth-form" Model="form" OnValidSubmit="Submit">
                <div class="form-field">
                    <label for="account-lookup">ชื่อผู้ใช้หรือรหัสพนักงาน</label>
                    <InputText id="account-lookup" @bind-Value="form.Lookup" disabled="@isSaving"
                               autocomplete="username" autofocus />
                </div>
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="login-error" role="alert">@error</div>
                }
                <button class="local-auth-submit" type="submit"
                        disabled="@(isSaving || string.IsNullOrWhiteSpace(form.Lookup))">
                    @(isSaving ? "กำลังส่งคำขอ..." : "ส่งคำขอรีเซ็ตรหัสผ่าน")
                </button>
            </EditForm>
            <div class="local-auth-help centered"><a href="local-login">กลับหน้าเข้าสู่ระบบ</a></div>
        }
    </section>
</main>

@code {
    private readonly FormModel form = new();
    private bool isSaving;
    private bool submitted;
    private string? error;

    private async Task Submit()
    {
        isSaving = true; error = null;
        try { await LocalSession.RequestPasswordResetAsync(form.Lookup.Trim()); submitted = true; }
        catch (Exception exception) { error = exception.Message; }
        finally { isSaving = false; }
    }

    private sealed class FormModel { public string Lookup { get; set; } = string.Empty; }
}
