    private string Initials() => string.Concat(new[] { employee.FirstName, employee.LastName }.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim()[0])).ToUpperInvariant() is var value && value.Length > 0 ? value : "P";
