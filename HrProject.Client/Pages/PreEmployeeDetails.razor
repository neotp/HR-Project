    {
        employee.SupervisorEmployeeId = employeeCode;
        employee.SupervisorName = EmployeeName(employeeCode);
    }
    private void SelectLeaveApprover(string employeeCode)
    {
        employee.LeaveApproverEmployeeId = employeeCode;
        employee.LeaveApproverName = EmployeeName(employeeCode);
    }
    private void SetResponsibilityProvinces(List<string> values)
    {
        employee.ResponsibilityProvinces = [.. values];
        employee.ResponsibilityProvince = string.Join(", ", values);
    }
    private string EmployeeName(string employeeCode) => employeeOptions.FirstOrDefault(x =>
        string.Equals(x.EmployeeCode, employeeCode, StringComparison.OrdinalIgnoreCase))?.FullName ?? "";
    private IEnumerable<MasterDataItemDto> MasterOptions(string categoryCode) => masterItems
        .Where(item => item.IsActive && string.Equals(item.CategoryCode, categoryCode, StringComparison.OrdinalIgnoreCase))
        .OrderBy(item => item.DisplayOrder)
        .ThenBy(item => item.NameTh);
    private IEnumerable<MasterDataItemDto> ResidenceDistrictOptions => ChildAddressOptions("DISTRICT", "PROVINCE", employee.ResidenceProvince);
    private IEnumerable<MasterDataItemDto> ResidenceSubdistrictOptions => ChildAddressOptions("SUBDISTRICT", "DISTRICT", employee.ResidenceDistrict, ResidenceDistrictOptions);
    private IEnumerable<MasterDataItemDto> ResidencePostalCodeOptions => ChildAddressOptions("POSTAL_CODE", "SUBDISTRICT", employee.ResidenceSubdistrict, ResidenceSubdistrictOptions);
    private IEnumerable<MasterDataItemDto> DepartmentOptions => ChildAddressOptions("DEPARTMENT", "BUSINESS_UNIT", employee.BusinessUnit);
    private IEnumerable<MasterDataItemDto> ChildAddressOptions(string childCategory, string parentCategory, string parentName, IEnumerable<MasterDataItemDto>? parents = null)
    {
        var parent = (parents ?? MasterOptions(parentCategory)).FirstOrDefault(item => string.Equals(item.NameTh, parentName, StringComparison.OrdinalIgnoreCase));
        return parent is null ? [] : MasterOptions(childCategory).Where(item => item.ParentItemId == parent.Id);
    }
    private void ResidenceProvinceChanged() { employee.ResidenceDistrict = ""; employee.ResidenceSubdistrict = ""; employee.ResidencePostalCode = ""; }
    private void ResidenceDistrictChanged() { employee.ResidenceSubdistrict = ""; employee.ResidencePostalCode = ""; }
    private void ResidenceSubdistrictChanged()
    {
        var postalCodes = ResidencePostalCodeOptions.ToList();
        employee.ResidencePostalCode = postalCodes.Count == 1 ? postalCodes[0].NameTh : "";
    }
    private void ResidenceProvinceSelected(string value) { employee.ResidenceProvince = value; ResidenceProvinceChanged(); }
    private void ResidenceDistrictSelected(string value) { employee.ResidenceDistrict = value; ResidenceDistrictChanged(); }
    private void ResidenceSubdistrictSelected(string value) { employee.ResidenceSubdistrict = value; ResidenceSubdistrictChanged(); }
    private void ResidencePostalCodeSelected(string value) => employee.ResidencePostalCode = value;
    private void BusinessUnitSelected(string value)
    {
        employee.BusinessUnit = value;
        if (!DepartmentOptions.Any(item => string.Equals(item.NameTh, employee.Department, StringComparison.OrdinalIgnoreCase)))
            employee.Department = "";
    }
    private Task LoadDepartmentOptions() => LoadChildOptions("DEPARTMENT", "BUSINESS_UNIT", employee.BusinessUnit);
    private Task LoadResidenceDistrictOptions() => LoadChildOptions("DISTRICT", "PROVINCE", employee.ResidenceProvince);
    private Task LoadResidenceSubdistrictOptions() => LoadChildOptions("SUBDISTRICT", "DISTRICT", employee.ResidenceDistrict, ResidenceDistrictOptions);
    private Task LoadResidencePostalCodeOptions() => LoadChildOptions("POSTAL_CODE", "SUBDISTRICT", employee.ResidenceSubdistrict, ResidenceSubdistrictOptions);
    private async Task LoadChildOptions(string childCategory, string parentCategory, string parentName, IEnumerable<MasterDataItemDto>? parents = null)
    {
        if (string.IsNullOrWhiteSpace(parentName)) return;
        var parent = (parents ?? MasterOptions(parentCategory)).FirstOrDefault(item =>
            string.Equals(item.NameTh, parentName, StringComparison.OrdinalIgnoreCase));
        if (parent is null) return;
        var children = await MasterDataLookup.GetChildrenAsync(childCategory, parent.Id);
        var existingIds = masterItems.Select(item => item.Id).ToHashSet();
        masterItems.AddRange(children.Where(item => existingIds.Add(item.Id)));
    }
    private void ResolveLegacyManagerIds()
    {
        if (string.IsNullOrWhiteSpace(employee.SupervisorEmployeeId)) employee.SupervisorEmployeeId = FindEmployeeCode(employee.SupervisorName);
        if (string.IsNullOrWhiteSpace(employee.LeaveApproverEmployeeId)) employee.LeaveApproverEmployeeId = FindEmployeeCode(employee.LeaveApproverName);
    }
    private string FindEmployeeCode(string name) => employeeOptions.FirstOrDefault(x =>
        string.Equals(x.EmployeeCode,name,StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x.FullName,name,StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x.ThaiFullName,name,StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x.EnglishFullName,name,StringComparison.OrdinalIgnoreCase))?.EmployeeCode ?? "";
    private void SetStartDate(DateOnly? value) => employee.StartDate = value ?? default;
    private void AddWorkHistory() => employee.WorkHistory.Add(new());
    private void AddEducationHistory() => employee.EducationHistory.Add(new());
    private void AddTrainingHistory() => employee.TrainingHistory.Add(new());
