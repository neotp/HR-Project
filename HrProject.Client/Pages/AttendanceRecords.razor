@page "/attendance/records"
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>การมาทำงาน | HR Project</PageTitle>

<section class="manage-page attendance-records-page">
    <header class="page-header-card"><div class="page-header-content"><div class="page-header-text">
        <h1><span class="records-header-icon" aria-hidden="true">◷</span> การมาทำงาน</h1>
        <p>ตรวจสอบประวัติและส่งข้อโต้แย้งรายการการมาทำงานของคุณ</p>
    </div></div></header>

    <section class="issue-summary" aria-label="สรุปการมาทำงานของฉัน">
        <article class="issue-summary-card late-summary"><span class="summary-icon">◷</span><div><span>มาสายทั้งหมด</span><strong>@LateCount</strong><small>วัน</small></div></article>
        <article class="issue-summary-card absent-summary"><span class="summary-icon">!</span><div><span>ขาดงานทั้งหมด</span><strong>@AbsentCount</strong><small>วัน</small></div></article>
    </section>

    <section class="content-card criteria-card">
        <div class="content-card-header">ค้นหาประวัติการมาทำงาน</div>
        <div class="content-card-body issue-criteria-grid">
            <div class="criteria-multiselect-field">
                <span>สถานะ</span>
                <details class="status-multiselect">
                    <summary><span>@StatusFilterSummary</span><span class="status-multiselect-chevron" aria-hidden="true">⌄</span></summary>
                    <div class="status-multiselect-menu">
                        <button class="status-filter-clear" type="button" @onclick="ClearStatusSelection">แสดงทั้งหมด</button>
                        @foreach (var option in StatusFilterOptions)
                        {
                            <label class="status-multiselect-option">
                                <input type="checkbox" checked="@selectedStatuses.Contains(option.Code)" @onchange="args => SetStatusFilter(option.Code, args.Value is true)" />
                                <span class="issue-status @option.CssClass">@option.Label</span>
                            </label>
                        }
                    </div>
                </details>
            </div>
            <label>วันที่เริ่มต้น<DateOnlyPicker @bind-Value="startDate" @bind-Value:after="ApplyFilter" AriaLabel="วันที่เริ่มต้น" /></label>
            <label>วันที่สิ้นสุด<DateOnlyPicker @bind-Value="endDate" @bind-Value:after="ApplyFilter" AriaLabel="วันที่สิ้นสุด" /></label>
            <button class="clear-filter-button" type="button" @onclick="ClearFilter">ล้างข้อมูล</button>
        </div>
    </section>

    <section class="content-card records-card">
        <div class="content-card-header records-card-header"><span>รายการการมาทำงานของฉัน</span><span class="record-count">@filteredRecords.Count รายการ</span></div>
        <div class="records-table-scroll"><table class="records-table">
            <thead><tr><th>วันที่</th><th>สถานะ</th><th>เวลาเข้า</th><th>เวลาออก</th><th>มาสาย</th><th>หมายเหตุ</th><th>ดำเนินการ</th></tr></thead>
            <tbody>
            @if (isLoading) { <tr><td colspan="7"><div class="records-loading"><span></span>กำลังโหลดข้อมูลการมาทำงาน...</div></td></tr> }
            else if (!string.IsNullOrWhiteSpace(loadError)) { <tr><td colspan="7"><div class="records-load-error">@loadError</div></td></tr> }
            else if (PagedRecords.Count == 0) { <tr><td colspan="7"><div class="records-empty-state"><span class="empty-icon">✓</span><strong>ไม่พบรายการการมาทำงาน</strong><span>ลองเปลี่ยนสถานะหรือช่วงวันที่ที่ใช้ค้นหา</span></div></td></tr> }
            else
            {
                @foreach (var record in PagedRecords)
                {
                    <tr class="@(expandedCommentDailyId == record.Id ? "comment-row-open" : null)">
                        <td>
                            <CommentToggleButton CommentCount="@record.CommentCount"
                                                 IsExpanded="@(expandedCommentDailyId == record.Id)"
                                                 AriaLabel="@($"ความคิดเห็นวันที่ {record.WorkDate:dd/MM/yyyy}")"
                                                 OnToggle="() => ToggleComments(record.Id)" />
                            @record.WorkDate.ToString("dd/MM/yyyy")
                        </td>
                        <td><div class="attendance-result-tags"><span class="issue-status @StatusClass(record)">@StatusText(record)</span>@if (record.IsWorkDayInProgress && record.FinalStatus != "IN_PROGRESS") { <span class="issue-status status-inprogress">อยู่ระหว่างวันทำงาน</span> }@if (record.RequiresReview) { <span class="issue-status status-reviewrequired">รอตรวจสอบ</span> }</div></td>
                        <td>@DisplayTime(record.FirstScanAt)@if (record.FirstScanSource == "WIFI") { <small class="ms-1">Wi-Fi</small> }</td><td>@DisplayTime(record.LastScanAt)</td>
                        <td>@(record.LateMinutes > 0 ? $"{record.LateMinutes} นาที" : "-")</td>
                        <td>@(record.OverrideReason ?? record.ReviewReason ?? "-")</td>
                        <td>
                            <div class="record-actions">
                                @if (HasResponseHistory(record.Id))
                                {
                                    <button class="history-button" type="button" @onclick="() => OpenHistory(record.Id)">ดูประวัติข้อโต้แย้ง</button>
                                }
                                @if (CanSubmitResponse(record))
                                {
                                    <button class="response-button" type="button" @onclick="() => OpenResponse(record)">ข้อโต้แย้ง</button>
                                }
                                else if (!HasResponseHistory(record.Id))
                                {
                                    <span class="response-unavailable">@ResponseUnavailableText(record)</span>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (expandedCommentDailyId == record.Id)
                    {
                        <tr class="comment-detail-row">
                            <td colspan="7">
                                <LeaveCommentThread EntityId="@record.Id" ApiPath="@($"api/attendance/{record.Id}/comments")" DocumentLabel="@($"รายการการมาทำงาน {record.WorkDate:dd/MM/yyyy}")" CurrentEmployeeId="@currentEmployeeId" CommentCountChanged="count => UpdateCommentCount(record.Id,count)" />
                            </td>
                        </tr>
                    }
                }
            }
            </tbody>
        </table></div>
        @if (filteredRecords.Count > 0) { <Pagination TotalItems="@filteredRecords.Count" @bind-CurrentPage="currentPage" @bind-PageSize="pageSize" /> }
    </section>
</section>

@if (selectedRecord is not null)
{
    <div class="response-overlay" role="dialog" aria-modal="true" aria-labelledby="response-title" @onclick="CloseResponse">
        <section class="response-modal" @onclick:stopPropagation="true">
            <header class="response-modal-header"><div><h2 id="response-title">Response/ข้อโต้แย้ง</h2><p>วันที่ @selectedRecord.WorkDate.ToString("dd/MM/yyyy") · @StatusText(selectedRecord)@(selectedRecord.RequiresReview ? " · รอตรวจสอบ" : "")</p></div><button type="button" aria-label="ปิด" disabled="@isSubmitting" @onclick="CloseResponse">×</button></header>
            <div class="response-modal-body">
                <section class="response-record-summary">
                    <div><span>เวลาเข้า</span><strong>@DisplayTime(selectedRecord.FirstScanAt)@if (selectedRecord.FirstScanSource == "WIFI") { <small class="ms-1">Wi-Fi</small> }</strong></div>
                    <div><span>เวลาออก</span><strong>@DisplayTime(selectedRecord.LastScanAt)</strong></div>
                    <div><span>สถานะ</span><strong>@StatusText(selectedRecord)@(selectedRecord.RequiresReview ? " · รอตรวจสอบ" : "")</strong></div>
                </section>
                @if (responsesLoading) { <div class="response-loading"><span></span>กำลังตรวจสอบข้อมูลข้อโต้แย้ง...</div> }
                else if (ExistingPendingResponse is not null)
                {
                    <section class="existing-response"><strong>ส่งข้อโต้แย้งแล้ว · รอดำเนินการ</strong><p>@ExistingPendingResponse.ResponseText</p><small>ส่งเมื่อ @ExistingPendingResponse.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                    <div class="response-issue-tags">@foreach (var issue in ExistingPendingResponse.Issues) { <span>@IssueTypeText(issue.IssueType) · @IssueStatusText(issue.Status)</span> }</div>
                    @if (ExistingPendingResponse.Attachments.Count > 0) { <div class="existing-files">@foreach (var file in ExistingPendingResponse.Attachments) { <span>@file.FileName <small>@FormatFileSize(file.FileSizeBytes)</small></span> }</div> }
                    </section>
                }
                else
                {
                    <div class="response-field"><span class="field-label">เลือกประเภทข้อโต้แย้ง <span class="required">*</span></span><div class="response-issue-options">
                        @foreach (var issueType in AvailableIssueTypes(selectedRecord))
                        {
                            <label><input type="checkbox" checked="@selectedResponseIssueTypes.Contains(issueType)" @onchange="eventArgs => SetResponseIssueType(issueType, eventArgs.Value as bool? == true)" /> @IssueTypeText(issueType)</label>
                        }
                    </div></div>
                    <label class="response-field"><span class="field-label">ข้อโต้แย้ง <span class="required">*</span></span><textarea maxlength="4000" rows="5" @bind="responseText" placeholder="กรอกรายละเอียดหรือเหตุผลที่ต้องการโต้แย้ง"></textarea></label>
                    <div class="response-field"><span>เอกสารแนบ</span><div class="attachment-picker"><InputFile class="attachment-input" @key="attachmentInputVersion" OnChange="SelectResponseAttachments" multiple accept=".pdf,.jpg,.jpeg,.png" /></div>
                        <small class="attachment-help">แนบได้หลายไฟล์ สูงสุด 10 ไฟล์ และแต่ละไฟล์ต้องไม่เกิน 10 MB (PDF, JPG หรือ PNG)</small>
                        @if (responseAttachments.Count > 0) { <div class="selected-attachments">@foreach (var attachment in responseAttachments) { <span title="@attachment.FileName">@attachment.FileName <button type="button" aria-label="ลบไฟล์" @onclick="() => RemoveAttachment(attachment)">×</button></span> }</div> }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(responseError)) { <div class="response-error">@responseError</div> }
            </div>
            <footer class="response-modal-footer"><button class="secondary-button" type="button" disabled="@isSubmitting" @onclick="CloseResponse">ปิด</button>
                @if (!responsesLoading && ExistingPendingResponse is null) { <button class="submit-response-button" type="button" disabled="@isSubmitting" @onclick="SubmitResponse">@if (isSubmitting) { <span class="button-spinner"></span> } @(isSubmitting ? "กำลังส่ง..." : "ส่งข้อโต้แย้ง")</button> }
            </footer>
        </section>
    </div>
}

@if (SelectedHistoryItems.Count > 0)
{
    <div class="response-overlay" role="dialog" aria-modal="true" aria-labelledby="history-title" @onclick="CloseHistory">
        <section class="response-modal history-modal" @onclick:stopPropagation="true">
            <header class="response-modal-header"><div><h2 id="history-title">ประวัติข้อโต้แย้ง</h2><p>วันที่ทำงาน @SelectedHistoryItems[0].WorkDate.ToString("dd/MM/yyyy") · @SelectedHistoryItems.Count คำขอ</p></div><button type="button" aria-label="ปิด" @onclick="CloseHistory">×</button></header>
            <div class="response-modal-body">
                <section class="response-record-summary history-summary">
                    <div><span>เวลาเข้า</span><strong>@DisplayTime(SelectedHistoryItems[0].FirstScanAt)</strong></div>
                    <div><span>เวลาออก</span><strong>@DisplayTime(SelectedHistoryItems[0].LastScanAt)</strong></div>
                    <div><span>สถานะปัจจุบัน</span><strong>@HistoryAttendanceStatusText(SelectedHistoryItems[0])</strong></div>
                </section>
                <div class="history-request-list">
                @foreach (var item in SelectedHistoryItems)
                {
                    <section class="history-request-card">
                        <header><div><strong>ส่งเมื่อ @item.Response.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong><small>ผู้ส่ง @item.Response.SubmittedByName</small></div><span class="history-status @ResponseStatusClass(item.Response.Status)">@ResponseStatusText(item.Response.Status)</span></header>
                        <section class="history-request-detail"><span>ข้อความที่ส่ง</span><p>@item.Response.ResponseText</p></section>
                        <section class="history-review-list">
                        @if (item.Response.Issues.Count == 0)
                        {
                            <div class="history-empty compact">ไม่พบรายละเอียดประเภทข้อโต้แย้ง</div>
                        }
                        else
                        {
                            @foreach (var issue in item.Response.Issues)
                            {
                                <article class="history-review-item">
                                    <div><strong>@IssueTypeText(issue.IssueType)</strong><span class="history-status @IssueStatusClass(issue.Status)">@IssueStatusText(issue.Status)</span></div>
                                    @if (!string.IsNullOrWhiteSpace(issue.ReviewNote)) { <p><span>หมายเหตุผู้ตรวจ:</span> @issue.ReviewNote</p> }
                                    @if (!string.IsNullOrWhiteSpace(issue.ReviewedByName) || issue.ReviewedAt.HasValue) { <small>ตรวจโดย @(issue.ReviewedByName ?? issue.ReviewedBy ?? "-")@(issue.ReviewedAt.HasValue ? $" · {issue.ReviewedAt.Value.ToLocalTime():dd/MM/yyyy HH:mm}" : "")</small> }
                                </article>
                            }
                        }
                        </section>
                        @if (item.Response.Attachments.Count > 0)
                        {
                            <section class="history-files"><h3>เอกสารแนบ</h3><div>@foreach (var file in item.Response.Attachments) { <button type="button" @onclick="() => PreviewHistoryAttachment(item, file)"><strong>@file.FileName</strong><small>@FormatFileSize(file.FileSizeBytes)</small></button> }</div></section>
                        }
                    </section>
                }
                </div>
            </div>
            <footer class="response-modal-footer"><button class="secondary-button" type="button" @onclick="CloseHistory">ปิด</button></footer>
        </section>
    </div>
}

@if (previewFile is not null)
{
    <div class="history-preview-overlay" role="dialog" aria-modal="true" @onclick="ClosePreview">
        <section class="history-preview-modal" @onclick:stopPropagation="true"><header><div><h2>เอกสารแนบ</h2><p>@previewFile.FileName</p></div><button type="button" aria-label="ปิด" @onclick="ClosePreview">×</button></header><div class="history-preview-body">
            @if (previewLoading) { <div class="preview-state">กำลังโหลดเอกสาร...</div> }
            else if (!string.IsNullOrWhiteSpace(previewError)) { <div class="preview-state error">@previewError</div> }
            else if (!string.IsNullOrWhiteSpace(previewUrl)) { @if (previewFile.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) { <img src="@previewUrl" alt="@previewFile.FileName" /> } else { <iframe src="@($"{previewUrl}#toolbar=0&navpanes=0")" title="@previewFile.FileName"></iframe> } }
        </div></section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "dailyId")] public long? TargetDailyId { get; set; }
    [SupplyParameterFromQuery(Name = "workDate")] public string? TargetWorkDate { get; set; }
    private List<AttendanceDailyDto> records = [];
    private List<AttendanceDailyDto> filteredRecords = [];
    private readonly HashSet<string> selectedStatuses = new(StringComparer.OrdinalIgnoreCase);
    private static readonly (string Code, string Label, string CssClass)[] StatusFilterOptions =
    [
        ("PRESENT", "มาปกติ", "status-present"),
        ("LATE", "มาสาย", "status-late"),
        ("ABSENT", "ขาดงาน", "status-absent"),
        ("IN_PROGRESS", "อยู่ระหว่างวันทำงาน", "status-inprogress"),
        ("REVIEW_REQUIRED", "รอตรวจสอบ", "status-reviewrequired")
    ];
    private string StatusFilterSummary => selectedStatuses.Count switch
    {
        0 => "ทั้งหมด",
        1 => StatusFilterOptions.First(x => x.Code == selectedStatuses.First()).Label,
        _ => $"เลือกแล้ว {selectedStatuses.Count} สถานะ"
    };
    private DateOnly? startDate;
    private DateOnly? endDate;
    private int currentPage = 1;
    private int pageSize = 10;
    private List<AttendanceResponseHistoryItemDto> responseHistory = [];
    private long? selectedHistoryDailyId;
    private AttendanceResponseAttachmentDto? previewFile;
    private string? previewUrl;
    private bool previewLoading;
    private string? previewError;
    private bool isLoading = true;
    private string? loadError;
    private long? expandedCommentDailyId;
    private string currentEmployeeId = string.Empty;
    private AttendanceDailyDto? selectedRecord;
    private string responseText = string.Empty;
    private readonly HashSet<string> selectedResponseIssueTypes = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<AttendanceAttachmentUploadDto> responseAttachments = [];
    private List<AttendanceResponseDto> existingResponses = [];
    private bool responsesLoading;
    private bool isSubmitting;
    private string? responseError;
    private int attachmentInputVersion;
    private int LateCount => records.Count(item => item.LateMinutes > 0);
    private int AbsentCount => records.Count(item => item.MissingMinutes > 0 || item.FinalStatus == "ABSENT");
    private List<AttendanceDailyDto> PagedRecords => filteredRecords.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    private List<AttendanceResponseHistoryItemDto> SelectedHistoryItems => selectedHistoryDailyId.HasValue
        ? responseHistory.Where(item => item.Response.AttendanceDailyId == selectedHistoryDailyId.Value).OrderByDescending(item => item.Response.SubmittedAt).ToList()
        : [];
    private AttendanceResponseDto? ExistingPendingResponse => existingResponses.FirstOrDefault(item => item.Status == "SUBMITTED");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
            if (string.IsNullOrWhiteSpace(currentUser?.EmployeeId)) throw new InvalidOperationException("ไม่พบบัญชีพนักงานที่เชื่อมกับ Microsoft");
            currentEmployeeId = currentUser.EmployeeId;
            var targetDate = DateOnly.TryParse(TargetWorkDate, out var parsedTargetDate)
                ? parsedTargetDate
                : DateOnly.FromDateTime(DateTime.Today);
            var start = new DateOnly(targetDate.Year, 1, 1);
            var end = new DateOnly(targetDate.Year, 12, 31);
            var recordsTask = Http.GetFromJsonAsync<List<AttendanceDailyDto>>($"api/attendance?employeeId={Uri.EscapeDataString(currentUser.EmployeeId)}&startDate={start:yyyy-MM-dd}&endDate={end:yyyy-MM-dd}");
            var historyTask = Http.GetFromJsonAsync<List<AttendanceResponseHistoryItemDto>>("api/attendance/responses/history");
            await Task.WhenAll(recordsTask, historyTask);
            records = recordsTask.Result ?? [];
            responseHistory = historyTask.Result ?? [];
            ApplyFilter();
            if (TargetDailyId.HasValue && records.Any(item => item.Id == TargetDailyId.Value))
            {
                expandedCommentDailyId = TargetDailyId.Value;
                var index = filteredRecords.FindIndex(item => item.Id == TargetDailyId.Value);
                if (index >= 0) currentPage = (index / pageSize) + 1;
            }
        }
        catch (Exception exception) { loadError = $"โหลดข้อมูลการมาทำงานไม่สำเร็จ: {exception.Message}"; }
        finally { isLoading = false; }
    }

    private void ApplyFilter()
    {
        filteredRecords = records.Where(MatchesStatusFilter)
            .Where(item => !startDate.HasValue || item.WorkDate >= startDate.Value).Where(item => !endDate.HasValue || item.WorkDate <= endDate.Value)
            .OrderByDescending(item => item.WorkDate).ToList();
        currentPage = 1;
    }
    private void ClearFilter() { selectedStatuses.Clear(); startDate = null; endDate = null; ApplyFilter(); }
    private void SetStatusFilter(string code, bool selected) { if (selected) selectedStatuses.Add(code); else selectedStatuses.Remove(code); ApplyFilter(); }
    private void ClearStatusSelection() { selectedStatuses.Clear(); ApplyFilter(); }

    private void ToggleComments(long attendanceDailyId) =>
        expandedCommentDailyId = expandedCommentDailyId == attendanceDailyId ? null : attendanceDailyId;
    private void UpdateCommentCount(long id,int count)
    {
        records=records.Select(item=>item.Id==id?item with{CommentCount=count}:item).ToList();
        filteredRecords=filteredRecords.Select(item=>item.Id==id?item with{CommentCount=count}:item).ToList();
    }

    private async Task OpenResponse(AttendanceDailyDto record)
    {
        if (!CanSubmitResponse(record)) return;
        selectedRecord = record; responseText = string.Empty; responseAttachments.Clear(); existingResponses = []; responseError = null; attachmentInputVersion++; responsesLoading = true;
        selectedResponseIssueTypes.Clear();
        foreach (var issueType in AvailableIssueTypes(record)) selectedResponseIssueTypes.Add(issueType);
        try { existingResponses = await Http.GetFromJsonAsync<List<AttendanceResponseDto>>($"api/attendance/{record.Id}/responses") ?? []; }
        catch (Exception exception) { responseError = $"โหลดข้อโต้แย้งเดิมไม่สำเร็จ: {exception.Message}"; }
        finally { responsesLoading = false; }
    }
    private void CloseResponse() { if (isSubmitting) return; selectedRecord = null; responseAttachments.Clear(); selectedResponseIssueTypes.Clear(); existingResponses = []; responseError = null; }

    private async Task SelectResponseAttachments(InputFileChangeEventArgs eventArgs)
    {
        responseError = null;
        var remaining = 10 - responseAttachments.Count;
        if (remaining <= 0) { responseError = "แนบไฟล์ได้ไม่เกิน 10 ไฟล์ต่อครั้ง"; return; }
        IReadOnlyList<IBrowserFile> files;
        try { files = eventArgs.GetMultipleFiles(remaining); } catch (InvalidOperationException) { responseError = $"เลือกไฟล์ได้อีกไม่เกิน {remaining} ไฟล์"; return; }
        const long maxFileSize = 10 * 1024 * 1024;
        foreach (var file in files)
        {
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not (".pdf" or ".jpg" or ".jpeg" or ".png")) { responseError = $"ไฟล์ {file.Name} ไม่รองรับ รองรับเฉพาะ PDF, JPG และ PNG"; return; }
            if (file.Size == 0 || file.Size > maxFileSize) { responseError = $"ไฟล์ {file.Name} ต้องมีขนาดมากกว่า 0 และไม่เกิน 10 MB"; return; }
            await using var stream = file.OpenReadStream(maxFileSize); using var memory = new MemoryStream(); await stream.CopyToAsync(memory);
            responseAttachments.Add(new AttendanceAttachmentUploadDto(Path.GetFileName(file.Name), string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType, memory.ToArray()));
        }
    }
    private void RemoveAttachment(AttendanceAttachmentUploadDto attachment) { responseAttachments.Remove(attachment); attachmentInputVersion++; }
    private static List<string> AvailableIssueTypes(AttendanceDailyDto record)
    {
        var result = new List<string>();
        if (record.LateMinutes > 0 || record.CalculatedStatus == "LATE") result.Add("LATE");
        if (record.MissingMinutes > 0 || record.FinalStatus == "ABSENT") result.Add("ABSENT");
        return result;
    }
    private void SetResponseIssueType(string issueType, bool selected)
    {
        if (selected) selectedResponseIssueTypes.Add(issueType); else selectedResponseIssueTypes.Remove(issueType);
    }
    private static string IssueTypeText(string issueType) => issueType == "LATE" ? "โต้แย้งมาสาย" : "โต้แย้งขาดงาน";
    private static string IssueStatusText(string status) => status switch
    {
        "APPROVED" => "อนุมัติแล้ว",
        "REJECTED" => "ไม่อนุมัติ",
        _ => "รอตรวจสอบ"
    };

    private async Task SubmitResponse()
    {
        if (selectedRecord is null || isSubmitting) return;
        responseError = null;
        if (selectedResponseIssueTypes.Count == 0) { responseError = "กรุณาเลือกประเภทข้อโต้แย้งอย่างน้อย 1 รายการ"; return; }
        if (string.IsNullOrWhiteSpace(responseText)) { responseError = "กรุณากรอกข้อโต้แย้ง"; return; }
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/attendance/{selectedRecord.Id}/responses", new AttendanceResponseRequest(responseText.Trim(), responseAttachments, selectedResponseIssueTypes.ToList()));
            if (!response.IsSuccessStatusCode) { var detail = (await response.Content.ReadAsStringAsync()).Trim().Trim('\"'); responseError = string.IsNullOrWhiteSpace(detail) ? "ส่งข้อโต้แย้งไม่สำเร็จ" : detail; return; }
            var saved = await response.Content.ReadFromJsonAsync<AttendanceResponseDto>();
            if (saved is not null)
            {
                existingResponses.Insert(0, saved);
                responseHistory.Insert(0, new AttendanceResponseHistoryItemDto(selectedRecord.WorkDate,
                    selectedRecord.FirstScanAt, selectedRecord.LastScanAt, selectedRecord.FinalStatus,
                    selectedRecord.LateMinutes, selectedRecord.MissingMinutes, saved));
                ApplyFilter();
            }
            responseText = string.Empty; responseAttachments.Clear(); attachmentInputVersion++;
        }
        catch (Exception exception) { responseError = $"ส่งข้อโต้แย้งไม่สำเร็จ: {exception.Message}"; }
        finally { isSubmitting = false; }
    }

    private bool MatchesStatusFilter(AttendanceDailyDto item) => selectedStatuses.Count == 0 ||
        (selectedStatuses.Contains("REVIEW_REQUIRED") && item.RequiresReview) ||
        (selectedStatuses.Contains("LATE") && item.LateMinutes > 0) ||
        (selectedStatuses.Contains("ABSENT") && (item.MissingMinutes > 0 || item.FinalStatus == "ABSENT")) ||
        (selectedStatuses.Contains("PRESENT") && item.FinalStatus == "PRESENT" && item.LateMinutes == 0 && item.MissingMinutes == 0) ||
        (selectedStatuses.Contains("IN_PROGRESS") && item.IsWorkDayInProgress);
    private static string StatusText(AttendanceDailyDto item)
    {
        var parts = new List<string>();
        if (item.LateMinutes > 0) parts.Add($"มาสาย {item.LateMinutes} นาที");
        if (item.MissingMinutes > 0) parts.Add($"ขาดงาน {item.MissingMinutes} นาที");
        if (parts.Count > 0) return string.Join(", ", parts);
        return item.FinalStatus switch
        {
            "IN_PROGRESS" => "อยู่ในช่วงเวลาทำงาน",
            "ABSENT" => "ขาดงาน",
            "LATE" => "มาสาย",
            _ => "มาปกติ"
        };
    }
    private static string StatusClass(AttendanceDailyDto item) => item.MissingMinutes > 0 || item.FinalStatus == "ABSENT"
        ? "status-absent"
        : item.LateMinutes > 0 || item.FinalStatus == "LATE"
            ? "status-late"
            : item.FinalStatus == "IN_PROGRESS" ? "status-inprogress" : "status-present";
    private static string DisplayTime(DateTime? value) => value?.ToString("HH:mm") ?? "-";
    private bool HasResponseHistory(long attendanceDailyId) => responseHistory.Any(item => item.Response.AttendanceDailyId == attendanceDailyId);
    private void OpenHistory(long attendanceDailyId) { selectedHistoryDailyId = attendanceDailyId; }
    private async Task CloseHistory() { await ClosePreview(); selectedHistoryDailyId = null; }
    private async Task PreviewHistoryAttachment(AttendanceResponseHistoryItemDto item, AttendanceResponseAttachmentDto file)
    {
        await RevokePreview(); previewFile = file; previewLoading = true; previewError = null;
        try
        {
            var response = item.Response;
            var bytes = await Http.GetByteArrayAsync($"api/attendance/{response.AttendanceDailyId}/responses/{response.Id}/attachments/{file.Id}/preview");
            previewUrl = await JS.InvokeAsync<string>("hrPreview.createObjectUrl", file.ContentType, bytes);
        }
        catch (Exception exception) { previewError = $"เปิดเอกสารไม่สำเร็จ: {exception.Message}"; }
        finally { previewLoading = false; }
    }
    private async Task ClosePreview() { await RevokePreview(); previewFile = null; previewError = null; }
    private async Task RevokePreview() { if (!string.IsNullOrWhiteSpace(previewUrl)) await JS.InvokeVoidAsync("hrPreview.revokeObjectUrl", previewUrl); previewUrl = null; }
    public async ValueTask DisposeAsync() => await RevokePreview();
    private static string ResponseStatusText(string status) => status switch { "APPROVED" => "อนุมัติแล้ว", "PARTIALLY_APPROVED" => "อนุมัติบางส่วน", "REJECTED" => "ไม่อนุมัติ", _ => "รอตรวจสอบ" };
    private static string ResponseStatusClass(string status) => $"response-{status.ToLowerInvariant()}";
    private static string IssueStatusClass(string status) => $"issue-{status.ToLowerInvariant()}";
    private static string HistoryAttendanceStatusText(AttendanceResponseHistoryItemDto item)
    {
        var parts = new List<string>();
        if (item.CurrentLateMinutes > 0) parts.Add($"มาสาย {item.CurrentLateMinutes} นาที");
        if (item.CurrentMissingMinutes > 0) parts.Add($"ขาดงาน {item.CurrentMissingMinutes} นาที");
        if (parts.Count > 0) return string.Join(", ", parts);
        return item.CurrentAttendanceStatus == "PRESENT" ? "มาปกติ" : item.CurrentAttendanceStatus;
    }
    private static bool CanSubmitResponse(AttendanceDailyDto record) =>
        record.IsResponseWindowOpen && record.FinalStatus is not ("IN_PROGRESS" or "PRESENT");
    private static string ResponseUnavailableText(AttendanceDailyDto record) =>
        record.IsWorkDayInProgress
            ? "รอจบวันทำงานก่อนโต้แย้ง"
            : !record.IsResponseWindowOpen
                ? "รอคำนวณผลหลังจบวัน"
                : record.FinalStatus == "PRESENT"
                    ? "รายการมาปกติไม่ต้องโต้แย้ง"
                    : "ยังไม่เปิดให้โต้แย้ง";
    private static string FormatFileSize(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.##} MB" : $"{bytes / 1024d:0.##} KB";
}
