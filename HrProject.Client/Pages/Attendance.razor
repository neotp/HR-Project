    private DateOnly? LastClickedCalendarDate;
    private DateTimeOffset LastCalendarClickAt;

    private void HandleDayClick(CalendarDay day)
    {
        var now = DateTimeOffset.UtcNow;
        if (LastClickedCalendarDate == day.Date &&
            (now - LastCalendarClickAt).TotalMilliseconds <= 700)
        {
            LastClickedCalendarDate = null;
            OpenCreateEventForDay(day);
            return;
        }

        LastClickedCalendarDate = day.Date;
        LastCalendarClickAt = now;
        SelectDay(day);
    }

