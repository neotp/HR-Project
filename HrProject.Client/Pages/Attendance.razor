    private void CloseEventModal()
    {
        if (IsSavingEvent) return;
        IsEventModalOpen = false;
        IsConfirmingEventDelete = false;
        EventErrorMessage = null;
    }

    private async Task SaveEventAsync()
    {
        EventErrorMessage = ValidateEventForm();
        if (EventErrorMessage is not null) return;

        IsSavingEvent = true;
        try
        {
            var request = new SaveAttendanceCalendarEventRequest(
                EventDate!.Value, EventType, EventStartTime, EventEndTime,
                string.IsNullOrWhiteSpace(EventTitle) ? null : EventTitle.Trim(),
                string.IsNullOrWhiteSpace(EventDetails) ? null : EventDetails.Trim());
            var response = EditingEventId.HasValue
                ? await Http.PutAsJsonAsync($"api/attendance-calendar-events/{EditingEventId.Value}", request)
                : await Http.PostAsJsonAsync("api/attendance-calendar-events", request);
            if (!response.IsSuccessStatusCode)
            {
                EventErrorMessage = await ReadEventError(response, "บันทึก Event ไม่สำเร็จ");
                return;
            }

            IsEventModalOpen = false;
            await LoadAttendanceForMonth();
            BuildCalendar();
            if (SelectedDay is not null)
                SelectedDay = CalendarDays.FirstOrDefault(day => day.Date == SelectedDay.Date);
        }
        catch (Exception)
        {
            EventErrorMessage = "บันทึก Event ไม่สำเร็จ กรุณาตรวจสอบการเชื่อมต่อ API";
        }
        finally
        {
            IsSavingEvent = false;
        }
    }

    private void RequestDeleteEvent()
    {
        EventErrorMessage = null;
        IsConfirmingEventDelete = true;
    }

    private void CancelDeleteEvent()
    {
        if (!IsSavingEvent) IsConfirmingEventDelete = false;
    }

    private async Task DeleteEventAsync()
    {
        if (!EditingEventId.HasValue) return;
        IsSavingEvent = true;
        try
        {
            var response = await Http.DeleteAsync($"api/attendance-calendar-events/{EditingEventId.Value}");
            if (!response.IsSuccessStatusCode)
            {
                EventErrorMessage = await ReadEventError(response, "ลบ Event ไม่สำเร็จ");
                return;
            }
            IsEventModalOpen = false;
            await LoadAttendanceForMonth();
            BuildCalendar();
            if (SelectedDay is not null)
                SelectedDay = CalendarDays.FirstOrDefault(day => day.Date == SelectedDay.Date);
        }
        catch (Exception)
        {
            EventErrorMessage = "ลบ Event ไม่สำเร็จ กรุณาตรวจสอบการเชื่อมต่อ API";
        }
        finally
        {
            IsSavingEvent = false;
            IsConfirmingEventDelete = false;
        }
    }

    private string? ValidateEventForm()
    {
        if (!EventDate.HasValue) return "กรุณาระบุวันที่";
        if (EventEndTime <= EventStartTime) return "เวลาสิ้นสุดต้องมากกว่าเวลาเริ่มต้น";
        if (EventType == "OTHER" && string.IsNullOrWhiteSpace(EventTitle)) return "กรุณาระบุหัวข้อสำหรับประเภทอื่น ๆ";
        return null;
    }

    private static async Task<string> ReadEventError(HttpResponseMessage response, string fallback)
    {
        var content = (await response.Content.ReadAsStringAsync()).Trim().Trim('"');
        return string.IsNullOrWhiteSpace(content) ? fallback : content.Replace("\\u0022", "\"");
    }

