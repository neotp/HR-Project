    private bool IsCompanyWorkDay(DateOnly date)
    {
        var configuredDay = WorkCalendarDays.FirstOrDefault(item => item.CalendarDate == date);
        if (configuredDay?.DayType == "PUBLIC_HOLIDAY")
            return false;
        if (configuredDay?.DayType == "WORKING_SATURDAY")
            return true;

        return date.DayOfWeek is not DayOfWeek.Saturday and not DayOfWeek.Sunday;
    }

