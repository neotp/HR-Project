@page "/attendance"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>ปฏิทินการมาทำงาน | HR Project</PageTitle>

<section class="manage-page attendance-page">
    <header class="page-header-card">
        <div class="page-header-content">
            <div class="page-header-text">
                <h1><span class="header-icon" aria-hidden="true">◷</span> ปฏิทินการมาทำงาน</h1>
                <p>ตรวจสอบเวลาเข้า-ออกงานและสถานะการทำงานในรูปแบบปฏิทิน</p>
            </div>
        </div>
    </header>

    <section class="attendance-summary" aria-label="สรุปการมาทำงาน">
        <article class="summary-card summary-workdays">
            <span class="summary-label">วันทำงานในเดือน</span>
            <strong>@WorkingDayCount</strong>
            <span class="summary-unit">วัน</span>
        </article>
        <article class="summary-card summary-present">
            <span class="summary-label">มาปกติ</span>
            <strong>@CountStatus(AttendanceStatus.Present)</strong>
            <span class="summary-unit">วัน</span>
        </article>
        <article class="summary-card summary-late">
            <span class="summary-label">มาสาย</span>
            <strong>@CountStatus(AttendanceStatus.Late)</strong>
            <span class="summary-unit">วัน</span>
        </article>
        <article class="summary-card summary-away">
            <span class="summary-label">ลา / ขาดงาน</span>
            <strong>@AwayCount</strong>
            <span class="summary-unit">วัน</span>
        </article>
    </section>

    <section class="content-card calendar-card">
        @if (IsLoadingCalendarData)
        {
            <div class="calendar-data-message loading-calendar-data">
                กำลังโหลดเอกสารการลาและปฏิทินการทำงาน...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(LoadErrorMessage))
        {
            <div class="calendar-data-message calendar-data-error">
                @LoadErrorMessage
            </div>
        }

        <div class="calendar-toolbar">
            <div>
                <h2>ปฏิทินการมาทำงาน</h2>
                <p>เลือกวันที่เพื่อดูรายละเอียดเวลาเข้า-ออกงาน ใบลา และ Event ของคุณ</p>
            </div>

            <div class="calendar-toolbar-actions">
                <button type="button" class="create-event-button" @onclick="OpenCreateEvent">+ สร้าง Event</button>
                <div class="month-navigation">
                    <button type="button"
                            class="month-button month-arrow"
                            aria-label="เดือนก่อนหน้า"
                            @onclick="ShowPreviousMonth">‹</button>
                    <div class="month-title" aria-live="polite">@MonthTitle</div>
                    <button type="button"
                            class="month-button month-arrow"
                            aria-label="เดือนถัดไป"
                            @onclick="ShowNextMonth">›</button>
                    <button type="button" class="month-button today-button" @onclick="ShowCurrentMonth">
                        เดือนปัจจุบัน
                    </button>
                </div>
            </div>
        </div>

        <div class="calendar-scroll">
            <div class="calendar-canvas">
                <div class="calendar-weekdays" aria-hidden="true">
                    @foreach (var weekday in WeekdayNames)
                    {
                        <div>@weekday</div>
                    }
                </div>

                <div class="calendar-grid">
                    @foreach (var day in CalendarDays)
                    {
                        var dayLeaveDocuments = GetLeaveDocuments(day.Date);
                        var dayEvents = GetCalendarEvents(day.Date);
                        var companyEvent = GetCompanyCalendarEvent(day.Date);
                        <div class="@GetDayCssClass(day)" @onclick="() => HandleDayClick(day)">
                            <div class="day-layout @(dayLeaveDocuments.Count > 0 || dayEvents.Count > 0 || companyEvent is not null ? "has-calendar-items" : null)">
                                <button type="button" class="day-main-column"
                                        aria-label="@GetDayAriaLabel(day)">
                                    <span class="day-heading">
                                        <span class="day-number">@day.Date.Day</span>
                                        @if (day.Date == Today)
                                        {
                                            <span class="today-label">วันนี้</span>
                                        }
                                    </span>

                                    @if (day.Record is not null)
                                    {
                                        <span class="@GetRecordStatusCssClass(day.Record)">
                                            <span class="status-dot" aria-hidden="true"></span>
                                            @GetRecordStatusText(day.Record)
                                        </span>

                                        @if (day.Record.LeaveDocument is null && !string.IsNullOrWhiteSpace(day.Record.ClockIn))
                                        {
                                            <span class="attendance-time">
                                                <span>เข้า @day.Record.ClockIn</span>
                                                <span>ออก @day.Record.ClockOut</span>
                                            </span>
                                        }
                                    }
                                </button>

                                @if (dayLeaveDocuments.Count > 0 || dayEvents.Count > 0 || companyEvent is not null)
                                {
                                    <div class="calendar-item-list">
                                        @if (companyEvent is not null)
                                        {
                                            <article class="company-calendar-slot @GetCompanyEventCssClass(companyEvent.DayType)">
                                                <span class="company-event-heading"><span aria-hidden="true">@(companyEvent.DayType == "PUBLIC_HOLIDAY" ? "★" : "▣")</span><strong>@companyEvent.Name</strong></span>
                                                <span class="company-event-time">@(companyEvent.DayType == "WORKING_SATURDAY" ? "09:00 → 17:00" : "ตลอดทั้งวัน")</span>
                                                <small>@(companyEvent.DayType == "WORKING_SATURDAY" ? "วันเสาร์ทำงาน · พัก 12:00–13:00" : "วันหยุดนักขัตฤกษ์")</small>
                                            </article>
                                        }
                                        @foreach (var leaveDocument in dayLeaveDocuments)
                                        {
                                            var leaveEndTime = CalculateLeaveEndTime(leaveDocument.StartTime, leaveDocument.LeaveHours);
                                            <button type="button"
                                                    class="leave-document-slot @GetLeaveSlotCssClass(leaveDocument.Status)"
                                                    aria-label="เปิดเอกสาร @leaveDocument.DocumentNo"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenLeaveDocument(leaveDocument.Id)">
                                                <span class="leave-slot-heading">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" /></svg>
                                                    <strong>@leaveDocument.LeaveTypeName</strong>
                                                </span>
                                                <span class="leave-slot-time">@leaveDocument.StartTime.ToString("HH:mm") <i aria-hidden="true">→</i> @leaveEndTime.ToString("HH:mm")</span>
                                                <small><i aria-hidden="true"></i>@GetLeaveDocumentStatusText(leaveDocument.Status)</small>
                                            </button>
                                        }
                                        @foreach (var calendarEvent in dayEvents)
                                        {
                                            <button type="button"
                                                    class="calendar-event-slot @GetEventTypeCssClass(calendarEvent.EventType)"
                                                    aria-label="@($"เปิด Event {GetEventDisplayTitle(calendarEvent)}")"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenEditEvent(calendarEvent)">
                                                <span class="event-slot-heading"><span aria-hidden="true">@GetEventIcon(calendarEvent.EventType)</span><strong>@GetEventDisplayTitle(calendarEvent)</strong></span>
                                                <span class="event-slot-time">@calendarEvent.StartTime.ToString("HH:mm") <i aria-hidden="true">→</i> @calendarEvent.EndTime.ToString("HH:mm")</span>
                                                <small>@GetEventStatusText(calendarEvent.Status)</small>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="calendar-footer">
            <div class="calendar-legend" aria-label="คำอธิบายสถานะ">
                <span><i class="legend-dot present"></i>มาปกติ</span>
                <span><i class="legend-dot late"></i>มาสาย</span>
                <span><i class="legend-dot leave"></i>ลา</span>
                <span><i class="legend-dot event"></i>Event ส่วนตัว</span>
                <span><i class="legend-dot absent"></i>ขาดงาน</span>
                <span><i class="legend-dot holiday"></i>วันหยุดนักขัตฤกษ์</span>
                <span><i class="legend-dot working-saturday"></i>วันเสาร์ทำงาน</span>
                <span><i class="legend-dot weekend"></i>วันหยุด</span>
            </div>
        </div>
    </section>

    @if (SelectedDay is not null)
    {
        <section class="content-card selected-day-card" aria-live="polite">
            <div class="selected-day-header">
                <div>
                    <span class="selected-day-eyebrow">รายละเอียดการมาทำงาน</span>
                    <h2>@FormatFullDate(SelectedDay.Date)</h2>
                </div>
                <button type="button" class="close-detail-button" aria-label="ปิดรายละเอียด" @onclick="ClearSelectedDay">×</button>
            </div>

            <section class="selected-detail-section">
                <h3>ข้อมูลการมาทำงาน</h3>
                @if (SelectedDay.Record is null)
                {
                    <div class="no-record">ยังไม่มีข้อมูลการมาทำงานสำหรับวันนี้</div>
                }
                else
                {
                    <div class="selected-day-details">
                        <div class="detail-item">
                            <span>สถานะ</span>
                            <strong class="@GetRecordStatusCssClass(SelectedDay.Record)">
                                <span class="status-dot" aria-hidden="true"></span>
                                @GetRecordStatusText(SelectedDay.Record)
                            </strong>
                        </div>
                        <div class="detail-item">
                            <span>เวลาเข้างาน</span>
                            <strong>@DisplayTime(SelectedDay.Record.ClockIn)</strong>
                        </div>
                        <div class="detail-item">
                            <span>เวลาออกงาน</span>
                            <strong>@DisplayTime(SelectedDay.Record.ClockOut)</strong>
                        </div>
                        <div class="detail-item detail-note">
                            <span>หมายเหตุ</span>
                            <strong>@SelectedDay.Record.Note</strong>
                        </div>
                    </div>
                }
            </section>

            @{ var selectedCompanyEvent = GetCompanyCalendarEvent(SelectedDay.Date); }
            @if (selectedCompanyEvent is not null)
            {
                <section class="selected-detail-section selected-company-event-section">
                    <h3>ปฏิทินบริษัท</h3>
                    <div class="selected-company-event @GetCompanyEventCssClass(selectedCompanyEvent.DayType)">
                        <span class="selected-company-icon" aria-hidden="true">@(selectedCompanyEvent.DayType == "PUBLIC_HOLIDAY" ? "★" : "▣")</span>
                        <div><small>รายการ</small><strong>@selectedCompanyEvent.Name</strong></div>
                        <div><small>ประเภท</small><strong>@(selectedCompanyEvent.DayType == "PUBLIC_HOLIDAY" ? "วันหยุดนักขัตฤกษ์" : "วันเสาร์ทำงาน")</strong></div>
                        <div><small>เวลาทำงาน</small><strong>@(selectedCompanyEvent.DayType == "PUBLIC_HOLIDAY" ? "ไม่มีการตรวจ Attendance" : "09:00–17:00 · พัก 12:00–13:00")</strong></div>
                        @if (!string.IsNullOrWhiteSpace(selectedCompanyEvent.Note))
                        {
                            <div class="selected-company-note"><small>หมายเหตุ</small><strong>@selectedCompanyEvent.Note</strong></div>
                        }
                    </div>
                </section>
            }

            @{ var selectedLeaveDocuments = GetLeaveDocuments(SelectedDay.Date); }
            @if (selectedLeaveDocuments.Count > 0)
            {
                <section class="selected-detail-section selected-leave-section">
                    <h3>เอกสารการลา <span>@selectedLeaveDocuments.Count รายการ</span></h3>
                    <div class="selected-leave-list">
                        @foreach (var leaveDocument in selectedLeaveDocuments)
                        {
                            var leaveEndTime = CalculateLeaveEndTime(leaveDocument.StartTime, leaveDocument.LeaveHours);
                            <article class="selected-leave-item @GetLeaveSlotCssClass(leaveDocument.Status)">
                                <button type="button" class="selected-leave-number" @onclick="() => OpenLeaveDocument(leaveDocument.Id)">
                                    @leaveDocument.DocumentNo
                                </button>
                                <div><span>ประเภทการลา</span><strong>@leaveDocument.LeaveTypeName</strong></div>
                                <div><span>ช่วงเวลา</span><strong>@leaveDocument.StartTime.ToString("HH:mm")–@leaveEndTime.ToString("HH:mm")</strong></div>
                                <div><span>จำนวน</span><strong>@leaveDocument.LeaveHours.ToString("0.##") ชั่วโมง</strong></div>
                                <div><span>สถานะ</span><strong>@GetLeaveDocumentStatusText(leaveDocument.Status)</strong></div>
                                <div class="selected-leave-reason"><span>เหตุผล</span><strong>@leaveDocument.LeaveReason</strong></div>
                            </article>
                        }
                    </div>
                </section>
            }

            @{ var selectedEvents = GetCalendarEvents(SelectedDay.Date); }
            @if (selectedEvents.Count > 0)
            {
                <section class="selected-detail-section selected-event-section">
                    <h3>Event ของฉัน <span>@selectedEvents.Count รายการ</span></h3>
                    <div class="selected-event-list">
                        @foreach (var calendarEvent in selectedEvents)
                        {
                            <button type="button" class="selected-event-item @GetEventTypeCssClass(calendarEvent.EventType)" @onclick="() => OpenEditEvent(calendarEvent)">
                                <span class="selected-event-icon" aria-hidden="true">@GetEventIcon(calendarEvent.EventType)</span>
                                <span><small>ประเภท</small><strong>@GetEventTypeText(calendarEvent.EventType)</strong></span>
                                <span><small>หัวข้อ</small><strong>@GetEventDisplayTitle(calendarEvent)</strong></span>
                                <span><small>ช่วงเวลา</small><strong>@calendarEvent.StartTime.ToString("HH:mm")–@calendarEvent.EndTime.ToString("HH:mm")</strong></span>
                                <span class="selected-event-details"><small>รายละเอียด</small><strong>@(string.IsNullOrWhiteSpace(calendarEvent.Details) ? "-" : calendarEvent.Details)</strong></span>
                            </button>
                        }
                    </div>
                </section>
            }
        </section>
    }
</section>

@if (IsEventModalOpen)
{
    <div class="event-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="event-modal-title">
        <section class="event-modal">
            <header>
                <div><h2 id="event-modal-title">@(EditingEventId.HasValue ? "แก้ไข Event" : "สร้าง Event")</h2><p>รายการจะแสดงเป็นกล่องในปฏิทินการมาทำงานของคุณ</p></div>
                <button type="button" aria-label="ปิด" disabled="@IsSavingEvent" @onclick="CloseEventModal">×</button>
            </header>
            <div class="event-modal-body">
                @if (!string.IsNullOrWhiteSpace(EventErrorMessage))
                {
                    <div class="event-form-error">@EventErrorMessage</div>
                }
                @if (EditingEventId.HasValue)
                {
                    <div class="event-audit-line">
                        <span class="event-review-status @GetEventStatusCssClass(EventStatus)">@GetEventStatusText(EventStatus)</span>
                        <span>สร้างเมื่อ @EventCreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        @if (!string.IsNullOrWhiteSpace(EventCreatedByName)) { <span>โดย @EventCreatedByName</span> }
                    </div>
                }
                <div class="event-form-grid">
                    <label class="event-form-field"><span>ประเภท Event <i>*</i></span>
                        <select @bind="EventType" disabled="@IsSavingEvent">
                            @foreach (var eventType in SelectableEventTypes)
                            {
                                <option value="@eventType.Code">@eventType.NameTh</option>
                            }
                        </select>
                    </label>
                    <label class="event-form-field"><span>วันที่ <i>*</i></span><DateOnlyPicker @bind-Value="EventDate" Disabled="@IsSavingEvent" /></label>
                    <label class="event-form-field"><span>เวลาเริ่มต้น <i>*</i></span><TimeMinutePicker @bind-Value="EventStartTime" Disabled="@IsSavingEvent" /></label>
                    <label class="event-form-field"><span>เวลาสิ้นสุด <i>*</i></span><TimeMinutePicker @bind-Value="EventEndTime" Disabled="@IsSavingEvent" /></label>
                    <label class="event-form-field event-form-full"><span>หัวข้อ @(EventType == "OTHER" ? "*" : "")</span><input maxlength="200" @bind="EventTitle" disabled="@IsSavingEvent" placeholder="เช่น ประชุมลูกค้าโครงการ ABC" /></label>
                    <label class="event-form-field event-form-full"><span>รายละเอียด</span><textarea maxlength="2000" @bind="EventDetails" disabled="@IsSavingEvent" placeholder="รายละเอียดเพิ่มเติม (ถ้ามี)"></textarea></label>
                </div>
            </div>
            <footer>
                @if (EditingEventId.HasValue)
                {
                    <button type="button" class="delete-event-button" disabled="@IsSavingEvent" @onclick="RequestDeleteEvent">ลบ Event</button>
                }
                <span></span>
                <button type="button" class="cancel-event-button" disabled="@IsSavingEvent" @onclick="CloseEventModal">ปิด</button>
                <button type="button" class="save-event-button" disabled="@IsSavingEvent" @onclick="SaveEventAsync">@(IsSavingEvent ? "กำลังบันทึก..." : "บันทึก Event")</button>
            </footer>
        </section>
    </div>
}

<ConfirmActionDialog IsOpen="@IsConfirmingEventDelete"
                     IsBusy="@IsSavingEvent"
                     Title="ยืนยันการลบ Event"
                     Message="@DeleteEventConfirmMessage"
                     ConfirmText="ยืนยันลบ"
                     BusyText="กำลังลบ Event..."
                     Tone="danger"
                     OnConfirm="DeleteEventAsync"
                     OnCancel="CancelDeleteEvent" />

@code {
    private static readonly string[] WeekdayNames = ["อา.", "จ.", "อ.", "พ.", "พฤ.", "ศ.", "ส."];
    private static readonly string[] ThaiMonthNames =
    [
        "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
        "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"
    ];

    private readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly DisplayedMonth;
    private List<CalendarDay> CalendarDays = [];
    private List<LeaveDocumentDto> LeaveDocuments = [];
    private List<WorkCalendarDayDto> WorkCalendarDays = [];
    private List<AttendanceDailyDto> AttendanceDailyRecords = [];
    private List<AttendanceCalendarEventDto> CalendarEvents = [];
    private List<AttendanceEventTypeMasterDto> AttendanceEventTypes = [];
    private string CurrentEmployeeId = string.Empty;
    private CalendarDay? SelectedDay;
    private bool IsLoadingCalendarData = true;
    private string? LoadErrorMessage;
    private bool IsEventModalOpen;
    private bool IsSavingEvent;
    private bool IsConfirmingEventDelete;
    private long? EditingEventId;
    private DateOnly? EventDate;
    private string EventType = "WORK_FROM_HOME";
    private TimeOnly EventStartTime = new(9, 0);
    private TimeOnly EventEndTime = new(18, 0);
    private string? EventTitle;
    private string? EventDetails;
    private string? EventErrorMessage;
    private string EventStatus = "APPROVED";
    private string? EventCreatedByName;
    private DateTimeOffset? EventCreatedAt;
    private IEnumerable<AttendanceEventTypeMasterDto> SelectableEventTypes => AttendanceEventTypes
        .Where(item => item.IsActive || string.Equals(item.Code, EventType, StringComparison.OrdinalIgnoreCase))
        .OrderBy(item => item.DisplayOrder)
        .ThenBy(item => item.NameTh);

    private string DeleteEventConfirmMessage =>
        $"คุณต้องการลบ Event ‘{(string.IsNullOrWhiteSpace(EventTitle) ? GetEventTypeText(EventType) : EventTitle)}’ วันที่ {EventDate:dd/MM/yyyy} ใช่หรือไม่?\nเมื่อลบแล้ว Attendance ของวันดังกล่าวจะถูกคำนวณใหม่";

    private string MonthTitle => $"{ThaiMonthNames[DisplayedMonth.Month - 1]} {DisplayedMonth.Year}";

    private int WorkingDayCount
    {
        get
        {
            var daysInMonth = DateTime.DaysInMonth(DisplayedMonth.Year, DisplayedMonth.Month);
            return Enumerable.Range(1, daysInMonth)
                .Select(day => new DateOnly(DisplayedMonth.Year, DisplayedMonth.Month, day))
                .Count(IsCompanyWorkDay);
        }
    }

    private int AwayCount =>
        LeaveDocuments
            .Where(document => document.LeaveDate.Year == DisplayedMonth.Year &&
                document.LeaveDate.Month == DisplayedMonth.Month &&
                IsActiveLeaveDocument(document))
            .Select(document => document.LeaveDate)
            .Distinct()
            .Count() + CountStatus(AttendanceStatus.Absent);

    protected override async Task OnInitializedAsync()
    {
        DisplayedMonth = new DateOnly(Today.Year, Today.Month, 1);
        BuildCalendar();

        try
        {
            WorkCalendarDays = await Http.GetFromJsonAsync<List<WorkCalendarDayDto>>(
                "api/work-calendar") ?? [];
            AttendanceEventTypes = await Http.GetFromJsonAsync<List<AttendanceEventTypeMasterDto>>(
                "api/system-master-data/attendance-event-types?includeInactive=true") ?? [];
        }
        catch (Exception)
        {
            AppendLoadError("ไม่สามารถโหลดวันหยุดและวันเสาร์ทำงานได้");
        }

        try
        {
            var currentUser = await Http.GetFromJsonAsync<CurrentMicrosoftUserDto>("api/auth/me");
            if (currentUser is null || string.IsNullOrWhiteSpace(currentUser.EmployeeId))
            {
                AppendLoadError("ไม่พบข้อมูลพนักงานที่เชื่อมกับบัญชี Microsoft");
                return;
            }

            CurrentEmployeeId = currentUser.EmployeeId;
            LeaveDocuments = await Http.GetFromJsonAsync<List<LeaveDocumentDto>>(
                $"api/leave-documents?creatorEmployeeId={Uri.EscapeDataString(currentUser.EmployeeId)}") ?? [];
            LeaveDocuments = LeaveDocuments
                .Where(IsVisibleLeaveDocument)
                .ToList();
            await LoadAttendanceForMonth();
        }
        catch (HttpRequestException)
        {
            AppendLoadError("ไม่สามารถโหลดเอกสารการลาได้ กรุณาตรวจสอบการเชื่อมต่อ API");
        }
        catch
        {
            AppendLoadError("เกิดข้อผิดพลาดระหว่างโหลดเอกสารการลา");
        }
        finally
        {
            IsLoadingCalendarData = false;
            BuildCalendar();
        }
    }

    private async Task ShowPreviousMonth()
    {
        DisplayedMonth = DisplayedMonth.AddMonths(-1);
        SelectedDay = null;
        await LoadAttendanceForMonth();
        BuildCalendar();
    }

    private async Task ShowNextMonth()
    {
        DisplayedMonth = DisplayedMonth.AddMonths(1);
        SelectedDay = null;
        await LoadAttendanceForMonth();
        BuildCalendar();
    }

    private async Task ShowCurrentMonth()
    {
        DisplayedMonth = new DateOnly(Today.Year, Today.Month, 1);
        SelectedDay = null;
        await LoadAttendanceForMonth();
        BuildCalendar();
    }

    private async Task LoadAttendanceForMonth()
    {
        if (string.IsNullOrWhiteSpace(CurrentEmployeeId)) return;
        var start = new DateOnly(DisplayedMonth.Year, DisplayedMonth.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        AttendanceDailyRecords = await Http.GetFromJsonAsync<List<AttendanceDailyDto>>(
            $"api/attendance?employeeId={Uri.EscapeDataString(CurrentEmployeeId)}&startDate={start:yyyy-MM-dd}&endDate={end:yyyy-MM-dd}") ?? [];
        CalendarEvents = await Http.GetFromJsonAsync<List<AttendanceCalendarEventDto>>(
            $"api/attendance-calendar-events?startDate={start:yyyy-MM-dd}&endDate={end:yyyy-MM-dd}") ?? [];
    }

    private void BuildCalendar()
    {
        var firstDay = new DateOnly(DisplayedMonth.Year, DisplayedMonth.Month, 1);
        var calendarStart = firstDay.AddDays(-(int)firstDay.DayOfWeek);

        CalendarDays = Enumerable.Range(0, 42)
            .Select(offset =>
            {
                var date = calendarStart.AddDays(offset);
                return new CalendarDay(
                    date,
                    date.Month == DisplayedMonth.Month && date.Year == DisplayedMonth.Year,
                    CreateCalendarRecord(date));
            })
            .ToList();
    }

    private AttendanceRecord? CreateCalendarRecord(DateOnly date)
    {
        var companyCalendarDay = WorkCalendarDays.FirstOrDefault(item => item.CalendarDate == date);
        if (companyCalendarDay?.DayType == "PUBLIC_HOLIDAY")
        {
            return new AttendanceRecord(
                AttendanceStatus.PublicHoliday,
                null,
                null,
                companyCalendarDay.Name,
                null,
                companyCalendarDay);
        }

        if (date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday &&
            companyCalendarDay?.DayType != "WORKING_SATURDAY")
        {
            return new AttendanceRecord(
                AttendanceStatus.Weekend,
                null,
                null,
                "วันหยุดประจำสัปดาห์",
                null,
                null);
        }

        var importedRecord = AttendanceDailyRecords.FirstOrDefault(item => item.WorkDate == date);
        if (importedRecord is not null)
            return FromDailyRecord(importedRecord, companyCalendarDay);

        if (companyCalendarDay?.DayType == "WORKING_SATURDAY")
        {
            if (AttendanceDailyRecords.All(item => item.WorkDate != date))
            {
                return new AttendanceRecord(
                    AttendanceStatus.ScheduledWork,
                    null,
                    null,
                    companyCalendarDay.Name,
                    null,
                    companyCalendarDay);
            }

            var saturdayMinute = 38 + (date.Day % 13);
            return new AttendanceRecord(
                AttendanceStatus.Present,
                $"08:{saturdayMinute:00}",
                "17:35",
                companyCalendarDay.Name,
                null,
                companyCalendarDay);
        }

        if (AttendanceDailyRecords.All(item => item.WorkDate != date))
        {
            return null;
        }

        if (date.Day % 13 == 0)
        {
            return new AttendanceRecord(
                AttendanceStatus.Absent,
                null,
                null,
                "ไม่มีการบันทึกเวลา",
                null,
                null);
        }

        if (date.Day % 7 == 0)
        {
            return new AttendanceRecord(
                AttendanceStatus.Late,
                "09:18",
                "18:05",
                "มาสาย 18 นาที",
                null,
                null);
        }

        var minute = 38 + (date.Day % 13);
        return new AttendanceRecord(
            AttendanceStatus.Present,
            $"08:{minute:00}",
            "17:35",
            "บันทึกเวลาครบถ้วน",
            null,
            null);
    }

    private static AttendanceRecord FromDailyRecord(
        AttendanceDailyDto daily, WorkCalendarDayDto? calendarDay) =>
        new(ParseAttendanceStatus(daily),
            daily.FirstScanAt?.ToString("HH:mm"), daily.LastScanAt?.ToString("HH:mm"),
            daily.OverrideReason ?? AttendanceStatusNote(daily),
            null, calendarDay, daily.LateMinutes, daily.MissingMinutes,
            daily.RequiresReview || daily.FinalStatus == "REVIEW_REQUIRED");

    private static AttendanceStatus ParseAttendanceStatus(AttendanceDailyDto daily)
    {
        if (daily.MissingMinutes > 0 || daily.FinalStatus is "ABSENT" or "INCOMPLETE") return AttendanceStatus.Absent;
        if (daily.LateMinutes > 0 || daily.FinalStatus == "LATE") return AttendanceStatus.Late;
        if (daily.FinalStatus == "IN_PROGRESS") return AttendanceStatus.InProgress;
        return AttendanceStatus.Present;
    }

    private static string AttendanceStatusNote(AttendanceDailyDto daily)
    {
        var parts = new List<string>();
        if (daily.LateMinutes > 0) parts.Add($"มาสาย {daily.LateMinutes} นาที");
        if (daily.MissingMinutes > 0) parts.Add($"ขาดงาน {daily.MissingMinutes} นาที");
        if (parts.Count == 0) parts.Add(daily.FinalStatus == "IN_PROGRESS" ? "อยู่ในช่วงเวลาทำงาน" : "มาปกติ");
        if (daily.RequiresReview || daily.FinalStatus == "REVIEW_REQUIRED") parts.Add("รอตรวจสอบ");
        return string.Join(" · ", parts);
    }

    private List<LeaveDocumentDto> GetLeaveDocuments(DateOnly date) => LeaveDocuments
        .Where(document => document.LeaveDate == date &&
            IsVisibleLeaveDocument(document))
        .OrderBy(document => document.StartTime)
