@using HrProject.Shared.Models

<div class="master-multi-select">
    @if (selectedValues.Count > 0)
    {
        <div class="selected-values">
            @foreach (var value in selectedValues)
            {
                <span class="selected-value">
                    @value
                    @if (!Disabled)
                    {
                        <button type="button" title="นำออก" @onclick="() => Remove(value)">×</button>
                    }
                </span>
            }
        </div>
    }
    <div class="multi-combobox">
        <input type="text" value="@searchText" placeholder="@Placeholder" autocomplete="off"
               disabled="@Disabled" role="combobox" aria-expanded="@isOpen" aria-autocomplete="list"
               @onfocus="Open" @onblur="CloseAfterSelection" @oninput="Search" />
        @if (isOpen && !Disabled)
        {
            <div class="master-options" role="listbox">
                @if (!FilteredItems.Any())
                {
                    <div class="master-option-empty">ไม่พบข้อมูลที่ค้นหา</div>
                }
                else
                {
                    @foreach (var item in FilteredItems)
                    {
                        <button type="button" class="master-option" role="option"
                                @onmousedown:preventDefault="true" @onclick="() => SelectItem(item)">
                            <strong>@item.NameTh</strong>
                            @if (!string.IsNullOrWhiteSpace(item.NameEn))
                            {
                                <span>@item.NameEn</span>
                            }
                        </button>
                    }
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<MasterDataItemDto> Items { get; set; } = [];
    [Parameter] public IReadOnlyCollection<string> Values { get; set; } = [];
    [Parameter] public EventCallback<List<string>> ValuesChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "-- เลือกหรือพิมพ์ค้นหาจังหวัด --";

    private List<string> selectedValues = [];
    private string synchronizedValues = string.Empty;
    private string searchText = string.Empty;
    private bool isOpen;

    private IEnumerable<MasterDataItemDto> FilteredItems
    {
        get
        {
            var term = searchText.Trim();
            return Items.Where(item => !selectedValues.Contains(item.NameTh, StringComparer.OrdinalIgnoreCase) &&
                    (term.Length == 0 || item.NameTh.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                     (item.NameEn?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                     item.ItemCode.Contains(term, StringComparison.OrdinalIgnoreCase)))
                .Take(100);
        }
    }

    protected override void OnParametersSet()
    {
        var signature = string.Join("|", Values ?? []);
        if (string.Equals(signature, synchronizedValues, StringComparison.Ordinal)) return;
        synchronizedValues = signature;
        selectedValues = (Values ?? []).Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void Open() => isOpen = true;
    private void Search(ChangeEventArgs args) { searchText = args.Value?.ToString() ?? string.Empty; isOpen = true; }

    private async Task SelectItem(MasterDataItemDto item)
    {
        if (!selectedValues.Contains(item.NameTh, StringComparer.OrdinalIgnoreCase)) selectedValues.Add(item.NameTh);
        searchText = string.Empty;
        synchronizedValues = string.Join("|", selectedValues);
        await ValuesChanged.InvokeAsync([.. selectedValues]);
    }

    private async Task Remove(string value)
    {
        selectedValues.RemoveAll(item => string.Equals(item, value, StringComparison.OrdinalIgnoreCase));
        synchronizedValues = string.Join("|", selectedValues);
        await ValuesChanged.InvokeAsync([.. selectedValues]);
    }

    private async Task CloseAfterSelection() { await Task.Delay(150); isOpen = false; }
}
