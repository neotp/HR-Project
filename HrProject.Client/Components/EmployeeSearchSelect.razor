@using HrProject.Shared.Models

<div class="employee-combobox @(InlineOptions ? "inline-options" : string.Empty)">
    <input type="text"
           @bind="SearchText"
           @bind:event="oninput"
           placeholder="@Placeholder"
           autocomplete="off"
           disabled="@Disabled"
           role="combobox"
           aria-expanded="@isOpen"
           aria-autocomplete="list"
           @onfocus="Open"
           @onblur="CloseAfterSelection" />

    @if (isOpen && !Disabled)
    {
        <div class="employee-options" role="listbox">
            @if (!FilteredEmployees.Any())
            {
                <div class="employee-option-empty">ไม่พบพนักงานที่ค้นหา</div>
            }
            else
            {
                @foreach (var employee in FilteredEmployees)
                {
                    <button type="button"
                            class="employee-option"
                            role="option"
                            @onmousedown:preventDefault="true"
                            @onclick="() => SelectEmployee(employee)">
                        <strong>@employee.FullName</strong>
                        <span>@EmployeeCodeFormat.Display(employee.EmployeeCode)@EmployeeDetails(employee)</span>
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<Employee> Items { get; set; } = [];
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool InlineOptions { get; set; }
    [Parameter] public string ExcludeEmployeeCode { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "พิมพ์ชื่อ รหัส หรืออีเมลพนักงาน";

    private string searchText = string.Empty;
    private string synchronizedValue = string.Empty;
    private bool isOpen;

    private string SearchText
    {
        get => searchText;
        set
        {
            var next = value ?? string.Empty;
            if (string.Equals(searchText, next, StringComparison.Ordinal))
                return;

            searchText = next;
            isOpen = true;
            if (synchronizedValue.Length == 0)
                return;

            synchronizedValue = string.Empty;
            _ = ValueChanged.InvokeAsync(string.Empty);
        }
    }

    private IEnumerable<Employee> FilteredEmployees
    {
        get
        {
            var term = searchText.Trim();
            return Items
                .Where(employee => !string.Equals(
                    employee.EmployeeCode, ExcludeEmployeeCode, StringComparison.OrdinalIgnoreCase))
                .Where(employee => term.Length == 0 ||
                    employee.EmployeeCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.FirstName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.LastName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.ThaiFullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.EnglishFullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.Nickname.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.Department.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.Position.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.Email.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    employee.LotusNotesEmail.Contains(term, StringComparison.OrdinalIgnoreCase))
                .Take(50);
        }
    }

    protected override void OnParametersSet()
    {
        if (string.Equals(Value, synchronizedValue, StringComparison.OrdinalIgnoreCase))
            return;

        synchronizedValue = Value ?? string.Empty;
        var selected = Items.FirstOrDefault(employee =>
            string.Equals(employee.EmployeeCode, synchronizedValue, StringComparison.OrdinalIgnoreCase));
        searchText = selected is null
            ? string.Empty
            : $"{selected.FullName} ({EmployeeCodeFormat.Display(selected.EmployeeCode)})";
    }

    private void Open() => isOpen = true;

    private async Task SelectEmployee(Employee employee)
    {
        searchText = $"{employee.FullName} ({EmployeeCodeFormat.Display(employee.EmployeeCode)})";
        synchronizedValue = employee.EmployeeCode;
        isOpen = false;
        await ValueChanged.InvokeAsync(employee.EmployeeCode);
    }

    private async Task CloseAfterSelection()
    {
        await Task.Delay(150);
        isOpen = false;
    }

    private static string EmployeeDetails(Employee employee)
    {
        var details = new[] { employee.EnglishFullName, employee.Department, employee.Email }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var text = string.Join(" · ", details);
        return text.Length == 0 ? string.Empty : $" · {text}";
    }
}
