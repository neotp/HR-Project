<div class="time-minute-picker" aria-label="@AriaLabel">
    <select value="@Value.Hour" @onchange="ChangeHour" disabled="@Disabled" aria-label="ชั่วโมง">
        @for (var hour = 0; hour < 24; hour++)
        {
            <option value="@hour">@hour.ToString("00")</option>
        }
    </select>
    <span aria-hidden="true">:</span>
    <select value="@Value.Minute" @onchange="ChangeMinute" disabled="@Disabled" aria-label="นาที">
        @for (var minute = 0; minute < 60; minute++)
        {
            <option value="@minute">@minute.ToString("00")</option>
        }
    </select>
</div>

@code {
    [Parameter] public TimeOnly Value { get; set; }
    [Parameter] public EventCallback<TimeOnly> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "เวลาแบบ 24 ชั่วโมง";

    private Task ChangeHour(ChangeEventArgs eventArgs)
    {
        var hour = int.TryParse(eventArgs.Value?.ToString(), out var value) ? value : Value.Hour;
        return ValueChanged.InvokeAsync(new TimeOnly(hour, Value.Minute));
    }

    private Task ChangeMinute(ChangeEventArgs eventArgs)
    {
        var minute = int.TryParse(eventArgs.Value?.ToString(), out var value) ? value : Value.Minute;
        return ValueChanged.InvokeAsync(new TimeOnly(Value.Hour, minute));
    }
}
