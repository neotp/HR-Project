@inject HttpClient Http

<section class="employee-change-history">
    @if (isLoading)
    {
        <div class="employee-history-state"><span class="history-spinner"></span>กำลังโหลดประวัติการเปลี่ยนแปลง...</div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="employee-history-state error">@loadError</div>
    }
    else if (items.Count == 0)
    {
        <div class="employee-history-state empty">
            <span aria-hidden="true">↺</span>
            <strong>ยังไม่มีประวัติการเปลี่ยนแปลง</strong>
            <small>เมื่อมีคำขอแก้ไขข้อมูล ประวัติและรายละเอียดฟิลด์จะปรากฏที่นี่</small>
        </div>
    }
    else
    {
        <div class="change-history-list">
            @foreach (var item in items)
            {
                <article class="change-history-card">
                    <header>
                        <div>
                            <strong>@item.RequestNo</strong>
                            <small>@(item.HistoryType == "ACTIVITY" ? "ดำเนินการโดย" : "ส่งคำขอโดย") @item.RequestedByName · @FormatDateTime(item.RequestedAt)</small>
                        </div>
                        <span class="history-status @StatusClass(item.Status)">@StatusText(item.Status)</span>
                    </header>

                    <div class="change-request-reason"><span>@(item.HistoryType == "ACTIVITY" ? "รายละเอียด" : "เหตุผลที่ขอแก้ไข")</span><p>@item.RequestReason</p></div>

                    @if (item.Changes.Count > 0)
                    {
                    <div class="field-change-list">
                        <div class="field-change-heading">
                            <strong>ข้อมูลที่เปลี่ยนแปลง</strong><span>@item.Changes.Count ฟิลด์</span>
                        </div>
                        @foreach (var change in item.Changes)
                        {
                            <div class="field-change-row">
                                <strong>@change.FieldName</strong>
                                <div class="value-comparison">
                                    <div><span>ข้อมูลเดิม</span>@ChangeValue(change, change.OldValue, true)</div>
                                    <span class="change-arrow" aria-hidden="true">→</span>
                                    <div class="new-value"><span>ข้อมูลใหม่</span>@ChangeValue(change, change.NewValue, false)</div>
                                </div>
                            </div>
                        }
                    </div>
                    }

                    @if (item.Actions.Count > 0)
                    {
                        <div class="change-action-list">
                            <strong>ลำดับการดำเนินการ</strong>
                            @foreach (var action in item.Actions)
                            {
                                <div class="change-action-item">
                                    <span class="action-dot @ActionClass(action.Action)"></span>
                                    <div><b>@ActionText(action.Action)</b><p>@action.Details</p></div>
                                    <small>@action.ActionByName<br />@FormatDateTime(action.ActionAt)</small>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.ReviewRemark))
                    {
                        <footer><span>หมายเหตุผู้ตรวจสอบ</span><strong>@item.ReviewRemark</strong></footer>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public int EmployeeId { get; set; }

    private readonly List<EmployeeChangeHistoryDto> items = [];
    private int loadedEmployeeId;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnParametersSetAsync()
    {
        if (EmployeeId <= 0 || EmployeeId == loadedEmployeeId) return;
        loadedEmployeeId = EmployeeId;
        isLoading = true;
        loadError = null;
        try
        {
            items.Clear();
            items.AddRange(await Http.GetFromJsonAsync<List<EmployeeChangeHistoryDto>>(
                $"api/employees/{EmployeeId}/change-history") ?? []);
        }
        catch (Exception exception)
        {
            loadError = $"โหลดประวัติไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static RenderFragment ChangeValue(EmployeeFieldChangeDto change, string value, bool oldValue) => builder =>
    {
        var text = FormatValue(change.FieldKey, value, oldValue);
        builder.OpenElement(0, "p");
        builder.AddAttribute(1, "title", text);
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private static string FormatValue(string fieldKey, string? value, bool oldValue)
    {
        if (fieldKey.Equals("profileImage", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(value) ? "ไม่มีรูปโปรไฟล์" : oldValue ? "รูปโปรไฟล์เดิม" : "รูปโปรไฟล์ใหม่";
        if (fieldKey.EndsWith(".history", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                using var json = System.Text.Json.JsonDocument.Parse(value ?? "[]");
                return $"{json.RootElement.GetArrayLength()} รายการ";
            }
            catch { return "ข้อมูลรายการถูกเปลี่ยนแปลง"; }
        }
        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", out var date)) return date.ToString("dd/MM/yyyy");
        if (string.Equals(value, "true", StringComparison.OrdinalIgnoreCase)) return "ใช่";
        if (string.Equals(value, "false", StringComparison.OrdinalIgnoreCase)) return "ไม่ใช่";
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string StatusText(string status) => status.ToUpperInvariant() switch
    {
        "PENDING" => "รออนุมัติ", "APPROVED" => "อนุมัติแล้ว",
        "REJECTED" => "ไม่อนุมัติ", "CANCELLED" => "ยกเลิก", "COMPLETED" => "ดำเนินการแล้ว", _ => status
    };
    private static string StatusClass(string status) => status.ToLowerInvariant();
    private static string ActionText(string action) => action.ToUpperInvariant() switch
    {
        "CREATE_REQUEST" => "ส่งคำขอแก้ไข", "APPROVE" => "อนุมัติ",
        "REJECT" => "ไม่อนุมัติ", "CANCEL" => "ยกเลิกคำขอ",
        "PERSONAL_DOCUMENT_ADDED" => "เพิ่มเอกสารส่วนตัว",
        "PERSONAL_DOCUMENT_DELETED" => "ลบเอกสารส่วนตัว", _ => action
    };
    private static string ActionClass(string action) => action.ToLowerInvariant().Replace('_', '-');
    private static string FormatDateTime(DateTimeOffset value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
}
