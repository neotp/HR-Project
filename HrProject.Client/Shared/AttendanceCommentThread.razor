@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<section class="attendance-comment-thread">
    <header class="attendance-comment-header">
        <div>
            <h3>ความคิดเห็นและการตอบกลับ</h3>
            <p>ใช้สำหรับพูดคุยเกี่ยวกับรายการการมาทำงานนี้</p>
        </div>
        <span>@comments.Count ข้อความ</span>
    </header>

    <div id="@TimelineId" class="attendance-comment-list" aria-live="polite">
        @if (isLoading)
        {
            <div class="attendance-comment-state"><i></i>กำลังโหลดความคิดเห็น...</div>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="attendance-comment-state error">@loadError <button type="button" @onclick="LoadComments">ลองใหม่</button></div>
        }
        else if (comments.Count == 0)
        {
            <div class="attendance-comment-state">ยังไม่มีความคิดเห็น เริ่มการสนทนาได้จากช่องด้านล่าง</div>
        }
        else
        {
            @foreach (var comment in comments)
            {
                <article class="attendance-comment-item">
                    <span class="attendance-comment-avatar" aria-hidden="true">@Initial(comment.CommentedByName)</span>
                    <div>
                        <header><strong>@comment.CommentedByName</strong><time>@comment.CommentedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></header>
                        <p>@comment.CommentText</p>
                    </div>
                </article>
            }
        }
    </div>

    <div class="attendance-comment-composer">
        <label for="@EditorId">Comment / Response <span>*</span></label>
        <textarea id="@EditorId" rows="3" maxlength="4000" disabled="@isSaving"
                  @bind="commentText" @bind:event="oninput"
                  placeholder="พิมพ์ความคิดเห็นหรือข้อความตอบกลับ..."></textarea>
        @if (!string.IsNullOrWhiteSpace(saveError))
        {
            <div class="attendance-comment-save-error">@saveError</div>
        }
        <div class="attendance-comment-actions">
            <small>@commentText.Length.ToString("N0") / 4,000</small>
            <button type="button" disabled="@(isSaving || string.IsNullOrWhiteSpace(commentText))" @onclick="SubmitComment">
                @(isSaving ? "กำลังส่ง..." : "ส่งความคิดเห็น")
            </button>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public long AttendanceDailyId { get; set; }

    private readonly List<AttendanceCommentDto> comments = [];
    private long loadedDailyId;
    private string commentText = string.Empty;
    private string? loadError;
    private string? saveError;
    private bool isLoading;
    private bool isSaving;
    private bool scrollToLatest;
    private string TimelineId => $"attendance-comments-{AttendanceDailyId}";
    private string EditorId => $"attendance-comment-editor-{AttendanceDailyId}";

    protected override async Task OnParametersSetAsync()
    {
        if (AttendanceDailyId <= 0 || loadedDailyId == AttendanceDailyId) return;
        loadedDailyId = AttendanceDailyId;
        await LoadComments();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToLatest) return;
        scrollToLatest = false;
        await JS.InvokeVoidAsync("hrScroll.toBottom", TimelineId, false);
    }

    private async Task LoadComments()
    {
        isLoading = true;
        loadError = null;
        comments.Clear();
        try
        {
            var http = HttpClientFactory.CreateClient("HrApiBackground");
            var result = await http.GetFromJsonAsync<List<AttendanceCommentDto>>(
                $"api/attendance/{AttendanceDailyId}/comments");
            if (result is not null) comments.AddRange(result);
            scrollToLatest = true;
        }
        catch (Exception exception)
        {
            loadError = $"โหลดความคิดเห็นไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitComment()
    {
        var text = commentText.Trim();
        if (isSaving || string.IsNullOrWhiteSpace(text)) return;
        isSaving = true;
        saveError = null;
        try
        {
            var http = HttpClientFactory.CreateClient("HrApiBackground");
            var response = await http.PostAsJsonAsync(
                $"api/attendance/{AttendanceDailyId}/comments",
                new AddAttendanceCommentRequest(text));
            if (!response.IsSuccessStatusCode)
            {
                var detail = (await response.Content.ReadAsStringAsync()).Trim().Trim('"');
                saveError = string.IsNullOrWhiteSpace(detail) ? "ส่งความคิดเห็นไม่สำเร็จ" : detail;
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<AttendanceCommentDto>();
            if (saved is not null) comments.Add(saved);
            commentText = string.Empty;
            scrollToLatest = true;
        }
        catch (Exception exception)
        {
            saveError = $"ส่งความคิดเห็นไม่สำเร็จ: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString();
}
