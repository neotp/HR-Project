@implements IDisposable
@inject HrProject.Client.Services.PageAvailabilityState PageAvailability
@inject HrProject.Client.Services.NavPendingRefreshState PendingRefreshState
@inject HrProject.Client.Services.LoadingState LoadingState
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<div class="nav-shell @(IsDesktopCollapsed ? "desktop-collapsed" : null)">
<div class="top-row navbar navbar-dark">
    <div class="container-fluid">
        <img class="brand-logo" src="images/image.png" alt="SiS logo" />
        <a class="navbar-brand" href="">SiS Distribution<br />(Thailand) PCL.</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (!collapseNavMenu)
{
    <button class="nav-backdrop" type="button" aria-label="ปิดเมนู" @onclick="ToggleNavMenu"></button>
}

<div class="@NavMenuCssClass nav-scrollable" @onclick="CloseNavMenu">
    <nav class="nav-menu">
        <p class="menu-section">การลา</p>
        <NavLink class="@MenuClass("LEAVE_DOCUMENTS")" href="leave/documents"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>เอกสารการลา @MaintenanceLabel("LEAVE_DOCUMENTS")</NavLink>
        <NavLink class="@MenuClass("LEAVE_ALL_DOCUMENTS")" href="leave/all-documents"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>เอกสารทั้งหมด @MaintenanceLabel("LEAVE_ALL_DOCUMENTS")</NavLink>
        @if (PageAvailability.HasAccess("LEAVE_PENDING"))
        {
            <NavLink class="@MenuClass("LEAVE_PENDING")" href="leave/pending"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="m7 13 3 3 7-8"/></svg>เอกสารรออนุมัติ @MaintenanceLabel("LEAVE_PENDING") @PendingBadge("LEAVE_PENDING")</NavLink>
        }
        <NavLink class="@MenuClass("LEAVE_REVISIONS")" href="leave/revisions"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>ขอแก้ไข/ยกเลิกเอกสาร @MaintenanceLabel("LEAVE_REVISIONS") @PendingBadge("LEAVE_REVISIONS")</NavLink>
        <NavLink class="@MenuClass("LEAVE_TEAM")" href="leave/team"><svg class="menu-icon" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M16 3.1a4 4 0 0 1 0 7.8M21 21v-2a6 6 0 0 0-3-5.2"/></svg>หัวหน้าแจ้งลาลูกน้อง @MaintenanceLabel("LEAVE_TEAM")</NavLink>
        <NavLink class="@MenuClass("LEAVE_REQUEST_QUOTA")" href="leave/request-quota"><svg class="menu-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4"/></svg>ขอวันลาเพิ่ม @MaintenanceLabel("LEAVE_REQUEST_QUOTA") @PendingBadge("LEAVE_REQUEST_QUOTA")</NavLink>
        <NavLink class="@MenuClass("LEAVE_MANAGE_QUOTA")" href="leave/manage-quota"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="9"/></svg>จัดการโควต้าวันลา @MaintenanceLabel("LEAVE_MANAGE_QUOTA")</NavLink>
        @if (PageAvailability.HasAccess("LEAVE_QUOTA_MOVEMENTS"))
        {
            <NavLink class="@MenuClass("LEAVE_QUOTA_MOVEMENTS")" href="leave/quota-movements"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/><path d="m15 3 3 3-3 3M9 15l-3 3 3 3"/></svg>Movement โควต้าวันลา @MaintenanceLabel("LEAVE_QUOTA_MOVEMENTS")</NavLink>
        }
        
        <p class="menu-section">การมาทำงาน</p>
        <NavLink class="@MenuClass("ATTENDANCE")" href="attendance" Match="NavLinkMatch.All"><svg class="menu-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>ปฏิทินการมาทำงาน @MaintenanceLabel("ATTENDANCE")</NavLink>
        <NavLink class="@MenuClass("ATTENDANCE_RECORDS")" href="attendance/records" Match="NavLinkMatch.All"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M4 5h16M4 12h16M4 19h16"/><circle cx="7" cy="5" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="7" cy="19" r="1"/></svg>การมาทำงาน @MaintenanceLabel("ATTENDANCE_RECORDS")</NavLink>
        @if (PageAvailability.HasAccess("ATTENDANCE_REVIEWS"))
        {
            <NavLink class="@MenuClass("ATTENDANCE_REVIEWS")" href="attendance/reviews"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>ตรวจสอบข้อโต้แย้ง @MaintenanceLabel("ATTENDANCE_REVIEWS") @PendingBadge("ATTENDANCE_REVIEWS")</NavLink>
        }
        <NavLink class="@MenuClass("WORK_CALENDAR")" href="attendance/calendar-settings"><svg class="menu-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg>กำหนดปฏิทินการทำงาน @MaintenanceLabel("WORK_CALENDAR")</NavLink>

        <p class="menu-section">การรับเข้าทำงาน</p>
        <NavLink class="@MenuClass("PRE_EMPLOYEES")" href="recruitment/pre-employees"><svg class="menu-icon" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M19 8v6M16 11h6"/></svg>Pre-Employee @MaintenanceLabel("PRE_EMPLOYEES") @PendingBadge("PRE_EMPLOYEES")</NavLink>

        <p class="menu-section">พนักงาน</p>
        <NavLink class="@MenuClass("EMPLOYEES")" href="" Match="NavLinkMatch.All"><svg class="menu-icon" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>ข้อมูลพนักงาน @MaintenanceLabel("EMPLOYEES")</NavLink>
        @if (PageAvailability.HasAccess("EMPLOYEES_RESIGNED"))
        {
            <NavLink class="@MenuClass("EMPLOYEES_RESIGNED")" href="employees/resigned"><svg class="menu-icon" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M17 9h5M19.5 6.5v5"/></svg>พนักงานที่ลาออก @MaintenanceLabel("EMPLOYEES_RESIGNED")</NavLink>
        }
        <NavLink class="@MenuClass("EMPLOYEE_EDIT_REQUESTS")" href="employees/edit-requests"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>ขอแก้ไขข้อมูลพนักงาน @MaintenanceLabel("EMPLOYEE_EDIT_REQUESTS") @PendingBadge("EMPLOYEE_EDIT_REQUESTS")</NavLink>
        
        <p class="menu-section">การจัดการระบบ</p>
        <NavLink class="@MenuClass("PERMISSIONS")" href="permissions"><svg class="menu-icon" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>จัดการสิทธิ์การเข้าถึง</NavLink>
        <NavLink class="@MenuClass("SYSTEM_MASTER_DATA")" href="system/master-data"><svg class="menu-icon" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="8" cy="6" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="10" cy="18" r="2"/></svg>จัดการข้อมูลพื้นฐานระบบ @MaintenanceLabel("SYSTEM_MASTER_DATA")</NavLink>
    </nav>
    <LoginDisplay />
</div>
</div>

@code {
    [Parameter]
    public bool IsDesktopCollapsed { get; set; }

    [Parameter]
    public EventCallback<bool> IsDesktopCollapsedChanged { get; set; }

    private bool collapseNavMenu = true;
    private string NavMenuCssClass => collapseNavMenu ? "is-collapsed" : "is-open";
    private readonly Dictionary<string, int> pendingCounts = new(StringComparer.OrdinalIgnoreCase);
    private readonly SemaphoreSlim pendingLoadLock = new(1, 1);
    private readonly CancellationTokenSource disposeToken = new();
    private HttpClient? backgroundHttp;
    private PeriodicTimer? refreshTimer;
    private string? currentEmployeeId;

    protected override async Task OnInitializedAsync()
    {
        using var initialLoading = LoadingState.BeginRequest();
        PageAvailability.Changed += HandleAvailabilityChanged;
        PendingRefreshState.RefreshRequested += HandlePendingRefreshRequested;
        Navigation.LocationChanged += HandleLocationChanged;
        backgroundHttp = HttpClientFactory.CreateClient("HrApiBackground");
        try { await PageAvailability.EnsureLoadedAsync(); }
        catch { }
        await RefreshPendingCountsAsync();
        refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RunRefreshLoopAsync();
    }

    private string MenuClass(string pageKey) =>
        PageAvailability.IsEnabled(pageKey) ? "menu-link" : "menu-link menu-disabled";

    private RenderFragment MaintenanceLabel(string pageKey) => builder =>
    {
        if (!PageAvailability.IsEnabled(pageKey))
            builder.AddMarkupContent(0, "<small class=\"maintenance-label\">ปิดปรับปรุง</small>");
    };

    private RenderFragment PendingBadge(string pageKey) => builder =>
    {
        if (!PageAvailability.IsEnabled(pageKey) ||
            !pendingCounts.TryGetValue(pageKey, out var count) || count <= 0)
            return;

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "nav-pending-badge");
        builder.AddAttribute(2, "title", $"มีรายการรอดำเนินการ {count} รายการ");
        builder.AddContent(3, count > 99 ? "99+" : count.ToString());
        builder.CloseElement();
    };

    private async Task RefreshPendingCountsAsync()
    {
        if (backgroundHttp is null || !await pendingLoadLock.WaitAsync(0))
            return;

        try
        {
            if (string.IsNullOrWhiteSpace(currentEmployeeId))
            {
                var user = await backgroundHttp.GetFromJsonAsync<CurrentMicrosoftUserDto>(
                    "api/auth/me", disposeToken.Token);
                currentEmployeeId = user?.EmployeeId;
            }
            if (string.IsNullOrWhiteSpace(currentEmployeeId)) return;

            var employeeId = Uri.EscapeDataString(currentEmployeeId);
            var next = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

            var pendingTask = PageAvailability.HasAccess("LEAVE_PENDING")
                ? GetListAsync<LeaveDocumentDto>(
                    $"api/leave-documents?status=PENDING_APPROVAL&actingEmployeeId={employeeId}")
                : Task.FromResult(new List<LeaveDocumentDto>());
            var editTask = GetListAsync<LeaveDocumentDto>(
                $"api/leave-documents?status=EDIT_REQUESTED&actingEmployeeId={employeeId}");
            var cancelTask = GetListAsync<LeaveDocumentDto>(
                $"api/leave-documents/cancel-requests/pending?actingEmployeeId={employeeId}");
            var quotaActionsTask = GetActionsAsync(employeeId, "LEAVE_REQUEST_QUOTA");
            var employeeActionsTask = GetActionsAsync(employeeId, "EMPLOYEE_EDIT_REQUESTS");
            var preEmployeeActionsTask = GetActionsAsync(employeeId, "PRE_EMPLOYEES");

            var year = DateTime.Today.Year;
            var from = new DateOnly(year, 1, 1);
            var to = new DateOnly(year, 12, 31);
            var attendanceTask = PageAvailability.HasAccess("ATTENDANCE_REVIEWS")
                ? GetListAsync<AttendanceReviewItemDto>(
                    $"api/attendance/reviews?startDate={from:yyyy-MM-dd}&endDate={to:yyyy-MM-dd}")
                : Task.FromResult(new List<AttendanceReviewItemDto>());
            var eventTask = PageAvailability.HasAccess("ATTENDANCE_REVIEWS")
                ? GetListAsync<AttendanceCalendarEventReviewDto>(
                    $"api/attendance-calendar-events/reviews?startDate={from:yyyy-MM-dd}&endDate={to:yyyy-MM-dd}")
                : Task.FromResult(new List<AttendanceCalendarEventReviewDto>());

            await Task.WhenAll(pendingTask, editTask, cancelTask, quotaActionsTask,
                employeeActionsTask, preEmployeeActionsTask, attendanceTask, eventTask);

            var pendingItems = await pendingTask;
            if (PageAvailability.HasAccess("LEAVE_PENDING"))
                next["LEAVE_PENDING"] = pendingItems.Count(item => item.Status == "PENDING_APPROVAL");

            var editItems = await editTask;
            var cancelItems = await cancelTask;
            next["LEAVE_REVISIONS"] = editItems.Where(item => item.Status == "EDIT_REQUESTED")
                .Select(item => item.Id)
                .Concat(cancelItems.Where(item => item.PendingCancelRequest is not null).Select(item => item.Id))
                .Distinct()
                .Count();

            var quotaActions = await quotaActionsTask;
            var employeeActions = await employeeActionsTask;
            var preEmployeeActions = await preEmployeeActionsTask;
            var quotaRequestsTask = HasReviewAction(quotaActions)
                ? GetListAsync<LeaveQuotaRequestDto>("api/leave-quota-requests")
                : Task.FromResult(new List<LeaveQuotaRequestDto>());
            var employeeRequestsTask = HasReviewAction(employeeActions)
                ? GetListAsync<EmployeeEditRequestDto>("api/employee-edit-requests")
                : Task.FromResult(new List<EmployeeEditRequestDto>());
            var preEmployeesTask = preEmployeeActions.Contains("CONVERT") ||
                                   preEmployeeActions.Contains("EDIT") ||
                                   preEmployeeActions.Contains("VIEW_ALL")
                ? GetListAsync<PreEmployeeDto>("api/pre-employees")
                : Task.FromResult(new List<PreEmployeeDto>());
            await Task.WhenAll(quotaRequestsTask, employeeRequestsTask, preEmployeesTask);

            if (HasReviewAction(quotaActions))
            {
                var requests = await quotaRequestsTask;
                next["LEAVE_REQUEST_QUOTA"] = requests.Count(item => item.Status == "PENDING");
            }

            if (PageAvailability.HasAccess("ATTENDANCE_REVIEWS"))
            {
                var attendanceItems = await attendanceTask;
                var eventItems = await eventTask;
                next["ATTENDANCE_REVIEWS"] =
                    attendanceItems.Count(item => item.LatestResponse?.Status == "SUBMITTED") +
                    eventItems.Count(item => item.Status == "PENDING");
            }

            if (HasReviewAction(employeeActions))
            {
                var requests = await employeeRequestsTask;
                next["EMPLOYEE_EDIT_REQUESTS"] = requests.Count(item => item.Status == "PENDING");
            }

            if (preEmployeeActions.Contains("CONVERT") || preEmployeeActions.Contains("EDIT") ||
                preEmployeeActions.Contains("VIEW_ALL"))
            {
                var preEmployees = await preEmployeesTask;
                next["PRE_EMPLOYEES"] = preEmployees.Count(item =>
                    item.Status is "DRAFT" or "INCOMPLETE" or "READY");
            }

            pendingCounts.Clear();
            foreach (var item in next)
                pendingCounts[item.Key] = item.Value;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (disposeToken.IsCancellationRequested) { }
        catch
        {
            // Keep the last successful counters when a background refresh fails.
        }
        finally
        {
            pendingLoadLock.Release();
        }
    }

    private async Task<List<T>> GetListAsync<T>(string url)
    {
        try
        {
            return await backgroundHttp!.GetFromJsonAsync<List<T>>(url, disposeToken.Token) ?? [];
        }
        catch when (!disposeToken.IsCancellationRequested)
        {
            return [];
        }
    }

    private async Task<HashSet<string>> GetActionsAsync(string employeeId, string pageKey)
    {
        try
        {
            var result = await backgroundHttp!.GetFromJsonAsync<CurrentPageActionPermissionsDto>(
                $"api/page-permissions/current-actions?employeeId={employeeId}&pageKey={pageKey}",
                disposeToken.Token);
            return result?.AllowedActions.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
        }
        catch when (!disposeToken.IsCancellationRequested)
        {
            return [];
        }
    }

    private static bool HasReviewAction(ISet<string> actions) =>
        actions.Contains("APPROVE") || actions.Contains("REJECT") || actions.Contains("VIEW_ALL");

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (refreshTimer is not null &&
                   await refreshTimer.WaitForNextTickAsync(disposeToken.Token))
                await RefreshPendingCountsAsync();
        }
        catch (OperationCanceledException) when (disposeToken.IsCancellationRequested) { }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = RefreshPendingCountsAsync();

    private void HandlePendingRefreshRequested() =>
        _ = InvokeAsync(RefreshPendingCountsAsync);

    private void HandleAvailabilityChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
        await IsDesktopCollapsedChanged.InvokeAsync(!IsDesktopCollapsed);
    }

    private void CloseNavMenu() => collapseNavMenu = true;

    public void Dispose()
    {
        PageAvailability.Changed -= HandleAvailabilityChanged;
        PendingRefreshState.RefreshRequested -= HandlePendingRefreshRequested;
        Navigation.LocationChanged -= HandleLocationChanged;
        disposeToken.Cancel();
        refreshTimer?.Dispose();
        disposeToken.Dispose();
    }
}
